<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <module name="TreeWalker">

        <!-- No empty blocks -->
        <module name="EmptyBlock"/>

        <!-- Methods should not exceed 30 lines -->
        <module name="MethodLength">
            <property name="max" value="40"/>
        </module>

        <!-- Limits method complexity (max 10 branches/paths) -->
        <module name="CyclomaticComplexity">
            <property name="max" value="15"/>
        </module>

        <!-- Interfaces must define types, not just constants -->
        <module name="InterfaceIsType"/>

        <!-- Method names must follow lowerCamelCase -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- Public classes must have JavaDoc -->
        <module name="JavadocType">
            <property name="scope" value="public"/>
        </module>

        <!-- Strings must be compared with .equals(), not == -->
        <module name="StringLiteralEquality"/>

        <!-- Prevents unnecessary instantiation (e.g. new Boolean(true)) -->
        <module name="IllegalInstantiation">
            <property name="classes" value="java.lang.Boolean,java.lang.Integer,java.lang.Long,java.lang.Double"/>
        </module>

    </module>
</module>