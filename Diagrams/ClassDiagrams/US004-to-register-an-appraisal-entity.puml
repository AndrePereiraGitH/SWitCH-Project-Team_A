@startuml

title US004 - Register Appraisal Entity (Class Diagram)

' =========================
' Controller Layer
' =========================

class US004ToRegisterAppraisalEntityController {
    +getAllGenres()
    +getAllPublicationTypes()
    +registerAppraisalEntity(name: String, contact: Contact, selectedGenresDTO: List<GenreDetailsDTO>, selectedPublicationTypesDTO: List<PublicationTypeDTO>)
    -validateSelectedGenresDTO()
    -validateSelectedPublicationTypesDTO()
}

' =========================
' Repository Layer
' =========================

class GenreRepository {
    +getAllGenres()
    +dtoToGenre(selectedGenresDTO)
}


class PublicationTypeRepository {
    +getAllPublicationTypes()
    +dtoToPublicationType(selectedPublicationTypesDTO: List<PublicationTypeDTO>)
}

class AppraisalEntityRepository {
    +createAndAddAppraisalEntity(name: String, contact: Contact, selectedGenresDTO: List<GenreDetailsDTO>, selectedPublicationTypesDTO: List<PublicationTypeDTO>)
    -exists(apEn)
    -add(apEn)
}
' =========================
' Factory Layer
' =========================

class FactoryAppraisalEntity {
    +create(name: String, contact: Contact, selectedGenresDTO: List<GenreDetailsDTO>, selectedPublicationTypesDTO: List<PublicationTypeDTO>)
}

' =========================
' DTO Layer
' =========================

class GenreDTO {
    +genreToDTO(genres : List<Genre>) : List<GenreDetailsDTO>
}

class PublicationTypeDTO {
    +publicationTypeToDTO(types : List<PublicationType>) : List<PubTypeDTO>
}

' =========================
' Domain Layer
' =========================

class AppraisalEntity {
    -name : String
    -contact : Contact
    -genres : List<Genre>
    -publicationTypes : List<PublicationType>
}

class Genre {
    -title : String
    +getTitle() : String
}

class PublicationType {
    -typeOfBinding : String
    -details : String
    +getTypeOfBinding() : String
    +getDetails() : String
}

' =========================
' Associations
' =========================

' Controller dependencies
US004ToRegisterAppraisalEntityController ..> GenreRepository
US004ToRegisterAppraisalEntityController ..> PublicationTypeRepository
US004ToRegisterAppraisalEntityController ..> AppraisalEntityRepository
US004ToRegisterAppraisalEntityController ..> GenreDTO
US004ToRegisterAppraisalEntityController ..> PublicationTypeDTO

' Repository to Domain
GenreRepository "1 " --> " * " Genre
PublicationTypeRepository "1        " --> " * " PublicationType

' DTO
GenreDTO --> Genre
PublicationTypeDTO --> PublicationType


AppraisalEntityRepository "1 " --> " * " AppraisalEntity

' AppraisalEntity composition
AppraisalEntityRepository --> FactoryAppraisalEntity
FactoryAppraisalEntity --> AppraisalEntity

AppraisalEntity "  1     " *-- "1..*" Genre
AppraisalEntity "1 " *-- "1..*    " PublicationType

@enduml

