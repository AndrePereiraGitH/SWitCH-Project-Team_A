@startuml
title US004 - Register Appraisal Entity (Class Diagram)

' =========================
' UI
' =========================
class ":UI004" {
}

' =========================
' Controller
' =========================
class ":US004ToRegisterAppraisalEntityController" {
    +getAllGenres()
    +getAllPublicationTypes()
    +registerAppraisalEntity()
}

' =========================
' Genre
' =========================
class ":GenreRepository" {
    -listOfGenre : List<Genre>
    +getAllGenres()
}

class ":GenreMapper" {
    -listOfGenreDTO : List<GenreDTO>
    +toDTO(allGenreList)
}

class ":Genre" {
    +getTitle()
}

' class "GenreDetailsDTO" {
' }

' class "GenreDTO" {
' }

' =========================
' Publication Type
' =========================
class ":PublicationTypeRepository" {
    -listOfPublicationType : List<PublicationType>
    +getAllPublicationTypes()
}

class ":PublicationTypeMapper" {
    -listOfPubTypeDTO : List<PubTypeDTO>
    +toDTO(List<PublicationType>)
}

class ":PublicationType" {
    +getDetails(listOfPubTypeDTO)
}

' class "PubTypeDTO" {
' }

' class "PubTypeDetailsDTO" {
' }

' =========================
' Appraisal Entity
' =========================
class ":AppraisalEntityRepository" {
    -lisOfAppraisalEntity: List<AppraisalEntity>
    +createAndAddAppraisalEntity()
}

class "AppraisalEntity" {
    -name : String
    -contact : Contact
    -selectedGenres : List<Genre>
    -selectedPublicationType : List<PublicationType>
}


' =========================
' Relationships
' =========================
":UI004" ..> ":US004ToRegisterAppraisalEntityController" : delegates to

":US004ToRegisterAppraisalEntityController" "1" ---> "1  " ":GenreRepository" : requests a list of
":US004ToRegisterAppraisalEntityController" "1      " ....> "1  " ":GenreMapper" : invokes

":GenreMapper" "1    " ..> "1..*  " ":Genre" : converts
' ":GenreMapper" --> "GenreDetailsDTO"
":GenreMapper" "1  " ..> "1..*  " "GenreDTO" : produces

":US004ToRegisterAppraisalEntityController" "1 " ---> "1 " ":PublicationTypeRepository" : requests a list of
":US004ToRegisterAppraisalEntityController" "1 " ....> "1  " ":PublicationTypeMapper" : invokes

":PublicationTypeMapper" "  1      " ..> "1..* " ":PublicationType" : converts
' ":PublicationTypeMapper" ..> "PubTypeDTO" : produces
":PublicationTypeMapper" "1 " ..> "1..*   " "PubTypeDetailsDTO" : produces

":US004ToRegisterAppraisalEntityController" "1 " ---> "1      " ":AppraisalEntityRepository" : requests registration to

":AppraisalEntityRepository" "1 " ..> " *   " "AppraisalEntity" : can create

@enduml