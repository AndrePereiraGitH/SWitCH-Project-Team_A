@startuml
title Diagrama de Classes - Registo de Entidade Avaliadora
/'
class Administrator {
  +provideAppraisalEntityData() : void
}

class UI {
  +requestAppraisalEntityData() : void
  +sendAppraisalEntityData(name: String, contact: String) : void
  +showSuccess() : void
}

class RegisterAppraisalController {
  +registerAppraisalEntity(name: String, contact: String) : boolean
}
'/
class AppraisalEntityRepository {
  -appraisalEntityList : List<AppraisalEntity>
  +createAndRegisterAppraisalEntity(name: String, contact: String) : AppraisalEntity
' Those methods are part of createAndRegisterAppraisalEntity
  +validateAppraisalEntity(ae: AppraisalEntity) : boolean
  +addToAppraisalEntityList(ae: AppraisalEntity) : void
}

class AppraisalEntity {
  -name : String
  -contact : Contact
}

class Contact {
  -phoneNum: String
  -extension: String
  -email: Email
  -location: Address
}

' Interactions

' Administrator "1" --> "1" UI : interacts
' UI "1" --> "1" RegisterAppraisalController : calls

RegisterAppraisalController "1 " -- "1 " AppraisalEntityRepository : request registration to >
AppraisalEntityRepository "1 " -- " * " AppraisalEntity : creates / manages >
AppraisalEntity "1 " -- "1 " Contact : contains >

@enduml

