@startuml
title Diagrama de Classes - Registo de Entidade Avaliadora

class AppraisalEntityRepository {
  +createAndRegisterAppraisalEntity(name: String, contact: String)
' Those methods are part of createAndRegisterAppraisalEntity
'  +validateAppraisalEntity(ae: AppraisalEntity) : boolean
'  +addToAppraisalEntityList(ae: AppraisalEntity) : void
}

class "List<AppraisalEntity>" {
  +addAppraisalEntityToAppraisalList (apEntity: AppraisalEntity)
}


class AppraisalEntity {
  -name : String
  -contact : Contact
}

class "List<Genre>" {
}

class Genre {
  -genreType : String
}

class Publicationtype {
  -mediaFormat : MediaFormat
  -typeOfBiding : TypeOfBinding
  -details : String
}

class Contact {
  -phoneNum: String
  -extension: String
  -email: Email
  -location: Address
}

' Interactions

' Administrator "1" --> "1" UI : interacts
' UI "1" --> "1" RegisterAppraisalController : calls

RegisterAppraisalController "1 " -- "1 " AppraisalEntityRepository : request registration to >
AppraisalEntityRepository "    1" .------- "      *   " AppraisalEntity : creates / manages >
AppraisalEntityRepository "1    " --- " 1  " "List<AppraisalEntity>" : has >

"List<AppraisalEntity>" "1 " -- " *  " AppraisalEntity : contains >
"List<AppraisalEntity>" "1 " ---- " 1    " "List<Genre>" : contains >
"List<AppraisalEntity>" "1 " ---- " 1    " Publicationtype : has >

"List<Genre>" "1" -- "1" Genre : has >

AppraisalEntity "1 " -- "1 " Contact : contains >

@enduml

