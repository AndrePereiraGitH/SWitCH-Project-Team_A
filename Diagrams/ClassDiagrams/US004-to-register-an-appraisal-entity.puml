@startuml
title US004 - To Register A Appraisal Entity

class US004ToRegisterAppraisalEntity {
  +registerAppraisalEntity (name: String, contact: Contact, publicationType: PublicationType, genre: Genre)
}

class AppraisalEntityRepository {
  +createAndAddToAppraisalEntityList(name: String, contact: Contact, publicationType: PublicationType, genre: Genre)
  +existAppraisalEntity () : boolean
' Those methods are part of createAndRegisterAppraisalEntity
'  +validateAppraisalEntity(ae: AppraisalEntity) : boolean
'  +addToAppraisalEntityList(ae: AppraisalEntity) : void
}

class "List<AppraisalEntity>" {
}


class AppraisalEntity {
  -name: String
  -contact: Contact
  -publicationType: PublicationType
  -genre: Genre
}


class Genre {
  -genreType : String
}

class PublicationType {
  -mediaFormat : MediaFormat
  -typeOfBiding : TypeOfBinding
  -details : String
}

/' class Contact {
  -phoneNum: String
  -extension: String
  -email: Email
  -location: Address
}
'/
' Interactions

US004ToRegisterAppraisalEntity "1 " -- "1 " AppraisalEntityRepository : request registration to >
AppraisalEntityRepository  .------- AppraisalEntity : creates / manages >
AppraisalEntityRepository "1    " --- " 1  " "List<AppraisalEntity>" : has >

"List<AppraisalEntity>" "1 " -- " *  " AppraisalEntity : contains >
"List<AppraisalEntity>" "1  " ---- " * " "Genre" : has >
"List<AppraisalEntity>" "1" ---- " 1  " PublicationType : has >


@enduml

