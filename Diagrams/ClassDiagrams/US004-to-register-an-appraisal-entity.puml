@startuml
title US004 - As an Administrator, I want to register an Appraisal Entity in the system

' ========================
' UI + APPLICATION LAYER
' ========================

class US004ToRegisterAppraisalEntityController {
  +getAllGenres(): List<Genre>
  +getAllPublicationTypes(): List<PublicationType>
  +registerAppraisalEntity(name, contact, genreId, publicationTypeIds)
}


' ========================
' DOMAIN LAYER
' ========================

' -------- Aggregate Root --------
class AppraisalEntity {
  -appraisalId: AppraisalEntityId
  -name
  -contact
  -genreIds: List<GenreId>
  -publicationTypeIds: List<PublicationTypeId>
}

class AppraisalEntityId {
  -String: apEnId
}

AppraisalEntity "1" *-- "1" AppraisalEntityId : has


' -------- Genre --------
class Genre {
  -String: title
}

class GenreId {
  -String: genreId
}

Genre "1" *-- "1" GenreId


' -------- PublicationType --------
class PublicationType {
  -String: mediaFormat
}

class PublicationTypeId {
  --String: pubTypeId
}

PublicationType "1" *-- "1" PublicationTypeId


' ========================
' INTERACTIONS
' ========================

AppraisalEntity "    1       " --> "      1..*" GenreId : can be \n related to
AppraisalEntity "1  " --> "  1..*        " PublicationTypeId : can be \n related to

GenreId ..> Genre
PublicationTypeId ..> PublicationType


' ========================
' REPOSITORIES
' ========================

interface GenreRepository {
  +getAllGenres(): List<Genre>
  +findById(id: GenreId): Genre
}

interface PublicationTypeRepository {
  +getAllPublicationTypes(): List<PublicationType>
  +findById(id: PublicationTypeId): PublicationType
}

interface AppraisalEntityRepository {
  +createAndAddAppraisalEntity(...)
}


GenreRepository ..> Genre
PublicationTypeRepository ..> PublicationType
AppraisalEntityRepository ..> FactoryAppraisalEntity


' ========================
' FACTORY
' ========================

class FactoryAppraisalEntity {
  +create(name, contact, genreId, publicationTypeId): AppraisalEntity
}

FactoryAppraisalEntity "   1 " --> "  1 " AppraisalEntity : creates


' ========================
' DEPENDENCIES
' ========================

US004ToRegisterAppraisalEntityController ...> GenreRepository : interacts with
US004ToRegisterAppraisalEntityController ...> PublicationTypeRepository : interacts with
US004ToRegisterAppraisalEntityController ..> AppraisalEntityRepository : interacts with

@enduml