@startuml

title US004 - Register Appraisal Entity (Class Diagram)

' =========================
' Controller Layer
' =========================

class US004ToRegisterAppraisalEntityController {

    +getAllGenres() : List<GenreDTO>
    +getAllPublicationTypes() : List<PublicationTypeDTO>
    +registerAppraisalEntity() : AppraisalEntity
}

' =========================
' Repository Layer
' =========================

class GenreRepository {
    +getAllGenres() : List<Genre>
}

class PublicationTypeRepository {
    +getAllPublicationTypes() : List<PublicationType>
}

class AppraisalEntityRepository {
    -appraisalEntities : List<AppraisalEntity>

    +createAndAddAppraisalEntity(name : String, contact : Contact, genres : List<Genre>, publicationTypes : List<PublicationType>) : AppraisalEntity
}

' =========================
' Mapper / DTO Layer
' =========================

class GenreDTO {
    +genreToDTO(genres : List<Genre>) : List<GenreDetailsDTO>
    +dtoToGenre(dto : GenreDetailsDTO) : Genre
}

class PublicationTypeDTO {
    +publicationTypeToDTO(types : List<PublicationType>) : List<PubTypeDTO>
    +dtoToPublicationType(dto : PubTypeDTO) : PublicationType
}

' =========================
' Domain Layer
' =========================

class AppraisalEntity {
    -name : String
    -contact : Contact
    -genres : List<Genre>
    -publicationTypes : List<PublicationType>
}

class Genre {
    -title : String
    +getTitle() : String
}

class PublicationType {
    -typeOfBinding : String
    -details : String
    +getTypeOfBinding() : String
    +getDetails() : String
}

' =========================
' Relationships
' =========================

' Controller dependencies
US004ToRegisterAppraisalEntityController ..> GenreRepository
US004ToRegisterAppraisalEntityController ..> PublicationTypeRepository
US004ToRegisterAppraisalEntityController ..> AppraisalEntityRepository
US004ToRegisterAppraisalEntityController ..> GenreDTO
US004ToRegisterAppraisalEntityController ..> PublicationTypeDTO

' Repository to Domain
GenreRepository "1 " --> " * " Genre
PublicationTypeRepository "1        " --> " * " PublicationType

AppraisalEntityRepository "1 " --> " * " AppraisalEntity

' AppraisalEntity composition
AppraisalEntity "  1     " *-- "1..*" Genre
AppraisalEntity "1 " *-- "1..*    " PublicationType

@enduml

