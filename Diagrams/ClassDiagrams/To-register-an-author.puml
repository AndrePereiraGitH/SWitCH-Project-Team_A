@startuml
title To Register an Author

' ── UI Layer ───────────────────────────────────────────────
class UI <<C>> {
}

' ── Controller Layer ───────────────────────────────────────
class ToRegisterAuthorCtrl <<C>> {
  + register(name: String, countryId: CountryId, dateOfBirth: LocalDate, biography: String): Author
}

' ── Application Layer ──────────────────────────────────────
class AuthorService <<C>> {
  + createAndSave(name: String, countryId: CountryId, dateOfBirth: LocalDate, biography: String): Author
}

' ── Domain Layer ───────────────────────────────────────────
interface IAuthorRepository <<I>> {
  + save(author: Author): Author
  + existsById(authorId: AuthorId): boolean
  + findById(id: AuthorId): Optional<Author>
  + findAll(): List<Author>
}

class AuthorFactory <<C>> {
  + create(name: String, countryId: CountryId, dateOfBirth: LocalDate, biography: String): Author
  + create(id: AuthorId, name: String, countryId: CountryId, dateOfBirth: LocalDate, biography: String): Author
}

class Author <<C>> {
  - id: AuthorId
  - name: String
  - countryId: CountryId
  - dateOfBirth: LocalDate
  - biography: String
  + id(): AuthorId
  + getName(): String
  + getCountryId(): CountryId
  + getDateOfBirth(): LocalDate
  + getBiography(): String
}

' ── Infrastructure Layer ───────────────────────────────────
class AuthorRepositoryJPAImpl <<C>> {
  + save(author: Author): Author
  + existsById(authorId: AuthorId): boolean
  + findById(id: AuthorId): Optional<Author>
  + findAll(): List<Author>
}

class AutomaticGeneratedAuthorJPAImpl <<C>> {
}

interface IAuthorRepositoryJPA <<I>> {
  + existsById(authorId: AuthorId): boolean
}

class AuthorAssembler <<C>> {
  + toDM(author: Author): AuthorDM
  + toDomain(authorDM: AuthorDM): Author
}

class AuthorDM <<C>> {
  - id: AuthorId
  - name: String
  - countryId: CountryId
  - dateOfBirth: LocalDate
  - biography: String
}

Rectangle Database {
}

' ── Relationships ──────────────────────────────────────────
UI "1" ..> "1" ToRegisterAuthorCtrl : uses
ToRegisterAuthorCtrl "1" ..> "1" AuthorService : uses

AuthorService "1" ..> "1" AuthorFactory : uses
AuthorService "1" ..> "1" IAuthorRepository : uses

IAuthorRepository <|.. AuthorRepositoryJPAImpl : implements
AuthorRepositoryJPAImpl "1" ..> "1" IAuthorRepositoryJPA : uses
AuthorRepositoryJPAImpl "1" ..> "1" AuthorAssembler : uses

IAuthorRepositoryJPA <|.. AutomaticGeneratedAuthorJPAImpl : implements
AutomaticGeneratedAuthorJPAImpl "1 1" ..> "1" Database : queries

AuthorAssembler "1" ..> "1" AuthorDM : creates
AuthorAssembler "1" ..> "1" Author : creates
AuthorAssembler "1" ..> "1" AuthorFactory : uses

AuthorFactory "1" ..> "*" Author : creates

@enduml