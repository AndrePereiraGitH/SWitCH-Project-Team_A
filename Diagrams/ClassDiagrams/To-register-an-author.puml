@startuml
title To Register Author

class ToRegisterAuthorController {
  -_authorService: AuthorService
  +register(name: String, countryId: CountryId, dateOfBirth: LocalDate, biography: String): Author
}

class AuthorService {
  -authorFactory: AuthorFactory
  -authorRepo: IAuthorRepository
  +createAndSave(name: String, countryId: CountryId, dateOfBirth: LocalDate, biography: String): Author
}

interface IAuthorRepository {
  +save(author: Author): Author
  +existsById(authorId: AuthorId): boolean
  +findById(id: AuthorId): Optional<Author>
  +findAll(): List<Author>
}

class AuthorRepositoryJPAImpl {
  -authorRepositoryJpa: IAuthorRepositoryJPA
  -authorAssembler: AuthorAssembler
  +save(author: Author): Author
  +existsById(authorId: AuthorId): boolean
  +findById(id: AuthorId): Optional<Author>
  +findAll(): List<Author>
}

class AuthorFactory {
  +create(name: String, countryId: CountryId, dateOfBirth: LocalDate, biography: String): Author
  +create(id: AuthorId, name: String, countryId: CountryId, dateOfBirth: LocalDate, biography: String): Author
}

class Author {
  -_id: AuthorId
  -_name: String
  -_countryId: CountryId
  -_dateOfBirth: LocalDate
  -_biography: String
  +id(): AuthorId
  +getName(): String
  +getCountryID(): CountryId
  +getDateOfBirth(): LocalDate
  +getBiography(): String
}

class AuthorAssembler {
  +toDM(author: Author): AuthorDM
  +toDomain(authorDM: AuthorDM): Author
}

class AuthorDM {
  -id: AuthorId
  -name: String
  -countryId: CountryId
  -dateOfBirth: LocalDate
  -biography: String
}

interface IAuthorRepositoryJPA {
}

interface JpaRepository<AuthorDM, AuthorId> {
}

ToRegisterAuthorController "1" ..> "1" AuthorService : uses
AuthorService "1" ..> "1" AuthorFactory : creates with
AuthorService "1" ..> "1" IAuthorRepository : persists with
IAuthorRepository <|.. AuthorRepositoryJPAImpl : implements
AuthorRepositoryJPAImpl "1" ..> "1" AuthorAssembler : converts with
AuthorRepositoryJPAImpl "1" ..> "1" IAuthorRepositoryJPA : delegates to
AuthorAssembler "1" ..> "1" AuthorFactory : reconstructs with
AuthorAssembler "1" ..> "1" AuthorDM : converts
AuthorFactory "1" ..> "*" Author : creates
JpaRepository <|-- IAuthorRepositoryJPA : extends

@enduml