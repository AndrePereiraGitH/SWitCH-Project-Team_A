@startuml
title US015 - Put a publication for sale in Direct Sale

class UI015 {}

class ToPutPublicationInDirectSaleController {
    + getAllPublications()
    + createAndAddItem(condition, weight, dimensions, publication) : Item
    + createAndAddDirectSale(items, price, shortDescription, listingTitle, seller, pictures) : boolean
}
class Library {
    - publications : List<Publication>
    + getAllPublications() : List<Publication>
}

class Publication {
    - bibliographicalData : BibliographicalData
    - publicationType : PublicationType
    - edition : String
    - code : Code
    +getDetails();
}

class LibraryPublicationDTO

class LibraryPublicationMapper {
    + toDTO(publications : List<Publication>) : List<LibraryPublicationDTO>

}

class Item {
    - publication : Publication
    - condition : Condition
    - weight : weight
    - dimensions : dimensions
}

class Listing {
    - item : List<Item>
    - price : Price
    - shortDescription : String
    - listingTitle : String
    - seller : User
    - List<pictures>: Pictures
}
class DirectSale {
    - listing : Listing
}

class ItemRepository {
    - items : List<Item>
}

class DirectSaleRepository {
    - directSales : List<DirectSale>
}

' --- UI flow ---
UI015 -.> ToPutPublicationInDirectSaleController : uses

' --- Use relationships ---
ToPutPublicationInDirectSaleController -.> Library : uses
ToPutPublicationInDirectSaleController -.> LibraryPublicationMapper : uses
ToPutPublicationInDirectSaleController -.> ItemRepository : uses
ToPutPublicationInDirectSaleController -.> DirectSaleRepository : uses

' --- Core domain relationships ---
Library "1" --> "*" Publication : owns
Publication "1" -> "0..1" Item : may create
Listing "1   " --> "1..*" Item : sells
DirectSale "0..1" --> "1" Listing : has

ItemRepository "1" --> "*" Item : stores
DirectSaleRepository "1" --> "*" DirectSale : stores

LibraryPublicationMapper -.> Publication : request for
LibraryPublicationMapper -.> LibraryPublicationDTO : maps to

@enduml