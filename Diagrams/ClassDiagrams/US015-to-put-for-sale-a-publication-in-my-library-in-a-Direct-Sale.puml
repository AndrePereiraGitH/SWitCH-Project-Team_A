@startuml
title US015 - To put for a sale a publication in my library in a direct sale

' -----CLASSES------

class UI015 {}

class ToPutPublicationInDirectSaleController {
    + getAllPublications(): List<PublicationSample>
    + createListing(title, selectedPublications, saleType, price, shortDescription, seller, pictures) : Listing
}
class Library {
    - publications: List<PublicationSample>
    - libraryName: String
    - user: User
    + getAllPublications(): List<PublicationSample>
}

class LibraryDTO_US015 {
    + toDTO(listOfAvailablePublications) : List<PublicationSampleDTO>
}

class PublicationSample {
    - bibliographicalData: BibliographicalData
    - owner: User
    - publicationStatus: PublicationStatus
    - edition: Edition
    - condition: Condition
    + getPublicationStatus(): PublicationStatus
    + getDetails() : PublicationSample
}

class FactoryListing {
    + create(title, selectedPublications, saleType, price, shortDescription, seller, pictures) : Listing
}

class ListingRepository {
    - listings: List<Listing>
    + add(listing): boolean
}

class Listing {
    - listingTitle: String
    - items: List<PublicationSample>
    - saleType: SaleType
    - price: Price
    - shortDescription: String
    - seller: User
    - pictures: List<Picture>
}

' ------ RELATIONSHIPS -----

' --- UI ---
UI015 "1" -.> "1" ToPutPublicationInDirectSaleController : communicates with

' --- Controller ---
ToPutPublicationInDirectSaleController "1" -.> "1" Library : uses
ToPutPublicationInDirectSaleController "1"-.> "1" LibraryDTO_US015 : uses
ToPutPublicationInDirectSaleController "1"-.> "1" FactoryListing : uses
ToPutPublicationInDirectSaleController "1"-.> "1" ListingRepository : uses

' --- Library ---
Library "0..1" --> "*" PublicationSample: owns

' --- LibraryDTO_US015 ---
LibraryDTO_US015 "1" -.> "1" PublicationSample : request from

' --- ListingRepository ---
ListingRepository "1" --> "*" Listing : stores

' --- Domain Classes ---
Listing "0..1" --> "1..*" PublicationSample : sells

@enduml