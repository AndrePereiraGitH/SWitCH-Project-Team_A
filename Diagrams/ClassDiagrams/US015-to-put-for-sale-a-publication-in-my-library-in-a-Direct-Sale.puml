@startuml
title US015 - To put for a sale a publication in my library in a direct sale

' -----CLASSES------

class UI015 {}

class US015ToPutPublicationInDirectSaleController {
    - library: Library
    - listingFactory: ListingFactory
    + findLibraryPublicationsAvailableForSale(): List<PublicationSampleDTO_US015>
    + putPublicationForSale(title, selectedPublications, saleType, price, shortDescription, seller, pictures): Listing
}
class Library {
    - publications: List<PublicationSample>
    - libraryName: String
    - user: User
    + findLibraryPublicationsAvailableForSale(): List<PublicationSample>
}

class PublicationSampleDTO_US015 {
    - title: String
    - authorsName: List<String>
    - genres: List<String>
    - ownerUsername: String
    - pubStatus: String
    - editionNumber: String
    - code: String
    - mediaFormat: String
    - editionLanguage: String
    - publisherName: String
    - condition: String
    + toDTO(listOfAvailablePublications): List<PublicationSampleDTO_US015>
}

class PublicationSample {
    - bibliographicalData: BibliographicalData
    - owner: User
    - publicationStatus: PublicationStatus
    - edition: Edition
    - condition: Condition
    + getPublicationStatus(): PublicationStatus
    + getDetails(): PublicationSample
}

class ListingFactory {
    + create(title, selectedPublications, saleType, price, shortDescription, seller, pictures): Listing
}

class ListingRepository {
    - listings: List<Listing>
    + add(listing): boolean
}

class Listing {
    - listingTitle: String
    - items: List<PublicationSample>
    - saleType: SaleType
    - price: Price
    - shortDescription: String
    - seller: User
    - pictures: List<Picture>
}

' ------ RELATIONSHIPS -----

' --- UI ---
UI015 -.> US015ToPutPublicationInDirectSaleController : requests operations from

' --- Controller ---
US015ToPutPublicationInDirectSaleController -.> Library : consults
US015ToPutPublicationInDirectSaleController -.> PublicationSampleDTO_US015 : maps using
US015ToPutPublicationInDirectSaleController -.> ListingFactory : delegates creation to
US015ToPutPublicationInDirectSaleController "1" -> "1" ListingRepository : maintains

' --- Library ---
Library "0..1" -> "*" PublicationSample: contains

' --- PublicationSampleDTO_US015 ---
PublicationSampleDTO_US015 ..> PublicationSample : maps from

' --- ListingRepository ---
ListingRepository "1" -> "*" Listing : stores

' --- Domain Classes ---
Listing "0..1" -> "1..*" PublicationSample : aggregates
ListingFactory "1" -> "1..*" Listing: creates

@enduml