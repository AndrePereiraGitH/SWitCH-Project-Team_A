@startuml
title US017 - Create Private Publication List

package "UI" {
  class CreatePublicationListUI
}

package "Controller" {
  class CreatePublicationListController {
    +createPublicationList(name, genre)
  }
}

package "Persistence" {
  class PublicationListRepository {
    +createAndAddPublicationList(name, genre)
    +validate(list)
    +add(list)
  }
}

package "Domain" {
  class PublicationList {
    -name
    -genre
    -isPrivate
  }

  class User

CreatePublicationListUI --> CreatePublicationListController : sends request
CreatePublicationListController --> PublicationListRepository : forwards request
PublicationListRepository --> PublicationList : creates

PublicationList "*" --> "1 " User : owner

@enduml
