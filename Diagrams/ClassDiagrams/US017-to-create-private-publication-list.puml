@startuml
title US017 - Create Private Collection Of Publications with a name and a set a genre


' _____________________
' DOMAIN
' _____________________

class User {
  -username : String
}

class Genre {
    - genreType  : String
}


class CollectionOfPublications {
  - collectionName : String
  - genre : Genre
  - isPrivate : boolean
  - publications : List<Publication>
}

class Publication {
}

User "1" --> " *   " CollectionOfPublications : owns
CollectionOfPublications "1" --> "1" Genre : has
CollectionOfPublications "1     " --> "*" Publication : contains

' ______________________
' APPLICATION
' ______________________

class CreateCollectionOfPublicationsController {
  +getAllGenres() : List<GenreDTO>
  +createAndAddCollectionOfPublications(name : String, genre : Genre, user : User) : CollectionOfPublications
}

class GenreMapper {
  +toDTO(genres : List<Genre>) : List<GenreDTO>
}

class GenreDTO {
   - name : String
}

' ___________________
' PERSISTENCE
' ___________________

class GenreRepository {
  +getAllGenres() : List<Genre>
}

class CollectionOfPublicationsRepository {
  + createIfNotExists(user : User, name : String, genre : Genre,\n isPrivate : boolean) : CollectionOfPublications
}

' _____________________
' DEPENDENCIES
' ____________________

CreateCollectionOfPublicationsController ..> GenreRepository : uses
CreateCollectionOfPublicationsController ..> GenreMapper : uses
CreateCollectionOfPublicationsController ..> CollectionOfPublicationsRepository : uses
CollectionOfPublicationsRepository ..> CollectionOfPublications : uses

GenreMapper ..> Genre : maps
GenreMapper ..> GenreDTO : creates



@enduml