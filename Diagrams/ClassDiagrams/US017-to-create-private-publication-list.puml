@startuml
title US017 - Create Private Collection Of Publications with a name and a genre

' _____________________
' DOMAIN
' _____________________

class User {
  - _userName : String
}

class Genre {
  - _genreType : String
  + getTitle() : String
}

class CollectionOfPublications {
  - _collectionName : String
  - _collectionGenre : Genre
  - _owner : User
  - _isPrivate : boolean
  - _collectionOfPublications : List<PublicationSample>
  + CollectionOfPublications(name : String, genre : Genre, user : User)
  + getCollectionName() : String
  + getCollectionGenre() : Genre
  + getOwner() : User
  + getIsPrivate() : boolean
}

class PublicationSample {
}

User "1" --> "*" CollectionOfPublications : owns
CollectionOfPublications "1" --> "1" Genre : has
CollectionOfPublications "1" --> "*" PublicationSample : contains

' ______________________
' APPLICATION
' ______________________

class US017ToCreateCollectionOfPublicationsController {
  - genreRepository : GenreRepository
  - collectionRepository : CollectionOfPublicationsRepository
  + getAllGenres() : List<GenreDTO_US017>
  + createCollection(name : String, genre : Genre, user : User) : CollectionOfPublications
}

class GenreDTO_US017 {
  + name : String
  + {static} toDTO(genre : Genre) : GenreDTO_US017
}

' ___________________
' PERSISTENCE
' ___________________

class GenreRepository {
  + getAllGenres() : List<Genre>
}

class CollectionOfPublicationsRepository {
  - _collectionOfPublicationsList : List<CollectionOfPublications>
  + createIfNotExists(user : User, name : String, genre : Genre) : CollectionOfPublications
}

' ___________________
' FACTORY
' ___________________

class CollectionOfPublicationsFactory {
  + create(name : String, genre : Genre, user : User) : CollectionOfPublications
}

' _____________________
' DEPENDENCIES
' _____________________

US017ToCreateCollectionOfPublicationsController ..> GenreRepository : uses
US017ToCreateCollectionOfPublicationsController ..> GenreDTO_US017 : uses
US017ToCreateCollectionOfPublicationsController ..> CollectionOfPublicationsRepository : uses

CollectionOfPublicationsRepository --> CollectionOfPublicationsFactory : has
CollectionOfPublicationsFactory ..> CollectionOfPublications : creates

GenreDTO_US017 ..> Genre : converts

@enduml
