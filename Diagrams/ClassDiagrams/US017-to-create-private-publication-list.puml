@startuml
title US017 - Create Private Publication List

package "UI" {
  class CreatePublicationListUI
}

package "Controller" {
  class CreatePublicationListController {
    +createPublicationList(name, genre, user)
  }
}

package "Domain" {
  class PublicationList {
    -name
    -isPublic
    -owner
    -genre
  }

    class User
    class Genre
  }

package "Persistence" {
  class PublicationListRepository {
    +save(list)
  }
}

CreatePublicationListUI --> CreatePublicationListController : calls
CreatePublicationListController --> PublicationList : creates
CreatePublicationListController --> PublicationListRepository : persists

PublicationList --> User : owner
PublicationList --> Genre : genre

note right of PublicationList
  - Created as private by default
    - Belongs to one User
    - Has a name and a genre
end note

@enduml
