@startuml
title US017 - Create Private Collection Of Publications

' ======================
' DOMAIN
' ======================

class User {
  -id
  -username
}

class CollectionOfPublications {
  -name : String
  -isPrivate : boolean
}

class Genre {
  -id
  -name
}

class Publication {
  -id
  -title
}

User "1" --> "*" CollectionOfPublications : owns
CollectionOfPublications "1" --> "1" Genre : has
CollectionOfPublications "1" --> "*" Publication : contains

' ======================
' APPLICATION
' ======================

class CreateCollectionOfPublicationsController {
  +requestGenres() : List<Genre>
  +createAndAddCollectionOfPublications(name : String, genre : Genre)
}

' ======================
' PERSISTENCE
' ======================

class GenreRepository {
  +getAllGenres() : List<Genre>
}

class CollectionOfPublicationsRepository {
  +create(name : String, genre : Genre) : CollectionOfPublications
  +add(collection : CollectionOfPublications)
}

' ======================
' DEPENDENCIES (FROM SEQUENCE)
' ======================

CreateCollectionOfPublicationsController ..> GenreRepository : uses
CreateCollectionOfPublicationsController ..> CollectionOfPublicationsRepository : uses

CollectionOfPublicationsRepository ..> CollectionOfPublications : create

@enduml
