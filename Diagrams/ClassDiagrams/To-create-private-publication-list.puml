@startuml
title To create a private collection of publications

' _____________________
' DOMAIN
' _____________________

interface IGenreRepository {
  + findAll() : List<Genre>
}

interface ICollectionOfPublicationsRepository {
  + save(collection : CollectionOfPublications) : CollectionOfPublications
  + existsById(id : CollectionOfPublicationsId) : boolean
}

class Genre {
  - _id : GenreId
  - _genreType : String
  + id() : GenreId
  + getGenreType() : String
  + sameAs(object : Object) : boolean
}

class GenreId {
  - genreID : String
  + getID() : String
}

class UserId {
  - id : String
}

class CollectionOfPublications {
  - _id : CollectionOfPublicationsId
  - _collectionName : String
  - _collectionGenreId : GenreId
  - _ownerId : UserId
  - _isPrivate : boolean
  + id() : CollectionOfPublicationsId
  + getCollectionName() : String
  + getCollectionGenre() : GenreId
  + getOwnerId() : UserId
  + getIsPrivate() : boolean
  + sameAs(obj : Object) : boolean
}

class CollectionOfPublicationsId {
  - id : String
}

class CollectionOfPublicationsFactory {
  + create(name : String, genreId : GenreId, userId : UserId) : CollectionOfPublications
  + create(id : CollectionOfPublicationsId, name : String, genreId : GenreId, userId : UserId, isPrivate : boolean) : CollectionOfPublications
}

Genre "1" --> "1" GenreId : identified by
CollectionOfPublications "1" --> "1" CollectionOfPublicationsId : identified by
CollectionOfPublications "1" --> "1" GenreId : has genre
CollectionOfPublications "1" --> "1" UserId : owned by
CollectionOfPublicationsFactory "1" ..> "*" CollectionOfPublications : <<creates>>

' ______________________
' APPLICATION
' ______________________

class ToCreateCollectionOfPublicationsController {
  + getAllGenres() : List<US017GenreDTO>
  + createCollection(name : String, genreId : GenreId, userId : UserId) : CollectionOfPublications
}

class US017GenreMapper {
  + {static} toDTOList(genres : List<Genre>) : List<US017GenreDTO>
  + {static} toDTO(genre : Genre) : US017GenreDTO
}

class US017GenreDTO {
  + name : String
}

' ___________________
' PERSISTENCE
' ___________________

class GenreRepositoryJpaImpl {
  + findAll() : List<Genre>
}

interface IGenreRepositoryJpa {
  + findByGenreType(genreType : String) : Optional<GenreDM>
}

class GenreAssembler {
  + toDM(genre : Genre) : GenreDM
  + toDomain(dm : GenreDM) : Genre
}

class CollectionOfPublicationsRepositoryJpaImpl {
  + save(collection : CollectionOfPublications) : CollectionOfPublications
  + existsById(id : CollectionOfPublicationsId) : boolean
}

interface ICollectionOfPublicationsRepositoryJpa {
}

class CollectionOfPublicationsAssembler {
  + toDM(collection : CollectionOfPublications) : CollectionOfPublicationsDM
  + toDomain(dm : CollectionOfPublicationsDM) : CollectionOfPublications
}

rectangle Database {
}

GenreRepositoryJpaImpl ..|> IGenreRepository : <<implements>>
GenreRepositoryJpaImpl "1" ..> "1" IGenreRepositoryJpa : uses
GenreRepositoryJpaImpl "1" ..> "1" GenreAssembler : uses
IGenreRepositoryJpa --|> JpaRepository : extends
IGenreRepositoryJpa "1" ..> "1" Database : queries

CollectionOfPublicationsRepositoryJpaImpl ..|> ICollectionOfPublicationsRepository : <<implements>>
CollectionOfPublicationsRepositoryJpaImpl "1" ..> "1" ICollectionOfPublicationsRepositoryJpa : uses
CollectionOfPublicationsRepositoryJpaImpl "1" ..> "1" CollectionOfPublicationsAssembler : uses
ICollectionOfPublicationsRepositoryJpa --|> JpaRepository : extends
ICollectionOfPublicationsRepositoryJpa "1" ..> "1" Database : queries

' _____________________
' DEPENDENCIES
' _____________________

ToCreateCollectionOfPublicationsController "1" ..> "1" IGenreRepository : uses
ToCreateCollectionOfPublicationsController "1" ..> "1" ICollectionOfPublicationsRepository : uses
ToCreateCollectionOfPublicationsController "1" ..> "1" CollectionOfPublicationsFactory : uses
ToCreateCollectionOfPublicationsController "1" ..> "1" US017GenreMapper : uses
US017GenreMapper "1" ..> "0..*" US017GenreDTO : <<creates>>
US017GenreMapper "1" ..> "0..*" Genre : reads

@enduml