@startuml
title To create a private collection of publications

' _____________________
' DOMAIN
' _____________________

interface IGenreRepository {
  + getAllGenres() : List<Genre>
}

interface ICollectionOfPublicationsRepository {
  + createAndAdd(userId : UserId, name : String, genreId : GenreID) : CollectionOfPublications
}

class Genre {
  - _id : GenreID
  - _genreType : String
  + id() : GenreID
  + getGenreType() : String
  + sameAs(object : Object) : boolean
}

class GenreID {
  - genreID : String
}

class User {
  - _id : UserId
  + id() : UserId
}

class UserId {
  - _id : String
}

class CollectionOfPublications {
  - _id : CollectionOfPublicationsID
  - _collectionName : String
  - _collectionGenreId : GenreID
  - _ownerId : UserId
  - _isPrivate : boolean
  + id() : CollectionOfPublicationsID
  + getCollectionName() : String
  + getCollectionGenre() : GenreID
  + getOwnerId() : UserId
  + getIsPrivate() : boolean
  + sameAs(obj : Object) : boolean
}

class CollectionOfPublicationsID {
  - _id : String
}

class CollectionOfPublicationsFactory {
  + create(name : String, genreId : GenreID, userId : UserId) : CollectionOfPublications
}

Genre "1" --> "1" GenreID : identified by
User "1" --> "1" UserId : identified by
CollectionOfPublications "1" --> "1" CollectionOfPublicationsID : identified by
CollectionOfPublications "1" --> "1" GenreID : has genre
CollectionOfPublications "1" --> "1" UserId : owned by
CollectionOfPublicationsFactory ..> CollectionOfPublications : <<creates>>

' ______________________
' APPLICATION
' ______________________

class US017ToCreateCollectionOfPublicationsController {
  - _genreRepository : IGenreRepository
  - _collectionRepository : ICollectionOfPublicationsRepository
  + getAllGenres() : List<US017GenreDTO>
  + createCollection(name : String, selectedGenre : Genre, user : User) : CollectionOfPublications
}

class US017GenreMapper {
  + {static} toDTO(genres : List<Genre>) : List<US017GenreDTO>
}

class US017GenreDTO {
  + name : String
  + {static} toDTO(genre : Genre) : US017GenreDTO
}

' ___________________
' PERSISTENCE
' ___________________

class GenreRepositoryMem {
  - _genres : List<Genre>
  - _genreFactory : GenreFactory
  - exists(genre : Genre) : boolean
}

class CollectionOfPublicationsRepositoryMem {
  - _collectionOfPublicationsList : List<CollectionOfPublications>
  - _factory : CollectionOfPublicationsFactory
}

GenreRepositoryMem ..|> IGenreRepository : <<implements>>
GenreRepositoryMem "1" --> "*" Genre : stores
CollectionOfPublicationsRepositoryMem ..|> ICollectionOfPublicationsRepository : <<implements>>
CollectionOfPublicationsRepositoryMem "1" --> "*" CollectionOfPublications : stores
CollectionOfPublicationsRepositoryMem --> CollectionOfPublicationsFactory : has

' _____________________
' DEPENDENCIES
' _____________________

US017ToCreateCollectionOfPublicationsController --> IGenreRepository : uses
US017ToCreateCollectionOfPublicationsController --> ICollectionOfPublicationsRepository : uses
US017ToCreateCollectionOfPublicationsController ..> US017GenreMapper : uses

US017GenreMapper ..> US017GenreDTO : uses
US017GenreDTO ..> Genre : converts

@enduml