@startuml

title To Get List Of Items On Auction For Given Genre

' ── UI Layer ───────────────────────────────────────────────
class UI022 {
}

' =========================
' Controller
' =========================
class US022ToGetListOfItemsOnAuctionOfGivenGenreController {
    - genreRepository : IGenreRepository
    - auctionRepository : IAuctionRepository
    - listingRepository : IListingRepository
    - bibliographicalDataRepository : IBibliographicalDataRepository
    - publicationSampleRepository : IPublicationSampleRepository
    - auctionMapper : US022AuctionMapper

    + getAllGenres() : List<US022GenreDTO>
    + getListOfItemsOnAuctionGivenGenre(dto: US022GenreDTO) : List<US022AuctionDTO>
}

' =========================
' DTOs
' =========================
class US022AuctionDTO {
    + auctionId : String
    + listingId : String
}

class US022GenreDTO {
    + genreId : GenreID
    + name : String
}

' =========================
' Mappers
' =========================
class US022AuctionMapper {
    + toDTO(auction: Auction) : US022AuctionDTO
    + toDTOList(auctions: List<Auction>) : List<US022AuctionDTO>
}

class US022GenreMapper {
    + toDTO(genre: Genre) : US022GenreDTO
    + toDTOList(genres: List<Genre>) : List<US022GenreDTO>
}

' =========================
' Domain
' =========================
class Genre {
    + id() : GenreID
    + getGenreType() : String
}

class BibliographicalData {
    + id() : BibliographicalDataID
    + getGenres() : List<GenreID>
}

class PublicationSample {
    + id() : PublicationSampleId
    + getBibliographicalDataID() : BibliographicalDataID
}

class Listing {
    + id() : ListingId
    + getItemsId() : List<PublicationSampleId>
}

class Auction {
    + id() : AuctionId
    + getListingId() : ListingId
}


' =========================
' Repositories
' =========================
interface IGenreRepository {
    + getAllGenres() : List<Genre>
    + findById(id: GenreID) : Genre
}

interface IBibliographicalDataRepository {
    + findAllBibliographicalDataByGenreId(id: GenreID) : List<BibliographicalDataID>
}

interface IPublicationSampleRepository {
    + findAllItemsIdByBibliographicalDataId(ids: List<BibliographicalDataID>) : List<PublicationSampleId>
}

interface IListingRepository {
    + findAllListingId(ids: List<PublicationSampleId>) : List<ListingId>
}

interface IAuctionRepository {
    + getListOfItemsOnAuctionGivenGenre(ids: List<ListingId>) : List<Auction>
}

' =========================
' Relationships (with cardinalities)
' =========================

' Controller dependencies
UI022 "1" -.> "1" US022ToGetListOfItemsOnAuctionOfGivenGenreController : uses
US022ToGetListOfItemsOnAuctionOfGivenGenreController "1" -.> "1" IGenreRepository : uses
US022ToGetListOfItemsOnAuctionOfGivenGenreController "1" -.> "1" IBibliographicalDataRepository : uses
US022ToGetListOfItemsOnAuctionOfGivenGenreController "1" -.> "1" IPublicationSampleRepository : uses
US022ToGetListOfItemsOnAuctionOfGivenGenreController "1" -.> "1" IListingRepository : uses
US022ToGetListOfItemsOnAuctionOfGivenGenreController "1" -.> "1" IAuctionRepository : uses
US022ToGetListOfItemsOnAuctionOfGivenGenreController "1" -.> "1" US022AuctionMapper : uses
US022ToGetListOfItemsOnAuctionOfGivenGenreController "1" -.> "1" US022GenreMapper : uses

' Mapper relations
US022AuctionMapper "1" -.> "*" Auction : maps from
US022AuctionMapper "1" -.> "1" US022AuctionDTO : create
US022GenreMapper "1" -.> "*" Genre : maps from
US022GenreMapper "1" -.> "1" US022GenreDTO : create

' Repository relations
IGenreRepository "1" --> "*" Genre : manages
IBibliographicalDataRepository "1" --> "*" BibliographicalData : manages
IPublicationSampleRepository "1" --> "*" PublicationSample : manages
IListingRepository "1" --> "*" Listing : manages
IAuctionRepository "1" --> "*" Auction : manages

@enduml