@startuml
title Class Diagram - US028 Get Items On Auction By Publisher
skinparam classAttributeIconSize 0
skinparam linetype ortho

' ========================
' CONTROLLER
' ========================
class ToGetListOfPublishersController {
    + getAllPublishers() : List<US028PublisherDTO>
    + findById(publisher) : List<US028AuctionDTO>
}

' ========================
' PUBLISHER
' ========================
interface IPublisherRepository {
    + getAllPublishers() : List<Publisher>
    + findById(id : PublisherId) : PublisherId
}

class PublisherRepositoryJpaImpl {
    + getAllPublishers() : List<Publisher>
    + findById(id : PublisherId) : PublisherId
}

interface IPublisherRepositoryJPA {
    + getAllPublishers() : List<PublisherDM>
    + findById(id : PublisherId) : Optional<PublisherDM>
}

class PublisherAssembler {
    + toDomainList(dms : List<PublisherDM>) : List<Publisher>
}

class PublisherFactory {
    + create(id : PublisherId, name : String) : Publisher
}

class Publisher {
    - id : PublisherId
    - name : String
    + id() : PublisherId
    + getName() : String
}

class PublisherId {
    - value : String
    + getId() : String
}

class PublisherDM {
    - id : PublisherId
    - name : String
    + getId() : PublisherId
}

class US028PublisherMapper {
    + toDTOs(publishers : List<Publisher>) : List<US028PublisherDTO>
    + toDTO(publisher : Publisher) : US028PublisherDTO
}

class US028PublisherDTO {
    - id : String
    - name : String
}

' ========================
' BIBLIOGRAPHICAL DATA
' ========================
interface IBibliographicalDataRepository {
    + findAllBibliographicalDataID(publisherId : PublisherId) : List<BibliographicalDataId>
}

class BibliographicalDataRepositoryJpaImpl {
    + findAllBibliographicalDataID(publisherId : PublisherId) : List<BibliographicalDataId>
}

interface IBibliographicalDataRepositoryJPA {
    + findAllByPublisherId(publisherId : PublisherId) : List<BibliographicalDataDM>
}

class BibliographicalDataDM {
    - bdId : BibliographicalDataId
    - publisherId : PublisherId
    + bdId() : BibliographicalDataId
}

class BibliographicalDataId {
    - value : String
}

' ========================
' PUBLICATION SAMPLE
' ========================
interface IPublicationSampleRepository {
    + findItemsIdByBibliographicalDataId(ids : List<BibliographicalDataId>) : List<PublicationSampleId>
}

class PublicationSampleRepositoryJpaImpl {
    + findItemsIdByBibliographicalDataId(ids : List<BibliographicalDataId>) : List<PublicationSampleId>
}

interface IPublicationSampleRepositoryJPA {
    + findAllByBibliographicalDataId(ids : List<BibliographicalDataId>) : List<PublicationSampleDM>
}

class PublicationSampleDM {
    - pubSampleId : PublicationSampleId
    - bibliographicalDataId : BibliographicalDataId
    + getPubSampleId() : PublicationSampleId
}

class PublicationSampleId {
    - value : String
}

' ========================
' LISTING
' ========================
interface IListingRepository {
    + findAllListingId(itemsId : List<PublicationSampleId>) : List<ListingId>
}

class ListingRepositoryJpaImpl {
    + findAllListingId(itemsId : List<PublicationSampleId>) : List<ListingId>
}

interface IListingRepositoryJPA {
    + findAllByItemsId(itemsId : List<PublicationSampleId>) : List<ListingDM>
}

class ListingDM {
    - listingId : ListingId
    - publicationSampleId : PublicationSampleId
    + getListingId() : ListingId
}

class ListingId {
    - value : String
}

' ========================
' AUCTION
' ========================
interface IAuctionRepository {
    + getAllAuctionsIdOnListing(listingIds : List<ListingId>) : List<Auction>
}

class AuctionRepositoryJpaImpl {
    + getAllAuctionsIdOnListing(listingIds : List<ListingId>) : List<Auction>
}

interface IAuctionRepositoryJPA {
    + findAllByListingId(listingIds : List<ListingId>) : List<AuctionDM>
}

class AuctionAssembler {
    + toDomain(dm : AuctionDM) : Auction
}

class AuctionFactory {
    + create(auctionId : AuctionId, ...) : Auction
}

class Auction {
    - auctionId : AuctionId
    - listingId : ListingId
    + getAuctionId() : AuctionId
}

class AuctionId {
    - value : String
}

class AuctionDM {
    - auctionId : AuctionId
    - listingId : ListingId
    + getAuctionId() : AuctionId
    + getListingId() : ListingId
}

class US028AuctionMapper {
    + toDTOList(auctions : List<Auction>) : List<US028AuctionDTO>
    + toDTO(auction : Auction) : US028AuctionDTO
}

class US028AuctionDTO {
    - auctionId : String
}

' ========================
' CONTROLLER RELATIONS
' ========================
ToGetListOfPublishersController "1" --> "1" IPublisherRepository : uses
ToGetListOfPublishersController "1" --> "1" IBibliographicalDataRepository : uses
ToGetListOfPublishersController "1" --> "1" IPublicationSampleRepository : uses
ToGetListOfPublishersController "1" --> "1" IListingRepository : uses
ToGetListOfPublishersController "1" --> "1" IAuctionRepository : uses
ToGetListOfPublishersController "1" --> "1" US028PublisherMapper : uses
ToGetListOfPublishersController "1" --> "1" US028AuctionMapper : uses

' ========================
' PUBLISHER FLOW
' ========================
IPublisherRepository <|.. PublisherRepositoryJpaImpl : implements
PublisherRepositoryJpaImpl "1" --> "1" IPublisherRepositoryJPA : delegates to
PublisherRepositoryJpaImpl "1" --> "1" PublisherAssembler : uses
PublisherAssembler "1" --> "1" PublisherFactory : uses
PublisherFactory "1" ..> "1..*" Publisher : creates
PublisherDM "1" --> "1" PublisherId : has
Publisher "1" --> "1" PublisherId : has
US028PublisherMapper "1" ..> "1..*" US028PublisherDTO : creates
US028PublisherMapper "1" --> "1..*" Publisher : reads

' ========================
' BIBLIOGRAPHICAL DATA FLOW
' ========================
IBibliographicalDataRepository <|.. BibliographicalDataRepositoryJpaImpl : implements
BibliographicalDataRepositoryJpaImpl "1" --> "1" IBibliographicalDataRepositoryJPA : delegates to
BibliographicalDataDM "1" --> "1" BibliographicalDataId : has
BibliographicalDataDM "1" --> "1" PublisherId : belongs to

' ========================
' PUBLICATION SAMPLE FLOW
' ========================
IPublicationSampleRepository <|.. PublicationSampleRepositoryJpaImpl : implements
PublicationSampleRepositoryJpaImpl "1" --> "1" IPublicationSampleRepositoryJPA : delegates to
PublicationSampleDM "1" --> "1" PublicationSampleId : has
PublicationSampleDM "1" --> "1" BibliographicalDataId : refers to

' ========================
' LISTING FLOW
' ========================
IListingRepository <|.. ListingRepositoryJpaImpl : implements
ListingRepositoryJpaImpl "1" --> "1" IListingRepositoryJPA : delegates to
ListingDM "1" --> "1" ListingId : has
ListingDM "1" --> "1" PublicationSampleId : refers to

' ========================
' AUCTION FLOW
' ========================
IAuctionRepository <|.. AuctionRepositoryJpaImpl : implements
AuctionRepositoryJpaImpl "1" --> "1" IAuctionRepositoryJPA : delegates to
AuctionRepositoryJpaImpl "1" --> "1" AuctionAssembler : uses
AuctionAssembler "1" --> "1" AuctionFactory : uses
AuctionFactory "1" ..> "1..*" Auction : creates
AuctionDM "1" --> "1" AuctionId : has
AuctionDM "1" --> "1" ListingId : belongs to
Auction "1" --> "1" AuctionId : has
Auction "1" --> "1" ListingId : linked to
US028AuctionMapper "1" --> "0..*" Auction : reads
US028AuctionMapper "1" ..> "0..*" US028AuctionDTO : creates

@enduml
