@startuml

 hide circle
 title To Register a New Publication

 class UI

 class ToRegisterNewPublicationCtrl {
   -publicationSampleService: PublicationSampleService
   +register(bibliographicalDataId: BibliographicalDataId, userId: UserId, publicationStatus: PublicationStatus, editionId: EditionId, condition: Condition)
 }

 class PublicationSampleService {
   -publicationSampleRepository: IPublicationSampleRepository
   -factory: PublicationSampleFactory
   +createAndSave(bibliographicalDataId: BibliographicalDataId, userId: UserId, publicationStatus: PublicationStatus, editionId: EditionId, condition: Condition)
 }

 class PublicationSample {
   -publicationSampleId: PublicationSampleId
   -bibliographicalDataId: BibliographicalDataId
   -ownerId: UserId
   -editionId: EditionId
   -libraryId: LibraryId
   -collectionOfPublicationsId: CollectionOfPublicationsId
   -publicationStatus: PublicationStatus
   -condition: Condition
 }

 class PublicationSampleFactory {
   +create(bibliographicalDataId: BibliographicalDataId, userId: UserId, publicationStatus: PublicationStatus, editionId: EditionId, condition: Condition)
   +create(publicationSampleId: PublicationSampleId, bibliographicalDataId: BibliographicalDataId, userId: UserId, publicationStatus: PublicationStatus, editionId: EditionId, condition: Condition)
 }

 interface IPublicationSampleRepository {
   +save(publicationSample: PublicationSample)
   +existsById(publicationSampleId: PublicationSampleId)
   +findAll()
   +findById(publicationSampleId: PublicationSampleId)
 }

 class PublicationSampleRepositoryJpaImpl {
   +save(publicationSample: PublicationSample)
   +existsById(publicationSampleId: PublicationSampleId)
   +findAll()
   +findById(publicationSampleId: PublicationSampleId)
 }

 interface IPublicationSampleRepositoryJpa {
   +save(publicationSampleDM: PublicationSampleDM)
   +existsById(publicationSampleId: PublicationSampleId)
   +findAll()
   +findById(publicationSampleId: PublicationSampleId)
 }

 class PublicationSampleAssembler {
   +toDM(publicationSample: PublicationSample)
   +toDomain(publicationSampleDM: PublicationSampleDM)
 }

 class PublicationSampleDM {
   -publicationSampleId: PublicationSampleId
   -bibliographicalDataId: BibliographicalDataId
   -ownerId: UserId
   -editionId: EditionId
   -libraryId: LibraryId
   -collectionOfPublicationsId: CollectionOfPublicationsId
   -publicationStatus: PublicationStatus
   -condition: Condition
 }

 ' =============
 ' Relationships
 ' =============

 UI "1" --> "1" ToRegisterNewPublicationCtrl : uses

 ToRegisterNewPublicationCtrl "1" --> "1" PublicationSampleService : delegates to

 PublicationSampleService "1" --> "1" IPublicationSampleRepository : uses
 PublicationSampleService "1" --> "1" PublicationSampleFactory : creates via

 PublicationSampleRepositoryJpaImpl "1" ..|> "1" IPublicationSampleRepository : implements
 PublicationSampleRepositoryJpaImpl "1" --> "1" IPublicationSampleRepositoryJpa : delegates to
 PublicationSampleRepositoryJpaImpl "1" --> "1" PublicationSampleAssembler : uses

 IPublicationSampleRepositoryJpa "1" --> "*" PublicationSampleDM : persists

 PublicationSampleAssembler ..> PublicationSampleFactory : reconstructs via
 PublicationSampleAssembler ..> PublicationSample : creates
 PublicationSampleAssembler ..> PublicationSampleDM : maps


 PublicationSampleFactory "1" --> "*" PublicationSample : creates

 @enduml