@startuml
top to bottom direction
title To get the list of items on auction of a given author (DDD)

class US026ToGetTheListOfItemsOnAuctionOfAGivenAuthorController {
  -authorRepository : IAuthorRepository
  -biblioRepository : IBibliographicalDataRepository
  -pubRepo : IPublicationSampleRepository
  -listingRepo : IListingRepository
  -auctionRepository : IAuctionRepository
  -mapper : US026AuctionMapper
  +getAllAuthors() : List<US026AuthorDTO>
  +getAuctionsByAuthorId(authorId : AuthorId) : List<US026AuctionDTO>
}


interface IAuthorRepository {
  +getAllAuthors() : List<Author>
}

interface IBibliographicalDataRepository {
  +findBibliographicalDataIdByAuthorId(authorId : AuthorId) : List<BibliographicalDataID>
}

interface IPublicationSampleRepository {
  +findPublicationSamplesByBiblioDataIds(biblioDataIds : List<BibliographicalDataID>) : List<PublicationSampleId>
}

interface IListingRepository {
  +findListingIdsByPublicationSampleIds(publicationSamplesIds : List<PublicationSampleId>) : List<ListingId>
  +findListingById(listingId : ListingId) : Optional<Listing>
}

interface IAuctionRepository {
  +findAuctionsByListingIds(listingIds : List<ListingId>) : List<Auction>
}

class Author {
  -authorId : AuthorId
  -name : String
  +id() : AuthorId
  +getName() : String
}

class Listing {
  -listingId : ListingId
  -listingTitle : String
  -itemsId : List<PublicationSampleId>
  +id() : ListingId
  +getListingTitle() : String
}

class Auction {
  -auc_id : AuctionId
  -listingId : ListingId
  -auctionStatus : AuctionStatus
  +id() : AuctionId
  +getListingId() : ListingId
  +getAuctionStatus() : AuctionStatus
}


class US026AuthorDTO {
  +authorID() : String
  +name() : String
}

class US026AuctionDTO {
  +id() : String
  +listingTitle() : String
  +auctionStatus() : String
}

class US026AuthorMapper {
  {static} +fromDomain(author : Author) : US026AuthorDTO
  {static} +fromDomainList(authors : List<Author>) : List<US026AuthorDTO>
}

class US026AuctionMapper {
  -listingRepo : IListingRepository
  +US026AuctionMapper(listingRepo : IListingRepository)
  +fromDomain(auction : Auction) : US026AuctionDTO
  +fromDomainList(auctions : List<Auction>) : List<US026AuctionDTO>
}


' --- Controller to repositories / mappers ---
US026ToGetTheListOfItemsOnAuctionOfAGivenAuthorController ....> IAuthorRepository : interacts with
US026ToGetTheListOfItemsOnAuctionOfAGivenAuthorController .....> IBibliographicalDataRepository : interacts with
US026ToGetTheListOfItemsOnAuctionOfAGivenAuthorController ......> IPublicationSampleRepository : interacts with
US026ToGetTheListOfItemsOnAuctionOfAGivenAuthorController .> IListingRepository : interacts with
US026ToGetTheListOfItemsOnAuctionOfAGivenAuthorController ...> IAuctionRepository : interacts with
US026ToGetTheListOfItemsOnAuctionOfAGivenAuthorController ..> US026AuthorMapper
US026ToGetTheListOfItemsOnAuctionOfAGivenAuthorController ....> US026AuctionMapper

' --- Mapper dependencies ---
US026AuthorMapper ...> Author
US026AuthorMapper ...> US026AuthorDTO

US026AuctionMapper ...> Auction
US026AuctionMapper ...> IListingRepository
US026AuctionMapper ..> US026AuctionDTO


' --- Repository contracts and ID flow ---
IAuthorRepository ..> Author

IListingRepository ..> Listing : manages

IAuctionRepository .....> Auction : manages

@enduml