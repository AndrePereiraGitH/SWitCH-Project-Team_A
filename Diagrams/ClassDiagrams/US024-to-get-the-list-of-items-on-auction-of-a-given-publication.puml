@startuml
title US024 - To get the list of items on auction of a given publication

class ToGetTheListOfItemsOnAuctionOfAGivenPublicationController {
  +getListOfItemsOnAuction(publication)
  -copyList(l1)
}

class ListingRepository {
  +getListOfItems(typeOfSale, publication)
  ' -convertStringToEnum(typeOfSale, publication)
  -validateParameters(typeOfSale, publication)
}

class Listing {
  - item: Item
  - saleType: SaleType
}

enum SaleType {
    DIRECT_SALE
    AUCTION
}

class Item {
    - bibliographicalData: BibliographicalData
}

class BibliographicalData {
    - title: Title
}

' Interactions

ToGetTheListOfItemsOnAuctionOfAGivenPublicationController  "1 " -- "1 " ListingRepository : uses >
ListingRepository "1 " -- " * " Listing : retrieves >
Listing "                                *" --> "1" SaleType : can be\nsold by >
Listing "1"--> "1  " Item : lists an >
Item "*" -- "1" BibliographicalData: has >

@enduml
