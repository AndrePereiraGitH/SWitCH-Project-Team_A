@startuml
title US024 - To get the list of items on auction of a given publication

class UI024 {

}

class ToGetTheListOfItemsOnAuctionOfAGivenPublicationController {
  +getAllPublications()
  +getListOfItemsOnAuction(publication)
  -copyList()
}

class PublicationRepository{
    +getAllPublications()
}

class AuctionRepository {
  +getListOfItemsOnAuction(publication)
  -validateParameters(publication)
}

class Auction {
 - listing: Listing
}

class Listing {
  - item: Item
  - saleType: SaleType
}

enum SaleType {
    DIRECT_SALE
    AUCTION
}

' class Item {
'    - bibliographicalData: BibliographicalData
'}

class Item {
    - publication: publication
}

class Publication {
    - bibliographicalData: BibliographicalData
    - code: Code
}

class BibliographicalData {
    - title: String
}

' Interactions

UI024 "1" .. "1" ToGetTheListOfItemsOnAuctionOfAGivenPublicationController: uses >
ToGetTheListOfItemsOnAuctionOfAGivenPublicationController  "1 " .. "1 " AuctionRepository : uses >
ToGetTheListOfItemsOnAuctionOfAGivenPublicationController  "1 " .. "1 " PublicationRepository : uses >
AuctionRepository "1 " -- " * " Auction : retrieves >
Auction "0..1" -- "1" Listing : has
Listing "                                *" -- "1" SaleType : can be\nsold by >
Listing "1" -- "1..*  " Item : lists an >
' Item "*" -- "1" BibliographicalData: has >
Item "*" -- "1" Publication: refers to a >
Publication "*" -- "1" BibliographicalData: has >

@enduml
