@startuml
title As a User, I want to get the list (title, author, type and ISBN/SSN) of publications in my library

class UI012 {
}

class US012GetListOfPublicationsInLibraryController {
    - userRepository : IUserRepository
    - pubSampleRepo : IPublicationSampleRepository
    - mapper : US012PublicationSampleMapper
    + US012GetListOfPublicationsInLibraryController(userRepository, pubSampleRepo, mapper)
    + getListOfPublicationsInLibraryDTO(username : String) : List<US012PublicationDetailsDTO>
}

interface IUserRepository {
    + findUserIdByUsername(username : String) : Optional<UserId>
}

interface IPublicationSampleRepository {
    + getAllPublicationsInUserLibrary(userId : UserId) : List<PublicationSample>
}

class US012PublicationSampleMapper {
    - bdRepo : IBibliographicalDataRepository
    - authorRepo : IAuthorRepository
    - editionRepo : IEditionRepository
    + US012PublicationSampleMapper(bdRepo, authorRepo, editionRepo)
    + toDTOs(publications : List<PublicationSample>) : List<US012PublicationDetailsDTO>
    + toDTO(publicationSample : PublicationSample) : US012PublicationDetailsDTO
}

class PublicationSample {
    + getBibliographicalDataID() : BibliographicalDataID
    + getEditionID() : EditionID
    + getOwnerID() : UserId
    + getLibraryID() : LibraryId
    + isOwnedByUser(userId : UserId) : boolean
    + isInUserLibrary() : boolean
}

record US012PublicationDetailsDTO {
    + pubTitle : String
    + authorName : List<String>
    + code : String
    + publicationType : String
}

' Relationships
UI012 ..> US012GetListOfPublicationsInLibraryController : uses
US012GetListOfPublicationsInLibraryController ..> IUserRepository : uses
US012GetListOfPublicationsInLibraryController ..> IPublicationSampleRepository : uses
US012GetListOfPublicationsInLibraryController ..> US012PublicationSampleMapper : uses
IPublicationSampleRepository --> PublicationSample : queries
US012PublicationSampleMapper ..> PublicationSample : reads
US012PublicationSampleMapper ..> US012PublicationDetailsDTO : creates

@enduml