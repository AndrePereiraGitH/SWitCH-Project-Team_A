@startuml
title US003 - Register Genre to Official Genre List

' _____________________
' DOMAIN
' _____________________

class Genre {
  - _genreType : String
  + getTitle() : String
  + getGenreType() : String
}

class GenreFactory {
  + createGenre(genreType : String) : Genre
}

GenreFactory ..> Genre : creates

' ______________________
' APPLICATION
' ______________________

class US003ToRegisterGenreController {
  - _genreRepository : GenreRepository
  + registerGenre(genreType : String) : Genre
}

' ___________________
' PERSISTENCE
' ___________________

class GenreRepository {
  - _genres : List<Genre>
  - _genreFactory : GenreFactory
  + createAndAddGenre(genreType : String) : Genre
  + getAllGenres() : List<Genre>
  - exists(genre : Genre) : boolean
}

GenreRepository "1" --> "*" Genre : stores

' _____________________
' DEPENDENCIES
' _____________________

US003ToRegisterGenreController ..> GenreRepository : uses
GenreRepository --> GenreFactory : has

@enduml
