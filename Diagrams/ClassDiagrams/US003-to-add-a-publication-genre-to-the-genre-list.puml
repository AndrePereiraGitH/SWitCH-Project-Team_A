@startuml
title US003 - Register Genre to Official Genre List

class ToRegisterGenreController {
  +registerGenre(genreType: String): Genre
}

class GenreRepository {
  -_genres: List<Genre>
  +createAndAddGenre(genreType: String): Genre
  -exists(genre: Genre): boolean
}

class Genre {
  -_genreType: String
  +getName(): String
}


ToRegisterGenreController "1" -.-> "_genreRepository  1" GenreRepository : uses
GenreRepository "1" --> "*" Genre : stores
GenreRepository "1" -.-> "*" Genre : creates


@enduml
