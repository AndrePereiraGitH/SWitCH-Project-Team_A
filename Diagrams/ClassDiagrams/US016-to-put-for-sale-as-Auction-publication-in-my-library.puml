@startuml
hide circle
skinparam classAttributeIconSize 0
title US016 - Put a publication from my library for sale in an auction



class ToPutPublicationInAuctionController <<controller>> {
  +getAllPublicationsInUserLibrary(username: String): List<Publication>
  +putPublicationForAuction(
    /'-pub: Publication,
    -listingPrice: Price,
    -shortDescription: String,
    -listingTitle: String,
    -seller: String,
    -initialDate: DateTime,
    -finalDate: DateTime,
    -initialPrice: Price,
    -buyOutPrice: Price'/
  ): boolean
}

class Library  {
  +getAllPublications(): List<Publication>
}

class Publication
class Item
class Listing
class Auction

class ItemRepository <<repository>> {
  +createAndAddItem(condition: Condition, weight: Weight, dimensions: Dimensions, pub: Publication): List<Item>
  -verifyIfExists(): void
  -add(): void
}

class ListingRepository <<repository>> {
  +create(): Listing
  -isExistent(listing: Listing): boolean
  -add(listing: Listing): void
}

class AuctionRepository <<repository>> {
  +createAndAdd(listing: Listing, initialDate: DateTime, finalDate: DateTime, initialPrice: Price, buyOutPrice: Price): Auction
  -validateAuction(auction: Auction): void
  -addAuction(auction: Auction): void
}

'======================
' Controller uses
'======================
ToPutPublicationInAuctionController --> Library : retrieves publications from
ToPutPublicationInAuctionController --> ItemRepository
ToPutPublicationInAuctionController --> ListingRepository
ToPutPublicationInAuctionController --> AuctionRepository

'======================
' Repositories handles with
'======================
ItemRepository ..> Item : creates/adds
ItemRepository ..> Publication : uses pub

ListingRepository ..> Listing : creates/adds

AuctionRepository ..> Auction : creates/adds
AuctionRepository ..> Listing : uses l1

'======================
' Domain interactions
'======================
Library "1" -- "*" Publication : contains
Item "0..*" --> "1" Publication : publication
Listing "1" o-- "1..*" Item : items
Auction "1" --> "1" Listing : listing

@enduml
