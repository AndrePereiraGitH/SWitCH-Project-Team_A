@startuml
hide empty members
hide circle
skinparam classAttributeIconSize 0
title US016 - Put a publication from my library for sale in an auction


  class Library {
    -library: List<Publications>
    +getAllPublications() : List<Publication>
  }


  class Publication {
    -saleType : SaleType
    +setSaleTypeAsAuction() : void
  }

  class Listing {
    -item : Item
    -price : Price
    -seller : User
  }


  class Auction {
    -_listing : Listing
    -_initialDate : LocalDateTime
    -_finalDate : LocalDateTime
    -_initialPrice : Price
    -_buyOutPrice : Price

    +Auction(listing, initialDate, finalDate, initialPrice, buyOutPrice)
  }

  class ItemRepository {
    -items : List<Item>

    +createListOfItems()
    +createAndAddItem(condition, weight,dimensions, pub1)
    +

  }

  class ListingRepository {
    -listings : List<Listing>

    +createAndAdd(itemsList, listingPrice, shortDescription, listingTitle, seller)
  }

  class AuctionRepository {
    +createAuction(listing,initialDate, finalDate, buyOutPrice) : Auction
  }

  class ToPutPublicationInAuctionController {
    +getAllPublicationsInUserLibrary(String username)
    +putPublicationForAuction(pub1, listingPrice, shortDescription,\n listingTitle, seller, initialDate, finalDate, initialPrice, buyOutPrice) : Auction
  }

' -------------------- Relationships --------------------

ToPutPublicationInAuctionController --> Library

Library "1" o-- "*" Publication : contains

ToPutPublicationInAuctionController ..> AuctionRepository
AuctionRepository --> Auction
ToPutPublicationInAuctionController ..> ListingRepository
ListingRepository --> Listing : uses ListingRepo to create a Listing that will be auctioned
ToPutPublicationInAuctionController ..> ItemRepository

@enduml
