@startuml
hide empty members
hide circle
skinparam classAttributeIconSize 0
title US016 - Put a publication from my library for sale in an auction


  class Library {
    -myLibrary: List<Publications>
    +getAllPublications() : List<Publication>
  }


  class Publication {
    -saleType : SaleType
    +setSaleTypeAsAuction() : void
  }

  class Listing {
    -item : Item
    -price : Price
    -seller : User
  }


  class Auction {
    -_listing : Listing
    -_initialDate : LocalDateTime
    -_finalDate : LocalDateTime
    -_initialPrice : Price
    -_buyOutPrice : Price

    +Auction(listing, initialDate, finalDate, initialPrice, buyOutPrice)
  }

  class AuctionRepository {
    +createAuction(Listing listing,LocalDateTime initialDate, LocalDateTime finalDate, Price initialPrice, Price buyOutPrice) : Auction
  }

  class ToPutPublicationInAuctionController {
    +getAllPublicationsInLibrary()
    +putPublicationForAuction(publication, initialDate, finalDate, initialPrice, buyOutPrice) : Auction
  }

' -------------------- Relationships --------------------

ToPutPublicationInAuctionController --> Library

Library "1" o-- "*" Publication : contains

ToPutPublicationInAuctionController ..> AuctionRepository
AuctionRepository --> Auction
AuctionRepository --> Listing : uses ListingRepo to create a Listing that will be auctioned

@enduml
