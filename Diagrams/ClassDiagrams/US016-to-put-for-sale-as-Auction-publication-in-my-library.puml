@startuml

title US016 - Put a publication from my library for sale in an auction

class US016ToPutPublicationInAuctionController {
  +getAllPublicationsInUserLibrary(userId: UserId): List<US016_PublicationSampleDTO>
  +createAuctionListing(listingTitle: String, selectedPublicationsID: List<PublicationSampleId>,\n initialPrice: Price, shortDescription: String, sellerId: UserId, pictures: List<Picture>, initialDate: LocalDateTime,\n finalDate: LocalDateTime, buyOutPrice: Price): boolean
}


class Listing {
    -id :ListingId
    -pubSamplesIds :List<publicationSampleId>

}
class Auction {
    -id :AuctionId
    -listigs :List<ListingId>
}
class PublicationSample {
    -id :PublicationSampleId
    -biblioDataIds :List<BibliographicalDataId>
    -libraryId : LibraryId

}
class BibliographicalData {
 -id : BibliographicalDataId
}

interface ILibraryRepository {
  +getLibraryByUserId(userId: UserId): Library
}

interface IPublicationSampleRepository {
  +getPublicationsByLibraryID(libraryId: LibraryId): List<PublicationSample>
}

interface IBibliographicalDataRepository {
  +findBibliographicalDataById(id: BibliographicalDataID): Optional<BibliographicalData>
}

interface IListingRepository {
  +createAndAdd(listingTitle: String, selectedPublicationsID: List<PublicationSampleId>, \n saleType: SaleType, initialPrice: Price, shortDescription: String, sellerId: UserId, pictures: List<Picture>): Listing
}

interface IAuctionRepository {
    +createAndAdd(listingId: ListingId, initialDate: LocalDateTime, \n finalDate: LocalDateTime, initialPrice: Price, buyOutPrice: Price): Auction
}

class US016_PublicationSampleDTO

class US016_PublicationSampleMapper {
  +fromDomain(publicationSample: PublicationSample, bd: BibliographicalData) : US016_PublicationSampleDTO
  +fromDomainList(publicationSamples: List<PublicationSample>): List<US016_PublicationSampleDTO>
}

class ListingFactory {
  +create(listingTitle: String, selectedPublicationsID: List<PublicationSampleId>, \n saleType: SaleType, initialPrice: Price, shortDescription: String, sellerId: UserId, pictures: List<Picture>)
}

class AuctionFactory {
  +create(listingId: ListingId, initialDate: LocalDateTime, \n finalDate: LocalDateTime, initialPrice: Price, buyOutPrice: Price)
}

US016ToPutPublicationInAuctionController ..> ILibraryRepository : invokes
US016ToPutPublicationInAuctionController ..> IPublicationSampleRepository : invokes
US016ToPutPublicationInAuctionController ..> IBibliographicalDataRepository : invokes
US016ToPutPublicationInAuctionController ..> IListingRepository : invokes
US016ToPutPublicationInAuctionController ..> IAuctionRepository : invokes
US016ToPutPublicationInAuctionController ..> US016_PublicationSampleMapper : uses

US016_PublicationSampleMapper ..> IBibliographicalDataRepository : retrieves
US016_PublicationSampleMapper ..> US016_PublicationSampleDTO : creates
US016_PublicationSampleMapper ..> PublicationSample : maps
US016_PublicationSampleMapper ..> BibliographicalData : maps

IListingRepository --> ListingFactory
ListingFactory ..> Listing : creates

IAuctionRepository --> AuctionFactory
AuctionFactory ..> Auction : creates

@enduml