@startuml
title US025 - To get the list of items on direct sale of a given author

' UI Layer
class UI025 {
}

' Controller
class ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController {
  +getAllAuthors()
  +getListOfItemsOnDirectSale(author)
}

' Repositories
class AuthorRepository {
  +getAllAuthors()
}

class DirectSaleRepository {
  +getListOfItemsOnDirectSale(author)
  -checkDirectSaleAuthor(author)
}

' DTOs
class AuthorDTO_US025 {
}

class DirectSaleDTO_US025 {
}

' Mappers
class AuthorMapper_US025 {
  +toDTO(listOfAllAuthors)
}

class DirectSaleMapper_US025 {
  +toDTO(listOfDirectSale)
}

' Domain classes
class DirectSale {
  - listing: Listing
  - directSaleDate: LocalDateTime
  +getDetails()
}

' Interactions
UI025 ..> ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController ..> DirectSaleRepository : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController ..> AuthorRepository : uses
AuthorMapper_US025 ..> AuthorDTO_US025 : maps to
DirectSaleMapper_US025 ..> DirectSaleDTO_US025 : maps to
ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController ..> AuthorMapper_US025 : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController ..> DirectSaleMapper_US025 : uses
DirectSaleMapper_US025 ..> DirectSale : communicates with

@enduml