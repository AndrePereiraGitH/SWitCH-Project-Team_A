@startuml
title US025 - To get the list of items on direct sale of a given author

class UI025{

}

class GetListOfItemsOnDirectSaleOfGivenAuthorController {
  +getAllAuthors()
  +getListOfItemsOnDirectSale(author)
  -copyList()
}

class AuthorRepository{
  +getAllAuthors()
}

class ListingRepository {
  +getListOfItemsOnDirectSale(author)
  -validateParameters(author)
}

class Listing {
  - item: Item
  - saleType: SaleType
}

enum SaleType {
    DIRECT_SALE
    AUCTION
}

class Item {
    - author: Author
}

class Author {
    - profile: Profile
}

' Interactions

UI025 "1" ..> "1" GetListOfItemsOnDirectSaleOfGivenAuthorController : uses >
GetListOfItemsOnDirectSaleOfGivenAuthorController "1" ..> "1" AuthorRepository : uses >
GetListOfItemsOnDirectSaleOfGivenAuthorController "1" ..> "1" ListingRepository : uses >
ListingRepository "         1" ..> "                *" Listing : retrieves >
Listing "                       *" ..> "1" SaleType : can be\nsold by >
Listing "1" ..> "1   " Item : lists an >
Item "             *" ..> "1 " Author : refers to >

@enduml