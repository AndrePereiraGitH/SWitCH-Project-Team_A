@startuml
title US025 - To get the list of items on direct sale of a given author

class UI025{

}

class ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController {
  +getAllAuthors()
  +getListOfItemsOnDirectSale(author)
}

class AuthorRepository{
    +getAllAuthors()
}

class DirectSaleRepository {
  +getListOfItemsOnDirectSale(author)
}

class DirectSale {
  - listing: Listing
  +getDetails()
}

class DirectSaleMapper {
  +toDTO(listOfDirectSale)
}

class DirectSaleDTO {
}

/'
class Listing {
  - item: Item
  - saleType: SaleType
}

enum SaleType {
    DIRECT_SALE
    AUCTION
}

'class Item {
'    - bibliographicalData: BibliographicalData
'}

class Item {
    - publication: publication
}

class Publication {
    - bibliographicalData: BibliographicalData
    - code: Code
}

class BibliographicalData {
    - title: String
}
'/

' Interactions

UI025 ..> ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController ..> DirectSaleRepository : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController ..> AuthorRepository: uses
DirectSaleRepository "1 " --> " * " DirectSale : contains
ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController ..> DirectSaleMapper : uses
DirectSaleMapper ..> DirectSaleDTO : maps to
DirectSaleMapper ..> DirectSale : uses
/'
DirectSale "1" -- "1" Listing : uses
Listing "                                *" -- "1" SaleType : can be sold by
Listing "1" -- "1..*    " Item : lists an
' Item "*" -- "1" BibliographicalData: has
Item "*" -- "1" Publication: refers to a
Publication "*" -- "1" BibliographicalData: has
'/

