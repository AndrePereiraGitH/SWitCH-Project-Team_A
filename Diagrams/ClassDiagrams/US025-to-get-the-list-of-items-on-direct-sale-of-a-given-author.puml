@startuml
title US025 - To get the list of items on direct sale of a given author

class UI025{

}

class getListOfItemsOnDirectSaleOfGivenAuthorController {
  +getListOfItemsOnDirectSale(author)
  -copyList()
}

class AuthorRepository{
    +getAllAuthors()
}

class Author {
  -authorProfile: Profile
}

class Profile {
  -name: String
}

class DirectSaleRepository {
  +getListOfItemsOnDirectSale(author)
  -validateParameters(author)
}

class DirectSale {
  - listing: Listing
}

class Listing {
  - items: List <Item>
}

class Item {
    - bibliographicalData: BibliographicalData
}

class BibliographicalData {
    - title: String
    - authors: List <Profile>
    }

' Interactions

UI025 "1 " ..> "1 " getListOfItemsOnDirectSaleOfGivenAuthorController : uses
getListOfItemsOnDirectSaleOfGivenAuthorController  " 1" ..> "1    " DirectSaleRepository : uses
getListOfItemsOnDirectSaleOfGivenAuthorController "1    " ..> "1 " AuthorRepository: uses
DirectSaleRepository "1 " --> " 1 " DirectSale : retrieves
DirectSale "1 " --> " 1 " Listing : is a type of
BibliographicalData "1 " --> "          *" Author : has
Author "1 " --> "1 " Profile : has
Listing "1 " --> "          1..*" Item: has
Item "1 " --> "          1" BibliographicalData: has

@enduml