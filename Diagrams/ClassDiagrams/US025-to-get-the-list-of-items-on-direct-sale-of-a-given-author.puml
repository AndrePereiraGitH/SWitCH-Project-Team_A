@startuml
title US025 - To get the list of items on direct sale of a given author

' UI Layer
class UI025 {
}

' Controller
class US025ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController {
  -authorRepository: IAuthorRepository
  -directSaleMapper: DirectSaleMapper_US025
  +getAllAuthors(): List<AuthorDTO_US025>
  +getListOfItemsOnDirectSaleOfAGivenAuthor(authorId: String): List<DirectSaleDTO_US025>
}

' Repositories
interface IAuthorRepository {
  +getAllAuthors(): List<Author>
  +findAuthorById(authorId: AuthorId): Optional<Author>
}

interface IListingRepository {
  +findAllDirectSaleListings(): List<Listing>
}

interface IPublicationSampleRepository {
  +findPublicationSampleById(id: PublicationSampleId): Optional<PublicationSample>
}

interface IBibliographicalDataRepository {
  +findBibliographicalDataById(id: BibliographicalDataID): Optional<BibliographicalData>
}

' DTOs
class AuthorDTO_US025 {
  -name: String
}

class DirectSaleDTO_US025 {
  -publicationTitle: String
  -authors: List<String>
  -price: BigDecimal
  -listingTitle: String
  -seller: String
}

' Mappers
class AuthorMapper_US025 {
  +{static} toDTO(author: Author): AuthorDTO_US025
  +{static} toDTOList(authors: List<Author>): List<AuthorDTO_US025>
}

class DirectSaleMapper_US025 {
  -bibliographicalDataRepository: IBibliographicalDataRepository
  -listingRepository: IListingRepository
  -publicationSampleRepository: IPublicationSampleRepository
  -toDTO(author: Author, item: PublicationSample, listing: Listing): DirectSaleDTO_US025
  +toDTOListByAuthor(author: Author): List<DirectSaleDTO_US025>
}

' Interactions
UI025 "1 " ..> "1 " US025ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController : uses
US025ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController "1 " ..> "1 " IAuthorRepository : uses
US025ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController "1 " ..> "1 " AuthorMapper_US025 : uses
US025ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController "1 " ..> "1 " DirectSaleMapper_US025 : uses
AuthorMapper_US025 "1  " ..> " *" AuthorDTO_US025 : creates
DirectSaleMapper_US025 "1 " ..> "*" DirectSaleDTO_US025 : creates
DirectSaleMapper_US025 "1 " ..> "1 " IListingRepository : uses
DirectSaleMapper_US025 "1 " ..> "1 " IPublicationSampleRepository : uses
DirectSaleMapper_US025 "1 " ..> "1 " IBibliographicalDataRepository : uses

@enduml