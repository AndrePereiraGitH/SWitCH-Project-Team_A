}

class ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController {
  +getAllAuthors()
  +getListOfItemsOnDirectSale(author)
}

class AuthorRepository{
    +getAllAuthors()
}

class AuthorDTO_US025 {
}

class AuthorMapper_US025 {
  +toDTO(listOfAuthor)
}

class DirectSaleRepository {
  +getListOfItemsOnDirectSale(author)
}

/'
class DirectSale {
  - listing: Listing
  +getDetails()
}
'/

class DirectSaleMapper_US025 {
  +toDTO(listOfDirectSale)
}

class DirectSaleDTO_US025 {
}

/'
class Listing {
  - item: Item
  - saleType: SaleType
}

enum SaleType {
    DIRECT_SALE
    AUCTION
}

'class Item {
'    - bibliographicalData: BibliographicalData
'}

class Item {
    - author: author
}

class author {
    - bibliographicalData: BibliographicalData
    - code: Code
}

class BibliographicalData {
    - title: String
}
'/

