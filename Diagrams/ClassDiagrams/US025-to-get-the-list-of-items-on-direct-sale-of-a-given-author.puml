@startuml
title US025 - To get the list of items on direct sale of a given author

' UI Layer
class UI025 {
}

' Controller
class US025ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController {
  -authorRepository: IAuthorRepository
  -listingRepository: IListingRepository
  -publicationSampleRepository: IPublicationSampleRepository
  -bibliographicalDataRepository: IBibliographicalDataRepository
  +getAllAuthors(): List<US025AuthorDTO>
  +getListOfItemsOnDirectSaleOfAGivenAuthor(authorId: String): List<US025DirectSaleDTO>
  -extractIds(samples: List<PublicationSample>): List<PublicationSampleId>
}

' Repositories
interface IAuthorRepository {
  +getAllAuthors(): List<Author>
  +findAuthorById(authorId: AuthorId): Optional<Author>
}

interface IListingRepository {
  +findDirectSaleListingsContaining(sampleIds: List<PublicationSampleId>): List<Listing>
}

interface IPublicationSampleRepository {
  +findByBibliographicalData(bds: List<BibliographicalData>): List<PublicationSample>
}

interface IBibliographicalDataRepository {
  +findByAuthorId(authorId: AuthorId): List<BibliographicalData>
}

' DTOs
class US025AuthorDTO {
  -name: String
}

class US025DirectSaleDTO {
  -publicationTitle: String
  -authors: List<String>
  -price: double
  -listingTitle: String
  -seller: String
}

' Mappers
class US025AuthorMapper {
  +{static} toDTO(author: Author): US025AuthorDTO
  +{static} toDTOList(authors: List<Author>): List<US025AuthorDTO>
}

class US025DirectSaleMapper {
  +{static} toDTO(author: Author, listings: List<Listing>, samples: List<PublicationSample>, \nbds: List<BibliographicalData>): List<US025DirectSaleDTO>
}

' Interactions
UI025 "1" ..> "1" US025ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController : uses
US025ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController "1" ..> "1" IAuthorRepository : uses
US025ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController "1" ..> "1" IListingRepository : uses
US025ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController "1" ..> "1" IPublicationSampleRepository : uses
US025ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController "1" ..> "1" IBibliographicalDataRepository : uses
US025ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController "1" ..> "1" US025AuthorMapper : uses
US025ToGetTheListOfItemsOnDirectSaleOfAGivenAuthorController "1" ..> "1" US025DirectSaleMapper : uses
US025AuthorMapper "1" ..> "*" US025AuthorDTO : creates
US025DirectSaleMapper "1" ..> "*" US025DirectSaleDTO : creates

@enduml