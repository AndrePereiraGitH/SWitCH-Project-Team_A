@startuml
title US027 - To get the list of items on direct sale of a given publisher

' -------------------------
' APPLICATION LAYER
' -------------------------

class UI027 {
}

class US027ToGetTheListOfItemsOnDirectSaleOfAGivenPublisherController {
    - publisherRepo: PublisherRepository
    - editionRepo: EditionRepository
    - publicationSampleRepo: PublicationSampleRepository
    - listingRepo: ListingRepository
    + getAllPublishers(): List<US027PublisherDTO>
    + findListOfItemsOnDirectSale(publisherId): List<US027ListingDTO>
}

' --- MAPPERS and DTOs ---

class US027PublisherMapper {
    + toDTOs(listOfAllPublishers):\nList<US027PublisherDTO>
}

class US027PublisherDTO {
    + publisherId: PublisherId
    + name: String
}

class US027ListingMapper {
    + toDTOs(listOfListings):\nList<US027ListingDTO>
}

class US027ListingDTO {
    + listingId: ListingId
    + listingTitle: String
    + price: String
    + pubTitle: String
    + authorsName: List<String>
}

' -------------------------
' REPOSITORIES
' -------------------------

interface IPublicationSampleRepository {
    - publicationSamples:List<PublicationSample>
    + findPublicationSampleIdsByEditionIds\n(editionIds): List<PublicationSampleId>
}

interface IPublisherRepository {
    - publishers: List<Publisher>
    + getAllPublishers(): List<Publisher>
}

interface IEditionRepository {
    - editions: List<Edition>
    + findEditionIdsByPublisherId\n(publisherId): List<EditionId>
}

interface IListingRepository {
    - listings: List<Listing>
    + findDirectSaleListingsContaining\n(pubSampleIds): List<Listing>
}

' -------------------------
' DOMAIN
' -------------------------

class Publisher {
    - publisherId: PublisherId
    - name: String
}

class PublicationSample {
    - publicationSampleId:\n PublicationSampleId
    - editionId: EditionId
}

class Listing {
    - listingId: ListingId
    - listingTitle: String
    - publicationSampleId:\nList<PublicationSampleId>
    - saleType: SaleType
    - price: Price
}

class Edition {
    - editionId: EditionId
    - publisherId: PublisherId
}

' --- VALUE OBJECTS ---
/'
enum SaleType {
    DIRECT_SALE
    AUCTION
}

class PublisherId {
}

class PublicationSampleId {
}

class EditionId {
}

class ListingId {
}
'/

' -------------------------
' RELATIONSHIPS
' -------------------------

' --- UI ---
UI027 ..> US027ToGetTheListOfItemsOnDirectSaleOfAGivenPublisherController : invokes

' --- Controller ---
US027ToGetTheListOfItemsOnDirectSaleOfAGivenPublisherController "1" -> "1" IPublisherRepository: uses
US027ToGetTheListOfItemsOnDirectSaleOfAGivenPublisherController "1" -> "1" IListingRepository : uses
US027ToGetTheListOfItemsOnDirectSaleOfAGivenPublisherController "1" -> "1" IPublicationSampleRepository : uses
US027ToGetTheListOfItemsOnDirectSaleOfAGivenPublisherController "1" -> "1" IEditionRepository : uses
US027ToGetTheListOfItemsOnDirectSaleOfAGivenPublisherController ..> US027PublisherMapper : creates DTO
US027ToGetTheListOfItemsOnDirectSaleOfAGivenPublisherController ..> US027ListingMapper : creates DTO

' --- Listing ---
IListingRepository "1" -> "*" Listing: persists

US027ListingMapper ..> Listing : maps
US027ListingMapper ..> US027ListingDTO : maps to

'Listing "1" -> "1..*" PublicationSampleId: refers to
Listing "*" -> "1" SaleType: for sale in
'Listing "1" -> "1" ListingId: has

' --- PubSample ---
IPublicationSampleRepository "1" -> "*" PublicationSample: persists

'PublicationSample "1" -> "1" PublicationSampleId: has
'PublicationSample "*" -> "1" EditionId: refers to

' --- Edition ---
IEditionRepository "1" -> "*" Edition: persists

'Edition "*" -> "1" PublisherId: refers to
'Edition "1" -> "1" EditionId: has

' --- Publisher ---
IPublisherRepository "1" -> "*" Publisher : persists

US027PublisherMapper ..> Publisher : maps
US027PublisherMapper ..> US027PublisherDTO : maps to
'Publisher "1" -> "1" PublisherId: has

@enduml
