@startuml
hide circle
title To Register a New Publication

class UI

class ToRegisterNewPublicationCtrl {
  -publicationSampleService: PublicationSampleService
  +register(bibliographicalDataId: BibliographicalDataId, userId: UserId, publicationStatus: PublicationStatus, editionId: EditionId, condition: Condition) : PublicationSample
}

class PublicationSampleService {
  -publicationSampleRepository: IPublicationSampleRepository
  -factory: PublicationSampleFactory
  +createAndSave(bibliographicalDataId: BibliographicalDataId, userId: UserId, publicationStatus: PublicationStatus, editionId: EditionId, condition: Condition) : PublicationSample
}

class PublicationSample {
  -publicationSampleId: PublicationSampleId
  -bibliographicalDataId: BibliographicalDataId
  -ownerId: UserId
  -editionId: EditionId
  -libraryId: LibraryId
  -collectionOfPublicationsId: CollectionOfPublicationsId
  -publicationStatus: PublicationStatus
  -condition: Condition
}

class PublicationSampleId
class BibliographicalDataId
class UserId
class EditionId
class LibraryId
class CollectionOfPublicationsId

class PublicationSampleFactory {
  +create(bibliographicalDataId: BibliographicalDataId, userId: UserId, publicationStatus: PublicationStatus, editionId: EditionId, condition: Condition) : PublicationSample
  +create(publicationSampleId: PublicationSampleId, bibliographicalDataId: BibliographicalDataId, userId: UserId, publicationStatus: PublicationStatus, editionId: EditionId, condition: Condition) : PublicationSample
}

interface IPublicationSampleRepository {
  +save(publicationSample: PublicationSample) : PublicationSample
  +existsById(publicationSampleId: PublicationSampleId) : boolean
  +findAll() : List<PublicationSample>
  +findById(publicationSampleId: PublicationSampleId) : Optional<PublicationSample>
}

class PublicationSampleRepositoryJpaImpl {
  +save(publicationSample: PublicationSample) : PublicationSample
  +existsById(publicationSampleId: PublicationSampleId) : boolean
  +findAll() : List<PublicationSample>
  +findById(publicationSampleId: PublicationSampleId) : Optional<PublicationSample>
}

interface IPublicationSampleRepositoryJpa {
  +save(publicationSampleDM: PublicationSampleDM) : PublicationSampleDM
  +existsById(publicationSampleId: PublicationSampleId) : boolean
  +findAll() : List<PublicationSampleDM>
  +findById(publicationSampleId: PublicationSampleId) : Optional<PublicationSampleDM>
}

class PublicationSampleAssembler {
  +toDM(publicationSample: PublicationSample) : PublicationSampleDM
  +toDomain(publicationSampleDM: PublicationSampleDM) : PublicationSample
}

class PublicationSampleDM {
  -publicationSampleId: PublicationSampleId
  -bibliographicalDataId: BibliographicalDataId
  -ownerId: UserId
  -editionId: EditionId
  -libraryId: LibraryId
  -collectionOfPublicationsId: CollectionOfPublicationsId
  -publicationStatus: PublicationStatus
  -condition: Condition
}

' =============
' Relationships
' =============

UI "1" --> "1" ToRegisterNewPublicationCtrl : uses

ToRegisterNewPublicationCtrl "1" --> "1" PublicationSampleService : delegates to

PublicationSampleService "1" --> "1" IPublicationSampleRepository : uses
PublicationSampleService "1" --> "1" PublicationSampleFactory : creates via

PublicationSampleRepositoryJpaImpl "1" ..|> "1" IPublicationSampleRepository : implements
PublicationSampleRepositoryJpaImpl "1" --> "1" IPublicationSampleRepositoryJpa : delegates to
PublicationSampleRepositoryJpaImpl "1" --> "1" PublicationSampleAssembler : uses

IPublicationSampleRepositoryJpa "1" --> "0..*" PublicationSampleDM : persists

PublicationSampleAssembler ..> PublicationSampleFactory : reconstructs via
PublicationSampleAssembler ..> PublicationSample : creates
PublicationSampleAssembler ..> PublicationSampleDM : maps

PublicationSampleFactory "1" --> "0..*" PublicationSample : creates

PublicationSample "1" --> "1" PublicationSampleId : identified by
PublicationSample "1" --> "1" BibliographicalDataId : references
PublicationSample "1" --> "1" UserId : owned by
PublicationSample "1" --> "1" EditionId : refers to
PublicationSample "1" --> "0..1" LibraryId : optionally assigned to
PublicationSample "1" --> "0..1" CollectionOfPublicationsId : optionally assigned to

@enduml