@startuml
title Add publication to library
hide circle

class AddPublicationToLibraryController{
+getListOfPublicationsNotInLibrary(UserId userId) : List<PublicationSample>
+addPublicationToLibrary(UserId userId, PublicationSampleId publicationSampleId) : Boolean
}

class IPublicationSampleRepository{
+findByUserIdAndLibraryIdIsNull(userId) : List<PublicationSample>
+save(PublicationSample publicationSample) : PublicationSample
+add(publicationSample) : Boolean
}

class ILibraryRepository{
+getByUserId(userId) : Library
}

class PublicationSample{
+assignLibrary(libraryId): this
}

class IPublicationSampleRepositoryJPA{
+findByUserIdAndLibraryIdIsNull(userId) : List<PublicationSampleDM>
+add(publicationSample) : Boolean
}

class ILibraryRepositoryJPA{
+getByUserId(userId) : LibraryDM
}

class PublicationSampleAssembler{
+toDomain(PubSampleDM) : PublicationSample
}

class PublicationSampleFactory{
+create(pubSampleId, bibliographicalDataId, userId, publicationStatus, editionId, \ncondition, libraryId, collectionOfPublicationsId)
}

Rectangle Database{
}
' ------ Interactions ------

AddPublicationToLibraryController "1" ..> "1" IPublicationSampleRepository : uses
IPublicationSampleRepository "1" ..> "1" IPublicationSampleRepositoryJPA : implements
IPublicationSampleRepository "1" ..> "1" PublicationSampleAssembler : uses
PublicationSampleAssembler "1" ..> "1" PublicationSampleFactory : uses
AddPublicationToLibraryController "1" ..> "1" ILibraryRepository : asks
ILibraryRepository "1" ..> ILibraryRepositoryJPA : implements
AddPublicationToLibraryController "1" ..> "1" PublicationSample : asks to assign library
IPublicationSampleRepositoryJPA ..> Database : queries
ILibraryRepositoryJPA ..> Database : queries



@enduml