class UI

class ToGetListOfItemsInAuctionOfAGivenAuthorController <<Controller>>{
  +getAllAuthors()
  +getAuctionsByAuthorId(selectedAuthorID)
}

interface IAuthorRepository <<Repository>>{
  +getAll()
}

interface IBiblioDataRepository <<Repository>>{
  +findIdsByAuthorId(selectedAuthorID)
}

interface IPublicationSampleRepository <<Repository>>{
  +findIdsByBiblioDataIds(bdIdList)
}

interface IListingRepository <<Repository>>{
  +findIdsByPublicationID(pubIdList)
}

interface IAuctionRepository <<Repository>>{
  +findByListingIds(listingIdList)
}

class AuthorAssembler <<Assembler>> {
  +toDomain(authorsDMList)
}

class AuctionAssembler <<Assembler>> {
  +toDomain(auctionDM)
}

class AuthorFactory <<Factory>>{
  +create(id, name, countryId, birthday, biography)
}

class AuctionFactory <<Factory>>{
  +create(id, startDate, finalDate, initialPrice, buyoutPrice)
}

class US026AuthorMapper <<Mapper>>{
  +fromDomainList(authorsList)
  +fromDomain(author)
}

class US026AuctionMapper <<Mapper>>{
  +fromDomainList(authorAuctionsList)
  +fromDomain(auction)
}

class US026AuthorDTO <<DTO>>
class US026AuctionDTO <<DTO>>

class Author <<Aggregate Root>>
class Auction <<Aggregate Root>>

