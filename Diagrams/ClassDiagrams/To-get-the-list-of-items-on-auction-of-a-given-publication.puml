@startuml

title To get the list of items on auction of a given publication

' ── UI Layer ───────────────────────────────────────────────
class UI {
}

' ── Application Layer ──────────────────────────────────────
class GetTheListOfItemsOnAuctionOfAGivenPublicationController {
  +getAllPublicationTitles(): List<String>
  +getAuctionListingsByTitle(title: String): List<US024AucListingDTO>
}

class US024AucListingMapper {
  +toDTOs(listOfAucListings: List<Listing>): List<US024AucListingDTO>
  +toDTO(aucListing: Listing): US024AucListingDTO
}

class US024AucListingDTO {
}

' ── Domain Layer ───────────────────────────────────────────
interface IBibliographicalDataRepository {
  +getAllTitles(): List<String>
  +findBibliographicalDataIdByTitle(title: String): Optional<BibliographicalDataId>
}

interface IPublicationSampleRepository {
  +findIdsByBibliographicalDataId(bdId: BibliographicalDataId): List<PublicationSampleId>
}

interface IListingRepository {
  +getAuctionListingsContaining(listOfPubSampleIds: List<PublicationSampleId>): List<Listing>
}

class Listing {
  -listingId: ListingId
  -listingTitle: String
  -itemsId: List<PublicationSampleId>
  -saleType: SaleType
  -price: Price
  -shortDescription: String
  -sellerId: UserId
  -pictures: List<Picture>
}

' ── Infrastructure Layer ───────────────────────────────────
interface IBibliographicalDataRepositoryJpa {
  +findAllTitles(): List<String>
  +findIdByTitleIgnoreCase(title: String): Optional<BibliographicalDataId>
}

interface IPublicationSampleRepositoryJpa {
  +findAllIdsByBdId(bdId: BibliographicalDataId): List<PublicationSampleId>
}

interface IListingRepositoryJpa {
  +findByPublicationSampleIdsInAndSaleType(listOfPubSampleIds: List<PublicationSampleId>, saleType: SaleType): List<ListingDM>
}

class ListingAssembler {
  +toDomain(listingDM: ListingDM): Listing
}

class ListingFactory {
  +create(listingId: ListingId, listingTitle: String, itemsId: List<PublicationSampleId>, saleType: SaleType, price: Price, shortDescription: String, sellerId: UserId, pictures: List<Picture>): Listing
}

rectangle Database {
}

' ── Relationships ──────────────────────────────────────────

UI ..> GetTheListOfItemsOnAuctionOfAGivenPublicationController : uses

GetTheListOfItemsOnAuctionOfAGivenPublicationController ..> IBibliographicalDataRepository : uses
GetTheListOfItemsOnAuctionOfAGivenPublicationController ..> IPublicationSampleRepository : uses
GetTheListOfItemsOnAuctionOfAGivenPublicationController ..> IListingRepository : uses
GetTheListOfItemsOnAuctionOfAGivenPublicationController ..> US024AucListingMapper : uses

IBibliographicalDataRepository <|.. IBibliographicalDataRepositoryJpa : implements
IPublicationSampleRepository <|.. IPublicationSampleRepositoryJpa : implements
IListingRepository <|.. IListingRepositoryJpa : implements

IListingRepositoryJpa ..> ListingAssembler : uses
ListingAssembler ..> ListingFactory : uses
ListingFactory ..> Listing : creates

IBibliographicalDataRepositoryJpa ..> Database : queries
IPublicationSampleRepositoryJpa ..> Database : queries
IListingRepositoryJpa ..> Database : queries

US024AucListingMapper ..> Listing : maps from
US024AucListingMapper ..> US024AucListingDTO : creates

@enduml