@startuml

title To get the list of items on auction of a given publication

' ── UI Layer ───────────────────────────────────────────────
class UI024 {
}

' ── Application Layer ──────────────────────────────────────
class US024GetTheListOfItemsOnAuctionOfAGivenPublicationController {
  +getAllPublicationTitles(): List<String>
  +getAuctionListingsByTitle(title: String): List<US024AucListingDTO>
}

class US024AucListingMapper {
  +toDTOs(listOfAucListings: List<Listing>): List<US024AucListingDTO>
  +toDTO(aucListing: Listing): US024AucListingDTO
}

class US024AucListingDTO {
}

' ── Domain Layer ───────────────────────────────────────────
interface IBibliographicalDataRepository {
  +getAllTitles(): List<String>
  +findBibliographicalDataIdByTitle(title: String): BibliographicalDataId
}

interface IPublicationSampleRepository {
  +findPubSampleIdsByBibliographicalDataId(bdId: BibliographicalDataId): List<PublicationSampleId>
}

interface IListingRepository {
  +getAuctionListingsContaining(listOfPubSampleIds: List<PublicationSampleId>): List<Listing>
}

class BibliographicalData {
  -id: BibliographicalDataId
  -title: String
}

class PublicationSample {
  -id: PublicationSampleId
}

class Listing {
  +isListingLinkedToAnAuction(): boolean
  +verifyIfListingContainsPubId(pubId: PublicationSampleId): boolean
}

' ── Relationships ──────────────────────────────────────────

UI024 ..> US024GetTheListOfItemsOnAuctionOfAGivenPublicationController : uses

US024GetTheListOfItemsOnAuctionOfAGivenPublicationController ..> IBibliographicalDataRepository : uses
US024GetTheListOfItemsOnAuctionOfAGivenPublicationController ..> IPublicationSampleRepository : uses
US024GetTheListOfItemsOnAuctionOfAGivenPublicationController ..> IListingRepository : uses
US024GetTheListOfItemsOnAuctionOfAGivenPublicationController ..> US024AucListingMapper : uses

IBibliographicalDataRepository "1" --> "*" BibliographicalData : manages
IPublicationSampleRepository "1" --> "*" PublicationSample : manages
IListingRepository "1" --> "*" Listing : manages

US024AucListingMapper ..> Listing : maps from
US024AucListingMapper ..> US024AucListingDTO : creates

@enduml