@startuml

'left to right direction
skinparam classAttributeIconSize 10
hide empty members

title To publicly share a list of mine

class "UI" as UI {

}

'Controller
class "ToPubliclyShareCollectionOfPublicationsController" as Controller {
  -collectionRepository: ICollectionOfPublicationsRepository
  -collectionService: CollectionOfPublicationsService
  +getUserCollections(userId: UserId): List<CollectionOfPublicationsDTO>
  +makeCollectionPublic(collectionDTO: CollectionDTO): boolean
}

'Repository Interfaces
interface "ICollectionOfPublicationRepository" as ICollectionOfPublicationsRepository  {
 + getByUserId(userId : UserId) : List<CollectionOfPublications>
 + makeCollectionPublic(id : CollectionOfPublicationsID) : boolean
}

interface "ICollectionOfPublicationsJPA" as ICollectionsJPA {
+findAllByUserId(ownerId : UserId) : CollectionOfPublications
 +update(collection : CollectionOfPublications) : CollectionOfPublications
}

class "CollectionOfPublicationsJpaImpl" as collectionRepoJpaImpl {
 -collectionsRepositoryJPA : ICollectionOfPublicationsRepositoryJpa
 -collectionsAssembler : CollectionOfPublicationsAssembler
 +findAllByUserId(ownerId : UserId) : CollectionOfPublications
 +update(collection : CollectionOfPublications) : CollectionOfPublications
}

class "AutomaticGeneratedCollectionOfPublicationsJPAImpl" as jpaAutomatic {
}

class "CollectionOfPublicationsService" as service {
-collectionRepository : ICollectionOfPublicationsRepository

+makeCollectionPublic(collectionId : CollectionOfPublicationsId) : boolean
}


'Domain
class "CollectionOfPublications" as collection{
  - id : CollectionOfPublicationsID
  - collectionName : String
  - collectionGenreId : GenreID
  - ownerId : UserId
  - isPrivate : boolean
  + getCollectionName() : String
  + getCollectionGenre() : GenreID
  + getOwnerId() : UserId
  + set_isPrivate(value : boolean) : boolean
}

class US019CollectionOfPublicationsMapper {
  + toDTO(collection : CollectionOfPublications) : US019CollectionOfPublicationsDTO
  + toDTOs(collections : List<CollectionOfPublications>) : List<US019CollectionOfPublicationsDTO>
}

class "US019CollectionOfPublicationsDTO" as DTO{
        - id : CollectionOfPublicationsId
        - name : String
        - genreName : String
        - ownerName : String
}

rectangle DataBase as db{
}

' Interactions
UI ..> Controller : uses

Controller ..> ICollectionOfPublicationsRepository : uses
Controller ..> US019CollectionOfPublicationsMapper : uses

Controller ..> service


ICollectionOfPublicationsRepository "1" ..> "*" collection : manages

collectionRepoJpaImpl ..|> ICollectionOfPublicationsRepository : implements
collectionRepoJpaImpl ..> ICollectionsJPA : uses

US019CollectionOfPublicationsMapper ..> collection : maps from
US019CollectionOfPublicationsMapper ..> DTO : creates
jpaAutomatic ..|> ICollectionsJPA : implements
jpaAutomatic ..> db : queries

service ..> collection : changes
service ..> ICollectionOfPublicationsRepository : uses

@enduml
