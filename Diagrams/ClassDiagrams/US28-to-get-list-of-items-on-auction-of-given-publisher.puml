@startuml
title US028 - To get the list of items on auction of a given publisher

class ItemController {
  +getItemsOnAuctionByPublisher(publisher)
}

class ListingRepository {
  +getBySaleType(typeOfSale)
}

class Listing {
  - _item: Item
  - _saleType: SaleType
}

enum SaleType {
    DIRECT_SALE
    AUCTION
}

class Item {
    - bibliographicalData: BibliographicalData
}

class BibliographicalData {
    - publisher: Publisher
    }

' Interactions

ItemController  "1 " -- "1 " ListingRepository : uses >
ListingRepository "1 " -- " * " Listing : retrieves >
Listing "                                *" --> "1 " SaleType : can be\nsold by >
Listing "1"--> "1    " Item : lists an >
Item "*" -- "1 " BibliographicalData: has >

@enduml
