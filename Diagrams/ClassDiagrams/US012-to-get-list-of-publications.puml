@startuml
title US012 - As a User, I want to get the list (title, author, type and ISBN/SSN) of publications in my library


    class UI012 {
    }



    class US012GetListOfPublicationsInLibraryController {
        - libraryRepository : LibraryRepository
        + getListOfPublicationsInLibraryDTO(username)
    }



    class PublicationDetailsDTO_US012 {
        - detailsDTO : String
        + toDTOs(listOfPublications : List<PublicationSample>) : List<PublicationDetailsDTO>
        + createDTO(details) : PublicationDetailsDTO
    }


    class Library {
        - publications : List<PublicationSample>
        + getAllPublications() : List<PublicationSample>
    }

    class PublicationSample {
        - details: Details
        + getDetails()
    }



    class LibraryRepository {
        + getAllPublicationsFromUserLibrary(username)
    }







' Relationships
UI012 ..> US012GetListOfPublicationsInLibraryController : uses
US012GetListOfPublicationsInLibraryController ..> LibraryRepository : uses
US012GetListOfPublicationsInLibraryController ..> PublicationDetailsDTO_US012 : creates


PublicationDetailsDTO_US012 ..> PublicationSample : converts from

Library "1" --> "0..*" PublicationSample : contains

LibraryRepository "1" --> "*" Library : manages


@enduml