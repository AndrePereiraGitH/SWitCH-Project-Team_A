@startuml
title US012 - Get the list of publications in my library (Class Diagram)

class UI012 {
}

class GetListOfPublicationsInLibraryController {
    +getListOfPublicationsInLibraryDTO(String username)
}

class Library {
    +getListOfPublicationsInLibrary()
}

class Publication {
}

class PublicationDTO {
}

class PublicationMapper {
    +getListOfPublicationsDTO(List<Publication> publications)
}

' ---------------- Relationships ----------------

UI012 ..> GetListOfPublicationsInLibraryController : delegates to

GetListOfPublicationsInLibraryController "1" --> Library : retrieves publications from
GetListOfPublicationsInLibraryController "1" ..> "1" PublicationMapper : invokes

Library "1" --> "*" Publication : contains

PublicationMapper "1" ..> "1..*" Publication : converts
PublicationMapper "1" ..> "1..*" PublicationDTO : produces

@enduml