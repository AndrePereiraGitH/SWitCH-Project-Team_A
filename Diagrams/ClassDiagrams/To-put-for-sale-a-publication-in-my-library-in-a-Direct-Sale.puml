@startuml
title To put for a sale a publication in my library in a direct sale

' -------------------------
' APPLICATION LAYER
' -------------------------

class UI015 {
}

class US015ToPutPublicationInDirectSaleController {
    - libraryRepository: ILibraryRepository
    - publicationSampleRepository: IPublicationSampleRepository
    - listingRepository: IListingRepository
    - pubSampleMapper: US015PublicationSampleMapper
    + findLibraryPublicationsAvailableForSale(): List<PublicationSampleDTO_US015>
    + putPublicationForSale(title, selectedPublicationIds, price, shortDescription, user1, pictures): boolean
}

record US015PublicationSampleDTO {
}

class US015PublicationSampleMapper {
    - bdRepo: IBibliographicalDataRepository
    - authorRepo: IAuthorRepository
    - editionRepo: IEditionRepository
    + toDTO(publication): US015BibliographicalDataDTO
    + toDTOs(listOfAvailablePublications): List<US015PublicationSampleDTO>
}

' -------------------------
' DOMAIN LAYER
' -------------------------

class PublicationSample {
    - publicationSampleId: PublicationSampleId
    - bibliographicalDataId: BibliographicalDataId
    - ownerId: UserId
    - publicationStatus: PublicationStatus
    - editionId: EditionId
    - condition: Condition
    - libraryId: LibraryId
    + isAvailableForSale(): boolean
}

class Listing {
    - listingId: String
    - listingTitle: String
    - publicationSampleIds: List<PublicationSampleId>
    - saleType: SaleType
    - price: Price
    - shortDescription: String
    - sellerId: UserId
    - pictures: List<Picture>
}

class ListingFactory {
    + create(title, publicationSampleIds, SaleType.DIRECT_SALE, price, shortDescription, userId, pictures): Listing
}

' -------------------------
' REPOSITORIES
' -------------------------

interface ILibraryRepository {
    + getLibraryByUserId(userId): Library
}

interface IPublicationSampleRepository {
    + findLibraryPublicationsAvailableForSaleByLibraryId(library.libraryId): List<PublicationSample>
    + getPublicationsByLibraryID(library.libraryId): List<PublicationSample>
}

interface IListingRepository {
    + createAndAdd(title, publicationSampleIds, SaleType.DIRECT_SALE, price, shortDescription, userId, pictures): Listing
}

' -------------------------
' RELATIONSHIPS
' -------------------------

' --- UI ---
UI015 -.> US015ToPutPublicationInDirectSaleController : "invokes"

' --- Controller ---
US015ToPutPublicationInDirectSaleController "1" --> "1" ILibraryRepository: "uses"
US015ToPutPublicationInDirectSaleController "1" --> "1" IPublicationSampleRepository : "uses"
US015ToPutPublicationInDirectSaleController "1" --> "1" IListingRepository : "uses"
US015ToPutPublicationInDirectSaleController "1" --> "1" US015PublicationSampleMapper : "creates DTOs"
US015ToPutPublicationInDirectSaleController ..> PublicationSample : "invokes"

' --- Library ---
Library <.. IPublicationSampleRepository : "queries by ID"

' --- PublicationSampleRepository ---
IPublicationSampleRepository "1" --> "*" PublicationSample : "returns"

' --- Listing ---

' --- Listing ---
IListingRepository "1" --> "1" ListingFactory : "uses"
IListingRepository "1" --> "*" Listing : "stores"

' --- PublicationSample DTO mapping ---
US015PublicationSampleMapper ..> US015PublicationSampleDTO : "maps from"

@enduml

