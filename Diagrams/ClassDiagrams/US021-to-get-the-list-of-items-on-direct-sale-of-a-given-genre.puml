@startuml
title US021 - To get the list of items on direct sale of a given genre

class UI021 {

}

class ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController {
  +getAllGenres()
  +getListOfItemsOnDirectSale(selectedGenreId: GenreId)
}

interface IGenreRepository {
  +getAllGenres() : List<Genre>
}

class Genre {
   - id: GenreID
    -genreType: String
}


interface IListingRepository {
  + findAllDirectSaleListings(): List<Listing>
}


class Listing {
  getSaleType(): SaleType
  getItemsId(): List<PublicationSampleId>
}

interface "IPublicationSampleRepository" as IPSR {
    + findPublicationSampleById(id) : Optional<PublicationSample>
}


class "PublicationSample" as PS {
    + getBibliographicalDataID() : BibliographicalDataID
}


interface "IBibliographicalDataRepository" as IBDR {
    + findBibliographicalDataById(id) : Optional<BibliographicalData>
}

class "BibliographicalData" as BD {
    + hasGenre(genre) : boolean
}

class "US021DirSaleListingMapper" as Mapper {
    + toDTO(listing: Listing): US021DirSaleListingDTO
}


class "US021DirSaleListingDTO" as DTO {

}




' Interactions
UI021 ..> ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController  ..> IGenreRepository : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController ..> IPSR : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController ..> IBDR : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController  ..> IListingRepository : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController ..> Mapper : uses

IGenreRepository "1 " --> "                   *" Genre : manages
IPSR  "1 "-->  "*" PS : manages
IBDR  "1 " -->  "*" BD : manages
IListingRepository "1 " --> "*" Listing : manages

Mapper ..> Listing : maps from
Mapper ..> DTO : creates

@enduml
