@startuml
title US021 - To get the list of items on direct sale of a given genre

class ItemController {
  +getListOfItems(typeOfSale, genre)
  #copyList(items)
}

class ItemRepository {
  +getListOfItems(typeOfSale, genre)
  -convertStringToEnum(typeOfSale, genre)
  -validateParameters(typeOfSale, genre)
}

class Item {
  - condition: Condition
  - weight: double
  - picture: List<Picture>
  - dimension: Dimensions
  - binding: TypeOfBinding
  - edition: String
  - bibliographicalData: BibliographicalData
}

enum SaleType {
    DIRECT_SALE
    AUCTION
}

enum Genre {
    FICTION
    NON_FICTION
    SCIENCE
    BIOGRAPHY
    HISTORY
    // others
}

' Interactions

ItemController  "1 " -- "1 " ItemRepository : uses >
ItemRepository "1 " -- " * " Item : retrieves >
Item "                                *" --> "1" SaleType : can be\nsold by >
Item "*"--> "1..*   " Genre : has >

@enduml
