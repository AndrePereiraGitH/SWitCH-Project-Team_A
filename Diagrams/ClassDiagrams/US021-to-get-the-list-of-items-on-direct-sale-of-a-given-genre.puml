@startuml
title US021 - To get the list of items on direct sale of a given genre

class UI021 {

}

class ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController {
  +getAllGenres()
  +getListOfItemsOnDirectSale(genre: Genre)
}

class GenreRepository {
  +getAllGenres()
}

class GenreDTO_US021 {
}


class GenreMapper_US021 {
   +toDTO(listOfAllGenres: List<Genre)
}

class DirectSaleMapper_US021 {
   +toDTO(listOfDirectSales: List<DirectSale)
}

class DirectSaleRepository {
  +getListOfItemsOnDirectSale(genre: Genre)
}

/'
class DirectSale {
  - listing: Listing
  +getDetails()
}

class Listing {
  - item: Item
  - saleType: SaleType
}

enum SaleType {
    DIRECT_SALE
    AUCTION
}

class Item {
    - publication: Publication
}

class Publication {
    - bibliographicalData: BibliographicalData
    - code: Code
}

class BibliographicalData {
    - title: String
    - genre: Genre
}

class Genre {
    - genreType: String
}
'/

' Interactions

UI021 ..> ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController ..> DirectSaleRepository : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController ..> GenreRepository : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController ..> GenreMapper_US021 : uses
GenreMapper_US021 ..> GenreDTO_US021 : maps to
'DirectSaleRepository "1 " --> " * " DirectSale : contains
ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController ..> DirectSaleMapper_US021 : uses
DirectSaleMapper_US021 ..> DirectSaleDTO_US021 : maps to
'DirectSaleMapper_US021 ..> DirectSale : uses
/'
DirectSale "1" --> "1" Listing : has
Listing "                                *" --> "1" SaleType : can be\nsold by
Listing "1"--> "1..*" Item : lists an
Item "*" --> "1" Publication: has
Publication "*" --> "1" BibliographicalData: has
BibliographicalData "*" --> "1..*" Genre: has
Genre "1" ..> "1" GenreRepository: uses
'/

@enduml
