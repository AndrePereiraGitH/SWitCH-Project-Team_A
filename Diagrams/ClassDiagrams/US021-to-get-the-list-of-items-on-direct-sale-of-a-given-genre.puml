@startuml
title US021 - To get the list of items on direct sale of a given genre

class UI021 {

}

class ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController {
  +getAllGenres()
  +getListOfItemsOnDirectSale(genre: Genre)
}

class GenreRepository {
  +getAllGenres()
}

class Genre {
    -genreType: String
    +getDetails()
}

class DirectSaleRepository {
  +getListOfItemsOnDirectSale(genre: Genre)
  -isDirectSaleFromGenre(genre)
}

class DirectSale {
  - listing: Listing
  - directSaleDate: LocalDateTime
  +getDetails()
}

class Item{
-condition: Condition
-dimension: Dimension
-publication: Publication
-weight: double
}


' Interactions
UI021 --> ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController --> DirectSaleRepository : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController --> GenreRepository : uses

GenreRepository --> Genre : stores
DirectSaleRepository --> DirectSale : stores

Genre --> Item : categorizes
DirectSale --> Item : has
@enduml
