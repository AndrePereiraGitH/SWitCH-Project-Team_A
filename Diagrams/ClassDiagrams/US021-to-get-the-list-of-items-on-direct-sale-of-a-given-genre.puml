@startuml
title US021 - To get the list of items on direct sale of a given genre

class UI021 {
}

class ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController {
  +getAllGenres() : List<US021GenreDTO>
  +getListOfItemsOnDirectSale(selectedGenreId: GenreID) : List<US021DirSaleListingDTO>
}

interface IGenreRepository {
  +getAllGenres() : List<Genre>
}

class Genre {
  -id: GenreID
  -genreType: String
}

class US021GenreMapper {
  +{static} toDTO(genre: Genre) : US021GenreDTO
  +{static} toDTOList(genres: List<Genre>) : List<US021GenreDTO>
}

class US021GenreDTO {
  -genreId: GenreID
  -name: String
}

interface IBibliographicalDataRepository {
  +findAllBibliographicalDataByGenreId(genreId: GenreID) : List<BibliographicalDataID>
}

interface IPublicationSampleRepository {
  +findAllItemsIdByBibliographicalDataId(bdIds: List<BibliographicalDataID>) : List<PublicationSampleId>
}

interface IListingRepository {
  +findDirectSaleListingsContaining(pubSampleIds: List<PublicationSampleId>) : List<Listing>
}

class Listing {
  -id: ListingId
  -listingTitle: String
  -price: Price
  -shortDescription: String
  -sellerId: UserId
}

class US021DirSaleListingMapper {
  +toDTO(listing: Listing) : US021DirSaleListingDTO
  +toDTOs(listings: List<Listing>) : List<US021DirSaleListingDTO>
}

class US021DirSaleListingDTO {
  -listingId: String
  -listingTitle: String
  -price: BigDecimal
  -shortDescription: String
  -sellerId: String
}

' Relationships
UI021 ..> ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController ..> IGenreRepository : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController ..> IBibliographicalDataRepository : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController ..> IPublicationSampleRepository : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController ..> IListingRepository : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController ..> US021GenreMapper : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController ..> US021DirSaleListingMapper : uses

IGenreRepository "1" --> "*" Genre : manages
IListingRepository "1" --> "*" Listing : manages

US021GenreMapper ..> Genre : maps from
US021GenreMapper ..> US021GenreDTO : creates

US021DirSaleListingMapper ..> Listing : maps from
US021DirSaleListingMapper ..> US021DirSaleListingDTO : creates

@enduml
