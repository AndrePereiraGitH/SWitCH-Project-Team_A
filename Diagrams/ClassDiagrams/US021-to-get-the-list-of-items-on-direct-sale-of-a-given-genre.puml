@startuml
title US021 - To get the list of items on direct sale of a given genre

class UI021 {

}

class ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController {
  +getAllGenres()
  +getListOfItemsOnDirectSale(genre)
}

class GenreRepository {
  +getAllGenres()
}

class DirectSaleMapper {
   +toDTO(listOfDirectSales)
}

class DirectSaleRepository {
  +getListOfItemsOnDirectSale(genre)
}

class DirectSale {
  - listing: Listing
  +getDetails()
}

/'
class Listing {
  - item: Item
  - saleType: SaleType
}

enum SaleType {
    DIRECT_SALE
    AUCTION
}

class Item {
    - publication: Publication
}

class Publication {
    - bibliographicalData: BibliographicalData
    - code: Code
}

class BibliographicalData {
    - title: String
    - genre: Genre
}

class Genre {
    - genreType: String
}
'/

' Interactions

UI021 ..> ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController ..> DirectSaleRepository : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController ..> GenreRepository : uses
DirectSaleRepository "1 " --> " * " DirectSale : contains
ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController ..> DirectSaleMapper : uses
DirectSaleMapper ..> DirectSaleDTO : maps to
DirectSaleMapper ..> DirectSale : uses
/'
DirectSale "1" --> "1" Listing : has
Listing "                                *" --> "1" SaleType : can be\nsold by
Listing "1"--> "1..*" Item : lists an
Item "*" --> "1" Publication: has
Publication "*" --> "1" BibliographicalData: has
BibliographicalData "*" --> "1..*" Genre: has
Genre "1" ..> "1" GenreRepository: uses
'/

@enduml
