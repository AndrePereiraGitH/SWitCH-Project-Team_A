@startuml
title US021 - To get the list of items on direct sale of a given genre

class UI021 {

}

class ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController {
  +getAllGenres()
  +getListOfItemsOnDirectSale(genre: Genre)
}

class GenreRepository {
  +getAllGenres()
}

class FactoryGenre  <<Factory>> {
}

class FactoryDirectSale <<Factory>> {
}


class Genre {
    -genreType: String
    +getDetails()
}

class DirectSaleRepository {
  +getListOfItemsOnDirectSale(genre: Genre)
  -isDirectSaleFromGenre(genre)
}

class DirectSale {
  - listing: Listing
  - directSaleDate: LocalDateTime
  +getDetails()
}

class Item{
-condition: Condition
-dimension: Dimension
-publication: Publication
-weight: double
}

' Interactions
UI021 "1 " ..>  ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController  ..> DirectSaleRepository : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController  ..> GenreRepository : uses

GenreRepository ..>  FactoryGenre : uses
GenreRepository "1 " --> "                   *" Genre : stores

DirectSaleRepository ..> FactoryDirectSale : uses

DirectSaleRepository "1 " --> "*" DirectSale : stores
Genre "1 " --> "1 " Item : categorizes
DirectSale "1 " -->  "1 " Item : has
@enduml
