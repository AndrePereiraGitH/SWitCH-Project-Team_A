@startuml
title US021 - To get the list of items on direct sale of a given genre

class ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController {
  +getListOfItemsOnDirectSale(genre)
  -copyList()
}

class ListingRepository{
  +getListOfItemsOnDirectSale(genre)
  -validateParameters(genre)
}

class Listing {
  - item: Item
  - saleType: SaleType
}

enum SaleType {
    DIRECT_SALE
    AUCTION
}

class Genre {
    - genre: String
}

class Item {
    - bibliographicalData: BibliographicalData
}

class BibliographicalData {
    - genre: Genre
}

' Interactions

ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController  "1 " -- "1 " ListingRepository : uses >
ListingRepository "1 " -- " * " Listing : retrieves >
Listing "                                *" --> "1" SaleType : can be\nsold by >
Listing "1"--> "*" Item : lists an >
Item "*" -- "1" BibliographicalData: has >
BibliographicalData "*" -- "1..*" Genre: has >

@enduml
