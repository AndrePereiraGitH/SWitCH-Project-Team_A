@startuml
hide circle
title To Register a New City

class UI

class ToRegisterNewCityController {
  -cityService: CityService
  +register(countryName: String, cityName: String) : City
}

class CityService {
  -cityFactory: CityFactory
  -cityRepository: ICityRepository
  -countryRepository: ICountryRepository
  +createAndSave(countryName: String, cityName: String) : City
}

class City {
  -cityID: CityID
  -countryID: CountryID
  -cityName: String
}

class CountryID
class CityID

class CityFactory {
  +create(countryID: CountryID, cityName: String) : City
  +create(cityID: CityID, countryID: CountryID, cityName: String) : City
}

interface ICityRepository {
  +save(city: City) : City
  +existsByCountryIDAndCityName(countryID: CountryID, cityName: String) : boolean
}

interface ICountryRepository {
  +findCountryIdByCountryName(countryName: String) : Optional<CountryID>
}

class CityRepositoryJPAImpl {
  +save(city: City) : City
  +existsByCountryIDAndCityName(countryID: CountryID, cityName: String) : boolean
}

interface ICityRepositoryJPA {
  +save(cityDM: CityDM) : CityDM
  +existsByCountryIDAndCityName(countryID: CountryID, cityName: String) : boolean
}

class CityAssembler {
  +toDM(city: City) : CityDM
  +toDomain(cityDM: CityDM) : City
}

class CityDM {
  -cityID: CityID
  -countryID: CountryID
  -cityName: String
}

' =====================
' Relationships + Verbs
' =====================

UI "1" --> "1" ToRegisterNewCityController : uses

ToRegisterNewCityController "1" --> "1" CityService : delegates to

CityService "1" --> "1" ICityRepository : uses
CityService "1" --> "1" ICountryRepository : queries
CityService "1" --> "1" CityFactory : creates via

CityRepositoryJPAImpl "1" ..|> "1" ICityRepository : implements
CityRepositoryJPAImpl "1" --> "1" ICityRepositoryJPA : delegates to
CityRepositoryJPAImpl "1" --> "1" CityAssembler : uses

ICityRepositoryJPA "1" --> "0..*" CityDM : persists

CityAssembler "1" --> "1" CityFactory : reconstructs via
CityAssembler "1" --> "1" City : creates
CityAssembler "1" --> "1" CityDM : maps

City "1" --> "1" CountryID : belongs to
City "1" --> "1" CityID : identified by

@enduml