@startuml
hide circle
title To Register a New City

class UI

class ToRegisterNewCityController {
  -cityService: CityService
  +register(countryName: String, cityName: String) : City
}

class CityService {
  -cityFactory: CityFactory
  -cityRepository: ICityRepository
  -countryRepository: ICountryRepository
  +createAndSave(countryName: String, cityName: String) : City
}

class City {
  -cityID: CityID
  -countryID: CountryID
  -cityName: String
}

class CountryID
class CityID

class CityFactory {
  +create(countryID: CountryID, cityName: String) : City
  +create(cityID: CityID, countryID: CountryID, cityName: String) : City
}

interface ICityRepository {
  +save(city: City) : City
  +existsByCountryIDAndCityName(countryID: CountryID, cityName: String) : boolean
}

interface ICountryRepository {
  +findCountryIdByCountryName(countryName: String) : Optional<CountryID>
}

class CityRepositoryJPAImpl {
  +save(city: City) : City
  +existsByCountryIDAndCityName(countryID: CountryID, cityName: String) : boolean
}

interface ICityRepositoryJPA {
  +save(cityDM: CityDM) : CityDM
  +existsByCountryIDAndCityName(countryID: CountryID, cityName: String) : boolean
}

class CityAssembler {
  +toDM(city: City) : CityDM
  +toDomain(cityDM: CityDM) : City
}

class CityDM {
  -cityID: CityID
  -countryID: CountryID
  -cityName: String
}

' =====================
' Relationships
' =====================

UI "1" --> "1" ToRegisterNewCityController

ToRegisterNewCityController "1" --> "1" CityService

CityService "1" --> "1" ICityRepository
CityService "1" --> "1" ICountryRepository
CityService "1" --> "1" CityFactory

CityRepositoryJPAImpl "1" ..|> "1" ICityRepository
CityRepositoryJPAImpl "1" --> "1" ICityRepositoryJPA
CityRepositoryJPAImpl "1" --> "1" CityAssembler

ICityRepositoryJPA "1" --> "0..*" CityDM

CityAssembler "1" --> "1" CityFactory
CityAssembler "1" --> "1" City
CityAssembler "1" --> "1" CityDM

City "1" --> "1" CountryID
City "1" --> "1" CityID

@enduml