@startuml
hide circle
title Register New City (Class Diagram)

class UI008{
}

class City {
  -cityName: String
  -countryID: CountryID
}

class Country {
  -countryName: String
  -countryID: CountryID
}

class CountryID

class CityFactory {
  +create(countryID: CountryID, cityName: String) : City
}

interface ICityRepository {
  +createAndAdd(countryID: CountryID, cityName: String) : City
}

interface ICountryRepository {
  +findCountryIdByCountryName(countryName: String) : Optional<CountryID>
}

class US008ToRegisterACityCtrl {
  -_cityRepository: ICityRepository
  -_countryRepository: ICountryRepository
  +registerNewCity(countryName: String, cityName: String) : boolean
}

' Relationships
UI008 ..> US008ToRegisterACityCtrl: uses
US008ToRegisterACityCtrl "1"..>"1" ICityRepository: uses
US008ToRegisterACityCtrl "1"..>"1" ICountryRepository: uses

ICityRepository "1"-->"*" City: manages
ICountryRepository "1"-->"*" CountryID: finds

City "1"-->"1..*" CountryID: belongs to
Country "1"-->"1" CountryID: identified by

ICityRepository "1"..>"1" CityFactory : uses

@enduml