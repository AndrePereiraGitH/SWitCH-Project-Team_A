@startuml
title Class Diagram - US028 Get Items On Auction By Publisher
skinparam classAttributeIconSize 0
skinparam linetype ortho
top to bottom direction
skinparam nodesep 100
skinparam ranksep 100

' ========================
' CONTROLLER
' ========================
class ToGetListOfItemsOnAuctionOfAGivenPublisherController {
    - publisherRepo : IPublisherRepository
    - editionRepo : IEditionRepository
    - pubSampleRepo : IPublicationSampleRepository
    - listingRepo : IListingRepository
    - listingMapper : US028ListingMapper
    + getAllPublishers() : List<US028PublisherDTO>
    + findListOfItemsOnAuctionByPublisherId(publisherId : PublisherID) : List<US028ListingDTO>
}

class UI {
}

' ========================
' DATABASE
' ========================
rectangle DataBase {
}

' ========================
' PUBLISHER
' ========================
interface IPublisherRepository {
    + findAll() : List<Publisher>
    + findById(id : PublisherID) : Optional<Publisher>
}

class PublisherRepositoryJpaImpl {
    - publisherRepositoryJpa : IPublisherRepositoryJpa
    - assembler : PublisherAssembler
    + findAll() : List<Publisher>
    + findById(id : PublisherID) : Optional<Publisher>
}

interface IPublisherRepositoryJpa {
    + findAll() : List<PublisherDM>
    + findById(id : PublisherID) : Optional<PublisherDM>
}

class AutomaticGeneratedPublisherRepoJPAImpl {
}

class PublisherAssembler {
    + toDomain(dm : PublisherDM) : Publisher
}

class PublisherFactory {
    + create(id : PublisherID, name : String) : Publisher
}

class Publisher {
    - id : PublisherID
    - name : String
    + id() : PublisherID
    + getName() : String
}

class PublisherID {
    - value : String
    + getId() : String
}

class PublisherDM {
    - id : PublisherID
    - name : String
    + getId() : PublisherID
    + getName() : String
}

class US028PublisherMapper {
    + toDTOs(publishers : List<Publisher>) : List<US028PublisherDTO>
    + toDTO(publisher : Publisher) : US028PublisherDTO
}

class US028PublisherDTO {
    - id : String
    - name : String
}

' ========================
' EDITION
' ========================
interface IEditionRepository {
    + findByPublisherId(publisherId : PublisherID) : List<Edition>
}

class EditionRepositoryJpaImpl {
    - editionRepositoryJpa : IEditionRepositoryJpa
    - assembler : EditionAssembler
    + findByPublisherId(publisherId : PublisherID) : List<Edition>
}

interface IEditionRepositoryJpa {
    + findAllByPublisherId(publisherId : PublisherID) : List<EditionDM>
}

class AutomaticGeneratedEditionRepoJPAImpl {
}

class EditionDM {
    - editionId : EditionID
    - publisherId : PublisherID
    + getEditionId() : EditionID
    + getPublisherId() : PublisherID
}

class EditionID {
    - value : String
}

class EditionAssembler {
    + toDomain(dm : EditionDM) : Edition
}

class EditionFactory {
    + create(editionID : EditionID, editionNumber : String, code : Code, physicalAttributes : PhysicalAttributes, publicationTypeId : PublicationTypeId, publisherID : PublisherID, mediaFormat : String, editionLanguage : Locale, editionDate : LocalDate, typeOfBinding : TypeOfBinding) : Edition
}

class Edition {
    - editionID : EditionID
    - publisherID : PublisherID
    + identity() : EditionID
}

' ========================
' PUBLICATION SAMPLE
' ========================
interface IPublicationSampleRepository {
    + findIdsByEditionIdIn(ids : List<EditionID>) : List<PublicationSampleId>
}

class PublicationSampleRepositoryJpaImpl {
    - publicationSampleRepositoryJpa : IPublicationSampleRepositoryJpa
    + findIdsByEditionIdIn(ids : List<EditionID>) : List<PublicationSampleId>
}

interface IPublicationSampleRepositoryJpa {
    + findAllByEditionIdIn(ids : List<EditionID>) : List<PublicationSampleDM>
}

class AutomaticGeneratedPublicationSampleRepoJPAImpl {
}

class PublicationSampleDM {
    - pubSampleId : PublicationSampleId
    - editionId : EditionID
    + getPubSampleId() : PublicationSampleId
    + getEditionId() : EditionID
}

class PublicationSampleId {
    - value : String
}

' ========================
' LISTING
' ========================
interface IListingRepository {
    + findAllByAuctionAndPublicationSampleIdIn(ids : List<PublicationSampleId>) : List<Listing>
}

class ListingRepositoryJpaImpl {
    - listingRepositoryJpa : IListingRepositoryJpa
    - assembler : ListingAssembler
    + findAllByAuctionAndPublicationSampleIdIn(ids : List<PublicationSampleId>) : List<Listing>
}

interface IListingRepositoryJpa {
    + findAllByItemsId(ids : List<PublicationSampleId>) : List<ListingDM>
}

class AutomaticGeneratedListingRepoJPAImpl {
}

class ListingAssembler {
    + toDomain(dm : ListingDM) : Listing
}

class ListingFactory {
    + create(listingId : ListingId, title : String, itemsId : PublicationSampleId, saleType : String, price : double, shortDescription : String, sellerId : String, pictures : List<String>) : Listing
}

class Listing {
    - listingId : ListingId
    - itemsId : PublicationSampleId
    - saleType : String
    + getListingId() : ListingId
    + getItemsId() : PublicationSampleId
    + isListingLinkedToAnAuction() : boolean
}

class ListingDM {
    - listingId : ListingId
    - publicationSampleId : PublicationSampleId
    - saleType : String
    + getListingId() : ListingId
    + getItemsId() : PublicationSampleId
    + getSaleType() : String
}

class ListingId {
    - value : String
}

class US028ListingMapper {
    + toDTO(listings : List<Listing>) : List<US028ListingDTO>
    + toDTO(listing : Listing) : US028ListingDTO
}

class US028ListingDTO {
    - listingId : String
    - title : String
    - price : double
    - shortDescription : String
}

' ========================
' CONTROLLER RELATIONS
' ========================
UI "1" ..> "1" ToGetListOfItemsOnAuctionOfAGivenPublisherController : uses

ToGetListOfItemsOnAuctionOfAGivenPublisherController "1" ..> "1" IPublisherRepository : uses
ToGetListOfItemsOnAuctionOfAGivenPublisherController "1" ..> "1" IEditionRepository : uses
ToGetListOfItemsOnAuctionOfAGivenPublisherController "1" ..> "1" IPublicationSampleRepository : uses
ToGetListOfItemsOnAuctionOfAGivenPublisherController "1" ..> "1" IListingRepository : uses
ToGetListOfItemsOnAuctionOfAGivenPublisherController "1" ..> "1" US028ListingMapper : uses
ToGetListOfItemsOnAuctionOfAGivenPublisherController ..> US028PublisherMapper : uses

' ========================
' PUBLISHER FLOW
' ========================
PublisherRepositoryJpaImpl "1" ..|> "1" IPublisherRepository
PublisherRepositoryJpaImpl "1" ..> "1" IPublisherRepositoryJpa : uses
PublisherRepositoryJpaImpl "1" ..> "1" PublisherAssembler : uses

AutomaticGeneratedPublisherRepoJPAImpl "1" ..|> "1" IPublisherRepositoryJpa
AutomaticGeneratedPublisherRepoJPAImpl "1" ..> "1" DataBase : queries

PublisherAssembler "1" ..> "1" PublisherFactory : uses
PublisherFactory "1" ..> "0..*" Publisher : creates

PublisherDM "1" --> "1" PublisherID : has
Publisher "1" --> "1" PublisherID : has

US028PublisherMapper "1" ..> "0..*" US028PublisherDTO : creates
US028PublisherMapper ..> Publisher : reads

' ========================
' EDITION FLOW
' ========================
EditionRepositoryJpaImpl "1" ..|> "1" IEditionRepository
EditionRepositoryJpaImpl "1" ..> "1" IEditionRepositoryJpa : uses
EditionRepositoryJpaImpl "1" ..> "1" EditionAssembler : uses

AutomaticGeneratedEditionRepoJPAImpl "1" ..|> "1" IEditionRepositoryJpa
AutomaticGeneratedEditionRepoJPAImpl "1" ..> "1" DataBase : queries

EditionAssembler "1" ..> "1" EditionFactory : uses
EditionFactory "1" ..> "0..*" Edition : creates

EditionDM "1" --> "1" EditionID : has
EditionDM "1" --> "1" PublisherID : belongs to

Edition "1" --> "1" EditionID : has
Edition "1" --> "1" PublisherID : belongs to

' ========================
' PUBLICATION SAMPLE FLOW
' ========================
PublicationSampleRepositoryJpaImpl "1" ..|> "1" IPublicationSampleRepository
PublicationSampleRepositoryJpaImpl "1" ..> "1" IPublicationSampleRepositoryJpa : uses

AutomaticGeneratedPublicationSampleRepoJPAImpl "1" ..|> "1" IPublicationSampleRepositoryJpa
AutomaticGeneratedPublicationSampleRepoJPAImpl "1" ..> "1" DataBase : queries

PublicationSampleDM "1" --> "1" PublicationSampleId : has
PublicationSampleDM "1" --> "1" EditionID : refers to

' ========================
' LISTING FLOW
' ========================
ListingRepositoryJpaImpl "1" ..|> "1" IListingRepository
ListingRepositoryJpaImpl "1" ..> "1" IListingRepositoryJpa : uses
ListingRepositoryJpaImpl "1" ..> "1" ListingAssembler : uses

AutomaticGeneratedListingRepoJPAImpl "1" ..|> "1" IListingRepositoryJpa
AutomaticGeneratedListingRepoJPAImpl "1" ..> "1" DataBase : queries

ListingAssembler "1" ..> "1" ListingFactory : uses
ListingFactory "1" ..> "0..*" Listing : creates

ListingDM "1" --> "1" ListingId : has
ListingDM "1" --> "1" PublicationSampleId : refers to

Listing "1" --> "1" ListingId : has
Listing "1" --> "1" PublicationSampleId : refers to

US028ListingMapper ..> Listing : reads
US028ListingMapper "1" ..> "0..*" US028ListingDTO : creates

@enduml