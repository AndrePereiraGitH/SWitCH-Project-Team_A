@startuml
title To put for a sale a publication in my library in a direct sale

class UI {}

' -------------------------
' Controller
' -------------------------

class ToPutForSaleAPublicationInDirectSaleController {
    + findLibraryPublicationsAvailableForSale(UserId userId): List<US015PublicationSampleDTO>
    + createDirectSaleListing(String title, List<PublicationSampleId> selectedPublicationIds,\n Price price, String shortDescription, UserId userId, List<Picture> pictures): Listing
}

' -------------------------
' Library
' -------------------------

interface ILibraryRepository {
    + getByUserId(UserId userId): Library
}

interface ILibraryRepositoryJPA {
    + getByUserId(UserId userId): LibraryDM
}

class LibraryRepositoryJPAImpl {
    + getByUserId(UserId userId): LibraryDM
}

'class AutomaticGeneratedLibraryRepositoryJPAImpl {}

class LibraryAssembler {
    +toDomain(LibraryDM libraryDM): Library
}

class LibraryFactory {
    + create(LibraryId libraryId, String libraryName, UserId userId): Library
}

class Library {
    - id: LibraryId
    - libraryName: String
    - userId: UserId
}

' -------------------------
' Publication Sample
' -------------------------

interface IPublicationSampleRepository {
    + findAvailableForSaleByLibraryId(LibraryId libraryId): List<PublicationSample>
}

interface IPublicationSampleRepositoryJPA {
    + findAvailableForSaleByLibraryId(LibraryId libraryId): List<PublicationSampleDM>
}

class PublicationSampleRepositoryJPAImpl {
    + findAvailableForSaleByLibraryId(LibraryId libraryId): List<PublicationSampleDM>
}

'class AutomaticGeneratedPublicationSampleRepositoryJPAImpl {}

class PublicationSampleAssembler {
    + toDomain(PublicationSampleDM pubSamplesDM): PublicationSample
}

class PublicationSampleFactory {
    + create(PublicationSampleId pubSampleId, BibliographicalDataId bdId, UserId userId,\nPublicationStatus pubStatus, EditionId editionId, Condition condition): PublicationSample
}

class PublicationSample {
    - publicationSampleId: PublicationSampleId
    - bibliographicalDataId: BibliographicalDataId
    - ownerId: UserId
    - publicationStatus: PublicationStatus
    - editionId: EditionId
    - condition: Condition
    - libraryId: LibraryId
}

record US015PublicationSampleDTO {
    - pubTitle: String
    - authorsName: List<String>
    - code: String
    - publicationType: String
}

class US015PublicationSampleMapper {
    - bdRepo: IBibliographicalDataRepository
    - authorRepo: IAuthorRepository
    - editionRepo: IEditionRepository
    + toDTO(PublicationSample puSample): US015PublicationSampleDTO
    + toDTOs(List<PublicationSample> listOfAvailablePublications): List<US015PublicationSampleDTO>
}

' -------------------------
' Listing
' -------------------------

class ListingService {
    + createAndSave(String title, List<PublicationSampleId> selectedPublicationIds, SaleType saleType,\nPrice price, String shortDescription, UserId userId, List<Picture> pictures): Listing
}

interface IListingRepository {
    + save(Listing listing): Listing
}

interface IListingRepositoryJPA {
    + save(ListingDM listingDM): ListingDM
}

class ListingRepositoryJPAImpl {
    + save(ListingDM listingDM): ListingDM
}

'class AutomaticGeneratedListingRepositoryJPAImpl {}

class ListingAssembler {
    + toDM(Listing listing): ListingDM
    + toDomain(ListingDM listingDM): Listing
}

class ListingFactory {
    + create(String title, List<PublicationSampleId> selectedPublicationIds, SaleType saleType,\nPrice price, String shortDescription, UserId userId, List<Picture> pictures): Listing
}

class Listing {
    - listingId: String
    - listingTitle: String
    - publicationSampleIds: List<PublicationSampleId>
    - saleType: SaleType
    - price: Price
    - shortDescription: String
    - sellerId: UserId
    - pictures: List<Picture>
}


' -------------------------
' RELATIONSHIPS
' -------------------------

UI "1" ..> "1" ToPutForSaleAPublicationInDirectSaleController: "uses"

' --- Controller ---
ToPutForSaleAPublicationInDirectSaleController "1" --> "1" ILibraryRepository: "uses"
ToPutForSaleAPublicationInDirectSaleController "1" --> "1" IPublicationSampleRepository : "uses"
ToPutForSaleAPublicationInDirectSaleController"1" --> "1" US015PublicationSampleMapper : "uses"
ToPutForSaleAPublicationInDirectSaleController "1" --> "1" ListingService : "uses"

' --- Library ---
LibraryRepositoryJPAImpl "1" ..|> "1" ILibraryRepository: implements
LibraryRepositoryJPAImpl "1" ..> "1" ILibraryRepositoryJPA: uses
'AutomaticGeneratedLibraryRepositoryJPAImpl "1" ..|> "1" ILibraryRepositoryJPA: implements
'AutomaticGeneratedLibraryRepositoryJPAImpl "1" ..> "1" database: queries

ILibraryRepository "1" ..> "1" LibraryAssembler: "uses"

LibraryAssembler "1" --> "1" LibraryFactory: "uses"
LibraryAssembler "1" ..> "1" LibraryDM: "receives"

LibraryFactory "1" --> "1" Library: "creates"

' --- PublicationSampleRepository ---
PublicationSampleRepositoryJPAImpl "1" ..|> "1" IPublicationSampleRepository: implements
PublicationSampleRepositoryJPAImpl "1" ..> "1" IPublicationSampleRepositoryJPA: uses
'AutomaticGeneratedPublicationSampleRepositoryJPAImpl "1" ..|> "1" IPublicationSampleRepositoryJPA: implements
'AutomaticGeneratedPublicationSampleRepositoryJPAImpl "1" ..> "1" database: queries

IPublicationSampleRepository "1" ..> "1" PublicationSampleAssembler: "uses"

PublicationSampleAssembler "1" --> "1" PublicationSampleFactory: "uses"
PublicationSampleAssembler "1" ..> "1" PublicationSampleDM: "receives"

PublicationSampleFactory "1" --> "1" PublicationSample: "creates"

US015PublicationSampleMapper ..> US015PublicationSampleDTO : "maps"

' --- Listing ---
ListingService "1" --> "1" ListingFactory: "uses"
ListingService "1" --> "1" IListingRepository: "uses"

ListingFactory "1" --> "1" Listing: "creates"

IListingRepository "1" ..> "1" ListingAssembler: "uses"

ListingRepositoryJPAImpl "1" ..|> "1" IListingRepository: implements
ListingRepositoryJPAImpl "1" ..> "1" IListingRepositoryJPA: uses
'AutomaticGeneratedListingRepositoryJPAImpl "1" ..|> "1" IListingRepositoryJPA: implements
'AutomaticGeneratedListingRepositoryJPAImpl "1" ..> "1" database: queries

ListingAssembler "1" ..> "1" ListingDM: "receives"
ListingAssembler "1" --> "1" ListingFactory: "uses"

@enduml

