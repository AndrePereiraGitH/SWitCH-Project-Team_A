@startuml
title US006 - To register a publishing company in the system

class RegisterPublisher {
  +registerPublisher(name, vatNumber, contact)
}

class PublisherRepository {
  +createNewPublisher(name, vatNumber, contact)
  +add(p1)
  +validator(p1): boolean
}

class Publisher {
  +name: String
  +vatNumber: String
  +contact: Contact

}

' Interactions

RegisterPublisher "1 " -- "1 " PublisherRepository : requests registration to >
PublisherRepository "1 " -- " * " Publisher : manages / stores >

@enduml