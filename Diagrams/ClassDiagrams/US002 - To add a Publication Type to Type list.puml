@startuml
title US002 - To add a publication type to type list in the system

'Need to create class

class RegisterPubType {
  -_pubTypeRepository: PubTypeRepository
    +createAndAddPubType(name: String): PubType
}

class PubTypeRepository {
    -_pubType: List<pubType>
  +createNewPubType(pubType: String)
  -validator(t1): boolean
}

class PubType {
  -_pubType: String
    +getName(): String

}

' Interactions

RegisterPubType "1 " -- "1 " PubTypeRepository : requests registration to >
PubTypeRepository "1 " -- " * " PubType : manages / stores >

@enduml