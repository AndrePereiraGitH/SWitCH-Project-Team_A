@startuml
title To create a library

' ── UI Layer ───────────────────────────────────────────────
package "UI" {
    class UI {
    }
}

' ── Application Layer ──────────────────────────────────────
package "Application" {
    class LibraryRESTController {
        + createLibrary(requestLibraryDTO: RequestLibraryDTO, username: String): ResponseEntity<ResponseLibraryDTO>
    }

    class LibraryService {
        + createAndSave(libraryName: String, username: String): Library
    }

    class LibraryMapper {
        + toDTO(library: Library): ResponseLibraryDTO
        + toDTOList(libraries: List<Library>): List<ResponseLibraryDTO>
        + toLibraryId(libId: String): LibraryId
        + toUserId(userId: String): UserId
    }

    class LibraryLinkProvider {
        + getLinksForLibraries(userId: UserId): Links
    }

    class RequestLibraryDTO {
        - libraryName: String
    }

    class ResponseLibraryDTO {
        - id: UUID
        - libraryName: String
    }
}

' ── Domain Layer ───────────────────────────────────────────
package "Domain" {
    interface IUserRepository {
        + findByUsername(username: String): Optional<User>
    }

    interface ILibraryRepository {
        + save(library: Library): Library
        + existsByUserId(userId: UserId): boolean
    }

    interface ILibraryPolicy {
        + canCreateLibrary(user: User): boolean
    }

    class LibraryFactory {
        + create(libraryName: String, userId: UserId): Library
        + create(id: LibraryId, name: String, userId: UserId): Library
    }

    class Library {
        - id: LibraryId
        - name: String
        - userId: UserId
        + id(): LibraryId
        + userId(): UserId
        + getLibraryName(): String
    }
}

' ── Infrastructure Layer ───────────────────────────────────
package "Infrastructure" {
    class LibraryRepositoryJPAImpl {
    }

    class UserRepositoryJPAImpl {
    }

    interface IUserRepositoryJPA {
        + findByUserName(username: String): Optional<UserDM>
    }

    interface ILibraryRepositoryJPA {
        + existsByUserId(userId: UserId): boolean
        + save(libraryDM: LibraryDM): LibraryDM
    }

    class LibraryAssembler {
        + toDM(library: Library): LibraryDM
        + toDomain(libraryDM: LibraryDM): Library
    }

    class UserDM {
        - id: UserId
        - username: String
        + getId(): UserId
    }

    class LibraryDM {
        - id: LibraryId
        - name: String
        - userId: UserId
        + id(): LibraryId
        + name(): String
        + userId(): UserId
    }

    Rectangle Database {
    }
}

' ── Relationships ──────────────────────────────────────────
UI "1" ..> "1" LibraryRESTController : uses

LibraryRESTController "1" ..> "1" LibraryService : uses
LibraryRESTController "1" ..> "1" LibraryMapper : uses
LibraryRESTController "1" ..> "1" LibraryLinkProvider : uses
LibraryRESTController ..> RequestLibraryDTO : receives
LibraryRESTController ..> ResponseLibraryDTO : returns

LibraryService "1" ..> "1" IUserRepository : uses
LibraryService "1" ..> "1" ILibraryPolicy : uses
LibraryService "1" ..> "1" LibraryFactory : uses
LibraryService "1" ..> "1" ILibraryRepository : uses

LibraryMapper ..> Library : maps
LibraryMapper ..> ResponseLibraryDTO : creates

IUserRepository <|.. UserRepositoryJPAImpl : implements
IUserRepositoryJPA <.. UserRepositoryJPAImpl : uses

ILibraryRepository <|.. LibraryRepositoryJPAImpl : implements
ILibraryRepositoryJPA <.. LibraryRepositoryJPAImpl : uses

LibraryRepositoryJPAImpl "1" ..> "1" LibraryAssembler : uses
LibraryRepositoryJPAImpl "1" ..> "1" LibraryFactory : uses

LibraryAssembler "1" ..> "1" LibraryDM : creates
LibraryAssembler "1" ..> "1" Library : creates
LibraryAssembler "1" ..> "1" LibraryFactory : uses

LibraryFactory "1" ..> "1" Library : creates

IUserRepositoryJPA "1" ..> "0..1" UserDM : retrieves
IUserRepositoryJPA "1" ...> "1" Database : queries
ILibraryRepositoryJPA "1" ...> "1" Database : queries

@enduml