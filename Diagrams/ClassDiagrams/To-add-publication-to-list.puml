@startuml
title Class Diagram - Add Publication to Collection Of Publication

skinparam packageStyle rectangle
left to right direction

' =========================
' APPLICATION LAYER
' =========================
package "Application" {

class "ToAddPublicationToA\nListOfMineController" as Controller {
  +getUserCollections(userId:UserId) : List<US018CollectionOfPublicationsDTO>
  +getPublicationsForCollection(userId:UserId, \ncollectionId:CollectionOfPublicationsId) : List<US018PublicationSampleDTO>
  +addPublicationToCollection(collectionId:CollectionOfPublicationsId, \npublicationSampleIds:List<PublicationSampleId>) : boolean
}

}

' =========================
' DOMAIN LAYER
' =========================
package "Domain" {

class CollectionOfPublications {
  -id: CollectionOfPublicationsId
  -collectionName: String
  -genreId: GenreId
  -ownerId: UserId
  -private: boolean
}

class PublicationSample {
  -id: PublicationSampleId
  -bibliographicalDataId: BibliographicalDataID
  -ownerId: UserId
  -publicationStatus: PublicationStatus
  -editionId: EditionID
  -condition: Condition

  +addPublicationToCollection(collectionId:CollectionOfPublicationsId) : PublicationSample
}

class BibliographicalData {
  -id: BibliographicalDataID
  -title: String
  -authors: List<AuthorId>
  -originalLanguage Locale
  -publicationDate LocalDate
  -genres List<GenreId>
  -chunksOfText String
}

class CollectionOfPublicationsFactory {
  +create(collectionId:CollectionOfPublicationsId,\ncollectionName:String, genreId:GenreId,\nownerId:UserId, private:boolean) : CollectionOfPublications
}

class PublicationSampleFactory {
  +create(pubSampleId:PublicationSampleId,\nbibliographicalDataId:BibliographicalDataID,\nuserId:UserId, publicationStatus:PublicationStatus,\neditionId:EditionID, condition:Condition) : PublicationSample
}

class BibliographicalDataFactory {
  +create(id: BibliographicalDataID, title: String, authors: List<AuthorId>, originalLanguage Locale, \npublicationDate LocalDate, genres List<GenreId>, chunksOfText String) : BibliographicalData
}

interface ICollectionOfPublicationsRepository {
  +getUserCollections(userId:UserId) : List<CollectionOfPublications>
}

interface IPublicationSampleRepository {
  +assignPublicationToCollection(collectionId:CollectionOfPublicationsId,\npublicationSampleIds:List<PublicationSampleId>) : boolean
  +findAvailableForCollection(userId:UserId,\ncollectionId:CollectionOfPublicationsId) : List<PublicationSample>
  +findById(publicationSampleId:PublicationSampleId) : Optional<PublicationSample>
  +update(publicationSample:PublicationSample) : PublicationSample
}

interface IBibliographicalDataRepository {
  +findById(id:BibliographicalDataID) : Optional<BibliographicalData>
}

CollectionOfPublications "1" --> "*" PublicationSample : contains >
PublicationSample "*" --> "1" BibliographicalData : references >

CollectionOfPublicationsFactory ..> CollectionOfPublications : creates >
PublicationSampleFactory ..> PublicationSample : creates >
BibliographicalDataFactory ..> BibliographicalData : creates >

Controller ..> ICollectionOfPublicationsRepository : retrieves >
Controller ..> IPublicationSampleRepository : retrieves >
Controller ..> IBibliographicalDataRepository : retrieves >

}

' =========================
' DTO LAYER
' =========================
package "DTO" {

class CollectionOfPublicationsDTO {
  -id: CollectionOfPublicationsId
  -collectionName: String
}

class PublicationSampleDTO {
  -id: PublicationSampleId
  -title: String
}

class US018CollectionOfPublicationsMapper {
  +toDTO(collection:CollectionOfPublications) : US018CollectionOfPublicationsDTO
  +toDTOs(collections:List<CollectionOfPublications>) : List<US018CollectionOfPublicationsDTO>
}

class PublicationSampleMapper {
  +toDTO(publicationSample:PublicationSample) : US018PublicationSampleDTO
  +toDTOs(publicationSamples:List<PublicationSample>) : List<US018PublicationSampleDTO>
}

US018CollectionOfPublicationsMapper ..> CollectionOfPublications : converts >
US018CollectionOfPublicationsMapper ..> CollectionOfPublicationsDTO : creates >

PublicationSampleMapper ..> PublicationSample : converts >
PublicationSampleMapper ..> PublicationSampleDTO : creates >

Controller ..> US018CollectionOfPublicationsMapper : maps >
Controller ..> PublicationSampleMapper : maps >
}

' =========================
' PERSISTENCE LAYER
' =========================
package "Persistence" {

class CollectionOfPublicationsDM
class PublicationSampleDM
class BibliographicalDataDM

class CollectionOfPublicationsAssembler {
  +toDomain(dm:CollectionOfPublicationsDM) : CollectionOfPublications
  +toDomainList(dmList:List<CollectionOfPublicationsDM>) : List<CollectionOfPublications>
}

class PublicationSampleAssembler {
  +toDM(publicationSample:PublicationSample) : PublicationSampleDM
  +toDomain(dm:PublicationSampleDM) : PublicationSample
  +toDomainList(dmList:List<PublicationSampleDM>) : List<PublicationSample>
}

class BibliographicalDataAssembler {
  +toDomain(dm:BibliographicalDataDM) : BibliographicalData
}

interface ICollectionOfPublicationsRepositoryJPA
interface IPublicationSampleRepositoryJPA
interface IBibliographicalDataRepositoryJPA

CollectionOfPublicationsAssembler ...> CollectionOfPublicationsFactory : ask creation to >
CollectionOfPublicationsAssembler ...> CollectionOfPublicationsDM : converts >

PublicationSampleAssembler ...> PublicationSampleFactory : ask creation to >
PublicationSampleAssembler ...> PublicationSampleDM : converts >

BibliographicalDataAssembler ...> BibliographicalDataFactory : ask creation to >
BibliographicalDataAssembler ...> BibliographicalDataDM : converts >

ICollectionOfPublicationsRepositoryJPA --> CollectionOfPublicationsDM : persists >
IPublicationSampleRepositoryJPA --> PublicationSampleDM : persists >
IBibliographicalDataRepositoryJPA --> BibliographicalDataDM : persists >
}

' =========================
' CROSS LAYER
' =========================

ICollectionOfPublicationsRepository <|.. ICollectionOfPublicationsRepositoryJPA : implements <
IPublicationSampleRepository <|.. IPublicationSampleRepositoryJPA : implements <
IBibliographicalDataRepository <|.. IBibliographicalDataRepositoryJPA : implements <

@enduml