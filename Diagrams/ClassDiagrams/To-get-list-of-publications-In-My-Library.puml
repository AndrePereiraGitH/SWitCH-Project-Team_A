@startuml
title As a User, I want to get the list of publications in my library

' ─────────────────────────────────────────
'  UI Layer
' ─────────────────────────────────────────
package "UI" {
    class UI {
    }
}

' ─────────────────────────────────────────
'  Application Layer
' ─────────────────────────────────────────
package "Application" {
    class PublicationSampleRESTController {
        + findPublicationsInLibrary(userId: String): ResponseEntity<List<PublicationDTO>>
    }

    class PublicationSampleService {
        + findPublicationsInLibrary(userId: UserId): List<PublicationSample>
    }

    class PublicationSampleMapper {
        + toUserId(userId: String): UserId
        + toPublicationDTO(pbSample: PublicationSample, bd: BibliographicalData, edition: Edition, authors: List<Author>, genres: List<Genre>, owner: User): PublicationDTO
    }

    class PublicationSampleLinkProvider {
        + getPublicLinks(): List<Link>
        + getLibraryLinks(userId: UserId): List<Link>
    }

    class PublicationDTO {
    }
}

' ─────────────────────────────────────────
'  Domain Layer
' ─────────────────────────────────────────
package "Domain" {
    interface IUserRepository {
        + findByID(userId: UserId): Optional<User>
    }

    interface IPublicationSampleRepository {
        + findPublicationsInLibrary(userId: UserId): List<PublicationSample>
    }

    interface IPublicationSampleAuthorizationPolicy {
        + canFindPublicationsInLibrary(user: User): boolean
    }

    class PublicationSample {
        + getBibliographicalDataID(): BibliographicalDataId
        + getEditionID(): EditionId
        + getOwnerID(): UserId
        + id(): PublicationSampleId
    }

    class User {
    }
}

' ─────────────────────────────────────────
'  Persistence Layer
' ─────────────────────────────────────────
package "Persistence" {
    class UserRepositoryJpaImpl {
    }

    class PublicationSampleRepositoryJpaImpl {
    }

    interface IUserRepositoryJPA {
        + findByUserName(username: String): Optional<UserDM>
    }

    interface IPublicationSampleRepositoryJpa {
        + findAllByOwnerId(userId: UserId): List<PublicationSampleDM>
    }

    class PublicationSampleAssembler {
        + toDomain(publicationSampleDM: PublicationSampleDM): PublicationSample
    }

    class PublicationSampleFactory <<factory>> {
        + create(id: PublicationSampleId, bibliographicalDataId: BibliographicalDataId, ownerId: UserId, editionId: EditionId, libraryId: LibraryId, collecOfPubId: CollecOfPubId, publicationStatus: PublicationStatus, condition: Condition): PublicationSample
    }

    class UserDM {
        + getId(): UserId
    }

    class PublicationSampleDM {
        + id(): PublicationSampleId
        + getBibliographicalDataID(): BibliographicalDataId
        + getOwnerID(): UserId
        + getEditionID(): EditionId
        + getLibraryID(): LibraryId
        + getCollecOfPubID(): CollecOfPubId
        + getPublicationStatus(): PublicationStatus
        + getCondition(): Condition
    }

    rectangle Database {
    }
}

' ─────────────────────────────────────────
'  Relationships
' ─────────────────────────────────────────
UI "1" ..> "1" PublicationSampleRESTController : uses

PublicationSampleRESTController "1" ..> "1" PublicationSampleService : uses
PublicationSampleRESTController "1" ..> "1" PublicationSampleMapper : uses
PublicationSampleRESTController "1" ..> "1" PublicationSampleLinkProvider : uses
PublicationSampleRESTController ..> PublicationDTO : returns

PublicationSampleService "1" ..> "1" IUserRepository : uses
PublicationSampleService "1" ..> "1" IPublicationSampleAuthorizationPolicy : uses
PublicationSampleService "1" ..> "1" IPublicationSampleRepository : uses

PublicationSampleMapper ..> PublicationSample : reads
PublicationSampleMapper ..> PublicationDTO : creates

IUserRepository <|.. UserRepositoryJpaImpl : implements
IUserRepositoryJPA <.. UserRepositoryJpaImpl : uses
IUserRepositoryJPA "1" ..> "0..1" UserDM : returns
IUserRepositoryJPA "1" ..> "1" Database : queries

IPublicationSampleRepository <|.. PublicationSampleRepositoryJpaImpl : implements
IPublicationSampleRepositoryJpa <.. PublicationSampleRepositoryJpaImpl : uses
PublicationSampleRepositoryJpaImpl "1" ..> "1" PublicationSampleAssembler : uses

IPublicationSampleRepositoryJpa "1" ..> "0..*" PublicationSampleDM : returns
IPublicationSampleRepositoryJpa "1" ...> "1" Database : queries

PublicationSampleAssembler "1" ..> "1" PublicationSampleDM : reads
PublicationSampleAssembler "1" ..> "1" PublicationSampleFactory : uses
PublicationSampleFactory "1" ..> "1" PublicationSample : creates

@enduml