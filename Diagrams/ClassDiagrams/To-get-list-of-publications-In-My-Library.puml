@startuml
title As a User, I want to get the list of publications in my library

' ─────────────────────────────────────────
'  Presentation layer
' ─────────────────────────────────────────
class UI {
}

' ─────────────────────────────────────────
'  Controller
' ─────────────────────────────────────────
class ToGetListOfPublicationsInLibraryController {
    + getListOfPublicationsInLibrary(username: String): List<US012PublicationDetailsDTO>
}

' ─────────────────────────────────────────
'  User side
' ─────────────────────────────────────────
interface IUserRepository {
    + findUserIdByUsername(username: String): Optional<UserId>
}

interface IUserRepositoryJPA {
    + findByUserName(username: String): Optional<UserDM>
}

class UserDM {
    + getId(): UserId
}

class UserId {
}

' ─────────────────────────────────────────
'  Publication side
' ─────────────────────────────────────────
interface IPublicationSampleRepository {
    + findByUserIdAndLibraryIdIsNotNull(userId: UserId): List<PublicationSample>
}

interface IPublicationSampleRepositoryJpa {
    + findAllByOwnerId(userId: UserId): List<PublicationSampleDM>
}

class PublicationSampleAssembler {
    + toDomain(publicationSampleDM: PublicationSampleDM): PublicationSample
}

class PublicationSampleFactory <<factory>> {
    + create(id: PublicationSampleId, bibliographicalDataId: BibliographicalDataId, ownerId: UserId, editionId: EditionId, libraryId: LibraryId, collecOfPubId: CollecOfPubId, publicationStatus: PublicationStatus, condition: Condition): PublicationSample
}

class PublicationSample {
    + isInUserLibrary(): boolean
}

class PublicationSampleDM {
    + id(): PublicationSampleId
    + getBibliographicalDataID(): BibliographicalDataId
    + getOwnerID(): UserId
    + getEditionID(): EditionId
    + getLibraryID(): LibraryId
    + getCollecOfPubID(): CollecOfPubId
    + getPublicationStatus(): PublicationStatus
    + getCondition(): Condition
}

' ─────────────────────────────────────────
'  Mapper / DTO
' ─────────────────────────────────────────
class US012PublicationSampleMapper {
    + toDTOs(publications: List<PublicationSample>): List<US012PublicationDetailsDTO>
    + toDTO(publicationSample: PublicationSample): US012PublicationDetailsDTO
}

class US012PublicationDetailsDTO {
}

' ─────────────────────────────────────────
'  Database
' ─────────────────────────────────────────
rectangle Database {
}

' ─────────────────────────────────────────
'  Relationships
' ─────────────────────────────────────────

UI "1" ..> "1" ToGetListOfPublicationsInLibraryController : uses

ToGetListOfPublicationsInLibraryController "1" ..> "1" IUserRepository : uses
ToGetListOfPublicationsInLibraryController "1" ..> "1" IPublicationSampleRepository : uses
ToGetListOfPublicationsInLibraryController "1" ..> "1" US012PublicationSampleMapper : uses

IUserRepositoryJPA ..|> IUserRepository : implements
IUserRepositoryJPA "1" ..> "0..1" UserDM : returns
IUserRepositoryJPA "1" ..> "1" Database : queries

IUserRepository "1" ..> "0..1" UserDM : reads
IUserRepository "1" ..> "0..1" UserId : returns

IPublicationSampleRepositoryJpa ..|> IPublicationSampleRepository : implements
IPublicationSampleRepository "1" ..> "1" PublicationSampleAssembler : uses
IPublicationSampleRepository "1" ..> "0..*" PublicationSample : filters

IPublicationSampleRepositoryJpa "1" ..> "0..*" PublicationSampleDM : returns
IPublicationSampleRepositoryJpa "1" ..> "1" Database : queries

PublicationSampleAssembler "1" ..> "1" PublicationSampleDM : reads
PublicationSampleAssembler "1" ..> "1" PublicationSampleFactory : uses
PublicationSampleFactory "1" ..> "1" PublicationSample : creates

US012PublicationSampleMapper "1" ..> "0..*" PublicationSample : reads
US012PublicationSampleMapper "1" ..> "0..*" US012PublicationDetailsDTO : creates

@enduml