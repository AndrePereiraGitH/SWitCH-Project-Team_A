@startuml
title As a User, I want to get the list (title, author, type and ISBN/SSN) of publications in my library

' ─────────────────────────────────────────
'  Presentation layer
' ─────────────────────────────────────────
class UI {
}

' ─────────────────────────────────────────
'  Controller
' ─────────────────────────────────────────
class GetListOfPublicationsInLibraryController {
    + getListOfPublicationsInLibrary(username: String): List<US012PublicationDetailsDTO>
}

' ─────────────────────────────────────────
'  User side
' ─────────────────────────────────────────
interface IUserRepository {
    + findUserIdByUsername(username: String): Optional<UserId>
}

interface IUserRepositoryJPA {
    + findByUserName(username: String): Optional<UserDM>
}

class UserDM {
    + getId(): UserId
}

' ─────────────────────────────────────────
'  Publication side
' ─────────────────────────────────────────
interface IPublicationSampleRepository {
    + findByUserIdAndLibraryIdIsNotNull(userId: UserId): List<PublicationSample>
}

interface IPublicationSampleRepositoryJpa {
    + findAllByOwnerId(userId: UserId): List<PublicationSampleDM>
}

class PublicationSampleAssembler {
    + toDomain(publicationSampleDM: PublicationSampleDM): PublicationSample
}

class PublicationSample {
    + isOwnedByUser(userId: UserId): boolean
    + isInUserLibrary(): boolean
}

class PublicationSampleDM {
}

' ─────────────────────────────────────────
'  Mapper / DTO
' ─────────────────────────────────────────
class US012PublicationSampleMapper {
    + toDTOs(publications: List<PublicationSample>): List<US012PublicationDetailsDTO>
    + toDTO(publicationSample: PublicationSample): US012PublicationDetailsDTO
}

class US012PublicationDetailsDTO {
}

' ─────────────────────────────────────────
'  Database
' ─────────────────────────────────────────
rectangle Database {
}

' ─────────────────────────────────────────
'  Relationships
' ─────────────────────────────────────────

UI ..> GetListOfPublicationsInLibraryController: uses

GetListOfPublicationsInLibraryController ..> IUserRepository: uses
GetListOfPublicationsInLibraryController ..> IPublicationSampleRepository: uses
GetListOfPublicationsInLibraryController ..> US012PublicationSampleMapper: uses

IUserRepository <|.. IUserRepositoryJPA: implements
IUserRepositoryJPA ..> UserDM: returns
IUserRepositoryJPA ..> Database: queries

IPublicationSampleRepository <|.. IPublicationSampleRepositoryJpa: implements
IPublicationSampleRepository ..> PublicationSampleAssembler: uses

IPublicationSampleRepositoryJpa ..> PublicationSampleDM: returns
IPublicationSampleRepositoryJpa ..> Database: queries

PublicationSampleAssembler ..> PublicationSampleDM: reads
PublicationSampleAssembler ..> PublicationSample: creates

US012PublicationSampleMapper ..> PublicationSample: reads
US012PublicationSampleMapper ..> US012PublicationDetailsDTO: creates

@enduml