@startuml
title US003 - Register Genre to Official Genre List

class RegisterGenreController {
  -_genreRepository: GenreRepository
  +createAndAddGenre(name: String): Genre
}

class GenreRepository {
  -_genres: List<Genre>
  +createAndAddGenre(name: String): Genre
  -existsByName(name: String): boolean
}

class Genre {
  -_name: String
  +getName(): String
}

RegisterGenreController --> GenreRepository : uses >
GenreRepository "1" --> "*" Genre : stores >

@enduml
