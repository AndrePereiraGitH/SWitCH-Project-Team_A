@startuml
title US003 - Register Genre to Official Genre List

class ToRegisterGenreController {
  -_genreRepository: GenreRepository
  +registerGenre(name: String): Genre
}

class GenreRepository {
  -_genres: List<Genre>
  +createAndAddGenre(name: String): Genre
  -exists(name: String): boolean
}

class Genre {
  -_name: String
  +getName(): String
}


ToRegisterGenreController "1" -.-> "1" GenreRepository : uses
GenreRepository "1" --> "*" Genre : stores
GenreRepository "1" --> "*" Genre : creates


@enduml
