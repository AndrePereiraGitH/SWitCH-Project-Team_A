@startuml
title To put for sale a publication in my library in a direct sale (REST)

skinparam linetype ortho

package "infrastructure/ persistence" {
    package "routes" {
        class Routes {
            + /publicationSamples/available-for-sale : GET, OPTIONS
            + /listings : POST, GET, OPTIONS
        }
    }
    package "user" {
        interface IUserRepositoryJPA {
            + findById(String userId): Optional<UserDM>
        }
        class UserDM {
            - userId: String
            - name: String
            - email: String
            - role: String
        }
    }
    package "publicationsample" {
        interface IPublicationSampleRepositoryJPA {
            + findAvailableForSaleByUserId(String userId): List<PublicationSampleDM>
        }
        class PublicationSampleDM {
            - publicationSampleId: String
            - bibliographicalDataId: String
            - ownerId: String
            - publicationStatus: String
            - editionId: String
            - condition: String
            - libraryId: String
        }
    }
    package "listing" {
        interface IListingRepositoryJPA {
            + save(ListingDM listingDM): ListingDM
        }
        class ListingDM {
            - listingId: String
            - listingTitle: String
            - publicationSampleIds: String
            - saleType: String
            - price: String
            - shortDescription: String
            - sellerId: String
            - pictures: String
        }
    }
}

package "adapters" {
    package "controller" {
        class PublicationSampleRESTController {
            + optionsAvailableForSale(): ResponseEntity
            + findAvailableForSale(String userId): ResponseEntity
        }
        class ListingRESTController {
            + optionsRoot(): ResponseEntity
            + createDirectSaleListing(String title, List<String> selectedPublicationIds,\nString saleType, String price, String shortDescription,\nString userId, List<String> pictures): ResponseEntity
        }
    }
    package "mapper" {
        class PublicationSampleMapper {
            + toUserId(String userId): UserId
            + toPublicationSampleDTO(PublicationSample pubSample, BibliographicalData bd,\nEdition edition, List<Author> authors, List<Genre> genres, User owner): PublicationSampleDTO
        }
        class ListingMapper {
            + toUserId(String userId): UserId
            + toPublicationId(String id): PublicationSampleId
            + toSaleType(String saleType): SaleType
            + toPrice(String price): Price
            + toPicture(String picture): Picture
            + toListingDTO(Listing listing): ListingDTO
        }
    }
    package "dto" {
        record PublicationSampleDTO {
            - pubTitle: String
            - authorName: List<String>
            - code: String
            - publicationType: String
        }
        record ListingDTO {
            - listingId: String
            - listingTitle: String
            - saleType: String
            - price: String
            - shortDescription: String
            - sellerId: String
        }
    }
    package "linkprovider" {
        class PublicationSampleLinkProvider {
            + getPublicLinks(): List<Link>
            + getDirectSaleLinks(UserId userId): List<Link>
        }
        class ListingLinkProvider {
            + getPublicLinks(): List<Link>
            + getListingLinks(ListingId listingId): List<Link>
        }
    }
    package "user" {
        class UserRepositoryJPAImpl {
            + findByID(UserId userId): Optional<User>
        }
        class UserAssembler {
            + toDomain(UserDM userDM): User
        }
    }
    package "publicationsample" {
        class PublicationSampleRepositoryJPAImpl {
            + findAvailableForSaleByUserId(UserId userId): List<PublicationSample>
        }
        class PublicationSampleAssembler {
            + toDomain(PublicationSampleDM pubSampleDM): PublicationSample
        }
    }
    package "listing" {
        class ListingRepositoryJPAImpl {
            + save(ListingDM listingDM): ListingDM
        }
        class ListingAssembler {
            + toDM(Listing listing): ListingDM
            + toDomain(ListingDM listingDM): Listing
        }
    }
}

package "application" {
    class PublicationSampleService {
        + findAvailableForSale(UserId userId): List<PublicationSample>
    }
    class ListingService {
        + createAndSave(String title, List<PublicationSampleId> selectedPublicationIds,\nSaleType saleType, Price price, String shortDescription,\nUserId userId, List<Picture> pictures): Listing
    }
    class BibliographicalDataService {
        + findById(BibliographicalDataId id): BibliographicalData
    }
    class EditionService {
        + findById(EditionId id): Edition
    }
    class AuthorService {
        + findById(AuthorId id): Author
    }
    class GenreService {
        + findById(GenreId id): Genre
    }
    class UserService {
        + findByID(UserId id): User
    }
    class PublicationSampleAuthorizationPolicy {
        + canFindAvailableForSale(User user): boolean
    }
    class ListingAuthorizationPolicy {
        + canCreateListing(User user): boolean
    }
}

package "domain" {
    package "user" {
        interface IUserRepository {
            + findByID(UserId userId): Optional<User>
        }
        class UserFactory {
            + create(UserId userId, String name, String email, String role): User
        }
        class User {
            - userId: UserId
            - name: String
            - email: String
            - role: String
        }
    }
    package "publicationsample" {
        interface IPublicationSampleRepository {
            + findAvailableForSaleByUserId(UserId userId): List<PublicationSample>
        }
        class PublicationSampleFactory {
            + create(PublicationSampleId pubSampleId, BibliographicalDataId bdId,\nUserId userId, PublicationStatus pubStatus,\nEditionId editionId, Condition condition): PublicationSample
        }
        class PublicationSample {
            - publicationSampleId: PublicationSampleId
            - bibliographicalDataId: BibliographicalDataId
            - ownerId: UserId
            - publicationStatus: PublicationStatus
            - editionId: EditionId
            - condition: Condition
            - libraryId: LibraryId
        }
    }
    package "listing" {
        interface IListingRepository {
            + save(Listing listing): Listing
        }
        class ListingFactory {
            + create(String title, List<PublicationSampleId> selectedPublicationIds,\nSaleType saleType, Price price, String shortDescription,\nUserId userId, List<Picture> pictures): Listing
        }
        class Listing {
            - listingId: ListingId
            - listingTitle: String
            - publicationSampleIds: List<PublicationSampleId>
            - saleType: SaleType
            - price: Price
            - shortDescription: String
            - sellerId: UserId
            - pictures: List<Picture>
        }
    }
}

' --- Controllers ---
PublicationSampleRESTController ..> PublicationSampleMapper : "uses"
PublicationSampleRESTController --> PublicationSampleService : "uses"
PublicationSampleRESTController --> PublicationSampleAuthorizationPolicy : "uses"
PublicationSampleRESTController --> PublicationSampleLinkProvider : "uses"
PublicationSampleRESTController ..> BibliographicalDataService : "uses"
PublicationSampleRESTController ..> EditionService : "uses"
PublicationSampleRESTController ..> AuthorService : "uses"
PublicationSampleRESTController ..> GenreService : "uses"
PublicationSampleRESTController ..> UserService : "uses"
ListingRESTController ..> ListingMapper : "uses"
ListingRESTController --> ListingService : "uses"
ListingRESTController --> ListingAuthorizationPolicy : "uses"
ListingRESTController --> ListingLinkProvider : "uses"

' --- Mappers ---
PublicationSampleMapper ..> PublicationSampleDTO : "creates"
ListingMapper ..> ListingDTO : "creates"

' --- Application ---
PublicationSampleService --> IUserRepository : "uses"
PublicationSampleService --> PublicationSampleAuthorizationPolicy : "uses"
PublicationSampleService --> IPublicationSampleRepository : "uses"
ListingService --> IUserRepository : "uses"
ListingService --> ListingAuthorizationPolicy : "uses"
ListingService --> ListingFactory : "uses"
ListingService --> IListingRepository : "uses"

' --- User persistence ---
UserRepositoryJPAImpl ..|> IUserRepository : "implements"
UserRepositoryJPAImpl ..> IUserRepositoryJPA : "uses"
UserRepositoryJPAImpl ..> UserAssembler : "uses"
UserAssembler --> UserFactory : "uses"
UserAssembler ..> UserDM : "receives"
UserFactory ..> User : "creates"

' --- PublicationSample persistence ---
PublicationSampleRepositoryJPAImpl ..|> IPublicationSampleRepository : "implements"
PublicationSampleRepositoryJPAImpl ..> IPublicationSampleRepositoryJPA : "uses"
PublicationSampleRepositoryJPAImpl ..> PublicationSampleAssembler : "uses"
PublicationSampleAssembler --> PublicationSampleFactory : "uses"
PublicationSampleAssembler ..> PublicationSampleDM : "receives"
PublicationSampleFactory ..> PublicationSample : "creates"

' --- Listing persistence ---
ListingRepositoryJPAImpl ..|> IListingRepository : "implements"
ListingRepositoryJPAImpl ..> IListingRepositoryJPA : "uses"
ListingRepositoryJPAImpl ..> ListingAssembler : "uses"
ListingAssembler --> ListingFactory : "uses"
ListingAssembler ..> ListingDM : "receives"
ListingFactory ..> Listing : "creates"

@enduml
