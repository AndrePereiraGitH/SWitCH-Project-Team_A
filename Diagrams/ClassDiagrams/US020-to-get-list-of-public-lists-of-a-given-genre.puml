@startuml
skinparam classAttributeIconSize 0

title US020 - Public Lists by Genre (using DTOs)

class US020_PublicListByGenreController {
  - _genreRepository : GenreRepository
  - _collectionRepo : CollectionOfPublicationsRepository
  + getGenres() : List<Genre>
  + getPublicListsByGenre(genre : Genre) : List<CollectionOfPublicationsDTO>
}

class GenreRepository {
  + getAllGenres() : List<Genre>
}

class CollectionOfPublicationsRepository {
  + findPublicByGenre(genre : Genre) : List<CollectionOfPublicationsDTO>
}

class Genre {
  - _genreType : String
}

class User {
  - _userName : String
}

class CollectionOfPublications {
  - _collectionName : String
  - _isPrivate : boolean
  - _collectionGenre : Genre
  - _ownerUserName : String
  - _collectionOfPublications : List<Publication>
  + getCollectionGenre() : Genre
  + getCollectionName() : String
  + getIsPrivate() : boolean
  + getOwner() : String
}

class CollectionOfPublicationsDTO {
  - listName : String
  - ownerUsername : String
}

US020_PublicListByGenreController --> GenreRepository : queries
US020_PublicListByGenreController --> CollectionOfPublicationsRepository : queries

CollectionOfPublicationsRepository --> CollectionOfPublications : reads
CollectionOfPublicationsRepository ..> CollectionOfPublicationsDTO : creates

CollectionOfPublications "0..*" --> "1" Genre : has
CollectionOfPublications "0..*" --> "1" User : owned by

US020_PublicListByGenreController ..> CollectionOfPublicationsDTO : returns

@enduml
