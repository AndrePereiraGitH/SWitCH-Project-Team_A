@startuml
skinparam classAttributeIconSize 0

title US020 - Class Diagram (matches updated sequence)

class PublicListController {
  -genreRepository : GenreRepository
  -listRepository : ListRepository
  +getGenres() : List<Genre>
  +getPublicListsByGenre(genreId : String) : List<ListSummary>
}

class GenreRepository {
  +findAll() : List<Genre>
}

class ListRepository {
  +findPublicByGenre(genreId : String) : List<ListSummary>
}

class Genre {
  -name : String
}

class User {
  -username : String
}

class List {
  -name : String
  -isPublic : boolean
  -genre : Genre
  -owner : User
}

class ListSummary {
  +listName : String
  +ownerUsername : String
}

PublicListController --> GenreRepository : searches
PublicListController --> ListRepository : searches

ListRepository --> List : contains

List "0..*" --> "1" Genre : has
List "0..*" --> "1" User : owner

PublicListController ..> ListSummary : returns


@enduml
