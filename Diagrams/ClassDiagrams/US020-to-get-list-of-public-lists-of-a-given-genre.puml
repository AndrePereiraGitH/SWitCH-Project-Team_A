@startuml
skinparam classAttributeIconSize 0

title US020 - As a user, I want to get a list (name and user) of the publicly published lists of a given genre

class PublicListController {
  -listRepo : ListRepo
  -genreRepo : GenreRepo
  +getGenres() : List<Genre>
  +getPublicListsByGenre(genreId : String) : List<ListSummary>
}

class ListRepo {
  +findPublicByGenre(genreId) : List<List>
}

class GenreRepo {
  +findAll() : List<Genre>
}

class List {
  -name : String
  -isPublic : boolean
  -genre : Genre
  -owner : User
}

class Genre {
  -name : String
}

class User {
  -username : String
}

class ListSummary {
  +listName : String
  +ownerUsername : String
}

PublicListController --> ListRepo : uses
PublicListController --> GenreRepo : uses

List "0..*" --> "1..*" Genre : genre
List "0..*" --> "1" User : owner
ListRepo "1" --> "*" List

PublicListController ..> ListSummary : returns

@enduml