@startuml
title US018 - Add Publication to List (Class Diagram)

package "UI" {
  class AddPublicationToListUI
}

package "Controller" {
  class AddPublicationToListController {
    +getMyPublicationLists(user)
    +getPublicationsForList(user, list)
    +addPublicationToList(list, publication)
  }
}

package "Persistence" {
  class PublicationListRepository {
    +getMyPublicationLists(user)
    +getPublications(list)
    +addPublicationToList(list, publication)
  }

  class LibraryRepository {
    +getLibrary(user)
  }
}

package "Domain" {
  class Library {
    +getPublications()
  }

  class PublicationList {
    +addPublication(publication)
  }

  class Publication
  class User
}

AddPublicationToListUI --> AddPublicationToListController : sends requests

AddPublicationToListController --> PublicationListRepository : queries / updates
AddPublicationToListController --> LibraryRepository : queries

LibraryRepository --> Library : returns
PublicationListRepository --> PublicationList : manages

Library "1  " o-- "*" Publication : contains
PublicationList "  1" o-- "*" Publication : contains
PublicationList "*" --> "    1" User : owner

@enduml
