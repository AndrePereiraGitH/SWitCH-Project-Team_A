@startuml
title US018 – Add Publication to List

package "UI" {
  class AddPublicationToListUI
}

package "Controller" {
    class AddPublicationToListController {
      +requestUserLists(user)
      +requestAvailablePublications(list, user)
      +addPublicationToList(publication, list, user)
    }
}

package "Domain" {
  class PublicationList {
    -name
    -isPublic
    -owner
    -genre
    +addPublication(publication)
    +getAvailablePublications(userPublications)
  }

  class Publication
  class User
}

package "Persistence" {
  class PublicationListRepository {
     +findListsByUser(user)
     +save(list)
  }

  class PublicationRepository {
    +findPublicationsByUser(user)
  }
}

AddPublicationToListUI --> AddPublicationToListController : requests
AddPublicationToListController --> PublicationList : adds to
AddPublicationToListController --> PublicationListRepository : acesses/ saves
AddPublicationToListController --> PublicationRepository : accesses

PublicationList --> Publication : contains
PublicationList --> User : owner

note right of PublicationList
  - Only publications of the user
    can be added
  - Validation is done inside
    the domain
end note

@enduml
