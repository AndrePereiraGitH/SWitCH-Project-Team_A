@startuml
title US018 - Add Publication to Collection Of Publications

' ======================
' Domain
' ======================

class User {
  -id
  -username
}

class Publication {
  -id
  -title
}

class CollectionOfPublications {
  -name : String
  -isPrivate : boolean
  +getPublications() : List<Publication>
  +addPublication(publication : Publication)
}

class Library {
  +getPublications() : List<Publication>
}

User "1" --> "*" CollectionOfPublications : owns
CollectionOfPublications "1" --> "*" Publication : contains
User "1" --> "1" Library : owns

' ======================
' Application
' ======================

class AddCollectionOfPublicationsController {
  +getUserCollections(user : User) : List<CollectionOfPublications>
  +addPublicationToCollection(collection : CollectionOfPublications, publication : Publication)
}

' ======================
' Persistence
' ======================

class CollectionOfPublicationsRepository {
  +getUserCollections(user : User) : List<CollectionOfPublications>
  +addPublicationToCollection(collection : CollectionOfPublications, publication : Publication)
}

class LibraryRepository {
  +getLibrary(user : User) : Library
}

' ======================
' Dependencies (from SSD)
' ======================

AddCollectionOfPublicationsController ..> CollectionOfPublicationsRepository : uses
AddCollectionOfPublicationsController ..> LibraryRepository : uses
CollectionOfPublicationsRepository ..> CollectionOfPublications : uses

@enduml
