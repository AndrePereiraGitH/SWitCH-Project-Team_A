@startuml
title US018 - Add Publication to List

package "Controller" {
  class AddPublicationToListController {
    +getMyPublicationLists()
    +getPublicationsForList()
    +addPublicationToList()
  }
}

package "Persistence" {
  class PublicationListRepository {
    +getMyPublicationLists()
    +getPublications()
    +addPublicationToList()
  }

  class LibraryRepository {
    +getLibrary()
  }
}

package "Domain" {
  class Library {
    +getPublications()
  }

  class PublicationList {
    +addPublication()
  }

  class Publication
  class User
}

AddPublicationToListController --> PublicationListRepository : uses
AddPublicationToListController --> LibraryRepository : uses

LibraryRepository --> Library : gets
PublicationListRepository --> PublicationList : updates

Library " 1" o-- "            *" Publication : contains
PublicationList "1   " o-- " *" Publication : contains
PublicationList " *" --> "    1" User :  belongs to
Library "1  " --> "1 " User :  belongs to


@enduml
