@startuml
title US018 - Add Publication to Collection Of Publications

' ======================
' Controller
' ======================

class AddCollectionOfPublicationsController {
    +getUserCollections(user)
    +getPublicationsForCollection(selectedCollectionDTO)
    +addPublicationToCollection(collectionSelectedDTO, selectedPublicationDTO)
    -diff(allUserPublications, publicationsInCollection)
}

' ======================
' Repository
' ======================

class CollectionOfPublicationsRepository {
    +getUserCollections(user)
    +collectionDTOToDomain(selectedCollectionDTO)
    +CollectionDTOToDomain(selectedCollectionDTO)
    +addPublicationToCollection(userCollection, publicationSample)
    -isFromUser()
}

class PublicationSampleRepository {
    +PublicationSampleDtoToDomain(userLibrary, selectedPublicationDTO)
}


' ======================
' DTO
' ======================

class CollectionOfPublicationsDTO {
    +createDTO(collectionName)
    +collectionOfPublicationToDTO(userCollections)
}

class PublicationSampleDTO {
    +publicationToDTO(publicationAvailable)
}

' ======================
' Domain
' ======================

class User {
  - username : String
  - library : Library
  - collections : List<CollectionOfPublications>
  + getLibrary() : Library
  + getCollections() : List<CollectionOfPublications>
}


class CollectionOfPublications {
  - name : String
  - publications : List<Publication>

    +getCollectionName()
    +getPublications(userCollectionSelected)
}

class Library {
  - publicationSample : List<PublicationSample>
    + getLibrary (user)
    + getPublications(userLibrary) : List<PublicationSample>

}

class PublicationSample {
    +getBibliographicalData()
}

class BibliographicalData


' ======================
' Associations
' ======================

AddCollectionOfPublicationsController ..> CollectionOfPublicationsRepository
AddCollectionOfPublicationsController ..> CollectionOfPublicationsDTO
AddCollectionOfPublicationsController ..> PublicationSampleDTO
AddCollectionOfPublicationsController ..> PublicationSampleRepository
AddCollectionOfPublicationsController ..> Library
AddCollectionOfPublicationsController ..> CollectionOfPublications

CollectionOfPublicationsRepository "1" --> "*" CollectionOfPublications

CollectionOfPublicationsDTO ..> CollectionOfPublications

CollectionOfPublications "1" ..> "*" PublicationSample

Library "1" --> "*" PublicationSample

PublicationSampleDTO --> PublicationSample
PublicationSample "1" --> "1" BibliographicalData

@enduml
