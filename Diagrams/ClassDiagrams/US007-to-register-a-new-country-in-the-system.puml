}

' Interactions
CountryController "1" -- "1" CountryRepository : request registering country >
'/CountryRepository  --  CountryRepository : manage/store
'/User "1"--"1" CountryController : requests registration of new country >
CountryRepository "1" -- "*" Country : stores >
@enduml