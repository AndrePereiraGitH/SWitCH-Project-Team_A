@startuml
title Register a Publishing Company

' ── UI Layer ───────────────────────────────────────────────
class UI <<C>> {
}

' ── Controller Layer ───────────────────────────────────────
class ToRegisterNewPublisherController <<C>> {
  + registerPublisher(name: String, vatNumber: String, contact: Contact): boolean
}

' ── Application Layer ──────────────────────────────────────
class PublisherService <<C>> {
  + createAndSave(name: String, vatNumber: String, contact: Contact): Publisher
}

' ── Domain Layer ───────────────────────────────────────────
interface IPublisherRepository <<I>> {
  + save(publisher: Publisher): Publisher
  + existsById(id: PublisherID): boolean
  + findById(id: PublisherID): Optional<Publisher>
  + findAll(): List<Publisher>
}

class PublisherFactory <<C>> {
  + create(name: String, vatNumber: String, contact: Contact): Publisher
  + create(id: PublisherID, name: String, vatNumber: String, contact: Contact): Publisher
}

class Publisher <<C>> {
  - id: PublisherID
  - name: String
  - vatNumber: String
  - contact: Contact
  + id(): PublisherID
  + getName(): String
  + getVatNumber(): String
  + getContact(): Contact
}

' ── Infrastructure Layer ───────────────────────────────────
class PublisherRepositoryJpaImpl <<C>> {
  + save(publisher: Publisher): Publisher
  + existsById(id: PublisherID): boolean
  + findById(id: PublisherID): Optional<Publisher>
  + findAll(): List<Publisher>
}

class AutomaticGeneratedPublisherJPAImpl <<C>> {
}

interface IPublisherRepositoryJpa <<I>> {
  + existsById(id: PublisherID): boolean
  + save(dm: PublisherDM): PublisherDM
  + findById(id: PublisherID): Optional<PublisherDM>
}

class PublisherAssembler <<C>> {
  + toDM(publisher: Publisher): PublisherDM
  + toDomain(dm: PublisherDM): Publisher
}

class PublisherDM <<C>> {
  - id: PublisherID
  - name: String
  - vatNumber: String
  - contact: Contact
}

Rectangle Database {
}

' ── Relationships ──────────────────────────────────────────
UI "1" ..> "1" ToRegisterNewPublisherController : uses
ToRegisterNewPublisherController "1" ..> "1" PublisherService : uses

PublisherService "1" ..> "1" PublisherFactory : uses
PublisherService "1" ..> "1" IPublisherRepository : uses

IPublisherRepository <|.. PublisherRepositoryJpaImpl : implements
PublisherRepositoryJpaImpl "1" ..> "1" IPublisherRepositoryJpa : delegates to
PublisherRepositoryJpaImpl "1" ..> "1" PublisherAssembler : converts with

IPublisherRepositoryJpa <|.. AutomaticGeneratedPublisherJPAImpl : implements
AutomaticGeneratedPublisherJPAImpl "1" ..> "1" Database : queries

PublisherAssembler "1" ..> "1" PublisherDM : creates
PublisherAssembler "1" ..> "1" Publisher : creates
PublisherAssembler "1" ..> "1" PublisherFactory : uses

PublisherFactory "1" ..> "*" Publisher : creates

@enduml