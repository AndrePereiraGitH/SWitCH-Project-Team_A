@startuml
title To register a publishing company in the system

class US006ToRegisterNewPublisherController {
  -publisherRepository: PublisherRepository
  +registerPublisher(name: String, vatNumber: String, contact: Contact): boolean
}

class PublisherRepository {
  -publishers: List<Publisher>
  +create(name: String, vatNumber: String, contact: Contact)
  -isExistent()
  -publishers.add(publisher:Publisher)
}

class PublisherFactory {
  +create(name: String, vatNumber: String, contact: Contact)
}


class Publisher {
  -name: String
  -vatNumber: String
  -contact: Contact
}

US006ToRegisterNewPublisherController "1" ..> "1" PublisherRepository : requests registration to >
PublisherRepository "1" --> "1" PublisherFactory : uses >
PublisherFactory "1" ..> "*" Publisher : creates >
PublisherRepository "1" --> "*" Publisher : stores >


@enduml