@startuml
title US005 - Register Author in MIteLovers

class RegisterAuthorController {
  -_registerAuthorRepository: RegisterAuthorRepository
  +createAndAddAuthor(Profile profile, String biography): Author
}

class AuthorRepository {
  -_authors: List<Author>
  +createAndAddAuthor(profile: Profile, biography: String): Author
  -exists(author: Author): boolean
}

class Author {
  -_authorProfile: Profile
  -_biography: String
  +getProfile(): Profile
  +getBiography(): String
}

class Profile {
  -name: String
  -country: Country
  -birthday: LocalDate
  +getName(): String
  +getCountry(): Country
  +getBirthday(): LocalDate
}

RegisterAuthorController "1" -.-> "1" AuthorRepository : uses
AuthorRepository "1" --> "*" Author : stores
AuthorRepository "1" --> "*" Author : creates
Author "1" --> "1" Profile : has

@enduml
