@startuml
title US002 - To add a publication type in the system

'Need to create class

class RegisterPubTypeController {
  -_pubTypeRepo: PublicationTypeRepository
    +RegisterPubType(mediaFormat: Media Format, typeOfBinding: TypeOfBinding, details: String): PublicationType
}

class PublicationTypeRepository {
  -_publicationTypes: List<PublicationType>
  +createPublicationType(mediaFormat: Media Format, typeOfBinding: TypeOfBinding, details: String): PublicationType
  +validatePublicationType(pubType: PublicationType): boolean
  +addToList(pubType: PublicationType): PublicationType
}

class PublicationType {
  -mediaFormat : MediaFormat
  -typeOfBinding : TypeOfBinding
  -details : String
  +getMediaFormat(): MediaFormat
  +getTypeOfBinding() : TypeOfBinding
  +getDetails() : String
}

' Interactions

RegisterPubTypeController "1 " -- "1 " PublicationTypeRepository : requests registration to >
PublicationTypeRepository "1 " -- " * " PublicationType : manages / stores >

@enduml