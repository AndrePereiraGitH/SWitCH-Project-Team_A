@startuml
title US023 - To get the list of items on direct sale of a given publication

class UI023{

}

class ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController {
  +getAllPublications()
  +getListOfItemsOnDirectSale(publication)
}

class PublicationRepository{
    +getAllPublications()
}

class PublicationDTO_US023 {
}

class PublicationMapper_US023 {
  +toDTO(listOfPublication)
}

class DirectSaleRepository {
  +getListOfItemsOnDirectSale(publication)
}

/'
class DirectSale {
  - listing: Listing
  +getDetails()
}
'/

class DirectSaleMapper_US023 {
  +toDTO(listOfDirectSale)
}

class DirectSaleDTO_US023 {
}

/'
class Listing {
  - item: Item
  - saleType: SaleType
}

enum SaleType {
    DIRECT_SALE
    AUCTION
}

'class Item {
'    - bibliographicalData: BibliographicalData
'}

class Item {
    - publication: publication
}

class Publication {
    - bibliographicalData: BibliographicalData
    - code: Code
}

class BibliographicalData {
    - title: String
}
'/

