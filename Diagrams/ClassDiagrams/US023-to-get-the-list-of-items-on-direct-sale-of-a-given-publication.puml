@startuml
title US023 - To get the list of items on direct sale of a given publication

class UI023{

}

class ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController {
  +getAllPublications()
  +getListOfItemsOnDirectSale(publication)
  -copyList()
}

class PublicationRepository{
    +getAllPublications()
}

class DirectSaleRepository {
  +getListOfItemsOnDirectSale(publication)
  -validateParameters(publication)
}

class DirectSale {
  - listing: Listing
}

class Listing {
  - item: Item
  - saleType: SaleType
}

enum SaleType {
    DIRECT_SALE
    AUCTION
}

'class Item {
'    - bibliographicalData: BibliographicalData
'}

class Item {
    - publication: publication
}

class Publication {
    - bibliographicalData: BibliographicalData
    - code: Code
}

class BibliographicalData {
    - title: String
}

' Interactions

UI023 "1" .. "1" ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController : uses >
ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController  "1 " .. "1" DirectSaleRepository : uses >
ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController "1" .. "1" PublicationRepository: uses >
DirectSaleRepository "1 " -- " * " DirectSale : retrieves >
DirectSale "1" -- "1" Listing : uses >
Listing "                                *" -- "1" SaleType : can be\nsold by >
Listing "1" -- "1..*    " Item : lists an >
' Item "*" -- "1" BibliographicalData: has >
Item "*" -- "1" Publication: refers to a >
Publication "*" -- "1" BibliographicalData: has >

@enduml
