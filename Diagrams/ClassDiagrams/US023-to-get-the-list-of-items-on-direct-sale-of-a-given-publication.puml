@startuml
title US023 - To get the list of items on direct sale of a given publication

class UI023{
}

class US023ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController {
  +getAllPublicationsBD() : List<BibliographicalDataDTO_US023>
  +findListOfItemsOnDirectSale(publication): List<PublicationSampleDTO_US023>
}

class BibliographicalDataRepository{
    +getAllPublicationsBD(): List<BibliographicalData>
}

class BibliographicalDataDTO_US023 {
  +toDTOs(listOfAllPublicationsBD): List<BibliographicalDataDTO_US023>
}

class BibliographicalData {
    - title: String
    - author: List<Author>
    - originalLanguage: Locale
    - publishDate: LocalDate
    - genre: List<Genre>
    - chunksOfText: String
    + getBibliographicalDataDetails()
}

class ListingRepository  {
    - listings: List<Listing>
    + findAllDirectSaleListings() : List<Listing>
}

class PublicationSampleRepository {
    - allPublicationsInTheSystem: List<PublicationSample>
    + findItemsByListingAndPublication(listOfListings, publication): List<PublicationSample>
}

class PublicationSampleDTO_US023 {
    +toDTOs(listOfItems)
}

class PublicationSample {
    - bibliographicalData: BibliographicalData
    - publicationType: PublicationType
    - userName: User
    - publicationStatus: PublicationStatus
    - edition: String
    - code: Code
    + getDetails() : PublicationSample
}

class Listing {
    - listingTitle: String
    - items: List<PublicationSample>
    - saleType: SaleType
    - price: Price
    - shortDescription: String
    - seller: User
    - pictures: List<Picture>
}

enum SaleType {
    DIRECT_SALE
    AUCTION
}

' Interactions

UI023 "1" ..> "1" US023ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController : uses

US023ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController "1" ..> "1" BibliographicalDataRepository: uses
US023ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController "1" ..> "1" BibliographicalDataDTO_US023 : uses
US023ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController "1" ..> "1" ListingRepository : uses
US023ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController "1" ..> "1" PublicationSampleRepository : uses
US023ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController "1" ..> "1" PublicationSampleDTO_US023 : uses

BibliographicalDataRepository "1" ..> "*" BibliographicalData : communicates with

BibliographicalDataDTO_US023 "1" ..> "1" BibliographicalData : transfers

ListingRepository "1" ..> "*" Listing: communicates with

PublicationSampleRepository "1" ..> "*" PublicationSample: communicates with

PublicationSampleDTO_US023 ..> PublicationSample : transfers

' Domain classes interactions

Listing "1" -> "1..*" PublicationSample: contains
Listing "1" -> "1" SaleType: for sale on

@enduml
