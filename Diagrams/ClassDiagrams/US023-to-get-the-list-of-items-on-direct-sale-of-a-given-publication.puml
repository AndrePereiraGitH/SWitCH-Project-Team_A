@startuml
title US023 - To get the list of items on direct sale of a given publication

class UI023{
}

class ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController {
  +getAllPublicationsBD()
  +getListOfItemsOnDirectSale(publication)
}

class BibliographicalDataRepository{
    +getAllPublicationsBD()
}

class BibliographicalDataDTO_US023 {
  +toDTO(listOfAllPublicationsBD)
}

class BibliographicalData {
    - title: String
    - author: List<Author>
    - originalLanguage: Locale
    - publishDate: LocalDate
    - genre: List<Genre>
    - chunksOfText: String
    + getBibliographicalDataDetails()
}

class ListingRepository  {
    - listings: List<Listing>
    + findDirectSaleListings()
}

class PublicationSampleRepository {
    - allPublicationsInTheSystem: List<PublicationSample>
    + findPublicationSamplesByListing(listOfListings, publication)
}

class PublicationSampleDTO_US023 {
    +toDTO(listOfItems)
}

class PublicationSample {
    - bibliographicalData: BibliographicalData
    - publicationType: PublicationType
    - userName: User
    - publicationStatus: PublicationStatus
    - edition: String
    - code: Code
    + getPublicationSampleDetails()
}

class Listing {
    - listingTitle: String
    - items: List<PublicationSample>
    - saleType: SaleType
    - price: Price
    - shortDescription: String
    - seller: User
    - pictures: List<Picture>
}

enum SaleType {
    DIRECT_SALE
    AUCTION
}

' Interactions

UI023 "1" ..> "1" ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController : uses

ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController "1" ..> "1" BibliographicalDataRepository: uses
ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController "1" ..> "1" BibliographicalDataDTO_US023 : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController "1" ..> "1" ListingRepository : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController "1" ..> "1" PublicationSampleRepository : uses
ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController "1" ..> "1" PublicationSampleDTO_US023 : uses

BibliographicalDataRepository "1" ..> "*" BibliographicalData : communicates with

BibliographicalDataDTO_US023 "1" ..> "1" BibliographicalData : transfers

ListingRepository "1" ..> "*" Listing: communicates with

PublicationSampleRepository "1" ..> "*" PublicationSample: communicates with

PublicationSampleDTO_US023 ..> PublicationSample : transfers

' Domain classes interactions

Listing "1" -> "1..*" PublicationSample: contains
Listing "1" -> "1" SaleType: for sale on

@enduml
