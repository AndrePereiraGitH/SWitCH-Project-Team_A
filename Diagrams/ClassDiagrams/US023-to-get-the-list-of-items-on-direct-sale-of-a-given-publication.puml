@startuml
title US023 - To get the list of items on direct sale of a given publication

' -------------------------
' APPLICATION LAYER
' -------------------------

class UI023{
}

class US023ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController {
  - bibliographicalDataRepository: IBibliographicalDataRepository
  - listingRepository: IListingRepository
  - publicationSampleRepository: IPublicationSampleRepository
  + getAllPublicationsBD() : List<US023BibliographicalDataDTO>
  + findListOfItemsOnDirectSale(bdID) : List<US023PublicationSampleDTO>
}


class US023BibliographicalDataMapper {
    + toDTO(bibliographicalData) : US023BibliographicalDataDTO
    + toDTOs(listOfAllPublicationsBD) : List<US023BibliographicalDataDTO>
}

record US023BibliographicalDataDTO {
}

class US023PublicationSampleMapper {
    + toDTO(item) : US023PublicationSampleDTO
    + toDTOs(listOfItems) : List<US023PublicationSampleDTO>
}

record US023PublicationSampleDTO {
}

' -------------------------
' REPOSITORIES
' -------------------------

interface IBibliographicalDataRepository {
  - bdList : List<BibliographicalData>
  + getAllPublicationsBD() : List<BibliographicalData>
}

interface IListingRepository {
  - listings : List<Listing>
  + findAllDirectSaleListings() : List<Listing>
}

interface IPublicationSampleRepository {
  - publicationSamples : List<PublicationSample>
  + findItemsByIdsAndPublication(listOfPubSampleIds, publicationId) : List<PublicationSample>
}

' -------------------------
' DOMAIN LAYER
' -------------------------

class BibliographicalData {
  - bdId : BibliographicalDataId
  - title : String
  - authorsId : List<AuthorId>
}

class Listing {
  - listingId : ListingId
  - listingTitle : String
  - publicationSampleIds : List<PublicationSampleId>
  - saleType : SaleType
  + getItemsIds(): List<PublicationSampleId>
}

class PublicationSample {
    - publicationSampleId: PublicationSampleId
    - bibliographicalDataId: BibliographicalDataId
    - ownerId: UserId
    - publicationStatus: PublicationStatus
    - editionId: EditionId
    - condition: Condition
    + getBibliographicalDataId() : BibliographicalDataId
}

' Value Objects
enum SaleType {
  DIRECT_SALE
  AUCTION
}

' -------------------------
' RELATIONSHIPS
' -------------------------

' --- UI ---
UI023 ..> US023ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController : invokes

' --- Controller ---
US023ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController "1" --> "1" IBibliographicalDataRepository : uses
US023ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController "1" --> "1" IListingRepository : uses
US023ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController "1" --> "1" IPublicationSampleRepository : uses
US023ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController ..> US023BibliographicalDataMapper : creates DTO
US023ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController ..> US023PublicationSampleMapper : creates DTO

' --- BD Repository ---
IBibliographicalDataRepository "1" --> "*" BibliographicalData : persists

' --- Listing Repository ---
IListingRepository "1" --> "*" Listing : persists

' --- PubSample Repository ---
IPublicationSampleRepository "1" --> "*" PublicationSample : persists

' --- Listing ---
Listing "*" --> "1" SaleType : for sale in

' --- PubSample Mapper and DTO ---
US023PublicationSampleMapper ..> PublicationSample : uses
US023PublicationSampleMapper ..> US023PublicationSampleDTO : create

' --- BD Mapper and DTO ---
US023BibliographicalDataMapper ..> BibliographicalData : uses
US023BibliographicalDataMapper ..> US023BibliographicalDataDTO : creates

@enduml

