@startuml
hide circle
title US008 - Register New City (Class Diagram)

class City {
  -cityName: String
  -countryID: CountryID
}

class Country {
  -countryName: String
  -countryID: CountryID
}

class CountryID

class CityFactory {
  +create(countryID: CountryID, cityName: String) : City
}

interface ICityRepository {
  +createAndAdd(countryID: CountryID, cityName: String) : City
}

interface ICountryRepository {
  +findCountryIdByCountryName(countryName: String) : Optional<CountryID>
}

class CityRepositoryMem {
  -_cities: List<City>
  -_cityFactory: CityFactory
  +createAndAdd(countryID: CountryID, cityName: String) : City
  -existsByAttributes(city: City) : boolean
}

class CountryRepositoryMem {
  -registeredCountries: List<Country>
  +findCountryIdByCountryName(countryName: String) : Optional<CountryID>
  -normalizeCountryName(countryName: String) : String
}

class US008ToRegisterACityCtrl {
  -_cityRepository: ICityRepository
  -_countryRepository: ICountryRepository
  +registerNewCity(countryName: String, cityName: String) : boolean
}

' Relationships
US008ToRegisterACityCtrl --> ICityRepository
US008ToRegisterACityCtrl --> ICountryRepository

ICityRepository <|.. CityRepositoryMem
ICountryRepository <|.. CountryRepositoryMem

CityRepositoryMem --> CityFactory
CityRepositoryMem --> City

CountryRepositoryMem --> Country

City --> CountryID
Country --> CountryID

@enduml