
@startuml
hide circle
title US008 - Register New City (Class Diagram)

class City {
  -cityName: String
  -country: Country
}

class Country {
  -name: String
}

class FactoryCity {
  +create(cityName: String, country: Country) : City
}

class CityRepository {
  +createAndAdd(cityName: String, countryName: String) : City
  -validate(city: City)
  -add(city: City)
}

class CountryRepository {
  +exists(countryName: String) : boolean
  +findByName(countryName: String) : Country
}

class US008RegisterNewCityController {
  +getCountryName(countryName: String) : boolean
  +registerNewCity(cityName: String, countryName: String) : City
}

' Interactions / Dependencies
US008RegisterNewCityController "1" ..> "1" CityRepository : uses
US008RegisterNewCityController "1" ..> "1" CountryRepository : verifies country
CityRepository "1" ..> "1" FactoryCity : creates via
CityRepository "1" --> "*" City : stores
City "*" --> "1" Country : is in

@enduml