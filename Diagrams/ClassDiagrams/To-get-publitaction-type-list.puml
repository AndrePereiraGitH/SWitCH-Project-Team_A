@startuml
title Class Diagram - Get All Publication Types

' ====== UI & Controller ======
class UI {
  +getAllPublicationTypes()
}

class Controller {
  +getAllPublicationTypes(): List<PublicationTypeDTO>
}

UI -.-> Controller : uses

' ====== Repository Layer ======
interface IPublicationTypeRepository {
  +getAllPublicationTypes(): List<PublicationType>
}

interface IPublicationTypeRepositoryJPA {
  +getAllPublicationTypes(): List<PublicationType>
}

IPublicationTypeRepository <|.. IPublicationTypeRepositoryJPA : implements

Controller -.-> IPublicationTypeRepository : uses


' ====== Domain ======
class PublicationType {
  -id: PublicationTypeId
  -mediaFormat: String
  +getId(): publicationTypeId
  +getMediaFormat(): String
}

' ====== Assembler & Factory ======
class PublicationTypeAssembler {
  +toDomainList(pubTypesPersisted): List<PublicationType>
}

class PublicationTypeFactory {
  +create(publicationType.id, mediaFormat): PublicationType
}

PublicationTypeAssembler -.-> PublicationTypeFactory : uses
PublicationTypeAssembler --> PublicationType

IPublicationTypeRepository -.-> PublicationTypeAssembler : uses

' ====== DTO & Mapper ======
class US014PublicationTypeDTO {
  -id: String
  -mediaFormat: String
}

class US014PublicationTypeMapper {
  +toDTOList(pubTypeList): List<US014PublicationTypeDTO>
}

Controller -.-> US014PublicationTypeMapper : uses
US014PublicationTypeMapper --> PublicationType
US014PublicationTypeMapper --> US014PublicationTypeDTO

@enduml