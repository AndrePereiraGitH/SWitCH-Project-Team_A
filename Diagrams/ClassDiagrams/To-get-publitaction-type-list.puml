' ====== UI & Controller ======
class UI {
  +findAll()
}

class ToGetPublicationTypeListController {
  +findAll(): List<US014PublicationTypeDTO>
}

UI "1" -.-> "1" ToGetPublicationTypeListController : uses

' ====== Repository Layer ======
interface IPublicationTypeRepository {
  +findAll(): List<PublicationType>
}

class PublicationTypeRepositoryJPAImpl {
}

interface IPublicationTypeRepositoryJPA {
  +findAll(): List<PublicationType>
}

rectangle DataBase {
}

' IPublicationTypeRepository "1" ..> "1" IPublicationTypeRepositoryJPA : uses
IPublicationTypeRepository "1" <|.. "1" PublicationTypeRepositoryJPAImpl : implements
IPublicationTypeRepositoryJPA "1" <.. "1" PublicationTypeRepositoryJPAImpl : uses
IPublicationTypeRepositoryJPA "1" ...> "1" DataBase : queries

ToGetPublicationTypeListController "1" -.-> "1" IPublicationTypeRepository : uses


' ====== Domain ======
class PublicationType {
  -id: PublicationTypeId
  -mediaFormat: String
  +getId(): publicationTypeId
  +getMediaFormat(): String
}

' ====== Assembler & Factory ======
class PublicationTypeAssembler {
  +toDomain(publicationTypeDms): List<PublicationType>
}

class PublicationTypeFactory {
  +create(publicationType.id, mediaFormat): PublicationType
}

PublicationTypeAssembler "1" -.-> "1" PublicationTypeFactory : uses
PublicationTypeFactory "1" --> "*" PublicationType : creates

PublicationTypeRepositoryJPAImpl "1" -.-> "1" PublicationTypeAssembler : uses

' ====== DTO & Mapper ======
class US014PublicationTypeDTO {
  -id: String
  -mediaFormat: String
}

class US014PublicationTypeMapper {
  +toDTOList(pubTypeList): List<US014PublicationTypeDTO>
}

ToGetPublicationTypeListController "1" -.-> "1" US014PublicationTypeMapper : uses
US014PublicationTypeMapper "1" --> "*" PublicationType : reads
US014PublicationTypeMapper "1" -.-> "1" US014PublicationTypeDTO : creates

