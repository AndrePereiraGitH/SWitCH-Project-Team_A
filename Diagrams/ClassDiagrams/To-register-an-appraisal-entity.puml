@startuml
title Class Diagram - Layered Architecture

skinparam packageStyle rectangle
left to right direction

' =========================
' APPLICATION LAYER
' =========================
package "Application" {

class "ToRegisterAppraisalEntityController" as Controller
class "AppraisalEntityService" as Service

Controller ..> Service : uses >
}

' =========================
' DOMAIN LAYER
' =========================
package "Domain" as DomainPkg {

class AppraisalEntity {
  -id: AppraisalEntityId
  -name: String
  -contact: Contact
}

class Genre {
  -id: GenreId
  -genreType: String
}
class PublicationType{
  -id: PublicationTypeId
  -mediaFormat: String
}

class AppraisalEntityFactory
class GenreFactory
class PublicationTypeFactory

interface IAppraisalEntityRepository
interface IGenreRepository
interface IPublicationTypeRepository

AppraisalEntity "1" --> "0..*" Genre : has >
AppraisalEntity "1" --> "0..*" PublicationType : has >

Service ..> AppraisalEntityFactory : creates >
Service ..> IAppraisalEntityRepository : saves >
Service ..> IGenreRepository : retrieves >
Service ..> IPublicationTypeRepository : retrieves >

AppraisalEntityFactory ..> AppraisalEntity : creates >
GenreFactory ..> Genre : creates >
PublicationTypeFactory ..> PublicationType : creates >


}

' =========================
' PERSISTENCE LAYER
' =========================
package "Persistence" as PersistPkg {

class AppraisalEntityDM
class GenreDM
class PublicationTypeDM

class AppraisalAssembler
class GenreAssembler
class PublicationTypeAssembler

interface IAppraisalEntityRepositoryJPA
interface IGenreRepositoryJPA
interface IPublicationTypeRepositoryJPA

AppraisalAssembler ..> AppraisalEntity : converts >
AppraisalAssembler ..> AppraisalEntityDM : converts >

GenreAssembler ....> Genre : converts >
GenreAssembler ..> GenreDM : converts >

PublicationTypeAssembler ..> PublicationType : converts >
PublicationTypeAssembler ..> PublicationTypeDM : converts >

IAppraisalEntityRepositoryJPA --> AppraisalEntityDM : persists >
IGenreRepositoryJPA --> GenreDM : persists >
IPublicationTypeRepositoryJPA --> PublicationTypeDM : persists >
}

' =========================
' CROSS LAYER
' =========================

Controller ..> IGenreRepository
Controller ..> IPublicationTypeRepository

IAppraisalEntityRepository <|.. IAppraisalEntityRepositoryJPA
IGenreRepository <|.. IGenreRepositoryJPA
IPublicationTypeRepository <|.. IPublicationTypeRepositoryJPA

@enduml