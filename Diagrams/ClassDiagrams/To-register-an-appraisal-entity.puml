@startuml
title Class Diagram - To register an Appraisal Entity

skinparam packageStyle rectangle
left to right direction

' =====================================================
' DATABASE
' =====================================================
package "Database" {

class DB <<Database>>

}

' =====================================================
' AUTO GENERATED
' =====================================================
package "AutoGenerated" {

class "AutoGeneratedAppraisalEntityJPAImpl" as AutoGeneratedAppraisalEntity
class "AutoGeneratedGenreJPAImpl" as AutoGeneratedGenre
class "AutoGeneratedPublicationTypeJPAImpl" as AutoGeneratedPublicationType

AutoGeneratedAppraisalEntity ..> DB : queries
AutoGeneratedGenre ..> DB : queries
AutoGeneratedPublicationType ..> DB : queries

}

' =========================
' APPLICATION / SERVICES
' =========================
package "Ctrl/Services" {

class "ToRegisterAppraisalEntityController" as Controller {
  +getAllGenre()
  +getPublicationTypes()
  +registerAppraisalEntity(name:String, contact:Contact, \ngenresId:List<GenreId>, publicationTypesId:List<PublicationTypeId>)
}

class "AppraisalEntityService" as Service {
  +createAndSave(name:String, contact:Contact, \ngenresId:List<GenreId>, publicationTypesId:List<PublicationTypeId>)
}

Controller ..> Service : uses >

}

' =========================
' DOMAIN LAYER
' =========================
package "Domain" {

class AppraisalEntity {
  -id: AppraisalEntityId
  -name: String
  -contact: Contact
}

class Genre {
  -id: GenreId
  -genreType: String
}

class PublicationType {
  -id: PublicationTypeId
  -mediaFormat: String
}

class AppraisalEntityFactory {
  +create(name:String, contact:Contact,\ngenresId:List<GenreId>,\npublicationTypesId:List<PublicationTypeId>)
}

class GenreFactory {
  +create(id:GenreId, genreType:String)
}

class PublicationTypeFactory {
  +create(id:PublicationTypeId, mediaFormat:String)
}

interface IAppraisalEntityRepository {
  +save(appraisalEntity:AppraisalEntity)
}

interface IGenreRepository {
  +findAll()
}

interface IPublicationTypeRepository {
  +findAll()
}

AppraisalEntity "1" --> "*" Genre : has
AppraisalEntity "1" --> "*" PublicationType : has

Service ..> AppraisalEntityFactory : creates
Service ..> IAppraisalEntityRepository : saves
Service ..> IGenreRepository : retrieves
Service ..> IPublicationTypeRepository : retrieves

AppraisalEntityFactory ..> AppraisalEntity : creates
GenreFactory ..> Genre : creates
PublicationTypeFactory ..> PublicationType : creates

}

' =========================
' DTO LAYER
' =========================
package "DTO" {

class US004GenreDTO {
  -id: GenreId
  -title: String
}

class US004PublicationTypeDTO {
  -id: PublicationTypeId
  -mediaFormat: String
}

class US004GenreMapper {
  +toDTO(genre:Genre)
  +toDTOs(genres:List<Genre>)
}

class US004PublicationTypeMapper {
  +toDTO(publicationType:PublicationType)
  +toDTOs(publicationTypes:List<PublicationType>)
}

US004GenreMapper ..> Genre : converts
US004GenreMapper ..> US004GenreDTO : creates

US004PublicationTypeMapper ..> PublicationType : converts
US004PublicationTypeMapper ..> US004PublicationTypeDTO : creates

Controller ..> US004GenreMapper : maps
Controller ..> US004PublicationTypeMapper : maps

}

' =====================================================
' PERSISTENCE / INFRASTRUCTURE
' =====================================================
package "Persistence / Infrastructure" {

' =========================
' DATA MODELS
' =========================

class AppraisalEntityDM
class GenreDM
class PublicationTypeDM

' =========================
' ASSEMBLERS
' =========================

class AppraisalAssembler {
  +toDM(appraisalEntity:AppraisalEntity)
  +toDomain(dm:AppraisalEntityDM)
}

class GenreAssembler {
  +toDM(genre:Genre)
  +toDomain(dm:GenreDM)
  +toDomainList(dmList:List<GenreDM>)
}

class PublicationTypeAssembler {
  +toDM(publicationType:PublicationType)
  +toDomain(dm:PublicationTypeDM)
  +toDomainList(dmList:List<PublicationTypeDM>)
}

' =========================
' JPA REPOSITORIES
' =========================

interface IAppraisalEntityRepositoryJPA
interface IGenreRepositoryJPA
interface IPublicationTypeRepositoryJPA

' =========================
' IMPLEMENTATIONS
' =========================

class AppraisalEntityRepositoryJPAImpl {
  +save(appraisalEntity:AppraisalEntity)
}

class GenreRepositoryJPAImpl {
  +findAll()
}

class PublicationTypeRepositoryJPAImpl {
  +findAll()
}

' =========================
' IMPLEMENTS
' =========================

AppraisalEntityRepositoryJPAImpl ..|> IAppraisalEntityRepository : implements
AppraisalEntityRepositoryJPAImpl ..|> IAppraisalEntityRepositoryJPA : implements

GenreRepositoryJPAImpl ..|> IGenreRepository : implements
GenreRepositoryJPAImpl ..|> IGenreRepositoryJPA : implements

PublicationTypeRepositoryJPAImpl ..|> IPublicationTypeRepository : implements
PublicationTypeRepositoryJPAImpl ..|> IPublicationTypeRepositoryJPA : implements

' =========================
' IMPLEMENTATION COMMUNICATION
' =========================

AppraisalEntityRepositoryJPAImpl --> AppraisalAssembler : converts
AppraisalEntityRepositoryJPAImpl ..> AutoGeneratedAppraisalEntity : requests

GenreRepositoryJPAImpl --> GenreAssembler : converts
GenreRepositoryJPAImpl ..> AutoGeneratedGenre : requests

PublicationTypeRepositoryJPAImpl --> PublicationTypeAssembler : converts
PublicationTypeRepositoryJPAImpl ..> AutoGeneratedPublicationType : requests

' =========================
' ASSEMBLER RELATIONS
' =========================

AppraisalAssembler ...> AppraisalEntityFactory : ask creation to
AppraisalAssembler ...> AppraisalEntityDM : converts

GenreAssembler ...> GenreFactory : ask creation to
GenreAssembler ...> GenreDM : converts

PublicationTypeAssembler ...> PublicationTypeFactory : ask creation to
PublicationTypeAssembler ...> PublicationTypeDM : converts

' =========================
' JPA RELATIONS
' =========================

IAppraisalEntityRepositoryJPA --> AppraisalEntityDM : persists
IGenreRepositoryJPA --> GenreDM : persists
IPublicationTypeRepositoryJPA --> PublicationTypeDM : persists

}

' =========================
' CROSS LAYER
' =========================

Controller ..> IGenreRepository : retrieves
Controller ..> IPublicationTypeRepository : retrieves

@enduml