@startuml
title As an Administrator, I want to register an Appraisal Entity in the system

' ========================
' UI + APPLICATION LAYER
' ========================

class US004ToRegisterAppraisalEntityController {
  +getAllGenres(): List<US004GenreDTO>
  +getAllPublicationTypes(): List<US004PublicationTypeDTO>
  +registerAppraisalEntity(name, contact, genreId, publicationTypeIds): AppraisalEntity
}


' ========================
' DOMAIN LAYER
' ========================

' -------- Aggregate Root --------
class AppraisalEntity {
  -appraisalId: AppraisalEntityId
  -name
  -contact
  -genreIds: List<GenreId>
  -publicationTypeIds: List<PublicationTypeId>
}

class AppraisalEntityId {
  -String: apEnId
}

AppraisalEntity "1" *-- "1" AppraisalEntityId : has


' -------- Genre --------
class Genre {
  -String: title
}

class GenreId {
  -String: genreId
}

Genre "   1 " *--- "        1 " GenreId : identifies


' -------- PublicationType --------
class PublicationType {
  -String: mediaFormat
}

class PublicationTypeId {
  -String: pubTypeId
}

PublicationType "1" *--- "1" PublicationTypeId : identifies


' ========================
' INTERACTIONS
' ========================

AppraisalEntity "    1       " --> "      1..*" GenreId : contains
AppraisalEntity "1  " --> "  1..*        " PublicationTypeId : contains

GenreId ..> Genre
PublicationTypeId ..> PublicationType


' ========================
' REPOSITORIES
' ========================

interface IGenreRepository {
  +getAllGenres(): List<Genre>
  +findById(id: GenreId): Genre
}

interface IPublicationTypeRepository {
  +getAllPublicationTypes(): List<PublicationType>
  +findById(id: PublicationTypeId): PublicationType
}

interface IAppraisalEntityRepository {
  +createAndAdd(...)
}


IGenreRepository ..> Genre
IPublicationTypeRepository ..> PublicationType
IAppraisalEntityRepository ..> AppraisalEntityFactory


' ========================
' FACTORY
' ========================

class AppraisalEntityFactory {
  +create(name, contact, genreId, publicationTypeId): AppraisalEntity
}

AppraisalEntityFactory "   1 " --> "  * " AppraisalEntity : creates


' ========================
' DEPENDENCIES
' ========================

US004ToRegisterAppraisalEntityController ...> IGenreRepository : interacts with
US004ToRegisterAppraisalEntityController ...> IPublicationTypeRepository : interacts with
US004ToRegisterAppraisalEntityController ..> IAppraisalEntityRepository : interacts with

@enduml