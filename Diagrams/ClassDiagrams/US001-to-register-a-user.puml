@startuml
title US001 - To register a user in the system

interface IUserRepository {
  +exists(username: String) : boolean
  +save(user: User) : void
}

class UserRepositoryMem {
  -_userList : List<User>
}

class UserFactory {
  +create(username: String, contact: Contact, profile: Profile, userRole: UserRole) : User
}

class RegisterUserController {
  -userRepository : IUserRepository
  -userFactory : UserFactory
  +registerUser(username: String, contact: Contact, profile: Profile, userRole: UserRole) : void
}

class User {
  -_id : UserId
  -_userName : String
  -_contact : Contact
  -_profile : Profile
  -_userRole : UserRole
  +getUserName() : String
}

RegisterUserController "1" ..> "1" IUserRepository : uses
RegisterUserController "1" ..> "1" UserFactory : uses
UserRepositoryMem ..|> IUserRepository : implements
UserRepositoryMem "1" --> "*" User : stores
UserFactory ..> User : creates

@enduml