@startuml
title US001 - To register a user in the system

class RegisterUserController {
  +registerUser(username: String, contact: String, profile: String) : boolean
}

class UserRepository {
  -userList: List<User>
  +createAndAddUser(username: String, contact: String, profile: String) : User
' Those methods are part of createAndAddUser
'  -validateUser(u: User) : boolean
'  -addUserToUserList(u: User) : void
}

class User {
  -username: String
  -contact: Contact
  -profile: Profile
}

class Contact {
  -phoneNum: String
  -extension: String
  -email: Email
  -location: Address
}


class Profile {
  -name: String;
  -country: Country;
  -birthday: LocalDate;
}

' Interaction

RegisterUserController "1 " -- "1 " UserRepository : request registration to >
UserRepository "1 " -- " * " User : creates / manages >
User "1  " -- "1 " Contact : contains >
User "1" -- "1  " Profile : has >
@enduml
