@startuml
title US001 - To register a user in the system

class RegisterUserController {
  +registerUser(username: String, contact: Contact, profile: Profile, userRole: UserRole)
}

class UserRepository {
  -users : List<User>
  +exists(userName: String) : boolean
  +createAndAddUser(username: String, contact: Contact, profile: Profile, userRole: UserRole) : User
  +getUserCount() : int
}

class "List<User>"

class User {
  -_userName : String
  -_contact : Contact
  -_profile : Profile
  -_userRole : UserRole
}

class Contact {
  -phoneNum : String
  -extension : String
  -email : Email
  -address : Address
}

class Profile {
  -name : String
  -country : Country
  -birthday : LocalDate
}

RegisterUserController "1 " --.> "1 " UserRepository : uses
UserRepository "1 " --> "1 " "List<User>" : has
"List<User>" "1 " --> "          *" User : stores
User "1   " --> "1 " Contact : has
User "1" --> "1  " Profile : has

@enduml