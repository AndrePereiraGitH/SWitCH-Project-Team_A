@startuml
title US001 - To register a user in the system

class RegisterUserController {
  +registerUser(username: String, contact: Contact, profile: Profile, userRole: UserRole)
}

class UserRepository {
  +createAndAddUser(username: String, contact: Contact, profile: Profile, userRole: UserRole)
' Those methods are part of createAndAddUser
'  -validateUser(u: User) : boolean
'  -addUserToUserList(u: User) : void
}

class "List<User>" {
}

class User {
  -username: String
  -userRole: UserRole
}

class Contact {
  -phoneNum: String
  -extension: String
  -email: Email
  -address: Address
}


class Profile {
  -name: String
  -country: Country
  -birthday: LocalDate
}

' Interaction

RegisterUserController "1 " -- "1 " UserRepository : request registration to >
UserRepository "1 " .--- " * " User : creates / manages >
UserRepository "1    " -- "1 " "List<User>" : has >
"List<User>" "1 " -- " *    " User : contains >
User "1  " -- "1 " Contact : contains >
User "1" -- "1  " Profile : has >
@enduml
