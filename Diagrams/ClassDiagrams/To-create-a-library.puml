@startuml
title To create a library

' ── UI Layer ───────────────────────────────────────────────
class UI {
}

' ── Application Layer ──────────────────────────────────────
class ToCreateLibraryCtrl {
    + createLibrary(libraryName: String, username: String): boolean
}

class LibraryService {
    + createAndSave(libraryName: String, userId: UserId): Library
}

' ── Domain Layer ───────────────────────────────────────────
interface IUserRepository {
    + findIdByUsername(username: String): Optional<UserId>
}

interface ILibraryRepository {
    + save(library: Library): Library
    + verifyIfUserHasALibrary(result: Optional<LibraryDM>): void
}

class LibraryFactory {
    + create(libraryName: String, userId: UserId): Library
    + create(id: LibraryId, libraryName: String, userId: UserId): Library)
}

class Library {
    - id: LibraryId
    - name: String
    - userId: UserId
}

' ── Infrastructure Layer ───────────────────────────────────
interface IUserRepositoryJPA {
    + findIdByUsername(username: String): Optional<UserId>
}

interface ILibraryRepositoryJPA {
    + findByUserId(userId: UserId): Optional<LibraryDM>
    + save(libraryDM: LibraryDM): LibraryDM
}

class LibraryAssembler {
    + toDM(library: Library): LibraryDM
    + toDomain(libraryDM: LibraryDM): Library
}

class LibraryDM {
    - id: LibraryId
    - name: String
    - userId: UserId
}

Rectangle Database {
}

' ── Relationships ──────────────────────────────────────────
UI ..> ToCreateLibraryCtrl: uses
ToCreateLibraryCtrl ..> IUserRepository: uses
ToCreateLibraryCtrl ..> LibraryService: uses

LibraryService ..> LibraryFactory: uses
LibraryService ..> ILibraryRepository: uses

IUserRepository <|.. IUserRepositoryJPA: implements
ILibraryRepository <|.. ILibraryRepositoryJPA: implements

ILibraryRepository ..> LibraryAssembler: uses
ILibraryRepository ..> LibraryFactory: uses

LibraryAssembler ..> LibraryFactory: uses
LibraryAssembler ..> LibraryDM: creates
LibraryAssembler ..> Library: creates

LibraryFactory ..> Library: creates

IUserRepositoryJPA ..> Database: queries
ILibraryRepositoryJPA ..> Database: queries

@enduml