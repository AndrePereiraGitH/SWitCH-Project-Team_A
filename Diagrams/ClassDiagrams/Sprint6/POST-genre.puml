@startuml
title Class Diagram - Register Genre (POST Only)

skinparam packageStyle rectangle
left to right direction

' =====================================================
' DATABASE
' =====================================================
package "Database" {
    class DB <<Database>>
}

' =====================================================
' AUTO GENERATED / JPA
' =====================================================
package "Infrastructure / AutoGenerated JPA" {

class "GenreJPAImpl" as GenreJPA

GenreJPA ..> DB : queries
}

' =====================================================
' REST CONTROLLER LAYER
' =====================================================
package "REST Controllers" {

class "GenreRESTController" as Controller {
  +createGenre(dto:GenreRequestDTO, userId:UserId)
}

class "GenreLinkProvider" as LinkProvider {
  +getLinks(userId:UserId)
}
}

' =====================================================
' APPLICATION LAYER
' =====================================================
package "Application / Services" {

class "GenreService" as Service {
  +createAndSave(genreType:String, userId:UserId)
  +findAll()
}

class "GenreAuthorizationPolicy" as AuthPolicy {
  +canCreateGenre(user:User)
}

Controller ..> Service : uses
Service ..> AuthPolicy : validates
}

' =====================================================
' DOMAIN LAYER
' =====================================================
package "Domain" {

class Genre {
  -id: GenreId
  -genreType: String
}

class GenreFactory {
  +create(genreType:String)
}

interface IGenreRepository {
  +save(genre:Genre)
  +findAll()
  +findByTitle(title:String)
}

Service ..> GenreFactory : creates
Service ..> IGenreRepository : saves
GenreFactory ..> Genre : <<create>>
}

' =====================================================
' DTO / MAPPER LAYER
' =====================================================
package "DTO / Mappers" {

class GenreRequestDTO {
  +genreName: String
}

class GenreResponseDTO {
  +id: String
  +genreName: String
}

class GenreMapper {
  +toDTO(genre:Genre)
  +toDTOs(genres:List<Genre>)
}

Controller ..> GenreMapper : maps request/response
RequestAppraisalEntityDTO ..>> Controller : received by
GenreMapper ..> Genre : converts
GenreMapper ..> GenreResponseDTO : creates
}

' =====================================================
' PERSISTENCE LAYER
' =====================================================
package "Persistence / Infrastructure" {

class GenreDM

class GenreAssembler {
  +toDM(genre:Genre)
  +toDomain(dm:GenreDM)
  +toDomainList(dmList:List<GenreDM>)
}

interface IGenreRepositoryJPA

class GenreRepositoryJPAImpl {
  +save(dm:GenreDM)
  +findAll()
}

GenreRepositoryJPAImpl ..|> IGenreRepositoryJPA
GenreRepositoryJPAImpl ..|> IGenreRepository

IGenreRepositoryJPA ..> GenreDM : persists

GenreRepositoryJPAImpl --> GenreAssembler : converts
GenreAssembler ..> GenreDM : converts
GenreAssembler ..> Genre : converts
GenreRepositoryJPAImpl ..> GenreJPA : generated in runtime
}

' =====================================================
' CROSS CUTTING
' =====================================================

Controller ..> LinkProvider : adds HATEOAS links
Controller ..> Service : create request
Controller ..> GenreResponseDTO : returns to UI

@enduml