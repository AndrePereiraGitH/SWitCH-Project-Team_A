@startuml
title Class Diagram - Register Genre (POST Only)

skinparam packageStyle rectangle
left to right direction

' =====================================================
' DATABASE
' =====================================================
package "Database" {
    class DB <<Database>>
}

' =====================================================
' AUTO GENERATED / JPA
' =====================================================
package "Infrastructure / AutoGenerated JPA" {

class "GenreJPAImpl" as GenreJPA

GenreJPA "1" ..> "1..*" DB : queries
}

' =====================================================
' REST CONTROLLER LAYER
' =====================================================
package "REST Controllers" {

class "GenreRESTController" as Controller {
  +createGenre(dto:GenreRequestDTO, userId:UserId)
}

class "GenreLinkProvider" as LinkProvider {
  +getLinks(userId:UserId)
}
}

' =====================================================
' APPLICATION LAYER
' =====================================================
package "Application / Services" {

class "GenreService" as Service {
  +createAndSave(genreType:String, userId:UserId)
  +findAll()
}

class "GenreAuthorizationPolicy" as AuthPolicy {
  +canCreateGenre(user:User)
}

Controller "1" ..> "1" Service : uses
Service "1" ..> "1" AuthPolicy : validates
}

' =====================================================
' DOMAIN LAYER
' =====================================================
package "Domain" {

class Genre {
  -id: GenreId
  -genreType: String
}

class GenreFactory {
  +create(genreType:String)
}

interface IGenreRepository {
  +save(genre:Genre)
  +findAll()
  +findByTitle(title:String)
}

Service "1" ..> "1" GenreFactory : creates
Service "1" ..> "1" IGenreRepository : saves
GenreFactory "1" ..> "1..*" Genre : create
}

' =====================================================
' DTO / MAPPER LAYER
' =====================================================
package "DTO / Mappers" {

class GenreRequestDTO {
  +genreName: String
}

class GenreResponseDTO {
  +id: String
  +genreName: String
}

class GenreMapper {
  +toDTO(genre:Genre)
  +toDTOs(genres:List<Genre>)
}

Controller "1" ..> "1" GenreMapper : maps request/response
GenreRequestDTO "1" ..>> "1" Controller : received by
GenreMapper "1" ..> "*" Genre : converts
GenreMapper "1" ..> "*" GenreResponseDTO : creates
Service "1" ..> "1" GenreMapper : ask to converts
}

' =====================================================
' PERSISTENCE LAYER
' =====================================================
package "Persistence / Infrastructure" {

class GenreDM

class GenreAssembler {
  +toDM(genre:Genre)
  +toDomain(dm:GenreDM)
  +toDomainList(dmList:List<GenreDM>)
}

interface IGenreRepositoryJPA

class GenreRepositoryJPAImpl {
  +save(dm:GenreDM)
  +findAll()
}

GenreRepositoryJPAImpl "1" ..> "1" IGenreRepositoryJPA : uses
GenreRepositoryJPAImpl "1" ..|> "1" IGenreRepository

IGenreRepositoryJPA "1" ..> "1..* "GenreDM : persists

GenreRepositoryJPAImpl "1" --> "1" GenreAssembler : converts
GenreAssembler "1" ..> "1..*" GenreDM : converts
GenreAssembler "1" ..> "1..*" Genre : converts
GenreRepositoryJPAImpl "1" ..> "1" GenreJPA : generated in runtime
GenreJPA "1" ..|> "1" IGenreRepositoryJPA : implements
}

' =====================================================
' CROSS CUTTING
' =====================================================

Controller "1" ..> "1" LinkProvider : adds HATEOAS links
Controller "1" ..> "1" Service : create request
Controller "1" ..> "1..*" GenreResponseDTO : returns to UI

@enduml