@startuml
title Class Diagram - Register Appraisal Entity (POST Only)

skinparam packageStyle rectangle
left to right direction

' =====================================================
' DATABASE
' =====================================================
package "Database" {
    class DB <<Database>>
}

' =====================================================
' AUTO GENERATED / JPA
' =====================================================
package "Infrastructure / AutoGenerated JPA" {

class "AppraisalEntityJPAImpl" as AppraisalJPA

AppraisalJPA "1" ..> "1..*" DB : queries
}

' =====================================================
' REST CONTROLLER LAYER
' =====================================================
package "REST Controllers" {

class "AppraisalEntityRestController" as Controller {
  +register(dto:RequestAppraisalEntityDTO, userId:UserId)
}

class "AppraisalEntityLinkProvider" as LinkProvider {
  +getLinks(userId:UserId)
}
}

' =====================================================
' APPLICATION LAYER
' =====================================================
package "Application / Services" {

class "AppraisalEntityService" as Service {
  +createAndSave(name:String,
                 contact:Contact,
                 genresId:List<GenreId>,
                 publicationTypesId:List<PublicationTypeId>,
                 userId:UserId)
}

class "AuthorizationPolicy" as AuthPolicy {
  +canCreateAppraisalEntity(userId:UserId)
}

Controller "1" ..> "1" Service : uses
Service "1" ..> "1" AuthPolicy : validates
}

' =====================================================
' DOMAIN LAYER
' =====================================================
package "Domain" {

class AppraisalEntity {
  -id: AppraisalEntityId
  -name: String
  -contact: Contact
}

class AppraisalEntityFactory {
  +create(name:String,
          contact:Contact,
          genresId:List<GenreId>,
          publicationTypesId:List<PublicationTypeId>)
}

interface IAppraisalEntityRepository {
  +save(entity:AppraisalEntity)
}

Service "1" ..> "1" AppraisalEntityFactory : creates
Service "1" ..> "1" IAppraisalEntityRepository : saves
AppraisalEntityFactory "1" ..> "1..*" AppraisalEntity : <<create>>
}

' =====================================================
' DTO / MAPPER LAYER
' =====================================================
package "DTO / Mappers" {

class RequestAppraisalEntityDTO
class ResponseAppraisalEntityDTO

class AppraisalEntityMapper {
  +toContact(dto)
  +toPubTypeIds(dto)
  +toGenreIds(dto)
  +toResponse(entity)
}

Controller "1" ..> "1" AppraisalEntityMapper : maps request/response
RequestAppraisalEntityDTO "1" ..>> "1" Controller : recieved by
}

' =====================================================
' PERSISTENCE LAYER
' =====================================================
package "Persistence / Infrastructure" {

class AppraisalEntityDM

class AppraisalAssembler {
  +toDM(entity:AppraisalEntity)
  +toDomain(dm:AppraisalEntityDM)
}

interface IAppraisalEntityRepositoryJPA

class AppraisalEntityRepositoryJPAImpl {
  +save(dm:AppraisalEntityDM)
}

AppraisalEntityRepositoryJPAImpl "1" ..> "1" IAppraisalEntityRepositoryJPA : uses
AppraisalEntityRepositoryJPAImpl "1" ..|> "1" IAppraisalEntityRepository : impelments
AppraisalJPA "1" ..|> "1" IAppraisalEntityRepositoryJPA : implements

IAppraisalEntityRepositoryJPA "1" ..> "1..*" AppraisalEntityDM : persists

AppraisalEntityRepositoryJPAImpl "1" --> "1" AppraisalAssembler : ask to converts
AppraisalAssembler "1" ..> "1..*" AppraisalEntityDM : converts
AppraisalAssembler "1" ..> "1..*" AppraisalEntity : converts
AppraisalEntityRepositoryJPAImpl "1" ..> "1" AppraisalJPA : generated in runtime
}

' =====================================================
' CROSS CUTTING
' =====================================================

Controller "1" ..> "1" LinkProvider : adds HATEOAS links
Controller "1" ..> "1" Service : create request
Controller "1" ..> "1" ResponseAppraisalEntityDTO : returns to display

@enduml