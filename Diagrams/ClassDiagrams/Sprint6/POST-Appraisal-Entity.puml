@startuml
title Class Diagram - Register Appraisal Entity (POST Only)

skinparam packageStyle rectangle
left to right direction

' =====================================================
' DATABASE
' =====================================================
package "Database" {
    class DB <<Database>>
}

' =====================================================
' AUTO GENERATED / JPA
' =====================================================
package "Infrastructure / AutoGenerated JPA" {

class "AppraisalEntityJPAImpl" as AppraisalJPA

AppraisalJPA ..> DB : queries
}

' =====================================================
' REST CONTROLLER LAYER
' =====================================================
package "REST Controllers" {

class "AppraisalEntityRestController" as Controller {
  +register(dto:RequestAppraisalEntityDTO, userId:UserId)
}

class "AppraisalEntityLinkProvider" as LinkProvider {
  +getLinks(userId:UserId)
}
}

' =====================================================
' APPLICATION LAYER
' =====================================================
package "Application / Services" {

class "AppraisalEntityService" as Service {
  +createAndSave(name:String,
                 contact:Contact,
                 genresId:List<GenreId>,
                 publicationTypesId:List<PublicationTypeId>,
                 userId:UserId)
}

class "AuthorizationPolicy" as AuthPolicy {
  +canCreateAppraisalEntity(userId:UserId)
}

Controller ..> Service : uses
Service ..> AuthPolicy : validates
}

' =====================================================
' DOMAIN LAYER
' =====================================================
package "Domain" {

class AppraisalEntity {
  -id: AppraisalEntityId
  -name: String
  -contact: Contact
}

class AppraisalEntityFactory {
  +create(name:String,
          contact:Contact,
          genresId:List<GenreId>,
          publicationTypesId:List<PublicationTypeId>)
}

interface IAppraisalEntityRepository {
  +save(entity:AppraisalEntity)
}

Service ..> AppraisalEntityFactory : creates
Service ..> IAppraisalEntityRepository : saves
AppraisalEntityFactory ..> AppraisalEntity : <<create>>
}

' =====================================================
' DTO / MAPPER LAYER
' =====================================================
package "DTO / Mappers" {

class RequestAppraisalEntityDTO
class ResponseAppraisalEntityDTO

class AppraisalEntityMapper {
  +toContact(dto)
  +toPubTypeIds(dto)
  +toGenreIds(dto)
  +toResponse(entity)
}

Controller ..> AppraisalEntityMapper : maps request/response
RequestAppraisalEntityDTO ..>> Controller : recieved by
}

' =====================================================
' PERSISTENCE LAYER
' =====================================================
package "Persistence / Infrastructure" {

class AppraisalEntityDM

class AppraisalAssembler {
  +toDM(entity:AppraisalEntity)
  +toDomain(dm:AppraisalEntityDM)
}

interface IAppraisalEntityRepositoryJPA

class AppraisalEntityRepositoryJPAImpl {
  +save(dm:AppraisalEntityDM)
}

AppraisalEntityRepositoryJPAImpl ..|> IAppraisalEntityRepositoryJPA : implements
AppraisalEntityRepositoryJPAImpl ..|> IAppraisalEntityRepository : impelments

IAppraisalEntityRepositoryJPA ..> AppraisalEntityDM : persists

AppraisalEntityRepositoryJPAImpl --> AppraisalAssembler : converts
AppraisalAssembler ..> AppraisalEntityDM : converts
AppraisalAssembler ..> AppraisalEntity : converts
AppraisalEntityRepositoryJPAImpl ..> AppraisalJPA : generated in runtime
}

' =====================================================
' CROSS CUTTING
' =====================================================

Controller ..> LinkProvider : adds HATEOAS links
Controller ..> Service : create request
Controller ..> ResponseAppraisalEntityDTO : returns to display

@enduml