@startuml
title Class Diagram - Get Auction Items By Genre (GET)

skinparam packageStyle rectangle
left to right direction

' =====================================================
' DATABASE
' =====================================================
package "Database" {
    class DB <<Database>>
}

' =====================================================
' AUTO GENERATED / JPA
' =====================================================
package "Infrastructure / AutoGenerated JPA" {

class "AuctionJPAImpl" as AuctionJPA
class "ListingJPAImpl" as ListingJPA
class "BibliographicalDataJPAImpl" as BDJPA
class "PublicationSampleJPAImpl" as PSJPA

AuctionJPA "1" ..> "1..*" DB : queries
ListingJPA "1" ..> "1..*" DB : queries
BDJPA "1" ..> "1..*" DB : queries
PSJPA "1" ..> "1..*" DB : queries
}

' =====================================================
' REST CONTROLLER LAYER
' =====================================================
package "REST Controllers" {

class "AuctionRESTController" as Controller {
  +getAuctions(genre:String, author:String,publisher:String, publication:String,\nsortByDeadline:boolean, userId:String) : ResponseEntity<List<AuctionDTO>>
}

class "AuctionLinkProvider" as LinkProvider {
  +getLinksForAuction(userId:UserId) : List<Link>
}
}

' =====================================================
' APPLICATION LAYER
' =====================================================
package "Application / Services" {

class "AuctionService" as AuctionService {
  +findByListingIdIn(listingIds:List<ListingId>) : List<Auction>
  +findByListingIdInOrderByAuctionDeadlineAsc(listingIds:List<ListingId>) : List<Auction>
}

class "ListingService" as ListingService {
  +findByAuctionAndPublicationSampleIdIn(pubSampleIds:List<PublicationSampleId>) : List<Listing>
}

class "BibliographicalDataService" as BDService {
  +findAllByGenreId(genreId:GenreId) : List<BibliographicalDataId>
}

class "PublicationSampleService" as PSService {
  +findIdsByBibliographicalDataIdIn(bdIds:List<BibliographicalDataId>) : List<PublicationSampleId>
}

Controller "1" ..> "1" AuctionService : uses
Controller "1" ..> "1" ListingService : uses
Controller "1" ..> "1" BDService : uses
Controller "1" ..> "1" PSService : uses
}

' =====================================================
' DOMAIN LAYER
' =====================================================
package "Domain" {

class Auction {
  -auctionId: AuctionId
  -listingId: ListingId
  -auctionStartDateTime: LocalDateTime
  -auctionEndDateTime: LocalDateTime
  -initialPrice: Price
  -buyoutPrice: Price
  -auctionStatus: AuctionStatus
  -closedAt: LocalDateTime
  -finalPrice: Price
}

class Listing {
  -listingId: ListingId
  -listingTitle: String
  -shortDescription: String
  -saleType: SaleType
}

interface IAuctionRepository {
  +findByListingIdIn(listingIds:List<ListingId>) : List<Auction>
  +findByListingIdInOrderByAuctionDeadlineAsc(listingIds:List<ListingId>) : List<Auction>
}

interface IListingRepository {
  +findAllByAuctionAndPublicationSampleIdIn(pubSampleIds:List<PublicationSampleId>) : List<Listing>
}

interface IBibliographicalDataRepository {
  +findAllByGenreId(genreId:GenreId) : List<BibliographicalDataId>
}

interface IPublicationSampleRepository {
  +findIdsByBibliographicalDataIdIn(bdIds:List<BibliographicalDataId>) : List<PublicationSampleId>
}

AuctionService "1" ..> "1" IAuctionRepository : asks to find
ListingService "1" ..> "1" IListingRepository : asks to find
BDService "1" ..> "1" IBibliographicalDataRepository : asks to find
PSService "1" ..> "1" IPublicationSampleRepository : asks to find
}

' =====================================================
' DTO / MAPPER LAYER
' =====================================================
package "DTO / Mappers" {

class AuctionDTO {
  +auctionId: String
  +listingId: String
  +listingTitle: String
  +listingDescription: String
  +auctionStartDateTime: LocalDateTime
  +auctionEndDateTime: LocalDateTime
  +closedAt: LocalDateTime
  +initialPrice: BigDecimal
  +buyoutPrice: BigDecimal
  +finalPrice: BigDecimal
  +auctionStatus: String
}

class AuctionMapper {
  +toDTOs(auctions:List<Auction>, listingMap:Map<ListingId,Listing>) : List<AuctionDTO>
  +toDTO(auction:Auction, listing:Listing) : AuctionDTO
}

Controller "1" ..> "1" AuctionMapper : maps response
Controller "1" ..> "1" AuctionDTO : returns to display
}

' =====================================================
' PERSISTENCE LAYER
' =====================================================
package "Persistence / Infrastructure" {

class AuctionDM
class ListingDM

class AuctionAssembler {
  +toDomain(dm:AuctionDM) : Auction
}

class ListingAssembler {
  +toDomain(dm:ListingDM) : Listing
}

interface IAuctionRepositoryJPA
interface IListingRepositoryJPA
interface IBibliographicalDataRepositoryJPA
interface IPublicationSampleRepositoryJPA

class AuctionRepositoryJPAImpl {
  +findByListingIdIn(listingIds:List<ListingId>) : List<Auction>
  +findByListingIdInOrderByAuctionDeadlineAsc(listingIds:List<ListingId>) : List<Auction>
}

class ListingRepositoryJPAImpl {
  +findAllByAuctionAndPublicationSampleIdIn(pubSampleIds:List<PublicationSampleId>) : List<Listing>
}

class BibliographicalDataRepositoryJPAImpl {
  +findAllByGenreId(genreId:GenreId) : List<BibliographicalDataId>
}

class PublicationSampleRepositoryJPAImpl {
  +findIdsByBibliographicalDataIdIn(bdIds:List<BibliographicalDataId>) : List<PublicationSampleId>
}

AuctionRepositoryJPAImpl "1" ..> "1" IAuctionRepositoryJPA : uses
AuctionRepositoryJPAImpl "1" ..|> "1" IAuctionRepository : implements
AuctionJPA "1" ..|> "1" IAuctionRepositoryJPA : implements
IAuctionRepositoryJPA "1" ..> "1..*" AuctionDM : persists
AuctionRepositoryJPAImpl "1" --> "1" AuctionAssembler : ask to convert
AuctionAssembler "1" ..> "1..*" Auction : converts
AuctionRepositoryJPAImpl "1" ..> "1" AuctionJPA : generates at runtime

ListingRepositoryJPAImpl "1" ..> "1" IListingRepositoryJPA : uses
ListingRepositoryJPAImpl "1" ..|> "1" IListingRepository : implements
ListingJPA "1" ..|> "1" IListingRepositoryJPA : implements
IListingRepositoryJPA "1" ..> "1..*" ListingDM : persists
ListingRepositoryJPAImpl "1" --> "1" ListingAssembler : ask to convert
ListingAssembler "1" ..> "1..*" Listing : converts
ListingRepositoryJPAImpl "1" ..> "1" ListingJPA : generates at runtime

BibliographicalDataRepositoryJPAImpl "1" ..|> "1" IBibliographicalDataRepository : implements
BDJPA "1" ..|> "1" IBibliographicalDataRepositoryJPA : implements
BibliographicalDataRepositoryJPAImpl "1" ..> "1" BDJPA : generates at runtime

PublicationSampleRepositoryJPAImpl "1" ..|> "1" IPublicationSampleRepository : implements
PSJPA "1" ..|> "1" IPublicationSampleRepositoryJPA : implements
PublicationSampleRepositoryJPAImpl "1" ..> "1" PSJPA : generates at runtime
}

' =====================================================
' CROSS CUTTING
' =====================================================

Controller "1" ..> "1" LinkProvider : adds HATEOAS links

@enduml