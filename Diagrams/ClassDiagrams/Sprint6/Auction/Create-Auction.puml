@startuml
title Class Diagram - Create and Persist an Auction (POST)

skinparam packageStyle rectangle
left to right direction

' =====================================================
' DATABASE
' =====================================================
package "Database" {
    class DB <<Database>>
}

' =====================================================
' AUTO GENERATED / JPA
' =====================================================
package "Infrastructure / AutoGenerated JPA" {

class "AuctionJPAImpl" as AuctionJPA

AuctionJPA "1" ..> "1..*" DB : queries
}

' =====================================================
' REST CONTROLLER LAYER
' =====================================================
package "REST Controllers" {

class "AuctionRESTController" as Controller {
  +createAuction(requestDTO:CreateAuctionDTO, userId:String) : ResponseEntity<AuctionDTO>
}

class "AuctionLinkProvider" as LinkProvider {
  +getLinksForAuction(userId:UserId) : List<Link>
}
}

' =====================================================
' APPLICATION LAYER
' =====================================================
package "Application / Services" {

class "AuctionService" as Service {
  +createAndSave(listingId:ListingId, startDateTime:LocalDateTime,\nendDateTime:LocalDateTime, initialPrice:Price, buyoutPrice:Price, userId:UserId) : Auction
}

class "AuctionAuthorizationPolicy" as AuthPolicy {
  +canCreateAuction(user:User) : boolean
}

class "ListingService" as ListingService {
  +findById(listingId:ListingId) : Listing
}

Controller "1" ..> "1" Service : uses
Controller "1" ..> "1" ListingService : uses
Service "1" ..> "1" AuthPolicy : validates
}

' =====================================================
' DOMAIN LAYER
' =====================================================
package "Domain" {

class Auction {
  -auctionId: AuctionId
  -listingId: ListingId
  -auctionStartDateTime: LocalDateTime
  -auctionEndDateTime: LocalDateTime
  -initialPrice: Price
  -buyoutPrice: Price
  -auctionStatus: AuctionStatus
  -closedAt: LocalDateTime
  -finalPrice: Price
}

class AuctionFactory {
  +create(listingId:ListingId, startDateTime:LocalDateTime,\nendDateTime:LocalDateTime, initialPrice:Price, buyoutPrice:Price) : Auction
  +create(auctionId:AuctionId, listingId:ListingId, startDateTime:LocalDateTime,\n endDateTime:LocalDateTime, initialPrice:Price, buyoutPrice:Price) : Auction
}

interface IAuctionRepository {
  +save(auction:Auction) : Auction
  +update(auction:Auction) : Auction
  +findById(id:AuctionId) : Optional<Auction>
  +findAll() : List<Auction>
  +findByListingIdIn(listingIds:List<ListingId>) : List<Auction>
  +findByListingIdInOrderByAuctionDeadlineAsc(listingIds:List<ListingId>) : List<Auction>
}

interface IUserRepository {
  +findByID(userId:UserId) : Optional<User>
}

interface IListingRepository {
  +findById(id:ListingId) : Optional<Listing>
}

Service "1" ..> "1" AuctionFactory : asks to create
Service "1" ..> "1" IAuctionRepository : asks to persist
Service "1" ..> "1" IUserRepository : asks to find user
Service "1" ..> "1" IListingRepository : asks to validate listing
AuctionFactory "1" ..> "1..*" Auction : <<create>>
}

' =====================================================
' DTO / MAPPER LAYER
' =====================================================
package "DTO / Mappers" {

class CreateAuctionDTO {
  +listingId: String
  +startDateTime: LocalDateTime
  +endDateTime: LocalDateTime
  +initialPrice: BigDecimal
  +buyoutPrice: BigDecimal
}

class AuctionDTO {
  +auctionId: String
  +listingId: String
  +listingTitle: String
  +listingDescription: String
  +auctionStartDateTime: LocalDateTime
  +auctionEndDateTime: LocalDateTime
  +closedAt: LocalDateTime
  +initialPrice: BigDecimal
  +buyoutPrice: BigDecimal
  +finalPrice: BigDecimal
  +auctionStatus: String
}

class AuctionMapper {
  +toDTO(auction:Auction, listing:Listing) : AuctionDTO
  +toDTOs(auctions:List<Auction>, listingMap:Map<ListingId,Listing>) : List<AuctionDTO>
  +toAuctionId(auctionId:String) : AuctionId
  +toListingId(listingId:String) : ListingId
  +toUserId(userId:String) : UserId
  +toPrice(price:String) : Price
}

Controller "1" ..> "1" AuctionMapper : maps request/response
CreateAuctionDTO "1" ..> "1" Controller : received by
Controller "1" ..> "1" AuctionDTO : returns to display
}

' =====================================================
' PERSISTENCE LAYER
' =====================================================
package "Persistence / Infrastructure" {

class AuctionDM

class AuctionAssembler {
  +toDM(auction:Auction) : AuctionDM
  +toDomain(dm:AuctionDM) : Auction
}

interface IAuctionRepositoryJPA

class AuctionRepositoryJPAImpl {
  +save(auction:Auction) : Auction
  +update(auction:Auction) : Auction
  +findById(id:AuctionId) : Optional<Auction>
  +findAll() : List<Auction>
  +findByListingIdIn(listingIds:List<ListingId>) : List<Auction>
  +findByListingIdInOrderByAuctionDeadlineAsc(listingIds:List<ListingId>) : List<Auction>
}

AuctionRepositoryJPAImpl "1" ..> "1" IAuctionRepositoryJPA : uses
AuctionRepositoryJPAImpl "1" ..|> "1" IAuctionRepository : implements
AuctionJPA "1" ..|> "1" IAuctionRepositoryJPA : implements

IAuctionRepositoryJPA "1" ..> "1..*" AuctionDM : persists

AuctionRepositoryJPAImpl "1" --> "1" AuctionAssembler : ask to convert
AuctionAssembler "1" ..> "1..*" AuctionDM : converts
AuctionAssembler "1" ..> "1..*" Auction : converts
AuctionRepositoryJPAImpl "1" ..> "1" AuctionJPA : generates at runtime
}

' =====================================================
' CROSS CUTTING
' =====================================================

Controller "1" ..> "1" LinkProvider : adds HATEOAS links
Controller "1" ..> "1" AuctionDTO : returns to display

@enduml