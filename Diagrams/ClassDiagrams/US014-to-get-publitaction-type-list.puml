@startuml
title US014 - Get Publication Types

class ToGetPublicationTypeController {
    +getAllPublicationTypes() : List<PublicationTypeDTO>
}

class PublicationTypeRepository {
    -publicationTypes : List<PublicationType>
    +getAllPublicationTypes() : List<PublicationType>
}

class PublicationTypeMapper {
    +toDTO(list : List<PublicationTypeDTO>)
}

class PublicationTypeDTO {
    +mediaFormat : MediaFormat
    +typeOfBinding : TypeOfBinding
    +details : String
}

class PublicationType {
    -mediaFormat : MediaFormat
    -typeOfBinding : TypeOfBinding
    -details : String
    +getAllDetails
}

ToGetPublicationTypeController "1" -.-> "1" PublicationTypeRepository : uses
ToGetPublicationTypeController "1" -.-> "1" PublicationTypeMapper : uses
PublicationTypeMapper "1" -.> "1" PublicationTypeDTO : maps
PublicationTypeRepository "1" --> "1" PublicationType : contains
@enduml