@startuml
title US009 - To create a library - Class Diagram


class UI009 {
}


class US009ToCreateLibraryCtrl {
    - libraryRepository: LibraryRepository
    - userRepository: UserRepository
    + createAndAddLibrary(libraryName, username): boolean
}

class UserRepository {
    + findIdByUsername(username): UserId
}

class LibraryRepository {
    - libraries: Map<UserId, Library>
    + createAndAdd(libraryName, userId): Library
    - verifyIfUserHasALibrary(userId): boolean
}


class LibraryFactory {
    + create(libraryName, userId): Library
}


class Library {
}


' Relationships
UI009 ..> US009ToCreateLibraryCtrl: uses
US009ToCreateLibraryCtrl ..> UserRepository: uses
US009ToCreateLibraryCtrl ..> LibraryRepository: uses
LibraryRepository "1" --> "1" LibraryFactory: uses
LibraryRepository "1" --> "*" Library: manages
LibraryFactory ..> Library: creates

@enduml