@startuml
title US026 - To get the list of items on auction of a given author

class GetListOfItemsOnAuctionOfGivenAuthorController {
  +getListOfItemsOnAuction(author)
  -copyList(l1)
}

class ListingRepository {
  +getListOfItems(typeOfSale, author)
  -validateParameters(typeOfSale, author)
}

class Listing {
  - item: Item
  - saleType: SaleType
}

enum SaleType {
    DIRECT_SALE
    AUCTION
}

class Item {
    - bibliographicalData: BibliographicalData
}

class BibliographicalData {
    - author: List<Profile>
    }

' Interactions

GetListOfItemsOnAuctionOfGivenAuthorController  "1 " -- "1 " ListingRepository : uses >
ListingRepository "1 " -- " * " Listing : retrieves >
Listing "                                *" --> "1 " SaleType : can be\nsold by >
Listing "1"--> "1    " Item : lists an >
Item "*" -- "1 " BibliographicalData: has >

@enduml
