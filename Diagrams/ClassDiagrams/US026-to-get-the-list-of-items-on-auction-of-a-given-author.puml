@startuml
hide circle
title US026 - To get the list of items on auction of a given author



' Controller
class ToGetTheListOfItemsOnAuctionOfAGivenAuthorController {
  +getAllAuthors()
  +getListOfItemsOnAuction(author)
}

' Repositories
class AuthorRepository {
  +getAllAuthors()
}

class AuctionRepository {
  +getListOfItemsOnAuction(author)
  -checkAuctionAuthor(author)
}



' Mappers
class AuthorDTO_US026 {
  +toDTO(listOfAllAuthors)
}

class AuctionDTO_US026 {
  +toDTO(listOfAuction)
}

' Domain classes
class Auction {
  - listing: Listing
  - auctionDate: LocalDateTime
  +getDetails()
}

' Interactions
ToGetTheListOfItemsOnAuctionOfAGivenAuthorController ..> AuctionRepository : uses
ToGetTheListOfItemsOnAuctionOfAGivenAuthorController ..> AuthorRepository : uses
ToGetTheListOfItemsOnAuctionOfAGivenAuthorController ..> AuthorDTO_US026 : uses
ToGetTheListOfItemsOnAuctionOfAGivenAuthorController ..> AuctionDTO_US026 : uses
AuctionDTO_US026 ..> Auction : communicates with

@enduml
