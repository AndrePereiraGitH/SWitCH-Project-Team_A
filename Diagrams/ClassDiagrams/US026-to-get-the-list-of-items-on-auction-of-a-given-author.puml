@startuml
title US026 - To get the list of items on auction of a given author

class UI026{

}

class ToGetTheListOfItemsOnAuctionOfAGivenAuthorController {
  +getAllAuthors()
  +getListOfItemsOnAuction(author)
}

class AuthorRepository{
    +getAllAuthors()
}

class AuctionRepository {
  +getListOfItemsOnAuction(author)
}

class Auction {
  - listing: Listing
  +getDetails()
}

class AuctionMapper {
  +toDTO(listOfAuction)
}

class AuctionDTO {
}

/'
class Listing {
  - item: Item
  - saleType: SaleType
}

enum SaleType {
    DIRECT_SALE
    AUCTION
}

'class Item {
'    - bibliographicalData: BibliographicalData
'}

class Item {
    - publication: publication
}

class Publication {
    - bibliographicalData: BibliographicalData
    - code: Code
}

class BibliographicalData {
    - title: String
}
'/

' Interactions

UI026 ..> ToGetTheListOfItemsOnAuctionOfAGivenAuthorController : uses
ToGetTheListOfItemsOnAuctionOfAGivenAuthorController ..> AuctionRepository : uses
ToGetTheListOfItemsOnAuctionOfAGivenAuthorController ..> AuthorRepository: uses
AuctionRepository "1 " --> " * " Auction : contains
ToGetTheListOfItemsOnAuctionOfAGivenAuthorController ..> AuctionMapper : uses
AuctionMapper ..> AuctionDTO : maps to
AuctionMapper ..> Auction : uses
/'
Auction "1" -- "1" Listing : uses
Listing "                                *" -- "1" SaleType : can be sold by
Listing "1" -- "1..*    " Item : lists an
' Item "*" -- "1" BibliographicalData: has
Item "*" -- "1" Publication: refers to a
Publication "*" -- "1" BibliographicalData: has
'/

@enduml
