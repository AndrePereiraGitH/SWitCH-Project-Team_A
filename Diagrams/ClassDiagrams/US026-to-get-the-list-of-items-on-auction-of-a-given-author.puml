@startuml
title US025 - To get the list of items on auction of a given author

class ListTheItemsOnAuctionByAuthorController {
  +getListOfItems(typeOfSale, author)
  #copyList(items)
}

class ItemRepository {
  +getListOfItems(typeOfSale, author)
  ' -convertStringToEnum(typeOfSale, author)
  -validateParameters(typeOfSale, author)
}

class Item {
  - bibliographicalData: BibliographicalData
}

enum SaleType {
    DIRECT_SALE
    AUCTION
}

class BibliographicalData {
    - authors: List<Profile>;
}

' Interactions

ListTheItemsOnAuctionByAuthorController  "1 " -- "1 " ItemRepository : uses >
ItemRepository "1 " -- " * " Item : retrieves >
Item "                                *" --> "1" SaleType : can be\nsold by >
Item "*"--> "1  " BibliographicalData : has >

@enduml