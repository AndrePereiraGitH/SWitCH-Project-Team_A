@startuml
title Get Official Genres List - Class Diagram
top to bottom direction
class ToGetListOfGenreController << controller >>
interface IGenreRepository << repository >>
class GenreRepositoryJPAImp << repository >>
class GenreDM << entity >>
class Genre << aggregate/entity >>
class US013GenreDTO << DTO >>
' ── UI Layer ───────────────────────────────────────────────
class UI {
}

' ── Application Layer ──────────────────────────────────────
class ToGetListOfGenreController {
    - genreRepository: IGenreRepository
    - mapper: US013GenreMapper
    + ToGetListOfGenreController(genreRepository: IGenreRepository, mapper: US013GenreMapper)
    + getGenresList(): List<US013GenreDTO>
}

class US013GenreMapper {
    + toDTOList(genres: List<Genre>): List<US013GenreDTO>
    - toDTO(genre: Genre): US013GenreDTO
}

class US013GenreDTO {
    - genreId: String
    - genreType: String
}

' ── Domain Layer ───────────────────────────────────────────
interface IGenreRepository {
    + getAllGenres(): List<Genre>
}

class Genre {
    - Id: GenreId
    - genreType: String
    + id(): GenreId
    + getGenreType(): String
}

class GenreId {
    - id: String
    + getId(): String
}

class GenreFactory {
    + create(genreId: GenreId, genreType: String): Genre
}

' ── Infrastructure Layer ───────────────────────────────────
class GenreRepositoryJPAImp {
    - genreRepositoryJPA: IGenreRepositoryJPA
    - assembler: GenreAssembler
    + getAllGenres(): List<Genre>
}

interface IGenreRepositoryJPA {
    + getAllGenres(): List<GenreDM>
}

class GenreAssembler {
    - factory: GenreFactory
    + toDM(genre: Genre): GenreDM
    - toDomain(genreDM: GenreDM): Genre
}

class GenreDM {
    - id: GenreId
    - genreType: String
}

Rectangle DataBase {
}

' ── Relationships ──────────────────────────────────────────
UI "1" ..> "1" ToGetListOfGenreController : uses

ToGetListOfGenreController "1" ..> "1" IGenreRepository : uses
ToGetListOfGenreController "1" ..> "1" US013GenreMapper : uses

US013GenreMapper "1" ..> "0..*" Genre : reads
US013GenreMapper "1" ..> "0..*" US013GenreDTO : creates

GenreRepositoryJPAImp "1" ..|> "1" IGenreRepository : implements
GenreRepositoryJPAImp "1" ..> "1" IGenreRepositoryJPA : uses
GenreRepositoryJPAImp "1" ..> "1" GenreAssembler : uses

IGenreRepositoryJPA "1" ..> "1" DataBase : queries

GenreAssembler "1" ..> "0..*" GenreDM : reads
GenreAssembler "1" ..> "1" GenreFactory : uses

GenreFactory "1" ..> "0..*" Genre : creates

Genre "1" --> "1" GenreId : has
GenreDM "1" --> "1" GenreId : has

@enduml