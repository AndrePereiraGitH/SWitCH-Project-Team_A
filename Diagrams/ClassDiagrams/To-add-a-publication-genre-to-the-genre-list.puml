@startuml
title To add a publication genre to the genre list

' _____________________
' DOMAIN
' _____________________

interface IGenreRepository {
  + save(genre : Genre) : Genre
  + findByTitle(title : String) : Optional<Genre>
  + findAll() : List<Genre>
  + findById(genreId : GenreId) : Optional<Genre>
}

class Genre {
  - _id : GenreId
  - _genreType : String
  + id() : GenreId
  + getGenreType() : String
  + sameAs(object : Object) : boolean
}

class GenreId {
  - genreID : String
  + getID() : String
}

class GenreFactory {
  + create(genreType : String) : Genre
  + create(genreId : GenreId, genreType : String) : Genre
}

Genre "1" --> "1" GenreId : identified by
GenreFactory "1" ..> "*" Genre : <<creates>>

' ______________________
' APPLICATION
' ______________________

class ToRegisterGenreController {
  - genreService : GenreService
  + registerGenre(genreType : String) : boolean
}

class GenreService {
  + createAndSave(genreType : String) : Genre
}

' ___________________
' PERSISTENCE
' ___________________

class GenreRepositoryJpaImpl {
  + save(genre : Genre) : Genre
  + findByTitle(title : String) : Optional<Genre>
  + findAll() : List<Genre>
  + findById(genreId : GenreId) : Optional<Genre>
}

interface IGenreRepositoryJpa {
  + findByGenreType(genreType : String) : Optional<GenreDM>
}

class GenreAssembler {
  + toDM(genre : Genre) : GenreDM
  + toDomain(dm : GenreDM) : Genre
}

class GenreDM {
  - id : GenreId
  - genreType : String
  + getId() : GenreId
  + getGenreType() : String
}

rectangle Database {
}

GenreRepositoryJpaImpl ..|> IGenreRepository : <<implements>>
GenreRepositoryJpaImpl "1" ..> "1" IGenreRepositoryJpa : uses
GenreRepositoryJpaImpl "1" ..> "1" GenreAssembler : uses
IGenreRepositoryJpa --|> JpaRepository : extends
GenreAssembler "1" ..> "1" GenreFactory : uses
IGenreRepositoryJpa "1" ..> "0..*" GenreDM : returns
IGenreRepositoryJpa "1" ..> "1" Database : queries

' _____________________
' DEPENDENCIES
' _____________________

ToRegisterGenreController "1" ..> "1" GenreService : uses
GenreService "1" ..> "1" IGenreRepository : uses
GenreService "1" ..> "1" GenreFactory : uses

@enduml