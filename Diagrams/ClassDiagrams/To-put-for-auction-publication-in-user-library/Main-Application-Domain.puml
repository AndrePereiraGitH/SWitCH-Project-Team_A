class ToPutForAuctionPublicationInUserLibraryController <<Controller>>{
  +getAllPublicationsInUserLibrary(userId: UserId): List<PublicationSampleDTO>
  +createAuctionListing(listingTitle: String, selectedPublicationsID: List<PublicationSampleId>,\n initialPrice: BigDecimal, shortDescription: String, sellerId: UserId, pictures: List<String>,\n initialDate: LocalDateTime, finalDate: LocalDateTime, buyoutPrice: BigDecimal): boolean
}

class ListingService <<Service>> {
  +createAndSave(listingTitle: String, selectedPublicationsID: List<PublicationSampleId>, saleType: SaleType,\n initialPrice: BigDecimal, shortDescription: String, sellerId: UserId, pictures: List<String>): Listing
}

class AuctionService <<Service>>{
  +createAndSave(listingId: ListingId, initialDate: LocalDateTime, finalDate: LocalDateTime,\n initialPrice: BigDecimal, buyoutPrice: BigDecimal): Auction
}

class Library <<Aggregate Root>> {
  -id: LibraryId
  -libraryName: String
  -userId: UserId
}

class PublicationSample <<Aggregate Root>> {
  -id: PublicationSampleId
  -bibliographicalDataId:PublicationSampleId
  -ownerId: UserId
  -publicationStatus: PublicationStatus
  -editionId: EditionId
  -condition: String
  +changeStatusToForSale()
}

class Listing <<Aggregate Root>> {
  -id: ListingId
  -listingTitle: String
  -itemsId: List<PublicationSampleId>
  -saleType: SaleType
  -price: BigDecimal
  -shortDescription: String
  -sellerId: UserId
  -pictures: List<String>
}

class Auction <<Aggregate Root>> {
  -id: AuctionId
  -listingId: ListingId
  -auctionStartDateTime: LocalDateTime
  -auctionFinalDateTime: LocalDateTime
  -initialPrice: BigDecimal
  -buyoutPrice: BigDecimal
}

interface ILibraryRepository <<Repository>> {
  +getByUserId(userId: LibraryId): Library
}

interface IPublicationSampleRepository <<Repository>>{
  +findByLibraryId(libraryId: LibraryId): List<PublicationSample>
}

interface IListingRepository <<Repository>>{
  +save(listing: Listing): Listing
}

interface IAuctionRepository <<Repository>>{
  +save(auction: Auction): Auction
}

class PublicationSampleDTO <<DTO>>

class US016_PublicationSampleMapper <<Mapper>> {
  +fromDomainList(pubDomainList: List<PublicationSample>)
}

note as PersistenceLink
[[Persistence.puml Open Persistence Diagram]]
end note

note right of IListingRepository
[[Persistence.puml Listing persistence]]
end note

note right of IAuctionRepository
[[Persistence.puml Auction persistence]]
end note

ToPutForAuctionPublicationInUserLibraryController --> ILibraryRepository
ToPutForAuctionPublicationInUserLibraryController --> IPublicationSampleRepository
ToPutForAuctionPublicationInUserLibraryController --> US016_PublicationSampleMapper
ToPutForAuctionPublicationInUserLibraryController --> ListingService
ToPutForAuctionPublicationInUserLibraryController --> AuctionService

ListingService --> IListingRepository
AuctionService --> IAuctionRepository

Library "1" --> "0..*" PublicationSample : contains
Listing "1" --> "1..*" PublicationSample : lists by itemsId
Auction "1" --> "1" Listing : auction of

US016_PublicationSampleMapper --> PublicationSample
US016_PublicationSampleMapper --> PublicationSampleDTO

@enduml