@startuml
title To get the list of items on direct sale of a given publication

' -------------------------
' Controller
' -------------------------

class ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController {
  + findAllBibliographicalData() : List<US023BibliographicalDataDTO>
  + findListOfItemsOnDirectSale(bibliographicalDataId bdId) : List<US023ListingDTO>
}

' -------------------------
' Bibliographical Data
' -------------------------

interface IBibliographicalDataRepository {
  + findAll() : List<BibliographicalData>
}

interface IBibliographicalDataRepositoryJPA {
  + findAll() : List<BibliographicalDataDM>
}

class BibliographicalDataAssembler {
    + toDomain(List<BibliographicalDataDM> listOfBDDMs): List<BibliographicalData>
}

class BibliographicalDataDM {
    - bdId: BibliographicalDataId
    - title: String
    - originalLanguage: Locale
    - publicationDate: LocalDate
    - genres: List<GenreId>
    - chunksOfText: String
}

class BibliographicalDataFactory {
    + create(BibliographicalDataId bdId, String title, List<AuthorId> authorIds, Locale language,
     LocalDate publicationDate, List<GenreId> genreIds, String chunksOfText) : BibliographicalData
}

class BibliographicalData {
  - bdId : BibliographicalDataId
  - title : String
  - authorsId : List<AuthorId>
}

class US023BibliographicalDataMapper {
    + toDTO(BibliographicalData bd) : US023BibliographicalDataDTO
    + toDTOs(List<BibliographicalData> listOfAllBD) : List<US023BibliographicalDataDTO>
}

record US023BibliographicalDataDTO {
    - bdId: String
    - pubTitle: String
    - authorsName: List<String>
}

' -------------------------
' Publication Sample
' -------------------------

interface IPublicationSampleRepository {
  + findIdsByBibliographicalDataId(BibliographicalDataId bdId):\nList<PublicationSampleId>
}

interface IPublicationSampleRepositoryJPA {
  + findIdsByBibliographicalDataId(BibliographicalDataId bdId):\nList<PublicationSampleId>
}

class PublicationSampleId {
}

/'
class PublicationSample {
    - publicationSampleId: PublicationSampleId
    - bibliographicalDataId: BibliographicalDataId
    - ownerId: UserId
    - publicationStatus: PublicationStatus
    - editionId: EditionId
    - condition: Condition
    - libraryId: LibraryId
    - collecOfPubId: CollectionOfPublicationsId
}
'/

' -------------------------
' Listing
' -------------------------

interface IListingRepository {
    + findAllByDirectSaleAndPublicationSampleIdIn(List<PublicationSampleId> publicationSampleIds): List<Listing>
}

interface IListingRepositoryJPA {
   + findAllByItemsId(List<PublicationSampleId> itemsId): List<ListingDM>
}

class ListingAssembler {
    + toDomain(List<ListingDM> listOfDSListingDMs): List<Listing>
}

class ListingDM  {
  - listingId : ListingId
  - listingTitle : String
  - publicationSampleIds : List<PublicationSampleId>
  - saleType : SaleType
  - sellerId: UserId
  - price: String
  - shortDescription: String
  - pictures: List<String>
}

class ListingFactory {
    + create(ListingId listingId, String listingTitle, List<PublicationSampleId> itemsId, SaleType saleType,
     Price price, String shortDescription, UserId sellerId, List<Picture> pictures): Listing
}

class Listing {
  - listingId : ListingId
  - listingTitle : String
  - publicationSampleIds : List<PublicationSampleId>
  - saleType : SaleType
  - sellerId: UserId
  - price: Price
  - shortDescription: String
  - pictures: List<Picture>
}

class US023ListingMapper {
    + toDTO(Listing listing) : US023ListingDTO
    + toDTOs(List<Listing> listOfDSListings) : List<US023ListingDTO>
}

record US023ListingDTO {
    - listingId: String
    - listingTitle: String
    - price: String
    - pubTitles: List<String>
    - authorsName: List<String>
}

' Value Objects
enum SaleType {
  DIRECT_SALE
  AUCTION
}

' -------------------------
' RELATIONSHIPS
' -------------------------

' --- Controller ---
ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController "1" --> "1" IBibliographicalDataRepository : retrieves data
ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController "1" --> "1" US023BibliographicalDataMapper : maps to DTO
ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController "1" --> "1" IPublicationSampleRepository : retrieves data
ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController "1" --> "1" IListingRepository : retrieves data
ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController "1" --> "1" US023ListingMapper : maps to DTO

' --- Bibliographical Data ---
IBibliographicalDataRepositoryJPA "1" --|> "1" IBibliographicalDataRepository: implements
IBibliographicalDataRepository "1" --> "1" BibliographicalDataAssembler: converts DM to Domain

BibliographicalDataAssembler "1" --> "1" BibliographicalDataFactory: uses
BibliographicalDataAssembler "1" ..> "1" BibliographicalDataDM: uses

BibliographicalDataFactory "1" --> "1" BibliographicalData : creates

US023BibliographicalDataMapper "1" ..> "1" US023BibliographicalDataDTO : maps to

' --- Publication Sample ---
IPublicationSampleRepositoryJPA "1" --|> "1" IPublicationSampleRepository: implements
IPublicationSampleRepository "1" --> "1" PublicationSampleId: uses
'IPublicationSampleRepository "1" --> "*" PublicationSample: persists

' --- Listing ---
IListingRepositoryJPA "1" --|> "1" IListingRepository: implements
IListingRepository "1" --> "1" ListingAssembler: converts DM to Domain

ListingAssembler "1" --> "1" ListingFactory: uses
ListingAssembler "1" ..> "1" ListingDM: uses

ListingFactory "1" --> "1" Listing: creates

Listing "*" --> "1" SaleType : for sale in

US023ListingMapper "1" ..> "1" US023ListingDTO : maps to

@enduml

