@startuml
title US005 - Register Author in MIteLovers

class ToRegisterAuthorController {
  -AuthorRepository: AuthorRepository
  +registerAuthor(name: String, country: Country, birthday: LocalDate, biography: String): Author
}

class AuthorRepository {
  -_authors: List<Author>
  +createAndAddAuthor(name: String, country: Country, birthday: LocalDate, biography: String): Author
  -exists(author: Author): boolean
}

class Author {
  -_authorProfile: Profile
  -_biography: String
  +getProfile(): Profile
  +getBiography(): String
}

class Profile {
  -_name: String
  -_country: Country
  -_birthday: LocalDate
  +getName(): String
  +getCountry(): Country
  +getBirthday(): LocalDate
}

ToRegisterAuthorController "1" -.-> "1" AuthorRepository : uses
AuthorRepository "1" --> "*" Author : stores
AuthorRepository "1" -.-> "*" Author : creates
Author "1" --> "1" Profile : has

@enduml
