@startuml
title US005 - Register Author in MIteLovers

class ToRegisterAuthorController {
  +registerAuthor(name: String, countryId: CountryId, birthday: LocalDate, biography: String): Author
}

interface IAuthorRepository {
  +createAndAdd(name: String, countryId: CountryId, birthday: LocalDate, biography: String): Author
  /'NO NEED FOR THIS US +getAllAuthors()'/
  -exists(author: Author): boolean
}

class Author {
  -_name :String
  -_countryId: CountryId
  -_birthday: LocalDate
  -_biography: String
}

class AuthorFactory {
+ create(name: String, countryId: CountryId, \n birthday: LocalDate, biography: String): Author
}


ToRegisterAuthorController "1 " -.-> "1" IAuthorRepository : uses
IAuthorRepository "1" --> "_authors *" Author : stores
IAuthorRepository "1" -.-> "                     1" AuthorFactory : uses
AuthorFactory "1   " -.-> "*" Author : creates

@enduml
