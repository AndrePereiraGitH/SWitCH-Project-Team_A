@startuml

title US019 - As a User, I want to publicly share a list of mine

skinparam classAttributeIconSize 0

class ShareListController {
  -listRepo : ListRepository
  +shareList(listId : String) : void
}

class ListRepository {
  +getList(listId : String) : List
  +save(list : List) : boolean
}

class List {
  -isPublic : boolean
  +makePublic() : void
}

ShareListController --> ListRepository : uses
ListRepository --> List : returns

@enduml