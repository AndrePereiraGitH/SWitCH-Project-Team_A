@startuml
autonumber
hide footbox
title To put for sale a publication in my library in a direct sale (full diagram - backend)

participant ":Router" as Router

participant ":PublicationSample\nRESTController" as PSCtrl
participant ":Publication\nSampleMapper" as PSMapper
participant ":PublicationSample\nService" as PubService

participant ":IUserRepository" as UserRepo
participant "user:\nOptional<User>" as user

participant ":PublicationSample\nAuthorizationPolicy" as PubPolicy
participant ":IPublicationSample\nRepository" as PubRepo
participant "pbSampleList:\nList<PublicationSample>" as PSList
participant "publicationDTOS:\nList<PublicationSampleDTOs>" as PSListDTOs
participant "pbSampleDTO:\nPublicationSampleDTO" as PSDTO
participant ":PublicationSample\nLinkProvider" as PSLink
participant ":IBibliographical\nDataService" as BDService
participant ":IEdition\nService" as EditionService
participant ":IAuthor\nService" as AuthorService
participant ":IGenre\nService" as GenreService
participant ":IUser\nService" as UserService

participant ":Listing\nRESTController" as ListCtrl
participant ":Listing\nMapper" as ListMapper
participant "pbSampleIds:\nList<PublicationSampleId" as pbSampleIds
participant "pictures:\nList<Pictures" as pictures
participant ":Listing\nService" as LServ
participant ":ListingAuthorization\nPolicy" as ListPolicy
participant ":Listing\nFactory" as LFactory
participant "listing:\nListing" as listing
participant ":IListing\nRepository" as LRepo
participant "persistedListing:\nListingDM" as persistedListing
participant "listingDTO:\nListingDTO" as listingDTO
participant ":Listing\nLinkProvider" as ListLink

' ==========================================
' 1 — GET available publications for sale
' ==========================================

[o-> Router : OPTIONS /publicationSamples/available-for-sale
activate Router
Router -> PSCtrl : optionsAvailableForSale()
activate PSCtrl
PSCtrl --> Router : 200 OK\nAllow: GET, OPTIONS
deactivate PSCtrl
[o<-- Router : 200 OK\nAllow: GET, OPTIONS
deactivate Router

[o-> Router : GET /publicationSamples/available-for-sale?userId={userId}
activate Router
Router -> PSCtrl : findAvailableForSale(userId)
activate PSCtrl

PSCtrl -> PSMapper : toUserId(userId)
activate PSMapper
PSMapper --> PSCtrl : id: UserId
deactivate PSMapper

PSCtrl -> PubService : findAvailableForSale(id)
activate PubService

PubService -> UserRepo : findByID(id)
activate UserRepo
UserRepo ->o] : SELECT * FROM users WHERE id = ?
UserRepo <--o] : data
UserRepo -->> user ** : <<create>>
UserRepo --> PubService : user
deactivate UserRepo

alt user not found
    PubService --> PSCtrl : EntityNotFoundException
    PSCtrl --> Router : 404 Not Found
end

PubService -> PubPolicy : canFindAvailableForSale(user)
activate PubPolicy
PubPolicy --> PubService : boolean
deactivate PubPolicy

alt not allowed
    PubService --> PSCtrl : AccessDeniedException
    PSCtrl --> Router : 403 Forbidden
end

PubService -> PubRepo : findAvailableForSaleByUserId(id)
activate PubRepo
PubRepo ->o] : SELECT * FROM publication_sample\n WHERE owner_id = ? AND status NOT IN ('FOR_SALE', 'SOLD')
PubRepo <--o] : data
PubRepo -->> PSList ** : <<create>>
PubRepo --> PubService : pbSampleList
deactivate PubRepo

PubService --> PSCtrl : pbSampleList
deactivate PubService

PSCtrl -->> PSListDTOs ** : <<create>>

loop for each pbSample in pbSampleList
    PSCtrl -> BDService : findById(pbSample.getBibliographicalDataId())
    activate BDService
    BDService --> PSCtrl : bd
    deactivate BDService

    PSCtrl -> EditionService : findById(pbSample.getEditionId())
    activate EditionService
    EditionService --> PSCtrl : edition
    deactivate EditionService

    PSCtrl -> AuthorService : findById(authorId) [for each author in bd]
    activate AuthorService
    AuthorService --> PSCtrl : authors
    deactivate AuthorService

    PSCtrl -> GenreService : findById(genreId) [for each genre in bd]
    activate GenreService
    GenreService --> PSCtrl : genres
    deactivate GenreService

    PSCtrl -> UserService : findByID(pbSample.getOwnerId())
    activate UserService
    UserService --> PSCtrl : owner
    deactivate UserService

    PSCtrl -> PSMapper : toPublicationSampleDTO(pbSample, bd, edition, authors, genres, owner)
    activate PSMapper
    PSMapper -->> PSDTO ** : <<create>>
    PSMapper --> PSCtrl : pbSampleDTO
    deactivate PSMapper

    PSCtrl -> PSCtrl : links.add(linkTo(methodOn(PSCtrl).findById(pbSample.id().getID())).withSelfRel())

    PSCtrl -> PSLink : getPublicLinks()
    activate PSLink
    PSLink --> PSCtrl : publicLinks
    deactivate PSLink
    PSCtrl -> PSCtrl : links.addAll(publicLinks)

    PSCtrl -> PSLink : getDirectSaleLinks(id)
    activate PSLink
    PSLink --> PSCtrl : directSaleLinks
    deactivate PSLink
    PSCtrl -> PSCtrl : links.addAll(directSaleLinks)

    PSCtrl -> PSCtrl : links.forEach(pbSampleDTO::add)
    PSCtrl -> PSCtrl : publicationDTOS.add(pbSampleDTO)
end

PSCtrl --> Router : 200 OK\n body: publicationDTOS
deactivate PSCtrl
[o<-- Router : 200 OK\nbody: publicationDTOS
deactivate Router

' ==========================================
' FLOW 2 — POST create direct sale listing
' ==========================================

[o-> Router : OPTIONS /listings
activate Router
Router -> ListCtrl : optionsRouter()
activate ListCtrl
ListCtrl --> Router : 200 OK\nAllow: POST, GET, OPTIONS
deactivate ListCtrl
[o<-- Router : 200 OK\n Allow: POST, GET, OPTIONS
deactivate Router

[o-> Router : POST /listings\n body: {title, selectedPublicationIds,\nsaleType, price, shortDescription, userId, pictures}
activate Router
Router -> ListCtrl : createDirectSaleListing(title, selectedPublicationIds, saleType, price, shortDescription, userId, pictures)
activate ListCtrl

ListCtrl -> ListMapper : toUserId(userId)
activate ListMapper
ListMapper --> ListCtrl : userId: UserId
deactivate ListMapper

ListCtrl --> pbSampleIds **: «create»
loop for each selectedPublicationId in selectedPublicationIds
    ListCtrl -> ListMapper : toPublicationId(selectedPublicationId)
    activate ListMapper
    ListMapper --> ListCtrl : pbSampleId: PublicationSampleId
    deactivate ListMapper
    ListCtrl -> pbSampleIds: add(pbSampleId)
end

ListCtrl -> ListMapper : toSaleType(saleType)
activate ListMapper
ListMapper --> ListCtrl : saleType: SaleType
deactivate ListMapper

ListCtrl -> ListMapper : toPrice(price)
activate ListMapper
ListMapper --> ListCtrl : price: Price
deactivate ListMapper

ListCtrl --> pictures **: «create»
loop for each picture in pictures
    ListCtrl -> ListMapper : toPicture(picture)
    activate ListMapper
    ListMapper --> ListCtrl : picture: Picture
    deactivate ListMapper
    ListCtrl -> pictures: add(picture)
end

ListCtrl -> LServ : createAndSave(title, pubSampleIds, saleType, price, shortDescription, userId, pictures)
activate LServ

LServ -> UserRepo : findByID(userId)
activate UserRepo
UserRepo ->o] : SELECT * FROM users WHERE id = ?
UserRepo <--o] : data
UserRepo -->> user ** : <<create>>
UserRepo --> LServ : user
deactivate UserRepo

alt user not found
    LServ --> ListCtrl : EntityNotFoundException
    ListCtrl --> Router : 404 Not Found
end

LServ -> ListPolicy : canCreateListing(user)
activate ListPolicy
ListPolicy --> LServ : boolean
deactivate ListPolicy

alt not allowed
    LServ --> ListCtrl : AccessDeniedException
    ListCtrl --> Router : 403 Forbidden
end

LServ -> LServ: verifyPublicationsOwner(pbSampleIds, userId)

alt publications not owned by user
    LServ --> ListCtrl : AccessDeniedException
    ListCtrl --> Router : 403 Forbidden
end

LServ -> LFactory : create(title, pbSampleIds, saleType,\nprice, shortDescription, userId, pictures)
activate LFactory
LFactory -->> listing ** : <<create>>
LFactory --> LServ : listing
deactivate LFactory

LServ -> LRepo : save(listing)
activate LRepo
LRepo ->o] : INSERT INTO listings ...
LRepo <--o] : data
LRepo -->> persistedListing ** : <<create>>
LRepo --> LServ : persistedListing
deactivate LRepo

LServ --> ListCtrl : persistedListing
deactivate LServ

ListCtrl -> ListMapper : toListingDTO(persistedListing)
activate ListMapper
ListMapper -->> listingDTO ** : <<create>>
ListMapper --> ListCtrl : listingDTO
deactivate ListMapper

ListCtrl -> ListCtrl : links.add(linkTo(methodOn(ListCtrl).findById(persistedListing.id().getID())).withSelfRel())

ListCtrl -> ListLink : getPublicLinks()
activate ListLink
ListLink --> ListCtrl : publicLinks
deactivate ListLink
ListCtrl -> ListCtrl : links.addAll(publicLinks)

ListCtrl -> ListLink : getListingLinks(persistedListing.id())
activate ListLink
ListLink --> ListCtrl : listingLinks
deactivate ListLink
ListCtrl -> ListCtrl : links.addAll(listingLinks)

ListCtrl -> ListCtrl : links.forEach(listingDTO::add)

ListCtrl --> Router : 201 Created\n body: listingDTO
deactivate ListCtrl
[o<-- Router : 201 Created\n body: listingDTO
deactivate Router

@enduml