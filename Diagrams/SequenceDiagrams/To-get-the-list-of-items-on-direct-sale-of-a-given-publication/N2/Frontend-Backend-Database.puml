@startuml
autonumber
hide footbox
title To get the list of items on direct sale of a given publication

actor User
participant ":Frontend" as FE
participant "Backend" as BE
database "Database" as db

' ==========================================
' 1 — Get all bibliographical data
' ==========================================

User -> FE : I want to see the items\non direct sale of a publication
activate FE
FE -> BE : OPTIONS /bibliographicalDatas
activate BE
BE --> FE : 200 OK\nAllow: GET, OPTIONS
deactivate BE
FE -> BE : GET /bibliographicalDatas
activate BE
BE -> db : SELECT * FROM bibliographical_data
activate db
db --> BE : data
deactivate db
BE -> db : SELECT * FROM authors\nWHERE id IN (...)
activate db
db --> BE : data
deactivate db
BE --> FE : 200 OK\nbody: listOfAllBDDTOs
deactivate BE
FE --> User : Which publication?\nChoose from the list!
deactivate FE

' =======================================================
' 2 — Get listings on direct sale for a given publication
' =======================================================

User -> FE : Selected publication
activate FE
FE -> BE : OPTIONS /listings
activate BE
BE --> FE : 200 OK\nAllow: POST, GET, OPTIONS
deactivate BE
FE -> BE : GET /listings?bibliographicalDataId={bdId}&saleType=DIRECT_SALE
activate BE
BE -> db : SELECT * FROM listings
activate db
db --> BE : data
deactivate db
BE -> db : SELECT id FROM publication_sample\nWHERE bibliographical_data_id IN (?)
activate db
db --> BE : data
deactivate db
BE --> FE : 200 OK\nbody: listOfListingDetailsDTOs
deactivate BE
FE --> User : Here are the items on\ndirect sale for that publication
deactivate FE

@enduml