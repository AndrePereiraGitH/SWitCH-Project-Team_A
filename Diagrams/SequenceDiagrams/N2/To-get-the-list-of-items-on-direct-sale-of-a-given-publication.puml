@startuml
hide footbox
autonumber
title To get the list of items on direct sale of a given publication

box #whitesmoke
actor Buyer
participant ":UI" as UI
end box

participant ":ToGetTheListOfItemsOn\nDirectSaleOfAGivenPublicationController" as Ctrl

participant ":IBibliographicalData\nRepository" as BDRepo
participant ":US023Bibliographical\nDataMapper" as BDMapper

participant ":IListing\nRepository" as ListingRepo

participant ":IPublicationSample\nRepository" as PubSampleRepo
participant ":US023Publication\nSampleMapper" as PSMapper

' Section 1 - Get all publications
Buyer -> UI : I want to get the list of items\n on direct sale of a given publication
activate UI
UI -> Ctrl : getAllPublicationBD()
activate Ctrl
Ctrl -> BDRepo: getAllPublicationBD()
activate BDRepo
BDRepo -->> "listOfAllPublicationsBD:\n List<BibliographicalData>" ** : «create»
BDRepo --> Ctrl: listOfAllPublicationsBD
deactivate BDRepo

' Section 2 - Converts all publications list to DTO
Ctrl -> BDMapper: toDTOs(listOfAllPublicationsBD)
activate BDMapper
BDMapper -->> "bibliographicalDataDTO:\nUS023BibliographicalDataDTO" ** : «create»
loop for each bibliographicalData
   BDMapper -->> "listOfAllBibliographicalDataDTO:\nList<US023BibliographicalDataDTO>" **: «create»
   BDMapper -> "bibliographicalDataDTO:\nUS023BibliographicalDataDTO" : add(bibliographicalDataDTO)
end
BDMapper --> Ctrl : listOfAllBibliographicalDataDTO
deactivate BDMapper
Ctrl --> UI : listOfAllBibliographicalDataDTO
deactivate Ctrl
Buyer <-- UI : Which publication? Choose!
deactivate UI

Buyer -> UI : publication
activate UI
UI -> Ctrl : findListOfItemsOnDirectSale(bdId)
activate Ctrl

' Section 3 - Get PublicationSample IDs for that BibliographicalData ID
Ctrl -> PubSampleRepo : findPubSampleIdsByBibliographicalDataId(bdId)
activate PubSampleRepo
PubSampleRepo -->> "listOfPubSampleId:\nList<PublicationSampleId" ** : «create»
PubSampleRepo --> Ctrl : listOfPubSampleId
deactivate PubSampleRepo

' Section 4 - Get Direct Sale Listings for those PublicationSample IDs
Ctrl -> ListingRepo : findDirectSaleListingsContaining(listOfPubSampleId)
activate ListingRepo
ListingRepo -->> "listOfDSListings:\nList<Listing>" ** : «create»
ListingRepo --> Ctrl : listOfDSListings
deactivate ListingRepo

' Section 5 - create DTO for items
Ctrl -> PSMapper : toDTOs(listOfDSListings)
activate PSMapper
PSMapper  -->> "listOfPubSampleDTO:\nList<US023PublicationSampleDTO>" ** : «create»
loop for each listing
    PSMapper -->> "listingDTO:\nUS023ListingDTO"** : «create»
    PSMapper -> "listOfPubSampleDTO:\nList<US023PublicationSampleDTO>" : add(listingDTO)
end
PSMapper --> Ctrl : listOfListingDTOs
deactivate PSMapper
Ctrl --> UI : listOfListingDTOs
deactivate Ctrl
UI --> Buyer : Shows the list of items on direct sale
deactivate UI

@enduml