@startuml

autonumber
hide footbox
title Register a New City

actor Administrator
participant ":UI" as UI
participant ":ToRegisterNewCityController" as Controller
participant ":CityService" as Service
participant ":ICountryRepository" as CountryRepository
participant ":ICityRepository" as CityRepository
participant ":CityFactory" as Factory
participant ":CityAssembler" as Assembler
participant ":ICityRepositoryJPA" as JPA
database "Database" as DB

Administrator -> UI : request
UI -> Controller : register(countryName, cityName)

Controller -> Service : createAndSave(countryName, cityName)

Service -> CountryRepository : findCountryIdByCountryName(countryName)
CountryRepository --> Service : countryId

Service -> CityRepository : existsByCountryIDAndCityName(countryId, cityName)
CityRepository --> Service : false

Service -> Factory : create(countryId, cityName)
Factory -->> city** : <<create>>
Factory --> Service : city

Service -> CityRepository : save(city)

CityRepository -> Assembler : toDM(city)
Assembler -->> cityDM** : <<create>>
Assembler --> CityRepository : cityDM

CityRepository -> JPA : save(cityDM)
JPA -> DB : INSERT
DB --> JPA : persisted
JPA --> CityRepository : cityDM

CityRepository -> Assembler : toDomain(cityDM)

Assembler -> Factory : create(cityID, countryID, cityName)
Factory -->> city** : <<create>>
Factory --> Assembler : city

Assembler --> CityRepository : city

CityRepository --> Service : city
Service --> Controller : city
Controller --> UI : city
UI --> Administrator : success

@enduml