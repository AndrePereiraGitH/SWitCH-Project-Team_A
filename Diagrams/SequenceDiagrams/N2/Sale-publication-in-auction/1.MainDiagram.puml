@startuml
autonumber
hide footbox
title Sale a Publication in an auction

box #whitesmoke
    actor User
    participant ":UI" as UI
end box

participant ":SalePublicationInAuction\nController" as ctrl
participant ":ListingService" as listingService

participant "AuctionService" as auctionService

' ======== GET ALL PUBLICATIONS IN USER'S LIBRARY =========
User -> UI : I want to sell a publication of my library as an auction
activate UI

UI -> ctrl : getAllPublicationsInUserLibrary(userId)
activate ctrl

ref over ctrl
[[2.GetAllPublicationsInUserLibrary.puml Get publications from user's library]]
end ref

ctrl --> UI : listOfPublicationsDTO
deactivate ctrl

UI --> User : Please, select one or more publications from your library
deactivate UI

User -> UI : Selected publications: pub1_dto
activate UI
UI --> User : Please insert listingTitle, initialPrice,\nshortDescription, sellerId, pictures,\ninitialDate, finalDate, buyOutPrice
deactivate UI

' ========== CREATE AN AUCTION LISTING =============

User -> UI : Provide data
activate UI
UI -> ctrl : createAuctionListing (listingTitle, selectedPublicationsID, initialPrice, \n shortDescription, sellerId, pictures, initialDate, finalDate, buyoutPrice)
activate ctrl

ctrl -> listingService : createAndSave (listingTitle, selectedPublicationsID, SaleType.AUCTION,\n                             initialPrice, shortDescription, sellerId, pictures)
activate listingService

' ------- CREATE LISTING INSTANCE ---------------------

ref over listingService
[[3.CreateAndPersistListing.puml Create and persist Listing]]
end ref

listingService --> ctrl : persistedListing
deactivate listingService
' =========== CREATE AUCTION ==============

ctrl -> auctionService : createAndSave ( persistedListing.id(), initialDate, finalDate, initialPrice, buyOutPrice)

' ------ CREATE AUCTION INSTANCE ---------

ref over auctionService
[[4.CreateAndPersistAuction.puml Create and persist Auction]]
end ref

activate auctionService
auctionService --> ctrl : persistedAuction
deactivate auctionService

' ---- UI RETURN

ctrl --> UI : true
deactivate ctrl

UI --> User : Your publication(s) are now in an auction
deactivate UI
@enduml