@startuml
autonumber
hide footbox
title To Get All Publications In User's Library



participant ":Ctrl" as ctrl

participant ":ILibraryRepository" as libRepo
participant ":ILibraryRepositoryJPA" as libRepoJPA
participant "libraryDM:LibraryDM" as libraryDM
participant "libAssembler\n:LibraryAssembler" as libAssembler
participant ":LibraryFactory" as libFactory

participant "library : Library" as library

participant ":IPublicationSample\nRepository" as pubRepo


participant ":IPublicationSample\nRepositoryJPA" as pubRepoJPA
participant "samplesListDM\n:List<PublicationSampleDM>" as samplesListDM


participant "pubSampleDM\n:PublicationSampleDM" as pubSampleDM
database "DataBase" as db

participant ":PublicationSamples\nAssembler" as pubAssembler

participant ":PublicationSample\nFactory" as pubFactory
participant "pubDomainList\n:List<PublicationSample" as pubDomainList

participant "pubSampleDomain\n:PublicationSample" as pubSampleDomain

participant "samplesList \n:List<PublicationSample>" as samplesList

participant ":US016_PublicationSample\nMapper" as pubMapper


ref over ctrl
[[1.MainDiagram.puml Back to main diagram]]
end ref

note over ctrl #E3F2FD
<b>Fragment</b>
---
This diagram is a fragment of the main sequence diagram.
end note


' =========== GET USER'S LIBRARY ========================

ctrl -> libRepo : getByUserId(userId)
activate ctrl
activate libRepo
libRepo -> libRepoJPA : getByUserId (userId)
activate libRepoJPA
libRepoJPA -> db
activate db
db --> libRepoJPA : data
deactivate db

libRepoJPA -->> libraryDM ** : <<create>>

libRepoJPA --> libRepo : libraryDM
deactivate libRepoJPA

libRepo -> libAssembler : toDomain(libraryDM)
activate libAssembler

' ---- GET LIBRARY DM DATA -----

libAssembler -> libraryDM : id()
activate libraryDM
libraryDM --> libAssembler : id
deactivate libraryDM

libAssembler -> libraryDM : getLibraryName()
activate libraryDM
libraryDM --> libAssembler : libraryName
deactivate libraryDM

libAssembler -> libraryDM : getUserID()
activate libraryDM
libraryDM --> libAssembler : userId
deactivate libraryDM


libAssembler -> libFactory : create ( id, libraryName,\n userId)

activate libFactory
libFactory -->> library ** : <<create>>
libFactory --> libAssembler : library
deactivate libFactory
libAssembler --> libRepo : library
deactivate libAssembler
libRepo --> ctrl : library
deactivate libRepo



' ======== GET ALL PUBLICATIONS IN USER'S LIBRARY ============

ctrl -> pubRepo : getAllByLibraryID ( library.id())
activate pubRepo
pubRepo -> pubRepoJPA : getAllByLibraryId (library.id())
activate pubRepoJPA
pubRepoJPA -> samplesListDM** : <<create>>

loop for each publicationSampleDM
pubRepoJPA -> db
activate db
db --> pubRepoJPA : data
deactivate db

pubRepoJPA --> pubSampleDM ** : <<create>>
pubRepoJPA -> pubRepoJPA : samplesListDM.add(pubSampleDM)
end

pubRepoJPA --> pubRepo : samplesListDM
deactivate pubRepoJPA



pubRepo -> pubAssembler : toDomainList(samplesListDM)
activate pubAssembler
pubAssembler -->> pubDomainList** : <<create>>


loop for each pubDM in samplesListDM
pubAssembler -> pubFactory : create (pubDM.id, bibliographicalDataId,\n userId, publicationStatus, editionId,\n condition)
activate pubFactory
pubFactory -->> pubSampleDomain** : <<create>>
pubFactory --> pubAssembler : pubSampleDomain
deactivate pubFactory

pubAssembler -> pubAssembler : pubDomainList.add(pubSampleDomain)
end

pubAssembler --> pubRepo : pubDomainList
deactivate pubAssembler

pubRepo --> ctrl : pubDomainList
deactivate pubRepo


' ======= CONVERT LIST OF PUBLICATION SAMPLES INTO DTO

ctrl -> pubMapper : fromDomainList(pubDomainList, bibliographicalDataMap)
activate pubMapper

ref over pubMapper
[[5.ConvertToDTOList.puml Convert to a list of DTO]]
end ref

pubMapper --> ctrl : listOfPublicationsDTO

deactivate pubMapper
deactivate ctrl

@enduml