@startuml
hide footbox
autonumber
title US009 - To create a library


actor User
participant ":UI009" as UI

participant ":US009ToCreateLibraryCtrl" as Ctrl
participant ":LibraryRepository" as LibraryRepo
participant ":LibraryFactory" as factory


User -> UI : I want to create a library.
activate UI
UI --> User : What name?
deactivate UI
User -> UI : libraryName, user
activate UI

UI -> Ctrl : createAndAddLibrary(libraryName,user)
activate Ctrl
Ctrl -> LibraryRepo : createAndAdd(libraryName,user)
activate LibraryRepo



LibraryRepo -> LibraryRepo: verifyIfUserHasALibrary()

LibraryRepo -> factory: create(libraryName,user)
activate factory
create "lib1:Library" as Library
factory -> Library : create()
factory -> LibraryRepo: lib1
deactivate factory


LibraryRepo -> LibraryRepo : libraries.put(user,lib1)


LibraryRepo --> Ctrl : lib1
deactivate LibraryRepo
Ctrl --> UI : true
deactivate Ctrl
UI --> User : Your library was created
deactivate UI

@enduml