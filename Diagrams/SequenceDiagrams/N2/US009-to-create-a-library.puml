@startuml
hide footbox
autonumber
title US009 - To create a library


actor User
participant ":UI009" as UI

participant ":US009ToCreateLibraryCtrl" as Ctrl

participant ":IUserRepository" as userRepo
participant ":ILibraryRepository" as LibraryRepo
participant ":LibraryFactory" as factory


User -> UI : I want to create a library.
activate UI
UI --> User : What name?
deactivate UI
User -> UI : libraryName, username

activate UI

UI -> Ctrl : createAndAddLibrary(libraryName,username)

activate Ctrl

Ctrl -> userRepo: findIdByUsername(username)
activate userRepo
userRepo --> Ctrl: userId
deactivate userRepo


Ctrl -> LibraryRepo : createAndAdd(libraryName,userId)
activate LibraryRepo



LibraryRepo -> LibraryRepo: verifyIfUserHasALibrary()

LibraryRepo -> factory: create(libraryName,userId)
activate factory
create "lib1:Library" as Library
factory -->> Library : <<create>>
factory --> LibraryRepo: lib1
deactivate factory


LibraryRepo -> LibraryRepo : libraries.put(userId,lib1)


LibraryRepo --> Ctrl : lib1
deactivate LibraryRepo
Ctrl --> UI : true
deactivate Ctrl
UI --> User : Your library was created
deactivate UI

@enduml