' -------- Get All Authors in System --------
Ctrl -> AuthorRepository : getAllAuthors()
activate Ctrl
activate AuthorRepository
AuthorRepository --> Ctrl : listOfAllAuthors
deactivate AuthorRepository


'------ Convert List of Authors into DTO --------
Ctrl -> AuthorMapper : fromDomainList(listOfAllAuthors)
activate AuthorMapper
AuthorMapper -->> AuthorsListDto ** : <<create>>

loop for each author in list
    AuthorMapper -> AuthorDTO ** : fromDomain(author)
    AuthorMapper -> AuthorMapper : authorsDtoList.add(authorDTO)
end

AuthorMapper --> Ctrl : authorsDtoList
deactivate AuthorMapper

deactivate Ctrl
@enduml