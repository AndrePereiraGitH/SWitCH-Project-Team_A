@startuml
hide footbox
autonumber
title Ref - findIdsByPublicationSampleIdIn(pubIdList)

participant ":Controller" as Ctrl
participant ":IListingRepository" as listingRepo
participant ":IListingRepositoryJPA" as listingRepoJPA
participant "pubIdList\n:List<PublicationSampleId>" as pubIdList
participant "listingIdList\n:List<ListingId>" as listingIdList
database "Database" as db

Ctrl -> listingRepo : findIdsByPublicationSampleIdIn(pubIdList)
activate listingRepo

listingRepo -> listingRepoJPA : findAllByItemsId(pubIdList)
activate listingRepoJPA

listingRepoJPA -> db : query listingId by publicationSampleId
activate db
db --> listingRepoJPA : listingId values
deactivate db

listingRepoJPA -->> listingIdList ** : <<create>>
listingRepoJPA --> listingRepo : listingIdList
deactivate listingRepoJPA

listingRepo --> Ctrl : listingIdList
deactivate listingRepo

@enduml