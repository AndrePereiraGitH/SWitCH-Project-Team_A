@startuml
hide footbox
autonumber
title Find Listing Ids By PublicationSampleIds

participant ":Controller" as Ctrl
participant ":IListingRepository" as listingRepo
participant ":IListingRepositoryJPA" as listingRepoJPA
participant "pubIdList\n:List<PublicationSampleId>" as pubIdList
participant "listingIdList\n:List<ListingId>" as pubIdList
participant "listingDMList\nList<ListingDM>" as listingDMList

database "Database" as db

note over Ctrl #E3F2FD
<b>Fragment</b>
---
This diagram is a fragment of the main sequence diagram.
end note

note over Ctrl #E3F2FD
<b>Navigation</b>
---
[[1.MainDiagram.puml Return to Main Diagram]]
end note

Ctrl -> listingRepo : findIdsByPublicationSampleIdIn(pubIdList)
activate listingRepo

listingRepo -> listingRepoJPA : findAllByItemsId(pubIdList)
activate listingRepoJPA

listingRepoJPA -> db : query listing by publicationSampleId
activate db
db --> listingRepoJPA : listingId values
deactivate db

listingRepoJPA -->> listingDMList** : <<create>>

listingRepoJPA -->> pubIdList ** : <<create>>

loop for each listingDM in listingDMList
listingRepoJPA -> listingRepoJPA : id = listingDM.getId()
listingRepoJPA -> listingRepoJPA : listingIdList.add(id)

end loop

listingRepoJPA --> listingRepo : pubIdList
deactivate listingRepoJPA

listingRepo --> Ctrl : pubIdList
deactivate listingRepo

@enduml