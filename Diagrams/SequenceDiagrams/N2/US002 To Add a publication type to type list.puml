@startuml
hide footbox
title US002 - Register Publication Type to Type List

box #Lightyellow
actor Administrator
participant ":UI" as UI
end box


' Human contact between Administrator and UI
Administrator -> UI : **1** I want to register a Publication Type in the system
UI -->> Administrator : **2** What type of Pub
Administrator -> UI : **3** Book

' First contact between UI and the System
UI -> RegisterPubTypeController : **4** RegisterPubType(PubType)
activate RegisterPubTypeController

RegisterPubTypeController -> PubTypeRepository : **5** createAndAddPubType(PubType)
activate PubTypeRepository
' Creation of p1 instance from User class
create "p1: PubType" as PubType


' Creation, validation and addition
PubTypeRepository -> PubType : **6** create(PubType)
PubTypeRepository -> PubTypeRepository : **7** validatePubType(p1)
PubTypeRepository -> PubTypeRepository : **8** add(p1)


' Return from PubTypeRepository to RegisterPubTypeController
PubTypeRepository --> RegisterPubTypeController : **9**  (p1)
deactivate PubTypeRepository

' Return from RegisterUserController to UI
RegisterPubTypeController --> UI : **10** Success
deactivate RegisterPubTypeController

' Return from UI to Administrator
UI --> Administrator : **11** Success

@enduml