@startuml
hide footbox
title US002 - Register Publication Type to Type List

autonumber

actor Administrator
participant ":UI002" as UI
participant ":US002_RegisterPubTypeController" as US002_RegisterPubTypeController


' Human contact between Administrator and UI
Administrator -> UI : I want to register a Publication Type in the system
UI -->> Administrator : Please enter mediaFormat, typeOfBinding, details
Administrator -> UI : Book, Hard Cover, Book with gold engravings

' First contact between UI and the System
UI -> US002_RegisterPubTypeController : RegisterPubType(mediaFormat, typeOfBinding, details)
activate US002_RegisterPubTypeController

US002_RegisterPubTypeController -> PublicationTypeRepository : createAndAddPubType(mediaFormat, typeOfBinding, details)
activate PublicationTypeRepository

participant ":List<PublicationType>" as LT

' Creation of p1 instance from User class
participant ":PublicationType" as PublicationType

' Creation, validation and addition
PublicationTypeRepository -> PublicationType : PublicationType(mediaFormat, typeOfBinding, details)
PublicationTypeRepository -> PublicationTypeRepository : ValidatePublicationType (pubType)
PublicationTypeRepository -> LT: addToList


' Return from PubTypeRepository to RegisterPubTypeController
PublicationTypeRepository --> US002_RegisterPubTypeController :  PubType
deactivate PublicationTypeRepository

' Return from RegisterUserController to UI
US002_RegisterPubTypeController --> UI : Success
deactivate US002_RegisterPubTypeController

' Return from UI to Administrator
UI --> Administrator : Success

@enduml
