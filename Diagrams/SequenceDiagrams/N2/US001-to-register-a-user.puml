@startuml

hide footbox
autonumber

title US001 - To register a user in the system

actor Administrator
participant UI
participant "RegisterUserController" as Controller
participant "UserRepository" as Repository
participant "UserFactory" as Factory
participant "User" as User
participant "users : List<User>" as UserList

Administrator -> UI : I want to register a user in the system
activate UI

UI -> Controller : registerUser(username, contact, profile, role)
activate Controller

Controller -> Repository : exists(username)
activate Repository

loop for each user in _userList
    Repository -> User : getUserName()
    activate User
    User --> Repository : userName
    deactivate User
    Repository -> Repository : userName.equals(username)
end

Repository --> Controller : false
deactivate Repository

Controller -> Factory : create(username, contact, profile, role)
activate Factory

Factory -> User : new User(username, contact, profile, role)
activate User
User --> Factory : user
deactivate User

Factory --> Controller : user
deactivate Factory

Controller -> Repository : save(user)
activate Repository

Repository -> UserList : add(user)
activate UserList
UserList --> Repository : success
deactivate UserList

Repository --> Controller : success
deactivate Repository

Controller --> UI : success
deactivate Controller

UI --> Administrator : New user has been registered in the system
deactivate UI

@enduml