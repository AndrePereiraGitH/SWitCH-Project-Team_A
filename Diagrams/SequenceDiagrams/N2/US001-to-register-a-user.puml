@startuml

hide footbox
autonumber

title US001 - To register a user in the system

actor Administrator
participant UI
participant RegisterUserController
participant UserRepository
participant "users : List<User>" as UserList
participant User

Administrator -> UI : I want to register a user in the system
activate UI

UI -> RegisterUserController : registerUser(username, contact, profile, role)
activate RegisterUserController

RegisterUserController -> UserRepository : createAndAddUser(username, contact, profile, role)

activate UserRepository

loop for each user in users

    UserRepository -> User : getUserName()
    activate User
    User --> UserRepository : userName
    deactivate User
    UserRepository -> UserRepository : equals(username)
end

UserRepository -> User : new User(username, contact, profile, role)
activate User
User --> UserRepository : success
deactivate User

UserRepository -> UserList : add(newUser)
activate UserList
UserList --> UserRepository : success
deactivate UserList

UserRepository --> RegisterUserController : success
deactivate UserRepository
RegisterUserController --> UI : success
deactivate RegisterUserController

UI --> Administrator : New user has been registered in the system
deactivate UI

@enduml