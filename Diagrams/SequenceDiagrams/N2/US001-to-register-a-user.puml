@startuml

hide footbox
autonumber

title US001 - To register a user in the system

actor Administrator
participant ":UI001" as UI

participant ":RegisterUserController" as RegisterUserController

participant ":UserRepository" as UserRepository

participant ":List<User>"

' Human contact between Administrator and UI
activate UI
Administrator -> UI : I want to register a user in the system
UI -->> Administrator :  Provide username, contact and profile information for the user
deactivate UI

Administrator -> UI :  Here's the username, contact and profile information

activate UI
' First contact between UI and the System
UI -> RegisterUserController : RegisterUser(username, contact, profile)
activate RegisterUserController

RegisterUserController -> UserRepository : createAndAddUser(username, contact, profile)

activate UserRepository
' Creation of u1 instance from User class
create "userTest: User" as User

' Creation, validation and addition
UserRepository -->> User : create(username, contact, profile)
UserRepository -> UserRepository : validateUser(userTest)
UserRepository -> ":List<User>" : addUserToUserList(userTest)

activate ":List<User>"
":List<User>" -->> UserRepository : userTest added to the Userlist
deactivate

' Return from UserRepository to RegisterUserController
UserRepository --> RegisterUserController : userTest
deactivate UserRepository

' Return from RegisterUserController to UI
RegisterUserController --> UI : Success
deactivate RegisterUserController

' Return from UI to Administrator
UI --> Administrator : Success
deactivate UI

@enduml