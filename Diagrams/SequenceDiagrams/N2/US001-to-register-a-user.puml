@startuml

hide footbox
autonumber

title US001 - To register a user in the system

actor Administrator
participant UI
participant "US001ToRegisterUserController" as Controller
participant "IUserRepository" as Repository
participant "UserFactory" as Factory
participant "User" as User

Administrator -> UI : I want to register a user in the system
activate UI

UI -> Controller : registerUser(username, contact, profile, role)
activate Controller

Controller -> Repository : exists(username)
activate Repository

loop for each user in _userList
    Repository -> User : getUserName()
    activate User
    User --> Repository : userName
    deactivate User
    Repository -> Repository : userName.equals(username)
end

Repository --> Controller : false
deactivate Repository

Controller -> Repository : create(username, contact, profile, role)
activate Repository

Repository -> Factory : create(username, contact, profile, role)
activate Factory

Factory -->> User : create(username, contact, profile, role)
activate User
User --> Factory : user
deactivate User

Factory --> Repository : user
deactivate Factory

Repository -> Repository : save(user)

Repository --> Controller : success
deactivate Repository

Controller --> UI : success
deactivate Controller

UI --> Administrator : New user has been registered in the system
deactivate UI

@enduml