@startuml

hide footbox
autonumber
title US027 - To get the list of items on direct sale of a given publisher

box #whitesmoke
actor Buyer
participant ":UI027" as UI
end box

'Controller
participant ":US027ToGetTheListOfItemsOn\nDirectSaleOfAGivenPublisherController" as Ctrl

'Repos
participant ":IPublisher\nRepository" as PublisherRepo
participant ":IEdition\nRepository" as EditionRepo
participant ":IPublicationSample\nRepository" as PubSampleRepo
participant ":IListing\nRepository" as ListingRepo

'Mappers
participant ":US027Publisher\nMapper" as PublisherMapper
participant ":US027Listing\nMapper" as ListingMapper


' Section 1 - Get all publishers
Buyer -> UI : I want to get the list of items\n on direct sale of a given publisher
activate UI
UI -> Ctrl : getAllPublishers()
activate Ctrl

Ctrl -> PublisherRepo: getAllPublishers()
activate PublisherRepo
PublisherRepo -->> "listOfAllPublishers:\nList<Publisher>" ** : «create»
PublisherRepo --> Ctrl: listOfAllPublishers
deactivate PublisherRepo

' Section 2 - Converts listOfAllPublishers to DTO
Ctrl -> PublisherMapper: toDTOs(listOfAllPublishers)
activate PublisherMapper
PublisherMapper -->> "listOfAllPublishersDTO:\nList<US027PublisherDTO>" ** : «create»
loop for each publisher
    PublisherMapper -->> "publisherDTO:\nUS027PublisherDTO" **: «create»
    PublisherMapper --> "listOfAllPublishersDTO:\nList<US027PublisherDTO>": add(publisherDTO)
end
PublisherMapper --> Ctrl : listOfAllPublishersDTO
deactivate PublisherMapper

' Section 3 - Returns PublisherDTO list to the user
Ctrl --> UI : listOfAllPublishersDTO
deactivate Ctrl
Buyer <-- UI : Which publisher? Choose!
deactivate UI

' Section 4 - User selects publisher
Buyer -> UI : publisher
activate UI
UI -> Ctrl : findListOfItemsOnDirectSale(publisherId)
activate Ctrl

' Section 5 - Get EditionIds of that Publisher
Ctrl -> EditionRepo : findEditionIdsByPublisherId(publisherId)
activate EditionRepo
EditionRepo -->> "listOfEditionIds:\nList<EditionId>" ** : «create»
EditionRepo --> Ctrl : listOfEditionIds
deactivate EditionRepo

' Section 6 — Get PublicationSampleIds for those EditionIds
Ctrl -> PubSampleRepo : findPublicationSampleIdsByEditionIds(listOfEditionIds)
activate PubSampleRepo
PubSampleRepo -->> "listOfPubSampleIds:\nList<PublicationSampleId>" ** : «create»
PubSampleRepo --> Ctrl : listOfPubSampleIds
deactivate PubSampleRepo

' Section 7 — Get Listings in direct sale containing those PublicationSamplesIds
Ctrl -> ListingRepo : findDirectSaleListingsContaining(listOfPubSampleIds)
activate ListingRepo
ListingRepo -->> "listOfListings:\nList<Listing>" ** : «create»
ListingRepo --> Ctrl : listOfListings
deactivate ListingRepo

' Section 8 - create DTO for listings
Ctrl -> ListingMapper : toDTOs(listOfListings)
activate ListingMapper
ListingMapper -->> "listOfListingDTOs:\nList<US027ListingDTO>" ** : «create»
loop for each listing in listOfListings
    ListingMapper -->> "listingDTO:\nUS027ListingDTO" ** : «create»
    ListingMapper -> "listOfListingDTOs:\nList<US027ListingDTO>" : add(listingDTO)
end
ListingMapper --> Ctrl : listOfListingDTOs
deactivate ListingMapper

Ctrl --> UI : listOfListingDTOs
deactivate Ctrl
UI --> Buyer : Shows the list of items on direct\n sale for the publisher
deactivate UI

@enduml