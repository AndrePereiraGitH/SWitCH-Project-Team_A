@startuml

hide footbox
autonumber
title US027 - To get the list of items on direct sale of a given publisher


actor Buyer
participant ":UI027" as UI027



participant ":ToGetListOfItemsOnDirectSaleOf\nGivenPublisherController" as Controller



participant ":ListingRepository" as Repository


Buyer -> UI027 : I want to get the list of items on direct sale of a given publisher
activate UI027
Buyer <-- UI027 : Which publisher?
Buyer -> UI027 : publisher

UI027 -> Controller : getItemsOnDirectSaleByPublisher(publisher)
activate Controller

Controller -> Repository : getListingsOnDirectSale()
activate Repository




create "data: List<Listing>" as Listing
Repository -> Listing


Repository --> Controller : data
deactivate Repository

Controller -> Controller : extract items of given\n publisher into new list\n**res: List<Item>**

Controller --> UI027 : res
deactivate Controller

UI027 --> Buyer : Display items on direct sale of given publisher
deactivate UI027

@enduml