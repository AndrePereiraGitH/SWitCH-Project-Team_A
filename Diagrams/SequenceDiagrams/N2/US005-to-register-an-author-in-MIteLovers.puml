@startuml
hide footbox
title US005 - Register Author in MiteLovers

actor Administrator
participant ":UI005" as UI

autoNumber


participant ":ToRegisterAuthorController" as C



participant ":AuthorRepository" as R

Administrator -> UI :  I want to register an author in MiteLovers
activate UI

UI -->> Administrator :  Please provide profile information and biography
deactivate

Administrator -> UI :  Here's the profile information and biography
activate UI
UI -> C : registerAuthor(name, \n country, birthday, biography)
activate C

C -> R :  createAndAddAuthor(name, \n country, birthday, biography)
activate R



 create participant "author1:Author" as A
 R -> A ++ : create(name, country, birthday, biography)

 create "profile1:Profile" as P
 A -> P : create(name, country, birthday)

 R -> R : exists(author1)
 deactivate A


alt author already exists
  R -->> C : Author already exists
  C -->> UI : Author already exists
  UI -->> Administrator : Author already exists
else author does NOT exist
  R -> R : addToList(author1)
  R -->> C :  author1
end
deactivate R
C -->> UI :  success
deactivate C

UI -->> Administrator :  success
deactivate UI


participant "country: Country"
participant "birthday: LocalDate"

@enduml
