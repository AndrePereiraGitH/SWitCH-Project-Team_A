@startuml
hide footbox
autonumber
title Register a Publishing Company (Full Detail)
box #WhiteSmoke
actor Administrator
participant ":UI" as UI
end box
participant ":ToRegisterNewPublisherController" as Controller
participant ":PublisherFactory" as PublisherFactory
participant ":PublisherRepository" as PublisherRepository
participant "contact:Contact" as Contact
participant "publisher:Publisher" as Publisher

note over Administrator, Controller #E3F2FD
  <b>Fragment</b>
  ---
  registerPublisher sub-flow detail
end note

Administrator -> UI : I want to register a Publishing Company
activate UI
UI --> Administrator : Please provide name, vatNumber and contact
deactivate UI

Administrator -> UI : Name: Cambridge; VatNumber: 123456; Contact: +4412345678
activate UI
UI -> Controller : registerPublisher(name, vatNumber, contact)
activate Controller

Controller -> PublisherFactory : create(name, vatNumber, contact)
activate PublisherFactory
PublisherFactory -->> Contact ** : <<create>>\nContact(contact)
PublisherFactory -->> Publisher ** : <<create>>\nPublisher(name, vatNumber, contact)
PublisherFactory --> Controller : publisher
deactivate PublisherFactory

Controller -> PublisherRepository : exists(publisher)
activate PublisherRepository
PublisherRepository --> Controller : false
deactivate PublisherRepository

Controller -> PublisherRepository : save(publisher)
activate PublisherRepository
PublisherRepository --> Controller : publisher
deactivate PublisherRepository

Controller --> UI : publisher
deactivate Controller
UI --> Administrator : success
deactivate UI
@enduml