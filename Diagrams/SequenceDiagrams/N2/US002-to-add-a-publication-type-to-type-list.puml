@startuml
hide footbox
title US002 - Register Publication Type to Type List

autonumber

actor Administrator
participant ":UI002" as UI
participant ":US002RegisterPubTypeController" as Ctrl
participant ":PublicationTypeRepository" as Repo
participant ":PublicationType" as PubType

Administrator -> UI : I want to register a Publication Type in the system
UI -->> Administrator : Please enter mediaFormat, typeOfBinding, details
Administrator -> UI : Book, Hard Cover, Book with gold engravings

UI -> Ctrl : RegisterPubType(mediaFormat, typeOfBinding, details)
activate Ctrl

Ctrl -> Repo : createPublicationType(mediaFormat, typeOfBinding, details)

activate Repo
deactivate PubType

Repo -> PubType ++ : createPublicationType(mediaFormat, typeOfBinding, details)
Repo -> Repo : validatePublicationType(PubType)

Repo -> Repo : addToList(PubType)

Repo --> Ctrl : PubType
deactivate Repo

Ctrl --> UI : PubType
deactivate Ctrl

UI --> Administrator : Success

@enduml
