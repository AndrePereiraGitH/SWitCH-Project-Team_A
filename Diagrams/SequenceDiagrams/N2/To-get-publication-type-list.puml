@startuml
autonumber
hide footbox
title US0014 - To Get All Publication Types List

actor User

participant ":UI014" as UI
participant ":US014GetPublicationType\nListController" as C
participant ":IPublicationType\nRepository" as PTR
participant ":US014Publication\nTypeMapper" as MAPPER

User -> UI : I want to get a list\n of all publication types
activate UI

UI -> C : getAllPublicationTypes()
activate C

C -> PTR : getAllPublicationTypes()
activate PTR

PTR --> C : listOfPublicationType
deactivate PTR

C -> MAPPER : toDTOList(listOfPublicationType)
activate MAPPER

create "listOfPublicationTypeDTO:\nList<US014PublicationTypeDTO>" as listDTO
MAPPER --> listDTO : <<create>>

loop for each PublicationType
    MAPPER -> "PublicationType" : getId()
    activate PublicationType
    PublicationType --> MAPPER : id
    deactivate PublicationType
    MAPPER -> "PublicationType" : getMediaFormat()
    activate PublicationType
    PublicationType --> MAPPER : mediaFormat
    deactivate PublicationType
    create "pubTypeDTO: \nUS014PublicationTypeDTO" as pubTypeDTO
    MAPPER -> pubTypeDTO : toDTO()
    MAPPER -> listDTO: listOfPublication\nTypeDTO.add(pubTypeDTO)
end

MAPPER --> C : listOfPublicationTypeDTO
deactivate MAPPER

C --> UI : listOfPublicationTypeDTO
deactivate C

UI --> User : Show list of\n publication types
deactivate UI

@enduml