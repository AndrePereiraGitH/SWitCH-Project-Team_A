@startuml

hide footbox
autonumber
title To get the list of items on direct sale of a given publisher (main diagram)

box #whitesmoke
actor Buyer
participant ":UI" as UI
end box

'Controller
participant ":ToGetTheListOfItemsOn\nDirectSaleOfAGivenPublisherController" as Ctrl

'Publisher
participant ":IPublisher\nRepository" as PublisherRepo

'Edition
participant ":IEdition\nRepository" as EditionRepo

'PublicationSample
participant ":IPublicationSample\nRepository" as PubSampleRepo

'Listing
participant ":IListing\nRepository" as ListingRepo
participant ":IListing\nRepositoryJPA" as ListingRepoJPA
participant "listOfListingDMs:\nList<ListingDM>" as listListingDMs
participant ":ListingAssembler" as ListingAss
participant ":ListingFactory" as ListingFact
participant "listing:\nListing" as Listing
participant "listOfListings:\nList<Listing>" as listListings
participant ":US027Listing\nMapper" as ListingMapper

'DB
database "database" as DB

' Section 1 - Get all publishers and converts to DTOs
Buyer -> UI : I want to get the list of items\n on direct sale of a given publisher
activate UI
UI -> Ctrl : findAllPublishers()
activate Ctrl
Ctrl -> PublisherRepo: findAll()
activate PublisherRepo

ref over PublisherRepo
[[get-all-publishers.puml Get All Publishers and Build DTOs]]
end ref

PublisherRepo --> Ctrl: listOfAllPublishers
deactivate PublisherRepo

' Section 2 - Returns PublisherDTO list to the user
Ctrl --> UI : listOfAllPublishersDTO
deactivate Ctrl
Buyer <-- UI : Which publisher? Choose!
deactivate UI

' Section 3 - User selects publisher
Buyer -> UI : publisher
activate UI
UI -> Ctrl : findListOfItemsOnDirectSaleByPublisherId(publisherId)
activate Ctrl

' Section 4 - Get EditionIds of that Publisher
Ctrl -> EditionRepo : findIdsByPublisherId(publisherId)
activate EditionRepo

ref over EditionRepo
[[get-editionIds-by-publisherId.puml Get EditionIds by PublisherId]]
end ref

EditionRepo --> Ctrl : listOfEditionIds
deactivate EditionRepo

' Section 5 — Get PublicationSampleIds for those EditionIds
Ctrl -> PubSampleRepo : findIdsByEditionIdIn(listOfEditionIds)
activate PubSampleRepo

ref over PubSampleRepo
[[get-pubSampleIds-by-editionIds.puml Get PublicationSampleIds by EditionIds]]
end ref

PubSampleRepo --> Ctrl : listOfPubSampleIds
deactivate PubSampleRepo

' Section 6 — Get Listings in direct sale containing those PublicationSamplesIds
Ctrl -> ListingRepo : findAllByDirectSaleAndPublicationSampleIdIn(listOfPubSampleIds)
activate ListingRepo
ListingRepo -> ListingRepoJPA: findAllByDirectSaleAndPublicationSampleIdIn(listOfPubSampleIds)
activate ListingRepoJPA
ListingRepoJPA -> DB: query by publicationSampleId and saleType DIRECT_SALE
activate DB
DB --> ListingRepoJPA: data
deactivate DB
ListingRepoJPA -->> listListingDMs **: «create»
ListingRepoJPA --> ListingRepo: listOfListingDMs
deactivate ListingRepoJPA
ListingRepo -->> listListings ** : «create»
loop for each listingDM in listOfListingDMs
    ListingRepo -> ListingAss: toDomain(listingDM)
    activate ListingAss
    ListingAss -> ListingFact: create(listingId,listingTitle, itemsId, saleType,\n price, shortDescription, sellerId, pictures)
    activate ListingFact
    ListingFact -->> Listing ** : «create»
    ListingFact --> ListingAss: listing
    deactivate ListingFact
    ListingAss --> ListingRepo: listing
    deactivate ListingAss
    ListingRepo -> listListings: add(listing)
end
ListingRepo --> Ctrl : listOfListings
deactivate ListingRepo

' Section 7 - create DTO for listings
Ctrl -> ListingMapper : toDTOs(listOfListings)
activate ListingMapper

ref over ListingMapper
[[build-listing-dtos.puml Build Listing DTOs]]
end ref

ListingMapper --> Ctrl : listOfListingDTOs
deactivate ListingMapper

Ctrl --> UI : listOfListingDTOs
deactivate Ctrl
UI --> Buyer : Shows the list of items on direct\n sale for the publisher
deactivate UI

@enduml