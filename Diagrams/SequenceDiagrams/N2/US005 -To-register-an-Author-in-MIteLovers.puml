@startuml
hide footbox
title US005 - Register Author in MiteLovers

box #WhiteSmoke
actor Administrator
participant ":UI005" as UI
end box

box "Controller" #LightBlue
participant ":RegisterAuthorController" as C
end box

box "Persistence" #LightGrey
participant ":AuthorRepository" as R
end box

Administrator -> UI : **1** I want to register an author in MiteLovers
activate UI
UI -->> Administrator : **2** Please provide name, country, and date of birth
Administrator -> UI : **3** Name: Tove Ditlevsen; Country: Denmark; DOB: 14-12-1917

UI -> C : **4** registerAuthor(name, country, birthday)
activate C

C -> R : **5** createAndAdd(name, country, birthday)
activate R


box "Domain Model" #LightYellow
  create "profile1:Profile" as P
  R -> P : **6** createProfile(name, country, birthday)

  create "author1:Author" as A
  R -> A : **7** createAuthor(profile1)
  R -> R : **8** existsByAuthor(author1)

  R -> R : **9** addToList(author1)

  R -->> C : **10** author1
end box
deactivate R
C -->> UI : **11** success
deactivate C

UI -->> Administrator : **12** success
deactivate UI
@enduml
