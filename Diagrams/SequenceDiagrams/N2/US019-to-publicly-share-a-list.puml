@startuml

hide footbox
autonumber

title US019 - To publicly share a list of mine

box #WhiteSmoke
actor User
participant ":UI019" as UI
end box

participant ":US019ToPubliclyShareCollectionOfPublicationsController" as Controller
participant ":ICollectionOfPublicationRepository" as CollectionRepository
participant "listOfUserCollections:\nList<CollectionOfPublications" as LUC
participant ":US019CollectionOfPublicationsMapper" as Mapper
participant "listCollectionsDTO:\nList<US019CollectionOfPublicationsDTO>" as listCollectionsDTO
participant ":CollectionOfPublications" as Collection

' == Section 1 - get user colllections ==
User -> UI : I want to publicly share a CollectionOfPublications of mine
activate UI
UI --> Controller: getUserCollections(userId)

activate Controller

Controller -->> CollectionRepository: getUserCollections(userId)
activate CollectionRepository
CollectionRepository -> LUC ** : «create»
CollectionRepository --> Controller: listOfUserCollections
deactivate CollectionRepository

Controller -> Mapper : toDTOs(listOfUserCollections)
activate Mapper
Mapper  -->> listCollectionsDTO ** : «create»

    loop for each collection in listOfUserCollections
        Mapper -> "collectionDTO:\nUS019CollectionOfPublicationsDTO" ** : toDTO(collection)
        Mapper -> listCollectionsDTO : add(US019CollectionOfPublicationsDTO)
    end
    Mapper  -->> Controller : listCollectionsDTO
deactivate Mapper

Controller --> UI : listCollectionsDTO
deactivate Controller

UI -->> User : Select the list you want to share : collectionDTO_A, collectionDTO_B, ...
deactivate UI

' == Section 2 - Make collection public ==
User -> UI : Selected collection (collectionDTO_A)
activate UI
UI -> Controller : makeCollectionPublic(collectionId, userId)


activate Controller

Controller -> CollectionRepository : findCollectionOfPublicationsById(collectionId)
activate CollectionRepository
CollectionRepository --> Controller : collection
deactivate CollectionRepository

Controller -> Collection : getOwnerId()
activate Collection
Collection --> Controller : ownerId
deactivate Collection

Controller --> Controller : verifies ownerId.equals(userId)

Controller -> Collection : set_isPrivate(false)
activate Collection
Collection --> Controller : true
deactivate Collection

Controller --> UI : false
deactivate Controller

UI --> User: Your collection is public now!

deactivate UI

@enduml
