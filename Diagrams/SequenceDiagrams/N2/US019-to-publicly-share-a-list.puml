@startuml

hide footbox
autonumber

title US019 - As a User, I want to publicly share a list of mine

box #WhiteSmoke
actor User
participant ":UI019" as UI
end box

participant ":ShareListController" as ShareListController
participant ":ListRepository" as ListRepository
participant "list: List" as List

activate UI

User -> UI : I want to publicly share a list of mine
UI --> ShareListController: requestAllLists()

activate ShareListController
ShareListController --> ListRepository: getAllLists()

activate ListRepository
ListRepository --> ShareListController: lists
deactivate ListRepository

ShareListController --> UI: lists
deactivate ShareListController

UI -->> User : Select the list you want to share (lists)
User -> UI : Selected list (listId)
UI -> ShareListController : shareList(listId)

activate ShareListController
ShareListController -> ListRepository : getList(listId)
activate ListRepository
ListRepository -> List : makePublic()

activate List
List --> ListRepository : updated
deactivate List

ListRepository --> ShareListController: Updated
deactivate ListRepository

ShareListController --> UI : Success
deactivate ShareListController

UI --> User: Done!

deactivate UI

@enduml
