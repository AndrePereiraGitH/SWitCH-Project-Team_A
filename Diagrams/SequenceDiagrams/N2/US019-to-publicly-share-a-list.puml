@startuml

hide footbox
autonumber

title US019 - As a User, I want to publicly share a list of mine

box #WhiteSmoke
actor User
participant ":UI019" as UI
end box

participant ":US019ToPubliclyShareListController" as Controller
participant ":CollectionOfPublicationRepository" as CollectionRepository
participant "collectionOfPublication: CollectionOfPublications" as CollectionOfPublications
participant "CollectionOfPublicationsDTO_US019" as dto

activate UI

User -> UI : I want to publicly share a CollectionOfPublications of mine
UI --> Controller: requestAllCollectionOfPublicationsByUser(user)

activate Controller
Controller --> CollectionRepository: getAllCollectionOfPublicationsByUser(user)
activate CollectionRepository
create "listOfUserCollections:List<CollectionOfPublications>" as CollectionOfPublicationsList
CollectionRepository -> CollectionOfPublicationsList : create()

loop for each CollectionOfPublications in list
    CollectionRepository -> CollectionOfPublications : isOwnerEqualsUser(user)
    activate CollectionOfPublications
    CollectionOfPublications --> CollectionRepository : true

    deactivate CollectionOfPublications

    CollectionRepository -> CollectionRepository : addCollectionToListOfUserCollections()



end


CollectionRepository --> Controller: listOfUserCollections
deactivate CollectionRepository

'Controller --> UI: listOfUserCollections
create "listCollectionsDTO : List<CollectionOfPublicationsDTO>" as CollectionDTOList
Controller -> CollectionDTOList : create()
loop for each CollectionOfPublications in listOfUserCollections
    Controller -> dto : fromDomain(collection)
    activate dto
    dto --> Controller : collectionDTO
    deactivate dto
    Controller -> Controller : addToListCollectionsDTO(collectionDTO)

end
Controller --> UI : listCollectionsDTO
deactivate Controller

UI -->> User : Select the list you want to share : collectionDTO_A, collectionDTO_B, ...
User -> UI : Selected collection (collectionDTO_A)
UI -> Controller : shareCollectionOfPublications(collectionDTO_A)


activate Controller
Controller -> CollectionRepository : getCollectionOfPublication(collectionDTO_A)
activate CollectionRepository
CollectionRepository --> Controller : collectionA
deactivate CollectionRepository


Controller -> CollectionRepository : makeCollectionOfPublicationsPublic(collection)
activate CollectionRepository
CollectionRepository -> CollectionOfPublications : set_isPrivate(false)
activate CollectionOfPublications
CollectionOfPublications --> CollectionRepository
deactivate CollectionOfPublications

CollectionRepository --> Controller : true

deactivate CollectionRepository

Controller --> UI : Success
deactivate Controller

UI --> User: Your collection is public now!

deactivate UI

@enduml
