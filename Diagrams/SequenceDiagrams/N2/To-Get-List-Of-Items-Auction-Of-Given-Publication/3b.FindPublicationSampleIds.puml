@startuml
hide footbox
autonumber
title Find Publication Sample Ids

participant ":GetTheListOfItemsOnAuctionOfAGivenPublicationController" as Ctrl
participant ":IPublicationSampleRepository" as pubSampleRepo
participant ":IPublicationSampleRepositoryJpa" as pubSampleJpa
participant "listOfPubSampleIds:List<PublicationSampleId>" as listOfPubSampleIds
participant "Database" as db

note over Ctrl #E3F2FD
<b>Navigation</b>
---
[[1.MainDiagram.puml Return to Main Diagram]]
end note

Ctrl -> pubSampleRepo: findIdsByBibliographicalDataId(bdId)
activate pubSampleRepo
pubSampleRepo -> pubSampleJpa: findAllByBdId(bdId)
activate pubSampleJpa
pubSampleJpa -> db: SELECT * FROM publication_sample\nWHERE bibliographical_data_id = ?
activate db
db --> pubSampleJpa: data
deactivate db
pubSampleJpa --> pbSampleDMList**: <<create>>
pubSampleJpa -->> listOfPubSampleIds **: <<create>>

loop for each dm in pbSampleDMList
    pubSampleJpa -> pubSampleJpa : id = dm.getId()
    pubSampleJpa -> pubSampleJpa: listOfPubSampleIds.add(id)
end

pubSampleJpa --> pubSampleRepo: listOfPubSampleIds

deactivate pubSampleJpa

pubSampleRepo --> Ctrl: listOfPubSampleIds
deactivate pubSampleRepo

@enduml