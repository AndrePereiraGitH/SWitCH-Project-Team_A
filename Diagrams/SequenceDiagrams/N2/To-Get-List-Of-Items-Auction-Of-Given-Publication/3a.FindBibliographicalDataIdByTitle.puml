@startuml
hide footbox
autonumber
title Find Bibliographical Data Id By Title

participant ":GetTheListOfItemsOnAuctionOfAGivenPublicationController" as Ctrl
participant ":IBibliographicalDataRepository" as bdRepo
participant ":IBibliographicalDataRepositoryJpa" as bdJpa
participant "Database" as db

ref over Ctrl
  [[1.MainDiagram.puml Main Diagram]]
end ref

Ctrl -> bdRepo: findBibliographicalDataIdByTitle(title)
activate bdRepo
bdRepo -> bdJpa: findIdByTitleIgnoreCase(title)
activate bdJpa
bdJpa -> db: SELECT id FROM bibliographical_data\nWHERE LOWER(TRIM(title)) = LOWER(TRIM(?))
activate db
db --> bdJpa: data
deactivate db
bdJpa --> bdRepo: bdId: Optional<BibliographicalDataId>
deactivate bdJpa
bdRepo --> Ctrl: bdId: Optional<BibliographicalDataId>
deactivate bdRepo

@enduml