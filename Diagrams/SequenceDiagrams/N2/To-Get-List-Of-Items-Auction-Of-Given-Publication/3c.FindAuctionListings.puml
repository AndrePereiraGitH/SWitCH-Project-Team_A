@startuml
hide footbox
autonumber
title Find Auction Listings

participant ":GetTheListOfItemsOnAuctionOfAGivenPublicationController" as Ctrl
participant ":IListingRepository" as listingRepo
participant ":IListingRepositoryJpa" as listingJpa
participant "Database" as db
participant "listOfAuctionListings:List<Listing>" as aucListing
participant ":ListingAssembler" as listingAssembler
participant ":ListingFactory" as listingFactory
participant "listing:Listing" as listing

note over Ctrl #E3F2FD
<b>Navigation</b>
---
[[1.MainDiagram.puml Return to Main Diagram]]
end note

Ctrl -> listingRepo: findAllByAuctionAndPublicationSampleIdIn(listOfPubSampleIds)
activate listingRepo
listingRepo -> listingJpa: findAllByItemsId(listOfPubSampleIds)
activate listingJpa
listingJpa -> db: SELECT * FROM listing\nWHERE publication_sample_id IN (?)
activate db
db --> listingJpa: data
deactivate db
listingJpa --> listingRepo: listingDMList: List<ListingDM>
deactivate listingJpa

listingRepo -->> aucListing **: <<create>>
loop for each dm in listingDMList
    listingRepo -> listingAssembler: toDomain(dm)
    activate listingAssembler
    listingAssembler -> listingFactory: create(dm.getListingId(), dm.getListingTitle(), dm.getItemsId(), dm.getSaleType(), dm.getPrice(), dm.getShortDescription(), dm.getSellerId(), dm.getPictures())
    activate listingFactory
    listingFactory -->> listing **: <<create>>
    listingFactory --> listingAssembler: listing
    deactivate listingFactory
    listingAssembler --> listingRepo: listing
    deactivate listingAssembler
    opt listing.isListingLinkedToAnAuction()
        listingRepo -> listingRepo: listOfAuctionListings.add(listing)
    end
end

listingRepo --> Ctrl: listOfAuctionListings
deactivate listingRepo

@enduml