@startuml
hide footbox
autonumber 2
title Get All Publication Titles

participant ":GetTheListOfItemsOnAuctionOfAGivenPublicationController" as Ctrl
participant ":IBibliographicalDataRepository" as bdRepo
participant ":IBibliographicalDataRepositoryJpa" as bdJpa
participant "listOfTitles:List<String>" as listOfTitles
participant "Database" as db

note over Ctrl #E3F2FD
<b>Navigation</b>
---
[[1.MainDiagram.puml Return to Main Diagram]]
end note

Ctrl -> bdRepo: findIdByTitle(title)
activate bdRepo
bdRepo -> bdJpa: findByTitleIgnoreCase(title.trim())
activate bdJpa
bdJpa -> db: SELECT * FROM bibliographical_data\nWHERE LOWER(title) = LOWER(?)
activate db
db --> bdJpa: data
deactivate db
bdJpa -->> bdDM** :<<create>>
bdJpa -> bdDM: getId()
activate bdDM
bdDM --> bdJpa: bdId
deactivate bdDM

bdJpa --> bdRepo: bdId
deactivate bdJpa
bdRepo --> Ctrl: bdID
deactivate bdRepo

@enduml