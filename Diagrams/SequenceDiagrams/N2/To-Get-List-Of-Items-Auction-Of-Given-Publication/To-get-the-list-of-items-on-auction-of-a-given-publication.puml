@startuml
hide footbox
autonumber
title To get the list of items on auction of a given publication

actor Buyer

' Participants
participant ":UI" as UI
participant ":GetTheListOfItemsOnAuctionOfAGivenPublicationController" as Ctrl

participant ":IBibliographicalDataRepository" as bdRepo
participant ":IBibliographicalDataRepositoryJpa" as bdJpa
participant "listOfBiblioDataDM\n:List<BibliographicalDataDM>" as listBiblioDM
participant "bdDM:Optional<BibliographicalDataDM>" as bdDM
participant "listOfTitles\n:List<String>" as listOfTitles

participant ":IPublicationSampleRepository" as pubSampleRepo

participant ":IPublicationSampleRepositoryJpa" as pubSampleJpa

participant ":IListingRepository" as listingRepo
participant "pbSampleDMList\n: List<PublicationSampleDM>" as pbSampleDMList
participant "listOfPubSampleIds\n:List<PublicationSampleId>" as listOfPubSampleIds
participant ":IListingRepositoryJpa" as listingJpa
participant "listingDMList\n:List<ListingDM>" as listingDMList

participant "listOfAuctionListings\n:List<Listing>" as aucListing

participant "Database" as db

participant ":ListingAssembler" as listingAssembler
participant ":ListingFactory" as listingFactory
participant "listing:Listing" as listing
participant ":US024AucListingMapper" as mapper
participant "listOfAuctionListingsDTO\n:List<US024AucListingDTO>" as listOfAucListingDTO
participant "aucListingDTO\n:US024AucListingDTO" as auctionListingDTO


' ─────────────────────────────────────────
' Section 1 - Get all publication titles
' ─────────────────────────────────────────
Buyer -> UI : I want to get the list of items\n on auction of a given publication
activate UI
UI -> Ctrl : getAllPublicationTitles()
activate Ctrl

Ctrl -> bdRepo: getAllTitles()
activate bdRepo
bdRepo -> bdJpa: findAll()
activate bdJpa
bdJpa -> db: SELECT * FROM bibliographical_data
activate db
db --> bdJpa: data
deactivate db

bdJpa -->> listBiblioDM **: <<create>>
bdJpa -->> listOfTitles **: <<create>>

loop for each dm in listOfBiblioDataDM
    bdJpa -> bdJpa : title = dm.getTitle()
    bdJpa -> bdJpa: listOfTitles.add(title)
end

bdJpa --> bdRepo: listOfTitles
deactivate bdJpa


bdRepo --> Ctrl: listOfTitles
deactivate bdRepo

Ctrl --> UI: listOfTitles
deactivate Ctrl

UI --> Buyer: Here is the list of publication titles.\n Pick one.
deactivate UI

' ─────────────────────────────────────────
' Section 2 - Find listings on auction for the selected publication
' ─────────────────────────────────────────
Buyer -> UI: title
activate UI
UI -> Ctrl: getAuctionListingsByTitle(title)
activate Ctrl

Ctrl -> bdRepo: findIdByTitle(title)
activate bdRepo
bdRepo -> bdJpa: findByTitleIgnoreCase(title.trim())
activate bdJpa
bdJpa -> db: SELECT * FROM bibliographical_data\nWHERE LOWER(title) = LOWER(?)
activate db
db --> bdJpa: data
deactivate db
bdJpa -->> bdDM** :<<create>>
bdJpa -> bdDM: getId()
activate bdDM
bdDM --> bdJpa: bdId
deactivate bdDM

bdJpa --> bdRepo: bdId
deactivate bdJpa
bdRepo --> Ctrl: bdID
deactivate bdRepo



Ctrl -> pubSampleRepo: findIdsByBibliographicalDataId(bdId)
activate pubSampleRepo
pubSampleRepo -> pubSampleJpa: findAllByBdId(bdId)
activate pubSampleJpa
pubSampleJpa -> db: SELECT * FROM publication_sample\nWHERE bibliographical_data_id = ?
activate db
db --> pubSampleJpa: data
deactivate db
pubSampleJpa --> pbSampleDMList**: <<create>>
pubSampleJpa -->> listOfPubSampleIds **: <<create>>

loop for each dm in pbSampleDMList
    pubSampleJpa -> pubSampleJpa : id = dm.getId()
    pubSampleJpa -> pubSampleJpa: listOfPubSampleIds.add(id)
end

pubSampleJpa --> pubSampleRepo: listOfPubSampleIds

deactivate pubSampleJpa

pubSampleRepo --> Ctrl: listOfPubSampleIds
deactivate pubSampleRepo




Ctrl -> listingRepo: findAllByAuctionAndPublicationSampleIdIn(listOfPubSampleIds)
activate listingRepo
listingRepo -> listingJpa: findAllByItemsId(listOfPubSampleIds)
activate listingJpa
listingJpa -> db: SELECT * FROM listing\nWHERE publication_sample_id IN (?)
activate db
db --> listingJpa: data
deactivate db
listingJpa -->> listingDMList**: <<create>>
listingJpa --> listingRepo: listingDMList
deactivate listingJpa

listingRepo -->> aucListing **: <<create>>
loop for each dm in listingDMList
    listingRepo -> listingAssembler: toDomain(dm)
    activate listingAssembler
    listingAssembler -> listingFactory: create(dm.getListingId(), dm.getListingTitle(), dm.getItemsId(), dm.getSaleType(), dm.getPrice(), dm.getShortDescription(), dm.getSellerId(), dm.getPictures())
    activate listingFactory
    listingFactory -->> listing **: <<create>>
    listingFactory --> listingAssembler: listing
    deactivate listingFactory
    listingAssembler --> listingRepo: listing
    deactivate listingAssembler
    opt listing.isListingLinkedToAnAuction()
        listingRepo -> listingRepo: listOfAuctionListings.add(listing)
    end
end

listingRepo --> Ctrl: listOfAuctionListings
deactivate listingRepo

' ─────────────────────────────────────────
' Section 3 - Build and return DTO
' ─────────────────────────────────────────
Ctrl -> mapper: toDTOs(listOfAuctionListings)
activate mapper

mapper -->> listOfAucListingDTO **: <<create>>

loop for each listing in listOfAuctionListings
    mapper -> auctionListingDTO **: toDTO(listing)
    mapper -> mapper: listOfAuctionListingsDTO.add(aucListingDTO)
end

mapper --> Ctrl: listOfAuctionListingsDTO
deactivate mapper

Ctrl --> UI: listOfAuctionListingsDTO
deactivate Ctrl

UI --> Buyer: Here is the list of auction listings\n for the selected publication.
deactivate UI

@enduml