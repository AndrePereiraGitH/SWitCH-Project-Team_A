@startuml
hide footbox
autonumber
title To get the list of items on auction of a given publication

actor Buyer

' Participants
participant ":UI" as UI
participant ":GetTheListOfItemsOnAuctionOfAGivenPublicationController" as Ctrl

participant ":IBibliographicalDataRepository" as bdRepo
participant ":IBibliographicalDataRepositoryJpa" as bdJpa

participant ":IPublicationSampleRepository" as pubSampleRepo
participant ":IPublicationSampleRepositoryJpa" as pubSampleJpa

participant ":IListingRepository" as listingRepo
participant ":IListingRepositoryJpa" as listingJpa

participant "Database" as db

participant "listOfAuctionListingsOfGivenPublication:List<Listing>" as aucListing
participant ":ListingAssembler" as listingAssembler
participant ":ListingFactory" as factory
participant ":Listing" as listing
participant ":US024AucListingMapper" as mapper
participant "listOfAuctionListingsDTO:List<US024AucListingDTO>" as listOfAucListingDTO
participant "aucListingDTO:US024AucListingDTO" as auctionListingDTO

' ─────────────────────────────────────────
' Section 1 - Get all publication titles
' ─────────────────────────────────────────
Buyer -> UI : I want to get the list of items\n on auction of a given publication
activate UI
UI -> Ctrl : getAllPublicationTitles()
activate Ctrl

Ctrl -> bdRepo: getAllTitles()
activate bdRepo
bdRepo -> bdJpa: findAllTitles()
activate bdJpa
bdJpa -> db: SELECT title FROM bibliographical_data
activate db
db --> bdJpa: data
deactivate db
bdJpa --> bdRepo: listOfTitles: List<String>
deactivate bdJpa
bdRepo --> Ctrl: listOfTitles: List<String>
deactivate bdRepo

Ctrl --> UI: listOfTitles: List<String>
deactivate Ctrl

UI --> Buyer: Here is the list of publication titles.\n Pick one.
deactivate UI

' ─────────────────────────────────────────
' Section 2 - Find listings on auction for the selected publication
' ─────────────────────────────────────────
Buyer -> UI: title
activate UI
UI -> Ctrl: getAuctionListingsByTitle(title)
activate Ctrl

Ctrl -> bdRepo: findBibliographicalDataIdByTitle(title)
activate bdRepo
bdRepo -> bdJpa: findIdByTitleIgnoreCase(title)
activate bdJpa
bdJpa -> db: SELECT id FROM bibliographical_data\nWHERE LOWER(TRIM(title)) = LOWER(TRIM(?))
activate db
db --> bdJpa: data
deactivate db
bdJpa --> bdRepo: bdId: Optional<BibliographicalDataId>
deactivate bdJpa
bdRepo --> Ctrl: bdId: Optional<BibliographicalDataId>
deactivate bdRepo

Ctrl -> pubSampleRepo: findIdsByBibliographicalDataId(bdId)
activate pubSampleRepo
pubSampleRepo -> pubSampleJpa: findAllIdsByBdId(bdId)
activate pubSampleJpa
pubSampleJpa -> db: SELECT id FROM publication_sample\nWHERE bibliographical_data_id = ?
activate db
db --> pubSampleJpa: data
deactivate db
pubSampleJpa --> pubSampleRepo: listOfPubSampleId: List<PublicationSampleID>
deactivate pubSampleJpa
pubSampleRepo --> Ctrl: listOfPubSampleId: List<PublicationSampleID>
deactivate pubSampleRepo

Ctrl -> listingRepo: getAuctionListingsContaining(listOfPubSampleId)
activate listingRepo
listingRepo -> listingJpa: findByPublicationSampleIdsInAndSaleType(listOfPubSampleId, SaleType.AUCTION)
activate listingJpa
listingJpa -> db: SELECT * FROM listing\nWHERE publication_sample_id IN (?)\nAND sale_type = 'AUCTION'
activate db
db --> listingJpa: data
deactivate db
listingJpa --> listingRepo: allListingDM: List<ListingDM>
deactivate listingJpa

listingRepo -->> aucListing **: <<create>>
loop for each dm in allListingDM
    listingRepo -> listingAssembler: toDomain(dm)
    activate listingAssembler
    listingAssembler -> factory: create(dm.getListingId(), dm.getListingTitle(), dm.getItemsId(), dm.getSaleType(), dm.getPrice(), dm.getShortDescription(), dm.getSellerId(), dm.getPictures())
    activate factory
    factory -->> listing **: <<create>>
    factory --> listingAssembler: listing
    deactivate factory
    listingAssembler --> listingRepo: listing
    deactivate listingAssembler
    listingRepo -> listingRepo: listOfAuctionListingsOfGivenPublication.add(listing)
end

listingRepo --> Ctrl: listOfAuctionListingsOfGivenPublication
deactivate listingRepo

' ─────────────────────────────────────────
' Section 3 - Build and return DTO
' ─────────────────────────────────────────
Ctrl -> mapper: toDTOs(listOfAuctionListingsOfGivenPublication)
activate mapper

mapper -->> listOfAucListingDTO **: <<create>>

loop for each listing in listOfAuctionListingsOfGivenPublication
    mapper -> auctionListingDTO **: toDTO(listing)
    mapper -> mapper: listOfAuctionListingsDTO.add(aucListingDTO)
end

mapper --> Ctrl: listOfAuctionListingsDTO
deactivate mapper

Ctrl --> UI: listOfAuctionListingsDTO
deactivate Ctrl

UI --> Buyer: Here is the list of auction listings\n for the selected publication.
deactivate UI

@enduml