@startuml
hide footbox
autonumber
title To get the list of items on auction of a given publication

actor Buyer

' Participants
participant ":UI"                                                                    as UI
participant ":GetTheListOfItemsOnAuctionOfAGivenPublicationController"            as Ctrl
participant ":IBibliographicalDataRepository"                                          as bdRepo
participant ":IPublicationSampleRepository"                                            as pubSampleRepo
participant ":IListingRepository"                                                      as listingRepo
participant "listOfAuctionListingsOfGivenPublication:List<Listing>"                   as aucListing
participant ":Listing"                                                                 as listing
participant ":US024AucListingMapper"                                                   as mapper
participant "listOfAuctionListingsDTO:List<US024AucListingDTO>"                       as listOfAucListingDTO
participant "aucListingDTO:US024AucListingDTO"                                        as auctionListingDTO

' Section 1 - Get all publication titles
Buyer -> UI : I want to get the list of items\n on auction of a given publication
activate UI
UI -> Ctrl : getAllPublicationTitles()
activate Ctrl

Ctrl -> bdRepo: getAllTitles()
activate bdRepo
bdRepo --> Ctrl: listOfTitles
deactivate bdRepo

Ctrl --> UI: listOfTitles
deactivate Ctrl

UI --> Buyer: Here is the list of publication titles.\n Pick one.
deactivate UI

' Section 2 - Find listings on auction for the selected publication
Buyer -> UI: title
activate UI
UI -> Ctrl: getAuctionListingsByTitle(title)
activate Ctrl

Ctrl -> bdRepo: findBibliographicalDataIdByTitle(title)
activate bdRepo
bdRepo --> Ctrl: bdId
deactivate bdRepo

Ctrl -> pubSampleRepo: findPubSampleIdsByBibliographicalDataId(bdId)
activate pubSampleRepo
pubSampleRepo --> Ctrl: listOfPubSampleId
deactivate pubSampleRepo

Ctrl -> listingRepo: getAuctionListingsContaining(listOfPubSampleId)
activate listingRepo

listingRepo -->> aucListing **: <<create>>

loop for each listing in ListingRepository
    listingRepo -> listing: isListingLinkedToAnAuction()
    activate listing
    listing --> listingRepo: true
    deactivate listing

    listingRepo -> listing: verifyIfListingContainsPubId(pubId)
    activate listing
    listing --> listingRepo: true
    deactivate listing

    listingRepo -> listingRepo: listOfAuctionListingsOfGivenPublication.add(listing)
end

listingRepo --> Ctrl: listOfAuctionListingsOfGivenPublication
deactivate listingRepo

' Section 3 - Build and return DTO
Ctrl -> mapper: toDTOs(listOfAuctionListingsOfGivenPublication)
activate mapper

mapper -->> listOfAucListingDTO**: <<create>>

loop for each aucListing in listOfAuctionListingsOfGivenPublication
    mapper -> auctionListingDTO **: toDTO(aucListing)
    mapper -> mapper: listOfAuctionListingsDTO.add(aucListingDTO)
end

mapper --> Ctrl: listOfAuctionListingsDTO
deactivate mapper

Ctrl --> UI: listOfAuctionListingsDTO
deactivate Ctrl

UI --> Buyer: Here is the list of auction listings\n for the selected publication.
deactivate UI

@enduml