@startuml
hide footbox
autonumber

title Create and Persist an Auction

participant ":Ctrl" as ctrl
participant ":AuctionService" as auctionService
participant ":IAuctionRepository" as AucRepo

participant ":AuctionAssembler" as auctionAssembler
participant "auctionDM\n:AuctionDM" as DMAuction
participant ":AuctionFactory" as aucFactory

participant ":IAuctionRepositoryJPA" as auctionRepoJPA

participant "auction: Auction" as auction

participant ":persistedAuction\n:Auction" as persistedAuction
participant ":auctionDMPersisted\n:AuctionDM" as auctionDMPersisted
database "Database" as db

ref over auctionService
[[1.MainDiagram.puml Back to main diagram]]
end ref

note over auctionService #E3F2FD
<b>Fragment</b>
---
This diagram is a fragment of the main sequence diagram.
end note

ctrl -> auctionService : createAndSave()
activate auctionService

auctionService -> aucFactory : create ( persistedListing.id(), initialDate,\n finalDate, initialPrice, buyOutPrice)
activate aucFactory
aucFactory -->> auction** : <<create>>
aucFactory --> auctionService : auction
deactivate aucFactory

auctionService -> AucRepo : save(auction)
activate AucRepo

' ------ CONVERT DOMAIN INSTANCE INTO DM -------
AucRepo -> auctionAssembler : toDM (auction)
activate auctionAssembler
auctionAssembler -->> DMAuction** : <<create>>
auctionAssembler --> AucRepo : auctionDM
deactivate auctionAssembler


' ------ JPA PERSISTENCE ---------------
AucRepo -> auctionRepoJPA : save (auctionDM)
activate auctionRepoJPA
auctionRepoJPA -> db : INSERT auctionDM
activate db
db -->> auctionRepoJPA : data
deactivate db
auctionRepoJPA -->> auctionDMPersisted ** : <<create>>
auctionRepoJPA --> AucRepo : auctionDMPersisted
deactivate auctionRepoJPA

AucRepo -> auctionAssembler : toDomain(auctionDMPersisted)
activate auctionAssembler

' --------- GET DATA FROM AUCTION DM
auctionAssembler -> auctionDMPersisted : id()
activate auctionDMPersisted
auctionDMPersisted --> auctionAssembler : id
deactivate auctionDMPersisted

auctionAssembler -> auctionDMPersisted : getListingId()
activate auctionDMPersisted
auctionDMPersisted --> auctionAssembler : listingId
deactivate auctionDMPersisted

auctionAssembler -> auctionDMPersisted : getAuctionStartDateTime()
activate auctionDMPersisted
auctionDMPersisted --> auctionAssembler : startDate
deactivate auctionDMPersisted

auctionAssembler -> auctionDMPersisted : getAuctionFinalDateTime()
activate auctionDMPersisted
auctionDMPersisted --> auctionAssembler : finalDate
deactivate auctionDMPersisted

auctionAssembler -> auctionDMPersisted : getInitialPrice()
activate auctionDMPersisted
auctionDMPersisted --> auctionAssembler : initialPrice
deactivate auctionDMPersisted

auctionAssembler -> auctionDMPersisted : getBuyoutPrice()
activate auctionDMPersisted
auctionDMPersisted --> auctionAssembler : buyoutPrice
deactivate auctionDMPersisted


auctionAssembler -> aucFactory : create ( id, listingId, startDate,\n finalDate, initialPrice, buyOutPrice)
activate aucFactory
aucFactory -->> persistedAuction ** : <<create>>
aucFactory -->> auctionAssembler : persistedAuction
deactivate aucFactory

auctionAssembler --> AucRepo : persitedAuction
deactivate auctionAssembler
AucRepo --> auctionService : persistedAuction
deactivate AucRepo
auctionService --> ctrl : persistedAuction
deactivate auctionService

@enduml