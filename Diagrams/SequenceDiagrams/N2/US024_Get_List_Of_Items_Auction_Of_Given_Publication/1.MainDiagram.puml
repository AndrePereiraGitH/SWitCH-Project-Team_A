@startuml
hide footbox
autonumber
title US024 - To get the list of items on auction of a given publication (Main)

actor Buyer
participant ":UI024" as UI
participant ":US024GetTheListOfItemsOnAuctionOfAGivenPublicationController" as Ctrl
participant ":BibliographicalDataRepository" as bdRepo
participant ":PublicationSampleRepository" as pubSampleRepo
participant ":ListingRepository" as listingRepo
participant ":US024AuctionMapper" as mapper

' --- Start ---
Buyer -> UI : I want to get the list of items\n on auction of a given publication
activate UI

' =========================
' Get All Publication Titles (reference)
' =========================
UI -> Ctrl : getAllPublicationTitles()
activate Ctrl

ref over Ctrl
[[2.GetAllPublicationTitles.puml Get All Publication Titles]]
end ref

Ctrl --> UI : listOfTitles
deactivate Ctrl

UI --> Buyer : Here is the list of publication titles.\n Pick one.
deactivate UI

Buyer -> UI : title
activate UI

' =========================
' Get Auction Listings By Title (reference)
' =========================
UI -> Ctrl : getAuctionListingsByTitle(title)
activate Ctrl

ref over Ctrl
[[3.GetAuctionListingsByTitle.puml Get Auction Listings By Title]]
end ref

Ctrl --> UI : listOfAuctionOfGivenPublication
deactivate Ctrl

' =========================
' Build Auction DTOs (reference)
' =========================
UI -> Ctrl : (internal mapping)
activate Ctrl

ref over Ctrl
[[4.BuildAuctionDTOs.puml Build Auction DTOs]]
end ref

Ctrl --> UI : listOfAuctionDTOs
deactivate Ctrl

UI --> Buyer : Here is the list of auction listings\n for the selected publication.
deactivate UI

@enduml