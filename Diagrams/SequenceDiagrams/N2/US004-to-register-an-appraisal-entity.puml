@startuml

hide footbox
autonumber
title US004 - Register Appraisal Entity (DTO + Mapper)

actor Administrator
participant ":UI004" as UI
participant ":US004ToRegisterAppraisalEntityController" as Controller

participant ":GenreRepository" as GenreRepo
participant ":GenreMapper" as GenreMapper

participant "listOfGenreDTO:List<GenreDTO>" as GenreDTO
participant ":Genre" as Genre
participant "Genre: GenreDTO" as GDTO

participant ":PublicationTypeRepository" as PubTypeRepo
participant ":PublicationTypeMapper" as PubTypeMapper

participant "listOfPublicationTypDTO:List<PubTypeDTO>" as PubTypeDTO
participant ":PublicationType" as PublicationType
participant "PublicationType: PubTypeDTO" as PDTO

participant ":AppraisalEntityRepository" as AppraisalRepo
participant ":List<AppraisalEntity>" as AppraisalList

' --- Start ---
Administrator -> UI : I want to register an Appraisal Entity
activate UI

' =========================
' Get Genres (DTO)
' =========================
UI -> Controller : requestGenres()
activate Controller

Controller -> GenreRepo : getAllGenres()
activate GenreRepo
GenreRepo --> Controller : List<Genre>
deactivate GenreRepo

Controller -> GenreMapper : toDTO(List<Genre>)
activate GenreMapper

' ----- Loop ----
GenreMapper -> GenreDTO** : create()

    loop for each publicationType in list
        GenreMapper -> Genre: getDetails(listOfGenreDTO)
        activate Genre
        Genre --> GenreMapper: GenreDetailsDTO
        deactivate Genre
        GenreMapper -> GDTO **: createDTO(GenreDetailsDTO)


        GenreMapper -> GenreMapper: listOfGenreDTO.add(GenreDetailsDTO)
    end

' ----- End loop ----

GenreMapper --> Controller : List<GenreDTO>
deactivate GenreMapper

Controller --> UI : List<GenreDTO>
deactivate Controller

UI --> Administrator : Display available Genres
deactivate UI

Administrator -> UI : Selected 1..* Genres
activate UI
' =========================
' Get Publication Types (DTO)
' =========================
UI -> Controller : requestPublicationTypes()
activate Controller

Controller -> PubTypeRepo : getAllPublicationTypes()
activate PubTypeRepo
PubTypeRepo --> Controller : List<PublicationType>
deactivate PubTypeRepo

Controller -> PubTypeMapper : toDTO(List<PublicationType>)
activate PubTypeMapper

' ----- Loop ----
PubTypeMapper -> PubTypeDTO** : create()

    loop for each publicationType in list
        PubTypeMapper -> PublicationType: getDetails(listOfPubTypeDTO)
        activate PublicationType
        PublicationType --> PubTypeMapper: PubTypeDetailsDTO
        deactivate PublicationType
        PubTypeMapper -> PDTO **: createDTO(PubTypeDetailsDTO)


        PubTypeMapper -> PubTypeMapper: listOfPubTypeDTO.add(PubTypeDetailsDTO)
    end

' ----- End loop ----

PubTypeMapper --> Controller : List<PublicationTypeDTO>
deactivate PubTypeMapper

Controller --> UI : List<PublicationTypeDTO>
deactivate Controller

UI --> Administrator : Display available Publication Types
deactivate UI

Administrator -> UI : Selected 1..* Publication Types
activate UI
' =========================
' Register Appraisal Entity
' =========================
UI -> Controller : registerAppraisalEntity(name, contact, selectedGenresDTO : List<GenreDTO>, selectedPublicationTypesDTO : List<PublicationTypeDTO> )
activate Controller

' Convert DTO -> Domain
Controller -> GenreMapper : toDomain(selectedGenresDTO)
GenreMapper --> Controller : List<Genre>

Controller -> PubTypeMapper : toDomain(selectedPublicationTypesDTO)
PubTypeMapper --> Controller : List<PublicationType>

Controller -> AppraisalRepo : createAndAddAppraisalEntity(name, contact, genres : List<Genre>, publicationTypes : List<PublicationType> )
activate AppraisalRepo

create "apEn : AppraisalEntity" as AppraisalEntity
AppraisalRepo --> AppraisalEntity : create(...)

AppraisalRepo -> AppraisalList : exists(apEn)
activate AppraisalList
AppraisalList --> AppraisalRepo : false
deactivate AppraisalList

AppraisalRepo -> AppraisalList : add(apEn)
activate AppraisalList
AppraisalList --> AppraisalRepo : apEn added
deactivate AppraisalList

AppraisalRepo --> Controller : apEn
deactivate AppraisalRepo

Controller --> UI : Success
deactivate Controller

UI --> Administrator : Success
deactivate UI

@enduml