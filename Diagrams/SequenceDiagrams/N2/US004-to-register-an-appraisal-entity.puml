@startuml

hide footbox
autonumber

title US004 - To Register an Appraisal Entity


actor Administrator
participant ":UI004" as UI
participant ":RegisterAppraisalController" as RegisterAppraisalController
participant ":AppraisalEntityRepository" as AppraisalEntityRepository
participant ":List<AppraisalEntity>"

activate UI
' Human communication started by Administrator
Administrator -> UI : I want to register an Appraisal Entity in the system
UI -->> Administrator : Provide the information for the New Appraisal Entity
deactivate UI


Administrator -> UI : For the new Appraisal Entity (apEntityXPTO), here's the information

activate UI
' First contact between UI and the System
UI -> RegisterAppraisalController : registerAppraisalEntity(name, contact, genre, publicationType)
activate RegisterAppraisalController

' Communication between RegisterAppraisalController and AppraisalEntityRepository
RegisterAppraisalController -> AppraisalEntityRepository : createAndAddAppraisalEntity(name, contact, genre, publicationType)
activate AppraisalEntityRepository

' Creation of new AppraisalEntity
create "apEntityXPTO: AppraisalEntity" as AppraisalEntity

' Creation, validation and addition made in AppraisalEntityRepository
AppraisalEntityRepository -> AppraisalEntity : createAppraisalEntity(name, contact, genre, publicationType)
AppraisalEntityRepository -> AppraisalEntityRepository : validateAppraisalEntity(apEntityXPTO)

' Adding new appraisal entity
AppraisalEntityRepository -> ":List<AppraisalEntity>" : addToAppraisalEntityList(apEntityXPTO)
activate ":List<AppraisalEntity>"
":List<AppraisalEntity>" -->> AppraisalEntityRepository : apEntityXPTO added to the AppraisalEntityList
deactivate

' Return from AppraisalEntityRepository to RegisterAppraisalController
AppraisalEntityRepository --> RegisterAppraisalController : apEntityXPTO
deactivate AppraisalEntityRepository

' Return from RegisterAppraisalConstroller to the UI
RegisterAppraisalController --> UI : Success
deactivate RegisterAppraisalController

' Return from UI to Administrator
UI --> Administrator :  Success
deactivate UI
@enduml