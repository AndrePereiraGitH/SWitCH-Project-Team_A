@startuml
hide footbox
autonumber
title Find BibliographicalData IDs By AuthorId

participant ":Controller" as Ctrl
participant ":IBibliographicalDataRepository" as bdRepo
participant ":IBibliographicalDataRepositoryJPA" as bdRepoJPA
participant "bdIdList\n:List<BibliographicalDataId>" as bdIdList
participant "bdDMList:\nList<BibliographicalDataDM>" as bdDMList

database "Database" as db

note over Ctrl #E3F2FD
<b>Fragment</b>
---
This diagram is a fragment of the main sequence diagram.
end note

note over Ctrl #E3F2FD
<b>Navigation</b>
---
[[1.MainDiagram.puml Return to Main Diagram]]
end note

Ctrl -> bdRepo : findIdsByAuthorId(selectedAuthorID)
activate Ctrl
activate bdRepo

bdRepo -> bdRepoJPA : findIdsByAuthorId(selectedAuthorID)
activate bdRepoJPA

bdRepoJPA -> db : query bibliographical_data by author_id
activate db
db --> bdRepoJPA : data
deactivate db

bdRepoJPA -->> bdDMList** : <<create>>

bdRepoJPA --> bdRepo : bdDMList
deactivate bdRepoJPA

bdRepo -->> bdIdList** : <<create>>

loop for each bdDM in bdDMList
bdRepo  -> bdDMList : getId()
activate bdDMList
bdDMList --> bdRepo  : id
deactivate bdDMList
bdRepo  -> bdIdList  : add(id)
end

bdRepo --> Ctrl : bdIdList
deactivate bdRepo

deactivate Ctrl
@enduml