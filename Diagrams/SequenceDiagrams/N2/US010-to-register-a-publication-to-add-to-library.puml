@startuml
hide footbox
autonumber
title US010 - To register a new publication in MiteLovers

' As a User, I want to register a new publication
' in the system, so that I can add the
' publication to my library.

actor User
participant ":UI010" as UI
participant ":ToRegisterNewPublicationCtrl" as Ctrl
participant ":PublicationSampleRepository" as SystemRepo
participant ":PublicationSampleFactory" as Factory

User -> UI : I want to add a publication to MiteLovers
activate UI

UI --> User : What publication?
deactivate UI

User -> UI : Here are the details \n(BibliographicalData, User, PublicationStatus, Edition, Condition)
activate UI

UI -> Ctrl : createAndAddPublication(bd, owner, status, edition, condition)
activate Ctrl

Ctrl -> SystemRepo : createAndAdd(bd, owner, status, edition, condition)
activate SystemRepo

SystemRepo -> Factory : create(bd, owner, status, edition, condition)
activate Factory

create "p1 : PublicationSample" as pub1
Factory -> pub1 : create(bd, owner, status, edition, condition)

Factory --> SystemRepo : pub1
deactivate Factory

SystemRepo -> SystemRepo : validate(pub1)
SystemRepo -> SystemRepo : add(pub1)

SystemRepo --> Ctrl : success(pub1)
deactivate SystemRepo

Ctrl --> UI : Success(pub1)
deactivate Ctrl

UI --> User : p1 was added
deactivate UI

@enduml