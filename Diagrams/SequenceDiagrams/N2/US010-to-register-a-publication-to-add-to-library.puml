@startuml
hide footbox
autonumber
title US010 - Register a new publication in MiteLovers

actor User
participant ":UI010" as UI
participant ":US010ToRegisterNewPublicationCtrl" as Ctrl
participant ":PublicationSampleRepository" as SystemRepo
participant ":PublicationSampleFactory" as Factory

User -> UI : I want to register a publication
activate UI

UI --> User : Provide publication details
deactivate UI

User -> UI : Here are the details \n(BibliographicalDataID, PublicationStatus, EditionID, Condition)
activate UI

UI -> Ctrl : registerNewPublication(bdId, userId, status, editionId, condition)
activate Ctrl

Ctrl -> SystemRepo : createAndAdd(bdId, userId, status, editionId, condition)
activate SystemRepo

SystemRepo -> Factory : create(bdId, userId, status, editionId, condition)
activate Factory

create "p1 : PublicationSample" as pub1
Factory --> pub1 : «create»

Factory --> SystemRepo : pub1
deactivate Factory

SystemRepo -> SystemRepo : save(pub1)

SystemRepo --> Ctrl : pub1
deactivate SystemRepo

Ctrl --> UI : true
deactivate Ctrl

UI --> User : Publication registered successfully
deactivate UI

@enduml