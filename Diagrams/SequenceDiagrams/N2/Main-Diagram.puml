@startuml
hide footbox
autonumber
title To Get Items on Direct Sale by Publisher (Main diagram)

actor Buyer

participant ":UI" as UI
participant ":ToGetListOfItemsOnDirectSaleOfGivenPublisherController" as Ctrl

participant ":IPublisherRepository" as publisherRepo
participant ":IPublisherRepositoryJpa" as publisherJpa

participant ":IEditionRepository" as editionRepo
participant ":IPublicationSampleRepository" as pubSampleRepo
participant ":IListingRepository" as listingRepo

participant ":US027PublisherMapper" as publisherMapper
participant ":US027ListingMapper" as listingMapper

database "Database" as DB

' =========================
' ENTRY POINT
' =========================

Buyer -> UI : I want items on direct sale of \n a given publisher
activate UI

UI -> Ctrl : getAllPublishers()
activate Ctrl

' =========================
' PUBLISHERS
' =========================

Ctrl -> publisherRepo : findAll()
activate publisherRepo

publisherRepo -> publisherJpa : findAll()
activate publisherJpa

publisherJpa -> DB : SELECT * FROM publisher
activate DB
DB --> publisherJpa : publisher data
deactivate DB

publisherJpa --> publisherRepo : List<Publisher>
deactivate publisherJpa

publisherRepo --> Ctrl : List<Publisher>
deactivate publisherRepo

Ctrl -> publisherMapper : toDTOs(publishers)
activate publisherMapper
publisherMapper --> Ctrl : List<US027PublisherDTO>
deactivate publisherMapper

Ctrl --> UI : publisherDTOs
deactivate Ctrl

UI --> Buyer : display publishers
deactivate UI

' =========================
' USER SELECTION
' =========================

Buyer -> UI : This is the publisher I want
activate UI

UI -> Ctrl : findListOfItemsOnDirectSaleByPublisherId(publisherId)
activate Ctrl

' =========================
' EDITIONS
' =========================

Ctrl -> editionRepo : findIdsByPublisherId(publisherId)
activate editionRepo

editionRepo -> DB : SELECT editionIds\nWHERE publisherId = ?
activate DB
DB --> editionRepo : editionIds
deactivate DB

editionRepo --> Ctrl : List<EditionId>
deactivate editionRepo

' =========================
' PUBLICATION SAMPLES
' =========================

Ctrl -> pubSampleRepo : findIdsByEditionIdIn(editionIds)
activate pubSampleRepo

pubSampleRepo -> DB : SELECT publicationSampleIds\nWHERE editionId IN (?)
activate DB
DB --> pubSampleRepo : publicationSampleIds
deactivate DB

pubSampleRepo --> Ctrl : List<PublicationSampleId>
deactivate pubSampleRepo

' =========================
' LISTINGS
' =========================

Ctrl -> listingRepo : findAllByDirectSaleAndPublicationSampleIdIn(pubSampleIds)
activate listingRepo

listingRepo -> DB : SELECT listings\nWHERE saleType = DIRECT_SALE\nAND publicationSampleId IN (?)
activate DB
DB --> listingRepo : listing data
deactivate DB

listingRepo --> Ctrl : List<Listing>
deactivate listingRepo

' =========================
' DTO MAPPING
' =========================

Ctrl -> listingMapper : toDTOs(listings)
activate listingMapper
listingMapper --> Ctrl : List<US027ListingDTO>
deactivate listingMapper

' =========================
' RESPONSE
' =========================

Ctrl --> UI : listingDTOs
deactivate Ctrl

UI --> Buyer : display direct-sale listings
deactivate UI

@enduml