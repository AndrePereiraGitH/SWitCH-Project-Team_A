@startuml

hide footbox
autonumber
title US022 - To get the list of items on auction of a given genre

box #WhiteSmoke
actor Buyer
participant ":UI022" as UI022
end box

Buyer -> UI022 : I want to get a list of items on auction of a given genre
activate UI022
UI022 --> Buyer : Which genre?
Buyer -> UI022 : genre

box "Controller" #LightBlue
participant ":ToGetTheListOfItemsOnAuctionOfAGivenGenreController" as ToGetTheListOfItemsOnAuctionOfAGivenGenreController
end box

UI022 -> ToGetTheListOfItemsOnAuctionOfAGivenGenreController: getListOfItemsOnAuction(genre)
activate ToGetTheListOfItemsOnAuctionOfAGivenGenreController

box "Persistence" #LightGrey
participant ":ListingRepository" as ListingRepository
end box

ToGetTheListOfItemsOnAuctionOfAGivenGenreController-> ListingRepository : getListOfItemsOnAuction(genre)
activate ListingRepository

ListingRepository -> ListingRepository : validateParameters(genre)

box "Domain Model" #LightYellow
create "l1: List<Listing>" as Listing
ListingRepository -> Listing : getList(genre)
end box

ListingRepository --> ToGetTheListOfItemsOnAuctionOfAGivenGenreController: l1
deactivate ListingRepository

ToGetTheListOfItemsOnAuctionOfAGivenGenreController-> ToGetTheListOfItemsOnAuctionOfAGivenGenreController: cl1: copyList(l1)

ToGetTheListOfItemsOnAuctionOfAGivenGenreController--> UI022 : cl1
deactivate ToGetTheListOfItemsOnAuctionOfAGivenGenreController

UI022 --> Buyer : List of items on auction
deactivate UI022

@enduml