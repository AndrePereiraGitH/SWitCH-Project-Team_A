@startuml
autonumber
hide footbox
title US022 - Get the list of items on auction of a given genre

actor Buyer

' Participants
participant ":UI022" as UI
participant ":ToGetTheListOfItemsOnAuction\nOfAGivenGenreController" as Ctrl
participant ":GenreRepository" as GenreRepo
participant ":GenreMapper" as GenreMapper
participant "genreDTO:GenreDTO" as GenreDTO
participant ":AuctionMapper" as Mapper
participant ":AuctionRepository" as AuctionRepo
participant "listOfAuctions:\nList<Auction>" as ListAuc
participant ":Auction" as AuctionDomain
participant "auctionDTO:\nAuctionDTO" as DTO
participant "listOfAuctionsDTO:\nList<AuctionDTO>" as ListDTO

' Interactions
Buyer -> UI : I want to get the list of items\n on auction of a given genre
activate UI

UI -> Ctrl : getAllGenres()
activate Ctrl

Ctrl -> GenreRepo : getAllGenres()
activate GenreRepo
GenreRepo --> Ctrl : listOfAllGenres
deactivate GenreRepo

Ctrl -> GenreMapper: toDTO(listOfAllGenre)
activate GenreMapper
GenreMapper -> GenreDTO ** : create()
activate GenreDTO
GenreDTO --> GenreMapper: GenreDTO
deactivate GenreDTO
GenreMapper -> GenreMapper : listOfAllGenreDTO.add(GenreDTO)
GenreMapper --> Ctrl: listOfAllGenreDTO
deactivate GenreMapper

Ctrl --> UI : listOfAllGenres
deactivate Ctrl

UI --> Buyer : Which genre? Choose!
deactivate UI

Buyer -> UI : genre
activate UI

UI -> Ctrl : getListOfItemsOnAuction(genre)
activate Ctrl

Ctrl -> AuctionRepo : getListOfItemsOnAuction(genre)
activate AuctionRepo

loop for each auction
    AuctionRepo -> AuctionRepo : checkAuctionGenre(genre)
end

AuctionRepo -> ListAuc ** :
AuctionRepo --> Ctrl : listOfAuctions
deactivate AuctionRepo

Ctrl -> Mapper : toDTO(listOfAuctions)
activate Mapper
Mapper -> ListDTO ** :

    loop for each auction
        Mapper -> AuctionDomain : getDetails()
        activate AuctionDomain
        AuctionDomain --> Mapper : details
        deactivate AuctionDomain

        Mapper -> DTO ** : create(details)
        activate DTO
        DTO --> Mapper : auctionDTO
        deactivate DTO

        Mapper -> Mapper : listOfAuctionsDTO.add(auctionDTO)
    end

Mapper --> Ctrl : listOfAuctionsDTO
deactivate Mapper

Ctrl --> UI : listOfAuctionsDTO
deactivate Ctrl

UI --> Buyer : Shows the list of items on auction
deactivate UI

@enduml