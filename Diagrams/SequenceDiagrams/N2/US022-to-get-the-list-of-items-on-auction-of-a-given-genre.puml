@startuml
autonumber
hide footbox
title US022 - Get List Of Items On Auction Of Given Genre

actor Buyer

participant ":UI022" as UI
participant ":GetListOfItemsOnAuctionOfGivenGenreController" as Ctrl
participant ":GenreRepository" as GenreRepo
participant ":GenreDTO_US022" as GenreDTO
participant ":AuctionRepository" as AuctionRepo
participant ":AuctionDTO_US022" as AuctionDTO


Buyer -> UI : I want to get a list of items\n on auction of a given genre
activate UI
UI -> Ctrl : getAllGenres()
activate Ctrl
Ctrl -> GenreRepo : getAllGenres()
activate GenreRepo
GenreRepo --> Ctrl : List<Genre>
deactivate GenreRepo

Ctrl -> GenreDTO : fromDomainList(List<Genre>)

activate GenreDTO
create "listOfGenreDTO:\nList<GenreDTO_US022>" as listDTO
GenreDTO -> listDTO : create()
loop for each Genre
    GenreDTO -> Genre : getGenreType()
    activate Genre
    Genre --> GenreDTO : genreType
    deactivate Genre
    GenreDTO -> GenreDTO : create GenreDTO_US022(genreType)
    GenreDTO -> listDTO : add(genreTypeDTO)
end
GenreDTO --> Ctrl : List<GenreDTO_US022>
deactivate GenreDTO

Ctrl --> UI : List<GenreDTO_US022>
deactivate Ctrl
UI --> Buyer : Show genres! Choose
deactivate UI

Buyer -> UI : Select genre: genreA
activate UI
UI -> Ctrl : getListOfItemsOnAuction(genreA)
activate Ctrl
Ctrl -> AuctionRepo : getListOfItemsOnAuctionGivenGenre(genreA)
activate AuctionRepo
AuctionRepo --> Ctrl : List<Auction>
deactivate AuctionRepo

Ctrl -> AuctionDTO : fromDomainList(List<Auction>)

activate AuctionDTO
create "listOfAuctionOfGivenGenreDTO:\nList<AuctionDTO_US022>" as listADTO
AuctionDTO -> listADTO : create()
loop for each Auction
    AuctionDTO -> Auction : getDetails()
    Auction --> AuctionDTO : auctionDetails
        AuctionDTO -> AuctionDTO : create AuctionDTO_US022
        AuctionDTO -> listADTO : add(AuctionDTO_US022)
end
AuctionDTO --> Ctrl : List<AuctionDTO_US022>
deactivate AuctionDTO

Ctrl --> UI : List<AuctionDTO_US022>
deactivate Ctrl
UI --> Buyer : Show List requested!
deactivate UI

@enduml