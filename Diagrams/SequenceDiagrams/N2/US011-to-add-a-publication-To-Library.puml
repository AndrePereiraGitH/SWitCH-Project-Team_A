@startuml
autonumber
hide footbox
title US011 - Add publication to library



actor "User" as User
participant ":UI011" as UI

participant ":AddPublicationToLibraryController" as Ctrl

participant ":IPublicationSampleRepository" as PubRepo

participant "ILibraryRepository" as LibDomain


autonumber

User -> UI : "I want to add a publication\n to my library"
activate UI
UI -> Ctrl : getListOfPublicationsNotInLibrary(userId)
activate Ctrl

Ctrl -> PubRepo: getAllPublicationsFromUserWithoutLibrary\n(userId)
activate PubRepo
PubRepo --> Ctrl: listOfPublicationsNotInLibrary
deactivate PubRepo
Ctrl --> UI: listOfPublicationsNotInLibrary
deactivate Ctrl
UI --> User: "Select Publication you wish\n to add to your Library"
deactivate UI

User -> UI: "I want to add <publicationSampleId>\n to my Library!"
activate UI
UI -> Ctrl: addPublicationToLibrary\n(UserId userId, PublicationSampleId publicationSampleId)
activate Ctrl
Ctrl -> LibDomain: getLibraryByUserId(userId)
activate LibDomain
LibDomain --> Ctrl: library
deactivate LibDomain
Ctrl -> PubRepo: findPublicationSampleById\n(publicationSampleId)
activate PubRepo
PubRepo --> Ctrl: pbSample
Ctrl -> PubRepo: addPublicationToLibrary(libraryId)
PubRepo --> Ctrl: true
deactivate PubRepo
Ctrl --> UI: true
deactivate Ctrl
UI --> User: "<PublicationSample>\n successfully added to your Library!"
deactivate UI

@enduml