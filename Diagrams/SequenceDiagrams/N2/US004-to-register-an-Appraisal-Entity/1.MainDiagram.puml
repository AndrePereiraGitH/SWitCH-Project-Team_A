@startuml

hide footbox
autonumber
title US004 - Register Appraisal Entity (Main)

actor Administrator
participant ":UI004" as UI
participant ":US004ToRegisterAppraisalEntityController" as Controller

Administrator -> UI : I want to register an Appraisal Entity
activate UI

UI --> Administrator : Please provide name and contact for the new AppraisalEntity
deactivate UI

Administrator -> UI : Here's the name and contact
activate UI

ref over UI, Controller
[[2.GetGenres.puml Get Genres]]

end ref

ref over UI, Controller
[[3.GetPublicationTypes.puml Get Publication Types]]

end ref

ref over UI, Controller
[[4.RegisterEntity.puml Register Entity]]

end ref

UI ---> Administrator : Success
deactivate UI

@enduml