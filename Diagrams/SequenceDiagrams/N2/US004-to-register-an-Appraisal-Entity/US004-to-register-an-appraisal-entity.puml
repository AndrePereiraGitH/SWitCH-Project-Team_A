@startuml

hide footbox
autonumber
title US004 - Register Appraisal Entity (DTO + Mapper + DDD)

actor Administrator
participant ":UI004" as UI
participant ":US004ToRegisterAppraisalEntityController" as Controller

participant ":GenreRepository" as GenreRepo
participant "allGenreList: List<Genre>" as allGenreList
participant ":GenreMapper" as GenreMapper
participant "listOfGenreDTO: List<GenreDTO>" as GenreDTO
participant ":Genre" as Genre
participant "genreDTO: GenreDTO" as GDTO
' participant "genreId: GenreId" as GenreId

participant ":PublicationTypeRepository" as PublicationTypeRepo
participant "allPublicationTypeList: List<PublicationType>" as allPublicationTypeList
participant ":PublicationTypeMapper" as PublicationTypeMapper
participant "listOfPublicationTypeDTO: List<PublicationTypeDTO>" as PublicationTypeDTO
participant ":PublicationType" as PublicationType
participant "publicationTypeDTO: PublicationTypeDTO" as PDTO
' participant "publicationTypeId: PublicationTypeId" as PublicationTypeId

participant ":AppraisalEntityRepository" as AppraisalRepo
participant ":FactoryAppraisalEntity" as FactoryAppraisalEntity
participant "apEn : AppraisalEntity" as AppraisalEntity
' participant "appraisalId: AppraisalEntityId" as AppraisalId


' --- Start ---
Administrator -> UI : I want to register an Appraisal Entity
activate UI

UI --> Administrator : Please provide name and contact for the new AppraisalEntity
deactivate UI

Administrator -> UI : Here's the name and contact
activate UI

' =========================
' Get Genres (DTO)
' =========================
UI -> Controller : getAllGenres()
activate Controller

Controller -> GenreRepo : getAllGenres()
activate GenreRepo
GenreRepo -->> allGenreList ** : <<create>>
GenreRepo --> Controller : allGenreList
deactivate GenreRepo

Controller -> GenreMapper : toDTO(allGenreList)
activate GenreMapper
GenreMapper -->> GenreDTO ** : <<create>>

loop for each genre in the list
'    GenreMapper -> Genre : getId()
'    activate Genre
'    Genre --> GenreMapper : id
'    deactivate Genre

    GenreMapper -> Genre : getTitle()
    activate Genre
    Genre --> GenreMapper : title
    deactivate Genre

    GenreMapper -->> GDTO ** : <<create>>
    GenreMapper -> GenreMapper : listOfGenreDTO.add(genreDTO)
end

GenreMapper --> Controller : listOfGenreDTO
deactivate GenreMapper

Controller --> UI : listOfGenreDTO
deactivate Controller

UI --> Administrator : Display available Genres
deactivate UI

Administrator -> UI : Selected one or more Genres
activate UI

' =========================
' Get Publication Types (DTO)
' =========================
UI -> Controller : getAllPublicationTypes()
activate Controller

Controller -> PublicationTypeRepo : getAllPublicationTypes()
activate PublicationTypeRepo
PublicationTypeRepo -->> allPublicationTypeList ** : <<create>>
PublicationTypeRepo --> Controller : allPublicationTypeList
deactivate PublicationTypeRepo

Controller -> PublicationTypeMapper : toDTO(allPublicationTypeList)
activate PublicationTypeMapper
PublicationTypeMapper -->> PublicationTypeDTO ** : <<create>>

loop for each publicationType in the list
'    PublicationTypeMapper -> PublicationType : getId()
'    activate PublicationType
'    PublicationType --> PublicationTypeMapper : id
'    deactivate PublicationType

    PublicationTypeMapper -> PublicationType : getMediaFormat()
    activate PublicationType
    PublicationType --> PublicationTypeMapper : mediaFormat
    deactivate PublicationType

    PublicationTypeMapper -->> PDTO ** : <<create>>
    PublicationTypeMapper -> PublicationTypeMapper : listOfPublicationTypeDTO.add(publicationTypeDTO)
end

PublicationTypeMapper --> Controller : listOfPublicationTypeDTO
deactivate PublicationTypeMapper

Controller --> UI : listOfPublicationTypeDTO
deactivate Controller

UI --> Administrator : Display available Publication Types
deactivate UI

Administrator -> UI : Selected one or more Publication Types
activate UI

' =========================
' Register Appraisal Entity
' =========================
UI -> Controller : registerAppraisalEntity(name, contact, selectedGenresDTO, selectedPublicationTypesDTO)
activate Controller

Controller -> Controller : validateSelectedGenres(selectedGenresDTO)
Controller -> Controller : validateSelectedPublicationTypes(selectedPublicationTypesDTO)

loop for each genreDTO in selectedGenresDTO
    Controller -> GenreRepo : findById(genreDTO.id)
    activate GenreRepo
    GenreRepo --> Controller : genres
    deactivate GenreRepo
end

loop for each publicationTypeDTO in selectedPublicationTypesDTO
    Controller -> PublicationTypeRepo : findById(publicationTypeDTO.id)
    activate PublicationTypeRepo
    PublicationTypeRepo --> Controller : publicationTypes
    deactivate PublicationTypeRepo
end

Controller -> AppraisalRepo : createAndAddAppraisalEntity(name, contact, genres, publicationTypes)
activate AppraisalRepo

AppraisalRepo -> FactoryAppraisalEntity : create(name, contact, genres, publicationTypes)
activate FactoryAppraisalEntity

FactoryAppraisalEntity -->> AppraisalEntity **: <<create>>

FactoryAppraisalEntity --> AppraisalRepo : apEn
deactivate FactoryAppraisalEntity

AppraisalRepo -> AppraisalRepo : exists(apEn)
AppraisalRepo --> AppraisalRepo : false
AppraisalRepo -> AppraisalRepo : add(apEn)

AppraisalRepo --> Controller : apEn
deactivate AppraisalRepo

Controller --> UI : Success
deactivate Controller

UI ---> Administrator : Success
deactivate UI

@enduml