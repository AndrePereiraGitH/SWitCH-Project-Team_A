participant ":UI004" as UI
participant ":US004ToRegisterAppraisalEntityController" as Controller
participant ":PublicationTypeRepository" as PublicationTypeRepo
participant "allPublicationTypeList: List<PublicationType>" as allPublicationTypeList
participant ":PublicationTypeMapper" as PublicationTypeMapper
participant "listOfPublicationTypeDTO: List<PublicationTypeDTO>" as listOfPublicationTypeDTO
participant ":PublicationType" as PublicationType
participant "publicationTypeDTO: PublicationTypeDTO" as publicationTypeDTO

UI -> Controller : getAllPublicationTypes()
activate Controller

Controller -> PublicationTypeRepo : getAllPublicationTypes()
activate PublicationTypeRepo
PublicationTypeRepo -->> allPublicationTypeList ** : <<create>>
PublicationTypeRepo --> Controller : allPublicationTypeList
deactivate PublicationTypeRepo

Controller -> PublicationTypeMapper : toDTO(allPublicationTypeList)
activate PublicationTypeMapper
PublicationTypeMapper -->> listOfPublicationTypeDTO ** : <<create>>

loop for each publicationType in allPublicationTypeList
    PublicationTypeMapper -> PublicationType : getId()
    activate PublicationType
    PublicationType --> PublicationTypeMapper : id
    deactivate PublicationType

    PublicationTypeMapper -> PublicationType : getMediaFormat()
    activate PublicationType
    PublicationType --> PublicationTypeMapper : mediaFormat
    deactivate PublicationType

    PublicationTypeMapper -->> publicationTypeDTO ** : <<create>>
    PublicationTypeMapper -> PublicationTypeMapper : listOfPublicationTypeDTO.add(publicationTypeDTO)
end

PublicationTypeMapper --> Controller : listOfPublicationTypeDTO
deactivate PublicationTypeMapper

Controller --> UI : listOfPublicationTypeDTO
deactivate Controller

@enduml