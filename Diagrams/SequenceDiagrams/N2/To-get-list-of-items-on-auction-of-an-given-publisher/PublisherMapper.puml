@startuml

hide footbox
autonumber
title Publisher mapping details

participant ":ToGetTheListOfItemsOn\nAuctionOfAGivenPublisherController" as Ctrl
participant ":PublisherRepository" as PublisherRepo
participant "listOfAllPublishers:\nList<Publisher>" as ListPublishers
participant ":US028PublisherMapper" as PublisherMapper
participant ":Publisher" as Publisher
participant ":US028PublisherDTO" as PublisherDTO
participant "listOfAllPublishersDTO:\nList<US028PublisherDTO>" as ListPublisherDTO

Ctrl -> PublisherRepo: getAllPublishers()
activate PublisherRepo
PublisherRepo -> ListPublishers ** : create()
PublisherRepo -->> Ctrl: listOfAllPublishers
deactivate PublisherRepo

Ctrl -> PublisherMapper: toDTOs(listOfAllPublishers)
activate PublisherMapper
PublisherMapper -> ListPublisherDTO ** : create()

loop for each publisher
    PublisherMapper -> Publisher: getName()
    activate Publisher
    Publisher -->> PublisherMapper: name

    PublisherMapper -> Publisher: id()
    Publisher -->> PublisherMapper: publisherId
    deactivate Publisher

    PublisherMapper -> PublisherDTO ** : create(name, publisherId)
    PublisherMapper -> ListPublisherDTO: add(publisherDTO)
end

PublisherMapper -->> Ctrl: listOfAllPublishersDTO
deactivate PublisherMapper

@enduml