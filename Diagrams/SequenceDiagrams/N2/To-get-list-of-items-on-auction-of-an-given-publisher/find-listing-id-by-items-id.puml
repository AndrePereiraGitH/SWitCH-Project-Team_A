@startuml

hide footbox
autonumber
title SD-US028-05 Find Listing Ids By Items Id

participant ":ToGetListOfPublishers\nController" as Controller
participant ":IListing\nRepository" as ListingRepo
participant ":IListing\nRepositoryJPA" as LJPA
participant "listingDMList:\nList<ListingDM>"
participant "listOfListingId:\nList<ListingId>"
participant "DataBase" as DB

Controller -> ListingRepo : findAllListingId(listOfItemsId)
activate ListingRepo

ListingRepo -> LJPA : findAllByItemsId(listOfItemsId)
activate LJPA

LJPA -> DB : SELECT * FROM listing\nWHERE publication_sample_id IN
activate DB
DB --> LJPA : data
deactivate DB

LJPA -->> "listingDMList:\nList<ListingDM>" ** : <<create>>
LJPA -->> "listOfListingId:\nList<ListingId>" ** : <<create>>

loop for each dm in listingDMList
    LJPA -> "listOfListingId:\nList<ListingId>" : add(dm.getListingId())
end

LJPA --> ListingRepo : listOfListingId
deactivate LJPA

ListingRepo --> Controller : listOfListingId
deactivate ListingRepo

@enduml