@startuml
hide footbox
autonumber
title Get All Publishers

participant ":ToGetListOfPublishers\nController" as Controller
participant ":IPublisherRepository" as publisherRepo
participant ":IPublisherRepositoryJpa" as publisherJpa
participant "publisherDMList:\nList<PublisherDM>" as publisherDMList
participant "listOfPublishers:\nList<Publisher>" as listOfPublishers
participant ":PublisherAssembler" as publisherAssembler
participant ":PublisherFactory" as publisherFactory
participant "publisher:Publisher" as publisher
participant "Database" as DB

note over Controller #E3F2FD
<b>Navigation</b>
---
[[./main.puml Return to Main Diagram]]
end note

Controller -> publisherRepo : findAll()
activate publisherRepo

publisherRepo -> publisherJpa : findAll()
activate publisherJpa

publisherJpa -> DB : SELECT * FROM publisher
activate DB
DB --> publisherJpa : data
deactivate DB

publisherJpa -->> publisherDMList ** : <<create>>
publisherJpa --> publisherRepo : publisherDMList
deactivate publisherJpa

publisherRepo -->> listOfPublishers ** : <<create>>

loop for each dm in publisherDMList
    publisherRepo -> publisherAssembler : toDomain(dm)
    activate publisherAssembler

    publisherAssembler -> publisherFactory : create(dm.getId(), dm.getName(), ...)
    activate publisherFactory
    publisherFactory -->> publisher ** : <<create>>
    publisherFactory --> publisherAssembler : publisher
    deactivate publisherFactory

    publisherAssembler --> publisherRepo : publisher
    deactivate publisherAssembler

    publisherRepo -> publisherRepo : listOfPublishers.add(publisher)
end

publisherRepo --> Controller : listOfPublishers
deactivate publisherRepo

@enduml