@startuml

hide footbox
autonumber
title SD-US028-04 Find Items Ids By Bibliographical Data Id

participant ":ToGetListOfPublishers\nController" as Controller
participant ":IPublicationSample\nRepository" as PubSampleRepo
participant ":IPublicationSample\nRepositoryJPA" as PSJPA
participant "pbSampleDMList:\nList<PublicationSampleDM>"
participant "listOfItemsId:\nList<PublicationSampleId>"
participant "DataBase" as DB

Controller -> PubSampleRepo : findItemsIdBy\nBibliographicalDataId(listOfBioDataId)
activate PubSampleRepo

PubSampleRepo -> PSJPA : findAllByBibliographicalDataId(listOfBioDataId)
activate PSJPA

PSJPA -> DB : SELECT * FROM publication_sample\nWHERE bibliographical_data_id IN
activate DB
DB --> PSJPA : data
deactivate DB

PSJPA -->> "pbSampleDMList:\nList<PublicationSampleDM>" ** : <<create>>
PSJPA -->> "listOfItemsId:\nList<PublicationSampleId>" ** : <<create>>

loop for each dm in pbSampleDMList
    PSJPA -> "listOfItemsId:\nList<PublicationSampleId>" : add(dm.getPubSampleId())
end

PSJPA --> PubSampleRepo : listOfItemsId
deactivate PSJPA

PubSampleRepo --> Controller : listOfItemsId
deactivate PubSampleRepo

@enduml