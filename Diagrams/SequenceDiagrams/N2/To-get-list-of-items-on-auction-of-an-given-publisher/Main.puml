@startuml
hide footbox
autonumber
title To Get The List Of Items On Auction Of A Given Publisher

actor Buyer

participant ":UI" as UI
participant ":US028ToGetTheListOfItemsOnAuctionOfAGivenPublisherController" as Ctrl

Buyer -> UI : I want to get the list of items\non auction of a given publisher
activate UI

UI -> Ctrl : getAllPublishers()
activate Ctrl

ref over Ctrl
[[get-all-publishers.puml Get All Publishers]]
end ref

Ctrl --> UI : listOfPublisherDTO
deactivate Ctrl

UI --> Buyer : Here is the list of publishers.\nPick one.
deactivate UI

Buyer -> UI : publisher
activate UI

UI -> Ctrl : findListOfItemsOnAuctionByPublisherId(publisherId)
activate Ctrl

ref over Ctrl
[[find-edition-ids-by-publisher-id.puml Find Edition Ids By Publisher Id]]
end ref

ref over Ctrl
[[find-publication-sample-ids-by-edition-ids.puml Find Publication Sample Ids By Edition Ids]]
end ref

ref over Ctrl
[[find-auction-listings-by-publication-sample-ids.puml Find Auction Listings By Publication Sample Ids]]
end ref

ref over Ctrl
[[build-listing-dtos.puml Build Listing DTOs]]
end ref

Ctrl --> UI : listOfAuctionListingsDTO
deactivate Ctrl

UI --> Buyer : Here is the list of items on auction\nfor the selected publisher.
deactivate UI

@enduml