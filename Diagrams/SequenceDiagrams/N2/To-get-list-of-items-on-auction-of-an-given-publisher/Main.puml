@startuml

hide footbox
autonumber
title To Get a List Of Items On Auction By A Given Publisher

actor Buyer as User

participant ":UI" as UI
participant ":ToGetListOfPublishers\nController" as Controller



participant ":IAuction\nRepository" as AuctionRepo
participant ":IAuction\nRepositoryJPA" as AJPA
participant ":Auction\nAssembler" as AuctionAssembler
participant ":Auction\nFactory" as Factory
participant "auctionDMList:\nList<AuctionDM>"
participant "listOfAuctionOnGivenPublisher:\nList<Auction>"
participant ":US028Auction\nMapper" as AuctionMapper
participant "DataBase" as DB


User -> UI : I want to see all official\n publishers in the system
activate UI

UI -> Controller : getAllPublishers()
activate Controller

    ref over Controller
[[to-get-publisher.puml Get All Publishers]]
    end ref

Controller --> UI : listOfPublisherDTO
deactivate Controller

UI --> User : Show publishers! Choose
deactivate UI
User -> UI : Select publisher
activate UI

UI -> Controller : findById(publisher)
activate Controller
ref over Controller
[[find-publisher-by-id.puml Find Publisher By Id]]
end ref


ref over Controller
[[find-bibliographical-data-id-by-publisher.puml Find Bibliographical Data Ids By Publisher]]
end ref

ref over Controller
[[find-items-id-by-bibliographical-data-id.puml Find Items Ids By Bibliographical Data Id]]
end ref

ref over Controller
[[find-listing-id-by-items-id.puml Find Listing Ids By Items Id]]
end ref

Controller -> AuctionRepo : getAllAuctionsIdOnListing(listOfListingId)
activate AuctionRepo
AuctionRepo -> AJPA : findAllByListingId(listOfListingId)
activate AJPA
AJPA -> DB : SELECT * FROM auction\nWHERE listing_id IN
activate DB
DB --> AJPA : data
deactivate DB
AJPA -->> "auctionDMList:\nList<AuctionDM>" ** : <<create>>
AJPA --> AuctionRepo : auctionDMList
deactivate AJPA

AuctionRepo -->> "listOfAuctionOnGivenPublisher:\nList<Auction>" ** : <<create>>

loop for each dm in auctionDMList
    AuctionRepo -> AuctionAssembler : toDomain(dm)
    activate AuctionAssembler
    AuctionAssembler -> Factory : create(dm.getAuctionId(), .... )
    activate Factory
    Factory -->> "auction:Auction" ** : <<create>>
    Factory --> AuctionAssembler : auction
    deactivate Factory
    AuctionAssembler --> AuctionRepo : auction
    deactivate AuctionAssembler

    opt
    AuctionRepo -> AuctionRepo : listOfAuctionOnGivenPublisher.add(auction)
    end
end

AuctionRepo --> Controller : listOfAuctionOnGivenPublisher
deactivate AuctionRepo

Controller -> AuctionMapper : toDTOList(listOfAuctionOnGivenPublisher)
activate AuctionMapper
AuctionMapper -->> "listOfAuctionDTO:\nList<US028AuctionDTO>" ** : <<create>>

loop for each Auction in listOfAuctionOnGivenPublisher

    AuctionMapper -> "AuctionDTO:\nUS028AuctionDTO" ** : toDTO
    AuctionMapper -> AuctionMapper : listOfAuctionDTO.add(auctionDTO)
end
AuctionMapper --> Controller : listOfAuctionDTO
deactivate AuctionMapper

Controller --> UI : listOfAuctionDTO
deactivate Controller

UI --> User : Display items
deactivate UI

@enduml