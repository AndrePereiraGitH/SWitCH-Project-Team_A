@startuml
hide footbox
autonumber
title Build Listing DTOs

participant ":US028ToGetTheListOfItemsOnAuctionOfAGivenPublisherController" as Ctrl
participant ":US028ListingMapper" as listingMapper
participant "listOfAuctionListings:List<Listing>" as listOfAuctionListings
participant "listOfAuctionListingsDTO:List<US028ListingDTO>" as listOfAuctionListingsDTO
participant "auctionListingDTO:US028ListingDTO" as auctionListingDTO

note over Ctrl #E3F2FD
<b>Navigation</b>
---
[[./main.puml Return to Main Diagram]]
end note

Ctrl -> listingMapper : toDTOs(listOfAuctionListings)
activate listingMapper

listingMapper -->> listOfAuctionListingsDTO ** : <<create>>

loop for each listing in listOfAuctionListings
    listingMapper -> auctionListingDTO ** : toDTO(listing)
    listingMapper -> listingMapper : listOfAuctionListingsDTO.add(auctionListingDTO)
end

listingMapper --> Ctrl : listOfAuctionListingsDTO
deactivate listingMapper

@enduml