@startuml
hide footbox
autonumber
title To get the list of items on direct sale of a given publication

box #whitesmoke
actor Buyer
participant ":UI" as UI
end box

' Controller
participant ":ToGetTheListOfItemsOn\nDirectSaleOfAGivenPublicationController" as Ctrl

' Publication Sample
participant ":IPublicationSample\nRepository" as PubSampleRepo
participant ":IPublicationSample\nRepositoryJPA" as PubSampleRepoJPA
participant "listOfPubSampleId:\nList<PublicationSampleId" as listPubSampleId

' Listing
participant ":IListing\nRepository" as ListingRepo
participant ":IListing\nRepositoryJPA" as ListingRepoJPA
participant "listOfDSListingDMs:\nList<ListingDM>" as listDSListingDMs
participant ":Listing\nAssembler" as ListingAss
participant "listOfDSListings:\nList<Listing>" as listDSListings
participant ":Listing\nFactory" as ListingFact
participant "listing:Listing" as Listing


' Database
database "database" as DB

' Section 1 - Get all publications and converts to DTO
Buyer -> UI : I want to get the list of items\n on direct sale of a given publication
activate UI
UI -> Ctrl : findAllBibliographicalData()
activate Ctrl

ref over Ctrl
[[2.GetAllPublications.puml Get all the publications in the system]]
end ref

ref over Ctrl
[[3.BuildPublicationDTOs.puml Build publications DTOs]]
end ref

autonumber 36
Ctrl --> UI : listOfAllBDDTO
deactivate Ctrl
Buyer <-- UI : Which publication? Choose!
deactivate UI

Buyer -> UI : publication
activate UI
UI -> Ctrl : findListOfItemsOnDirectSale(bdId)
activate Ctrl

' Section 2 - Get PublicationSample IDs for that BibliographicalData ID
Ctrl -> PubSampleRepo : findPubSampleIdsBy\nBibliographicalDataId(bdId)
activate PubSampleRepo
PubSampleRepo -> PubSampleRepoJPA: findPubSampleIdsBy\nBibliographicalDataId(bdId)
activate PubSampleRepoJPA
PubSampleRepoJPA -> DB: QUERY all publicationSample by bibliographicalDataId
activate DB
DB --> PubSampleRepoJPA: data
deactivate DB
PubSampleRepoJPA -->> listPubSampleId** : «create»
PubSampleRepoJPA --> PubSampleRepo: listOfPubSampleId
deactivate PubSampleRepoJPA
PubSampleRepo --> Ctrl: listOfPubSampleId
deactivate PubSampleRepo

' Section 3 - Get Direct Sale Listings for those PublicationSample IDs
Ctrl -> ListingRepo : findDirectSaleListingsContainingPublicationSampleId(listOfPubSampleId)
activate ListingRepo
ListingRepo -> ListingRepoJPA: findDirectSaleListingsContaining\nPublicationSampleId(listOfPubSampleId)
activate ListingRepoJPA
ListingRepoJPA -> DB: QUERY listings by publicationSampleId and saleType
activate DB
DB --> ListingRepoJPA: data
deactivate DB
ListingRepoJPA -->> listDSListingDMs** : «create»
ListingRepoJPA --> ListingRepo: listOfDSListingDMs
deactivate ListingRepoJPA
ListingRepo -> ListingAss: toDomain(listOfDSListingDMs)
activate ListingAss
ListingAss -->> listDSListings **: «create»
loop for each listingDM in listOfDSListingDMs
    ListingAss -> ListingFact: create(listingId, listingTitle, itemsId, saleType,\n price, shortDescription, sellerId, pictures)
    activate ListingFact
    ListingFact -->> Listing** : «create»
    ListingFact --> ListingAss: listing
    ListingAss -> listDSListings: add(listing)
    deactivate ListingFact
end
ListingAss --> ListingRepo: listOfDSListings
deactivate ListingAss

ListingRepo --> Ctrl : listOfDSListings
deactivate ListingRepo

' Section 4 - creates DTO
ref over Ctrl
[[4.BuildListingDTOs.puml Build Listing DTOs]]
end ref

autonumber 66
Ctrl --> UI : listOfListingDTOs
deactivate Ctrl
UI --> Buyer : Shows the list of items on direct sale
deactivate UI

@enduml