@startuml
autonumber
hide footbox
title Find Publications in Library

participant ":PublicationSampleService" as Service
participant ":IUserRepository" as UserRepo
participant "user: Optional<User>" as user
participant ":PublicationSampleAuthorizationPolicy" as Policy
participant ":IPublicationSampleRepository" as PubRepo
participant "pbSampleList: List<PublicationSample>" as pbSampleList
participant "Database" as db

note over Service #E3F2FD
<b>Navigation</b>
---
[[1_MainDiagram.puml Return to Main Diagram]]
end note

Service -> UserRepo : findByID(id)
activate UserRepo
UserRepo -> db : SELECT * FROM users WHERE id = ?
activate db
db --> UserRepo : data
deactivate db
UserRepo -->> user ** : <<create>>
UserRepo --> Service : user
deactivate UserRepo

alt user not found
    Service --> Service : throw EntityNotFoundException
end

Service -> Policy : canFindPublicationsInLibrary(user)
activate Policy
Policy --> Service : boolean
deactivate Policy

alt not allowed
    Service --> Service : throw AccessDeniedException
end

Service -> PubRepo : findPublicationsInLibrary(id)
activate PubRepo
PubRepo -> db : SELECT * FROM publication_sample WHERE library_id = ?
activate db
db --> PubRepo : data
deactivate db
PubRepo -->> pbSampleList ** : <<create>>
PubRepo --> Service : pbSampleList
deactivate PubRepo

@enduml