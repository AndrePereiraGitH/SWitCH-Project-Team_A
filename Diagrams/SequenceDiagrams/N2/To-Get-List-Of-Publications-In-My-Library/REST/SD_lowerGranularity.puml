@startuml
autonumber
hide footbox
title As a User, I want to get the list of publications in my library

participant "Frontend" as FE
participant "apiClient" as Client
participant "Backend" as BE
participant "Database" as DB

[o-> FE : User requests library publications
activate FE

FE -> Client : OPTIONS /publicationSamples/in-library
activate Client
Client -> BE : OPTIONS /publicationSamples/in-library
activate BE
BE --> Client : 200 OK\nAllow: GET, OPTIONS
deactivate BE
Client --> FE : 200 OK\nAllow: GET, OPTIONS
deactivate Client

FE -> Client : GET /publicationSamples/in-library?userId={userId}
activate Client
Client -> BE : GET /publicationSamples/in-library?userId={userId}
activate BE

BE -> DB : query user
activate DB
DB --> BE : user data
deactivate DB

alt user not found
    BE --> Client : 404 Not Found
    Client --> FE : 404 Not Found
end

alt user not allowed
    BE --> Client : 403 Forbidden
    Client --> FE : 403 Forbidden
end

BE -> DB : query publications, bibliographical data,\neditions, authors, genres, owners
activate DB
DB --> BE : data
deactivate DB

BE -> BE : build publication DTOs\n+ HATEOAS links

BE --> Client : 200 OK\nbody: publicationDTOS\n(DTO + HATEOAS links)
deactivate BE
Client --> FE : 200 OK\nbody: publicationDTOS\n(DTO + HATEOAS links)
deactivate Client

[o<-- FE : render publications
deactivate FE

@enduml
