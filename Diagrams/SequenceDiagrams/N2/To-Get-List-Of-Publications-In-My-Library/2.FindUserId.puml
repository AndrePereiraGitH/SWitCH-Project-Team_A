@startuml
hide footbox
autonumber
title Find User ID

participant ":GetListOfPublicationsInLibraryController" as Ctrl
participant ":IUserRepository" as userRepo
participant ":IUserRepositoryJPA" as userJpa
participant "Database" as db

note over Ctrl #E3F2FD
<b>Navigation</b>
---
[[1.MainDiagram.puml Return to Main Diagram]]
end note

Ctrl -> userRepo: findUserIdByUsername(username)
activate userRepo

userRepo -> userJpa: findByUserName(username)
activate userJpa

userJpa -> db: SELECT * FROM users WHERE username = ?
activate db
db --> userJpa: data
deactivate db

userJpa --> userRepo: Optional<UserDM>
deactivate userJpa

userRepo -> userRepo: .map(UserDM::getId)

userRepo --> Ctrl: Optional<UserId>
deactivate userRepo

@enduml