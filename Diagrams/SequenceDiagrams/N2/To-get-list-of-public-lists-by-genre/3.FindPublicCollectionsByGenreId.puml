@startuml
hide footbox
autonumber

title Find Public Collections By Genre Id

participant ":PublicListByGenreController" as Ctrl

participant ":CollectionOfPublicationsRepositoryJpaImpl" as collectionRepo
participant ":ICollectionOfPublicationsRepositoryJpa" as collectionRepoJpa
database ":Database" as DB
participant ":CollectionOfPublicationsAssembler" as assembler
participant ":CollectionOfPublicationsFactory" as factory
participant "publicCollectionsList:\nList<CollectionOfPublications>" as publicCollectionsList

note over Ctrl #E3F2FD
<b>Fragment</b>
---
This diagram is a fragment of the main sequence diagram.
end note

note over Ctrl #E3F2FD
<b>Navigation</b>
---
[[1.MainDiagram.puml Return to Main Diagram]]
end note

Ctrl -> collectionRepo : findPublicCollectionsByGenreId(selectedGenreId)

collectionRepo -> collectionRepoJpa : findByGenreIdAndIsPrivateFalse(genreId)
activate collectionRepoJpa

collectionRepoJpa -> DB : select collections\nwhere genre_id = genreId\nand is_private = false
activate DB
DB --> collectionRepoJpa : collectionDMList
deactivate DB

collectionRepoJpa --> collectionRepo : collectionDMList
deactivate collectionRepoJpa

collectionRepo -->> publicCollectionsList ** : <<create>>

loop for each collectionDM
    collectionRepo -> assembler : toDomain(collectionDM)
    activate assembler

    assembler -> factory : create(id, collectionName,\ngenreId, userId, isPrivate)
    activate factory
    factory --> assembler : collection
    deactivate factory

    assembler --> collectionRepo : collection
    deactivate assembler

    collectionRepo -> collectionRepo : publicCollectionsList.add(collection)
end

collectionRepo --> collectionRepo : return publicCollectionsList

collectionRepo --> Ctrl : publicCollectionsList

@enduml