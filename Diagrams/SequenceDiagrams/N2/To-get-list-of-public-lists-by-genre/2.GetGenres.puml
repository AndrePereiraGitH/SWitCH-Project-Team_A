@startuml
hide footbox
autonumber

title Get Genres

participant ":PublicListByGenreController" as Ctrl
participant ":IGenreRepository" as genreRepo
participant ":IGenreRepositoryJpa" as genreRepoJpa
database ":Database" as DB
participant ":GenreAssembler" as genreAssembler
participant ":US013GenreMapper" as genreMapper
participant "genreDTO:\nUS013GenreDTO" as genreDTO
participant "genresDTOList:\nList<US013GenreDTO>" as genresDTOList

note over Ctrl #E3F2FD
<b>Fragment</b>
---
This diagram is a fragment of the main sequence diagram.
end note

note over Ctrl #E3F2FD
<b>Navigation</b>
---
[[1.MainDiagram.puml Return to Main Diagram]]
end note

Ctrl -> genreRepo : findAll()
activate genreRepo

genreRepo -> genreRepoJpa : findAll()
activate genreRepoJpa

genreRepoJpa -> DB : select all genres
activate DB
DB --> genreRepoJpa : genreDMList
deactivate DB

genreRepoJpa --> genreRepo : genreDMList
deactivate genreRepoJpa

loop for each genreDM
    genreRepo -> genreAssembler : toDomain(genreDM)
    activate genreAssembler
    genreAssembler --> genreRepo : genre
    deactivate genreAssembler
end

genreRepo --> Ctrl : genreList
deactivate genreRepo

Ctrl -> genreMapper : toDTO(genreList)
activate genreMapper

genreMapper -->> genresDTOList ** : <<create>>

loop for each genre in genreList
    genreMapper -> genreDTO ** : <<create>>
    genreMapper -> genreMapper : genresDTOList.add(genreDTO)
end

genreMapper --> Ctrl : genresDTOList
deactivate genreMapper

@enduml