@startuml
hide footbox
autonumber

title US020 - Public lists by genre (returns DTO summary)

actor User
participant ":UI020" as UI
participant ":US020PublicListByGenreController" as Controller
participant ":GenreRepository" as GenreRepo
participant ":CollectionOfPublicationsRepository" as CollectionRepo
participant "CollectionOfPublications" as Collection
participant "CollectionOfPublicationsDTO" as DTO

User -> UI : Request public lists by genre
UI -> Controller : getGenres()

activate Controller
Controller -> GenreRepo : getAllGenres()
GenreRepo --> Controller : List<Genre>
Controller --> UI : List<Genre>
deactivate Controller

User -> UI : Select genre (genreId)
UI -> Controller : getPublicListsByGenre(genreId)

activate Controller
Controller -> CollectionRepo : findPublicByGenre(genreId)
activate CollectionRepo

loop for each CollectionOfPublications in repository
  CollectionRepo -> Collection : getIsPrivate()
  CollectionRepo -> Collection : getCollectionGenre()
  CollectionRepo -> Collection : getCollectionName()
  CollectionRepo -> Collection : getOwner().getUserName()
  CollectionRepo -> DTO : new CollectionOfPublicationsDTO(listName, ownerUsername)
end

CollectionRepo --> Controller : List<CollectionOfPublicationsDTO>
deactivate CollectionRepo
Controller --> UI : List<CollectionOfPublicationsDTO>
deactivate Controller

UI --> User : Display list summaries

@enduml
