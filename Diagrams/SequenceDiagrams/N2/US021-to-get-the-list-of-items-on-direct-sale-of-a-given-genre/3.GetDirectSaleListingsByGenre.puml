@startuml
hide footbox
autonumber
title US021 - Get Direct Sale Listings By Genre

participant ":UI021" as UI
participant ":ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController" as Ctrl
participant ":IListingRepository" as IlistingRepo
participant ":IPublicationSampleRepository" as IpubSampleRepo
participant ":IBibliographicalDataRepository" as IbdRepo
participant "resultList:\nList<Listing>" as ResultList

note over UI, IbdRepo #E3F2FD
<b>Fragment</b>
---
This diagram is a fragment of the main sequence diagram.
end note

note over UI, IbdRepo #E3F2FD
<b>Navigation</b>
---
[[1.MainDiagram.puml Return to Main Diagram]]
end note

UI -> Ctrl : getListOfItemsOnDirectSale(selectedGenreId)
activate Ctrl

Ctrl -> IlistingRepo : findAllDirectSaleListings()
activate IlistingRepo
IlistingRepo -->> ResultList ** : «create»
IlistingRepo --> Ctrl : resultList
deactivate IlistingRepo

loop for each listing in List<Listing>
    loop for each PublicationSampleId in listing.getItemsId()
        Ctrl -> IpubSampleRepo : findPublicationSampleById(id)
        activate IpubSampleRepo
        IpubSampleRepo --> Ctrl : PublicationSample
        deactivate IpubSampleRepo

        Ctrl -> IbdRepo : findBibliographicalDataById(bdId)
        activate IbdRepo
        IbdRepo --> Ctrl : BibliographicalData
        deactivate IbdRepo

        Ctrl -> Ctrl : bd.hasGenre(selectedGenreId)

        alt hasGenre == true
            Ctrl -> ResultList : add(listing)
        end
    end
end

Ctrl --> UI : resultList
deactivate Ctrl

@enduml