@startuml
hide footbox
autonumber
title US021 - To get the list of items on direct sale of a given genre

actor Buyer

' Participants
participant ":UI021" as UI
participant ":ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController" as Ctrl
participant ":IGenreRepository" as IGenreRepo
participant "CopylistOfAllGenres:\nList<Genre>" as LG
participant ":IListingRepository" as IListingRepo
participant "resultList:\nList<Listing>" as ResultList 
participant ":IPublicationSampleRepository" as IPSRepo
participant ":IBibliographicalDataRepository" as IBDRepo
participant ":US021DirSaleListingMapper" as Mapper
participant "listOfDirectSaleDTO:\nList<US021DirectSaleDTO>" as LDTO


' Interactions

' Section 1 - Get all genres
Buyer -> UI : I want to get the list of items on direct sale of a given genre
activate UI

UI -> Ctrl : getAllGenres()
activate Ctrl

Ctrl -> IGenreRepo : getAllGenres()
activate IGenreRepo

IGenreRepo -->> LG ** : «create»

IGenreRepo --> Ctrl : CopylistOfAllGenres
deactivate IGenreRepo

Ctrl --> UI : CopylistOfAllGenres
deactivate Ctrl

UI --> Buyer : Which genre? Choose!
deactivate UI

' Section 2 - Get list of direct sales with the genre chosen
Buyer -> UI : selectedGenre
activate UI

UI -> Ctrl : getListOfItemsOnDirectSale(selectedGenreId)
activate Ctrl

Ctrl -> IListingRepo : findAllDirectSaleListings()
activate IListingRepo

IListingRepo -->> ResultList ** : «create»

IListingRepo --> Ctrl : resultList
deactivate IListingRepo


loop for each listing in List<Listing>
    loop for each PublicationSampleId in listing.getItemsId()
        Ctrl -> IPSRepo : findPublicationSampleById(id)
        activate IPSRepo
        IPSRepo --> Ctrl : PublicationSample
        deactivate IPSRepo

        Ctrl -> IBDRepo : findBibliographicalDataById(bdId)
        activate IBDRepo
        IBDRepo --> Ctrl : BibliographicalData
        deactivate IBDRepo

        Ctrl -> Ctrl : bd.hasGenre(selectedGenreId)

        alt hasGenre == true
            Ctrl -> ResultList : add(listing)
        end
    end
end

' Section 3 - Convert to DTO
Ctrl -> Mapper : toDTOs(resultList)
activate Mapper

Mapper -->> LDTO ** : <<create>>

loop for each listing in resultList
    Mapper -->> directSaleDTO ** : toDTO(listing)
    Mapper -->> LDTO : add(US021DirectSaleDTO)
end

Mapper --> Ctrl : listOfDirectSaleDTO
deactivate Mapper

Ctrl --> UI : listOfDirectSaleDTO
deactivate Ctrl

UI --> Buyer : Shows the list of items on direct sale
deactivate UI

@enduml