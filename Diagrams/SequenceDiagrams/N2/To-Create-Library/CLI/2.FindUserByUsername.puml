@startuml
hide footbox
autonumber
title Find User By Username

participant ":ToCreateLibraryCtrl" as Ctrl
participant ":IUserRepository" as userRepo
participant ":IUserRepositoryJPA" as userJpa
participant "userDM: Optional<UserDM>" as userDM
participant "Database" as db

note over Ctrl #E3F2FD
<b>Navigation</b>
---
[[1.MainDiagram.puml Return to Main Diagram]]
end note

Ctrl -> userRepo: findByUsername(username)
activate userRepo

userRepo -> userJpa: findByUserName(username)
activate userJpa

userJpa -> db: SELECT * FROM users WHERE username = ?
activate db
db --> userJpa: data
deactivate db

userJpa --> userDM**: <<create>>
userJpa -> userDM: getId()
activate userDM
userDM --> userJpa: userId
deactivate userDM

userJpa --> userRepo: userId
deactivate userJpa

userRepo --> Ctrl: userId
deactivate userRepo

@enduml