@startuml
hide footbox
autonumber
title Find User By Username

participant ":ToCreateLibraryCtrl" as Ctrl
participant ":IUserRepository" as userRepo
participant ":IUserRepositoryJPA" as userJpa
participant "Database" as db

note over Ctrl #E3F2FD
<b>Navigation</b>
---
[[1.MainDiagram.puml Return to Main Diagram]]
end note

Ctrl -> userRepo: findIdByUsername(username)
activate userRepo

userRepo -> userJpa: findIdByUsername(username)
activate userJpa

userJpa -> db: SELECT id FROM users WHERE username = ?
activate db
db --> userJpa: data
deactivate db

userJpa --> userRepo: Optional<UserId>
deactivate userJpa

userRepo --> Ctrl: Optional<UserId>
deactivate userRepo

@enduml