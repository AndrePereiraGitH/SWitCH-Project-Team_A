@startuml
hide footbox
autonumber 4
title Save Library

participant ":LibraryService" as service
participant ":ILibraryRepository" as LibraryRepo
participant ":ILibraryRepositoryJPA" as libraryJpa
participant ":LibraryAssembler" as assembler
participant "libraryDM:LibraryDM" as dm
participant ":LibraryFactory" as factory
participant "persistedLib:Library" as persistedLib
participant "Database" as db

note over service #E3F2FD
<b>Navigation</b>
---
[[1.MainDiagram.puml Return to Main Diagram]]
end note

service -> LibraryRepo: save(library)
activate LibraryRepo

LibraryRepo -> libraryJpa: findByUserId(userId)
activate libraryJpa

libraryJpa -> db: SELECT WHERE userId
activate db
db --> libraryJpa: result
deactivate db

libraryJpa --> LibraryRepo: result
deactivate libraryJpa

LibraryRepo -> LibraryRepo: verifyIfUserHasALibrary(result)

LibraryRepo -> assembler: toDM(library)
activate assembler

assembler -->> dm**: <<create>>
assembler --> LibraryRepo: libraryDM
deactivate assembler

LibraryRepo -> libraryJpa: save(libraryDM)
activate libraryJpa

libraryJpa -> db: INSERT libraryDM
activate db
db --> libraryJpa: data
deactivate db

libraryJpa --> LibraryRepo: libraryDM
deactivate libraryJpa

LibraryRepo -> assembler: toDomain(libraryDM)
activate assembler

assembler -> factory: create(libraryDM.id(), libraryDM.name(), libraryDM.userId())
activate factory

factory -->> persistedLib**: <<create>>
factory --> assembler: persistedLib
deactivate factory

assembler --> LibraryRepo: persistedLib
deactivate assembler

LibraryRepo --> service: persistedLib
deactivate LibraryRepo

@enduml