@startuml
hide footbox
autonumber

title US017 - Create Private Publication List

box #whitesmoke
actor "User" as User
participant ":UI - US017" as UI
end box

box "Controller" #Lightblue
participant ":CreatePublicationListController" as Controller
end box

box "Persistence" #LightGrey
participant ":PublicationListRepository" as Repository
end box

box "Domain" #Lightyellow
participant ":PublicationList" as List
end box

User -> UI : I want to create a new private list
activate UI

UI -> Controller : requestListCreation(user)
activate Controller

Controller --> UI : request list name and genre

User -> UI : provide name and genre

UI -> Controller : createPublicationList(name, genre, user)

Controller -> List : new(name, genre, user)
activate List
List --> Controller : publicationList
deactivate List

Controller -> Repository : save(publicationList)
activate Repository
Repository --> Controller : success
deactivate Repository

Controller --> UI : success
deactivate Controller

UI --> User : private list created
deactivate UI

@enduml
