@startuml
hide footbox
autonumber

title US017 - Create Private Collection Of Publications with a name and a genre

actor "User" as User
participant ":UI017" as UI
participant ":US017ToCreateCollectionOfPublicationsController" as Controller

participant ":GenreRepository" as GenreRepo
participant "allGenreList: List<Genre>" as allGenreList

participant ":GenreDTO_US017" as GenreMapper

participant "listOfGenreDTO: List<GenreDTO_US017>" as GenreDTO
participant ":Genre" as Genre
participant "genreDTO: GenreDTO_US017" as GDTO

participant ":CollectionOfPublicationsRepository" as CollectionRepository
participant ":CollectionOfPublicationsFactory" as Factory

' --- Start ---
User -> UI : I want to create a new private collection
activate UI

UI --> User : Provide collection name
deactivate UI

User -> UI : collection name provided
activate UI

' =========================
' Get Genres (DTO)
' =========================
UI -> Controller : getAllGenres()
activate Controller

Controller -> GenreRepo : getAllGenres()
activate GenreRepo
GenreRepo -->> allGenreList **: create()
GenreRepo --> Controller : allGenreList
deactivate GenreRepo

Controller -> GenreMapper : genreToDTO(allGenreList)
activate GenreMapper

' ----- Loop ----
GenreMapper --> GenreDTO** : create()

    loop for each genre in the list
        GenreMapper -> Genre : getGenreType()
        activate Genre
        Genre --> GenreMapper : title
        deactivate Genre

        GenreMapper -> GDTO **: createDTO(title)

        GenreMapper -> GenreMapper : listOfGenreDTO.add(genreDTO)
    end

' ----- End loop ----

GenreMapper --> Controller : List<GenreDTO_US017>
deactivate GenreMapper

Controller --> UI : List<GenreDTO_US017>
deactivate Controller

UI --> User : Show genres! Select one!
deactivate UI

' =========================
' Create Private Collection
' =========================
User -> UI : Selected genre: genreA
activate UI

UI -> Controller : createCollection(name, selectedGenre, user)
activate Controller

Controller -> CollectionRepository : createIfNotExists(user, name, genre)
activate CollectionRepository

loop for each existing collection
    CollectionRepository -> CollectionRepository : compare(user, name, genre)
    alt [duplicate found]
        CollectionRepository --> Controller : error: "Collection already exists"
    end
end

CollectionRepository -> Factory : create(name, genre, user)
activate Factory

create "cp: CollectionOfPublications"
Factory -> "cp: CollectionOfPublications" : create()
note right : _isPrivate = true\n(set by constructor)
Factory --> CollectionRepository : cp
deactivate Factory

CollectionRepository -> CollectionRepository : _collectionOfPublicationsList.add(cp)
CollectionRepository --> Controller : cp
deactivate CollectionRepository

Controller --> UI : Success
deactivate Controller

UI --> User : Private collection of publications was created
deactivate UI

@enduml
