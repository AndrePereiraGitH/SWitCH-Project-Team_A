@startuml
hide footbox
autonumber

title US017 - Create Private Collection Of Publications with a name and a set a genre

actor "User" as User
participant ":UI017" as UI
participant ":CreateCollectionOfPublicationsController" as Controller
participant ":GenreRepository" as GenreRepository
participant ":GenreMapper" as GenreMapper
participant "genreDTO:GenreDTO" as GenreDTO
participant ":CollectionOfPublicationsRepository" as CollectionRepository

'_____
User -> UI : I want to create a new private collection
activate UI

UI --> User : Provide collection name
deactivate UI
User -> UI : collection name provided
activate UI
'______

UI -> Controller : getAllGenres()
activate Controller

Controller -> GenreRepository : getAllGenres()
activate GenreRepository
GenreRepository --> Controller : listOfGenres
deactivate GenreRepository

Controller -> GenreMapper: toDTO(listOfGenres)
activate GenreMapper
GenreMapper -> "genreDTO:GenreDTO" ** : create()
activate "genreDTO:GenreDTO"
"genreDTO:GenreDTO" --> GenreMapper : genreDTO
deactivate "genreDTO:GenreDTO"

/'
activate GenreDTO
/'
GenreDTO --> GenreMapper: genreDTO

deactivate GenreDTO
'/
GenreMapper -> GenreMapper : addToList(genreDTO)
GenreMapper --> Controller: listOfAllGenreDTO
deactivate GenreMapper

Controller --> UI : listOfAllGenreDTO
deactivate Controller

UI --> User : Which genres type? Select one!
deactivate UI

User -> UI : Selected genre type
activate UI
'______


UI -> Controller : createAndAddCollectionOfPublication(name, genreType, user)
activate Controller

Controller -> CollectionRepository : createIfNotExists(user, name, genreType, true)
activate CollectionRepository

loop for each existing collection of the user
    CollectionRepository -> CollectionRepository : compare(name, genreType)
end

alt collection already exists
    CollectionRepository --> CollectionRepository  : duplicateFound
        CollectionRepository --> Controller : error (duplicate)

else collection does not exist
    create "cp:CollectionOfPublications"
    CollectionRepository -> "cp:CollectionOfPublications" : create(name, genreType, true)
    CollectionRepository -> CollectionRepository : addToList(cp)
    CollectionRepository --> Controller : cp

end

deactivate CollectionRepository

Controller --> UI : success
deactivate Controller

UI --> User : Private collection of publications was created
deactivate UI

@enduml

