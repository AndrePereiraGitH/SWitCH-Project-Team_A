@startuml
hide footbox
autonumber

title US017 - Create Private Collection Of Publications

actor "User" as User
participant ":UI017" as UI
participant ":CreateCollectionOfPublicationsController" as Controller
participant ":GenreRepository" as GenreRepository
participant ":CollectionOfPublicationsRepository" as CollectionRepository

User -> UI : I want to create a new private collection
activate UI

UI --> User : Request collection name
deactivate UI
User -> UI : Provide collection name
activate UI

UI -> Controller : requestGenre()
activate Controller

Controller -> GenreRepository : getAllGenres()
activate GenreRepository

GenreRepository -> GenreRepository : loadAllGenres()

GenreRepository --> Controller : genres : List<Genre>
deactivate GenreRepository

Controller --> UI :  genres
deactivate Controller

UI --> User : Display genres (select one)
deactivate UI

User -> UI : Select genre
activate UI

UI -> Controller : createAndAddCollectionOfPublication(name, selectedGenre)
activate Controller

Controller -> CollectionRepository  : createAndAddCollectionOfPublication(name, selectedGenre)
activate CollectionRepository

create "cp1:CollectionOfPublications" as CollectionOfPublications

CollectionRepository -> CollectionOfPublications : create(name, selectedGenre)
CollectionRepository -> CollectionRepository : validate(cp1)
CollectionRepository -> CollectionRepository : add(cp1)

CollectionRepository --> Controller : cp1
deactivate CollectionRepository

Controller --> UI : success
deactivate Controller

UI --> User : Your private collection of publications was created
deactivate UI

@enduml
