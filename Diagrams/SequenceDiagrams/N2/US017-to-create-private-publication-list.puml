@startuml
hide footbox
autonumber

title US017 - Create Private Publication List

box #whitesmoke
actor "User" as User
participant ":UI017" as UI
end box

box "Controller" #Lightblue
participant ":CreatePublicationListController" as Controller
end box

box "Persistence" #LightGrey
participant ":PublicationListRepository" as Repository
end box

User -> UI : I want to create a new private list
activate UI

UI --> User : Give it a name and a genre
User -> UI : name, genre

UI -> Controller : createAndAddPublicationList(name, genre)
activate Controller

Controller -> Repository : createAndAddPublicationList(name, genre)
activate Repository

box "Domain" #Lightyellow
create "pl1:PublicationList" as PublicationList
end box

Repository -> PublicationList : create(name, genre)

Repository -> Repository : validate(pl1)
Repository -> Repository : add(pl1)

Repository --> Controller : true
deactivate Repository

Controller --> UI : success
deactivate Controller

UI --> User : Your publication list was created
deactivate UI

@enduml
