@startuml
autonumber
hide footbox
title US0016 - Put a publication from my library for sale in an auction

box #whitesmoke
    actor User
    participant ":UI" as UI
end box

    participant ":ToPutPublicationInAuctionController" as ctrl

    participant ":AuctionRepository" as AucRepo

    participant ":Library" as Lib




User -> UI : I want to sell a publication of my library as an auction"
activate UI
UI -> ctrl : getAllPublicationsInLibrary()
activate ctrl
ctrl -> Lib : getAllPublications()
activate Lib
create "listOfPublications:List<Publication>" as listPub
Lib -> listPub
Lib --> ctrl : listOfPublications
deactivate Lib
ctrl --> UI : listOfPublications
deactivate ctrl

UI --> User : Please, select a publication from your list: pub1, pub2, pub3
deactivate UI
User -> UI : pub1
activate UI
UI --> User : Insert initialDate, finalDate, initialPrice, buyOutPrice you want to this Auction
User -> UI : provide data: initialDate, finalDate, initialPrice, buyOutPrice



UI -> ctrl : putPublicationForAuction(pub1, initialDate, finalDate, initialPrice, buyOutPrice)
activate ctrl
ctrl -> AucRepo : putPublicationForAuction(pub1, initialDate, finalDate, initialPrice, buyOutPrice)
activate AucRepo

create "l1:Listing" as l1
AucRepo -> l1 : createListing()

create "auction1:Auction" as a1
AucRepo -> a1 : createAuction(l1, initialDate, finalDate, initialPrice, buyOutPrice)

AucRepo -> AucRepo : validateAuction(auction1)
AucRepo -> AucRepo : addAuction(auction1)
AucRepo --> ctrl : auction1
deactivate AucRepo

ctrl --> UI : success
deactivate ctrl
UI --> User : Your publication pub1 is now in an Auction
deactivate UI
@enduml
