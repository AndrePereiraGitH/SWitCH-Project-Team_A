@startuml
hide footbox
autonumber

title US003 - Register Genre to Official Genre List

actor Administrator
participant ":UI003" as UI
participant ":US003ToRegisterGenreController" as Controller
participant ":GenreRepository" as GenreRepository
participant ":GenreFactory" as GenreFactory

Administrator -> UI : I want to add a new genre to the official list
activate UI

UI --> Administrator : Please enter the genre name
deactivate UI

Administrator -> UI : name("romance")
activate UI

UI -> Controller : registerGenre(genreType)
activate Controller

Controller -> GenreRepository : createAndAddGenre(genreType)
activate GenreRepository

GenreRepository -> GenreFactory : createGenre(genreType)
activate GenreFactory

create "romance: Genre"
GenreFactory -> "romance: Genre" : create ()
GenreFactory --> GenreRepository : romance
deactivate GenreFactory

GenreRepository -> GenreRepository : exists(romance)

alt [genre already exists]
    GenreRepository --> Controller : error: "Genre already exists"
    Controller --> UI : error: "Genre already exists"
    UI --> Administrator : Genre already exists

else [genre does NOT exist]
    GenreRepository -> GenreRepository : _genres.add(romance)
    GenreRepository --> Controller : romance

end

deactivate GenreRepository

Controller --> UI : success
deactivate Controller

UI --> Administrator : success
deactivate UI

@enduml
