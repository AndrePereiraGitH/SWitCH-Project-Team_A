@startuml
hide footbox
title US003 - Register Genre to Official Genre List


actor Administrator
participant ":UI003" as UI

participant ":ToRegisterGenreController" as RegisterGenreController

participant ":GenreRepository" as GenreRepository

Administrator -> UI : **1** I want to add a new genre to the official list

activate UI

UI -->> Administrator : **2** Please enter the genre name
Administrator -> UI : **3** name("romance")


UI -> RegisterGenreController : **4** registerGenre(genreType)
activate RegisterGenreController

RegisterGenreController -> GenreRepository : **5** createAndAddGenre(genreType)
activate GenreRepository

  create "romance:Genre" as Genre

  GenreRepository -> Genre : **6** create(genreType)
  GenreRepository -> GenreRepository : **7** exists(romance)
  alt genre already exists
    GenreRepository -->> RegisterGenreController : Genre already exists
    RegisterGenreController -->> UI : Genre already exists
    UI -->> Administrator : Genre already exists
  else genre does NOT exist
  GenreRepository -> GenreRepository : **8** addToList(romance)
  GenreRepository  -->> RegisterGenreController : **9** romance
  end


deactivate GenreRepository

RegisterGenreController -->> UI : **10** success
deactivate RegisterGenreController

UI -->> Administrator : **11**  success
deactivate UI

@enduml
