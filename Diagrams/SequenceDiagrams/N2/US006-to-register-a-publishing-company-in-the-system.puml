@startuml

hide footbox
autonumber
title US006 - To register a publishing company in the system

box #WhiteSmoke
actor Administrator
participant ":UI006" as UI
end box


participant ":US006ToRegisterNewPublisherController" as RegisterPublisherController



participant ":PublisherRepository" as PublisherRepository
participant "publishers:List<Publisher>" as list
participant "PublisherFactory" as factory
participant "publisher:Publisher" as publisher

Administrator -> UI : I want to register a Publishing Company

activate UI
UI -->> Administrator : Please Provide name, VatNumber, and Contact

deactivate UI

Administrator -> UI : Name: Cambridge; VatNumber 123456; Contact: +4412345678

activate UI

UI -> RegisterPublisherController : registerPublisher(name, vatNumber, contact)
activate RegisterPublisherController

RegisterPublisherController -> PublisherRepository : createAndAddPublisher(name, vatNumber, contact)

activate PublisherRepository

PublisherRepository -> list **: create()
PublisherRepository -> factory: create(name, vatNumber, contact)


activate factory

factory -> publisher ** : create(name, vatNumber, contact)

factory -> PublisherRepository: publisher

deactivate factory

PublisherRepository -> PublisherRepository : isExistent()
PublisherRepository -> PublisherRepository: publishers.add(publisher)

PublisherRepository --> RegisterPublisherController : publisher
deactivate PublisherRepository

RegisterPublisherController --> UI : success
deactivate RegisterPublisherController

UI --> Administrator : success



@enduml
