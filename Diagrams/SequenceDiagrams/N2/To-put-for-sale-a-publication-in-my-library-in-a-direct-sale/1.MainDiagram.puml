@startuml
autonumber
hide footbox
title To put for sale a publication in my library in a direct sale

box #whitesmoke
actor User
participant ":UI" as UI
end box

' Controller
participant ":ToPutForSaleAPublicationInDirectSaleController" as Ctrl

' Listing
participant ":ListingService" as LServ
participant ":IListingRepository" as LRepo
participant ":ListingAssembler" as LAss
participant ":IListingRepositoryJPA" as LRepoJPA
participant "listingDM:\nListingDM" as LDM
participant ":ListingFactory" as LFactory
participant "listing:\nListing" as Listing
participant "persistedListing:\nListing" as persListing

' Database
database "Database" as DB

' --- Step 1: User initiates the process ---
User -> UI : I want to put for sale a publication\nin a direct sale
activate UI
UI -> Ctrl : findLibraryPublicationsAvailableForSale()
activate Ctrl

' --- Step 2: find User's Library ---
ref over Ctrl
[[2.FindAllPublicationsInUserLibraryAvailableForSale.puml]]
end ref
Ctrl --> UI : listOfAvailablePubSampleDTO
deactivate Ctrl

' --- Step 3: Returns the list of available publications to the user ---
UI --> User : Which publication(s)?\nChoose from the list!
deactivate UI

' --- Step 4: User selects publications and provides listing details ---
User -> UI : Selected publication(s)
activate UI
UI --> User : Specify title, price,\nshort description and pictures
deactivate UI

User -> UI : Title, price, short description,\npictures
activate UI

UI -> Ctrl : createDirectSaleListing(title, selectedPublicationIds,\nprice, shortDescription, userId, pictures)
activate Ctrl

' --- Step 5: Listing creation ---
Ctrl -> LServ : createAndSave(title, selectedPublicationIds, SaleType.DIRECT_SALE, price, shortDescription, userId, pictures)
activate LServ

LServ -> LFactory : createAndSave(title, selectedPublicationIds, SaleType.DIRECT_SALE,\n price, shortDescription, userId, pictures)
activate LFactory

LFactory -->> Listing ** : «create»(title, selectedPublicationIds, SaleType.DIRECT_SALE,\n price, shortDescription, userId, pictures)
LFactory --> LServ : listing
deactivate LFactory

LServ --> LRepo : save(listing)
activate LRepo
LRepo -> LAss : toDM(listing)
activate LAss
LAss -->> LDM ** : «create»
LAss --> LRepo : listingDM
deactivate LAss
LRepo -> LRepoJPA : save(listingDM)
activate LRepoJPA
LRepoJPA -> DB : INSERT persistedListing
activate DB
DB --> LRepoJPA : persistedListing
deactivate DB
LRepoJPA --> LRepo : persistedListing
deactivate LRepoJPA
LRepo -> LAss : toDomain(persistedListing)
activate LAss
LAss -> LFactory : create(listingId,listingTitle, itemsId, saleType, price, shortDescription, sellerId, pictures)
activate LFactory
LFactory -->> persListing ** : «create»
LFactory --> LAss : persistedListing
deactivate LFactory
LAss --> LRepo : persistedListing
deactivate LAss
LRepo --> LServ : persistedListing
deactivate LRepo
LServ --> Ctrl : persistedListing
deactivate LServ


Ctrl --> UI : persistedListing
deactivate Ctrl

UI --> User : Publication(s) put for direct\n sale with success
deactivate UI

@enduml
