@startuml
autonumber
hide footbox
title To put for sale a publication in my library in a direct sale

box #whitesmoke
actor User
participant ":UI" as UI
end box

' Controller
participant ":ToPutForSaleAPublicationInDirectSaleController" as Ctrl

' Library
participant ":ILibraryRepository" as LibRepo
participant ":ILibraryRepositoryJPA" as LibRepoJPA
participant "libraryDM:\nLibraryDM" as LibDM
participant ":LibraryAssembler" as LibAss
participant ":LibraryFactory" as LibFact
participant "library:\nLibrary" as Lib

' Publication Sample
participant ":IPublicationSampleRepository" as PSRepo
participant ":IPublicationSampleRepositoryJPA" as PSRepoJPA
participant "listOfAvailablePublicationDMs:\nList<PublicationSampleDM>" as listAvailablePSDM
participant "pubSampleDM:\nPublicationSampleDM" as PSDM
participant ":PublicationSampleAssembler" as PSAss
participant ":PublicationSampleFactory" as PSFact
participant "pubSample:\nPublicationSample" as PS
participant "listOfAvailablePublications:\nList<PublicationSample>" as listAvailablePS
' DTO
participant ":US015PublicationSampleMapper" as Mapper
participant "listOfAvailablePubSampleDTO:\nList<US015PublicationSampleDTO>" as listDTO
participant "publicationSampleDTO:\nUS015PublicationSampleDTO" as DTO_O

' Listing
participant ":ListingService" as LServ
participant ":IListingRepository" as LRepo
participant ":ListingAssembler" as LAss
participant ":IListingRepositoryJPA" as LRepoJPA
participant "listingDM:\nListingDM" as LDM
participant ":ListingFactory" as LFactory
participant "listing:\nListing" as Listing
participant "persistedListingDM:\nListingDM" as persListingDM
participant "persistedListing:\nListing" as persListing

' Database
database "Database" as DB

' --- Step 1: User initiates the process ---
User -> UI : I want to put for sale a publication\nin a direct sale
activate UI
UI -> Ctrl : findLibraryPublicationsAvailableForSale(UserId userId)
activate Ctrl

' --- Step 2: find User's Library ---
Ctrl -> LibRepo : getByUserId(userId)
activate LibRepo
LibRepo -> LibRepoJPA : getByUserId(userId)
activate LibRepoJPA
LibRepoJPA -> DB : query library by userId
activate DB
DB --> LibRepoJPA : data
deactivate DB
LibRepoJPA -->> LibDM ** : «create»
LibRepoJPA -> LibDM: getId()
activate LibDM
LibDM --> LibRepoJPA: libraryId
deactivate LibDM
LibRepoJPA --> LibRepo: libraryId
deactivate LibRepoJPA
LibRepo --> Ctrl: libraryId
deactivate LibRepo

' --- Step 3: find Library's Publication Samples Available For Sale ---
Ctrl -> PSRepo : findAvailableForSaleByLibraryId(libraryId)
activate PSRepo
PSRepo -> PSRepoJPA : findAvailableForSaleByLibraryId(libraryId)
activate PSRepoJPA
PSRepoJPA -> DB : query publicationSample by libraryId \nWHERE status NOT IN ('FOR_SALE', 'SOLD')
activate DB
DB --> PSRepoJPA : data
deactivate DB
PSRepoJPA -->> listAvailablePSDM ** : «create»
loop for each pubSampleDM in listAvailablePSDM
    PSRepoJPA -->> PSDM ** : «create»
    PSRepoJPA -> listAvailablePSDM : add(pubSampleDM)
end
PSRepoJPA --> PSRepo : listOfAvailablePublicationDMs
deactivate PSRepoJPA
PSRepo -->> listAvailablePS ** : «create»
loop for each pubSampleDM in listOfAvailablePublicationDMs
        PSRepo -> PSAss : toDomain(pubSampleDM)
        activate PSAss
        PSAss -> PSDM : id()
        activate PSDM
        PSDM --> PSAss : pubSampleId
        deactivate PSDM
        PSAss -> PSDM : getBibliographicalDataId()
        activate PSDM
        PSDM --> PSAss : bdId
        deactivate PSDM
        PSAss -> PSDM : getUserId()
        activate PSDM
        PSDM --> PSAss : userId
        deactivate PSDM
        PSAss -> PSDM : getPublicationStatus()
        activate PSDM
        PSDM --> PSAss : pubStatus
        deactivate PSDM
        PSAss -> PSDM : getEditionId()
        activate PSDM
        PSDM --> PSAss : editionId
        deactivate PSDM
        PSAss -> PSDM : getCondition
        activate PSDM
        PSDM --> PSAss : condition
        deactivate PSDM
        PSAss -> PSFact : create(pubSampleId, bdId, userId,\n pubStatus, editionId, condition)
        activate PSFact
        PSFact --> PS ** : «create»
        PSFact --> PSAss : pubSample
        deactivate PSFact
        PSAss --> PSRepo: pubSample
        deactivate PSAss
        PSRepo -> listAvailablePS : add(pubSample)
end
PSRepo --> Ctrl: listOfAvailablePublications
deactivate PSRepo

' --- Step 4: Converts the list of available publications to DTOs ---
Ctrl -> Mapper : toDTOs(listOfAvailablePublications)
activate Mapper
Mapper -->> listDTO ** : «create»
loop for each publicationSample in listOfAvailablePublications
    Mapper -->> DTO_O **: «create»
    Mapper -> listDTO: add(publicationSampleDTO)
end
Mapper --> Ctrl : listOfAvailablePubSampleDTO
deactivate Mapper
Ctrl --> UI : listOfAvailablePubSampleDTO
deactivate Ctrl

' --- Step 5: Returns the list of available publications to the user ---
UI --> User : Which publication(s)?\nChoose from the list!
deactivate UI

' --- Step 6: User selects publications and provides listing details ---
User -> UI : Selected publication(s)
activate UI
UI --> User : Specify title, price,\nshort description and pictures
deactivate UI

User -> UI : Title, price, short description,\npictures
activate UI

UI -> Ctrl : createDirectSaleListing(title, selectedPublicationIds,\nprice, shortDescription, userId, pictures)
activate Ctrl

' --- Step 7: Listing creation ---
Ctrl -> LServ : createAndSave(title, selectedPublicationIds, SaleType.DIRECT_SALE, price, shortDescription, userId, pictures)
activate LServ

LServ -> LFactory : create(title, selectedPublicationIds, SaleType.DIRECT_SALE,\n price, shortDescription, userId, pictures)
activate LFactory

LFactory -->> Listing ** : «create»(title, selectedPublicationIds, SaleType.DIRECT_SALE,\n price, shortDescription, userId, pictures)
LFactory --> LServ : listing
deactivate LFactory

LServ --> LRepo : save(listing)
activate LRepo
LRepo -> LAss : toDM(listing)
activate LAss
LAss -->> LDM ** : «create»
LAss --> LRepo : listingDM
deactivate LAss
LRepo -> LRepoJPA : save(listingDM)
activate LRepoJPA
LRepoJPA -> DB : INSERT listingDM
activate DB
DB --> LRepoJPA : data
deactivate DB
LRepoJPA -->> persListingDM ** : «create»
LRepoJPA --> LRepo : persistedListingDM
deactivate LRepoJPA
LRepo -> LAss : toDomain(persistedListingDM)
activate LAss
LAss -> persListingDM: id()
activate persListingDM
persListingDM --> LAss: listingId
deactivate persListingDM
LAss -> persListingDM: getListingTitle()
activate persListingDM
persListingDM --> LAss: listingTitle
deactivate persListingDM
LAss -> persListingDM: getItemsId()
activate persListingDM
persListingDM --> LAss: itemsId
deactivate persListingDM
LAss -> persListingDM: getSaleType)
activate persListingDM
persListingDM --> LAss: saleType
deactivate persListingDM
LAss -> persListingDM: getPrice()
activate persListingDM
persListingDM --> LAss: price
deactivate persListingDM
LAss -> persListingDM: getShortDescription()
activate persListingDM
persListingDM --> LAss: shortDescription
deactivate persListingDM
LAss -> persListingDM: getSellerId()
activate persListingDM
persListingDM --> LAss: sellerId
deactivate persListingDM
LAss -> persListingDM: getPictures()
activate persListingDM
persListingDM --> LAss: pictures
deactivate persListingDM
LAss -> LFactory : create(listingId,listingTitle, itemsId, saleType, price, shortDescription, sellerId, pictures)
activate LFactory
LFactory -->> persListing ** : «create»
LFactory --> LAss : persistedListing
deactivate LFactory
LAss --> LRepo : persistedListing
deactivate LAss
LRepo --> LServ : persistedListing
deactivate LRepo
LServ --> Ctrl : persistedListing
deactivate LServ


Ctrl --> UI : success
deactivate Ctrl

UI --> User : Publication(s) put for direct\n sale with success
deactivate UI

@enduml

