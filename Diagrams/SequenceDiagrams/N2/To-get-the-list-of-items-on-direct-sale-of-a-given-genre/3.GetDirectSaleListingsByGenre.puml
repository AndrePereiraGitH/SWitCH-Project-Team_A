@startuml
hide footbox
autonumber
title Get Direct Sale Listings By Genre

participant ":UI" as UI
participant ":ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController" as Ctrl
participant ":IBibliographicalDataRepository" as IBDRepo
participant ":IPublicationSampleRepository" as IPSRepo
participant ":IListingRepository" as IListingRepo

note over UI, IListingRepo #E3F2FD
<b>Fragment</b>
---
This diagram is a fragment of the main sequence diagram.
end note

note over UI, IListingRepo #E3F2FD
<b>Navigation</b>
---
[[1.MainDiagram.puml Return to Main Diagram]]
end note

UI -> Ctrl : getListOfItemsOnDirectSale(selectedGenreId)
activate Ctrl

Ctrl -> IBDRepo : findAllBibliographicalDataByGenreId(selectedGenreId)
activate IBDRepo
IBDRepo -->> "listOfBdIds:\nList<BibliographicalDataID>" ** : «create»
IBDRepo --> Ctrl : listOfBdIds
deactivate IBDRepo

Ctrl -> IPSRepo : findAllItemsIdByBibliographicalDataId(listOfBdIds)
activate IPSRepo
IPSRepo -->> "listOfPubSampleIds:\nList<PublicationSampleId>" ** : «create»
IPSRepo --> Ctrl : listOfPubSampleIds
deactivate IPSRepo

Ctrl -> IListingRepo : findDirectSaleListingsContaining(listOfPubSampleIds)
activate IListingRepo
IListingRepo -->> "listOfDirectSaleListings:\nList<Listing>" ** : «create»
IListingRepo --> Ctrl : listOfDirectSaleListings
deactivate IListingRepo

Ctrl --> UI : listOfDirectSaleListings
deactivate Ctrl

@enduml
