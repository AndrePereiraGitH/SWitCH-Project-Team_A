@startuml
hide footbox
autonumber
title To Register a New Publication Sample

actor User
participant ":UI" as UI
participant ":ToRegisterNewPublicationCtrl" as Controller
participant ":PublicationSampleService" as Service
participant ":IPublicationSampleRepository" as Repo
participant ":PublicationSampleAssembler" as Assembler
participant ":PublicationSampleFactory" as Factory
participant ":IPublicationSampleRepositoryJPA" as JPA

participant "pbSample: PublicationSample" as pbSample
participant "pbSampleDM: PublicationSampleDM" as pbSampleDM

database "DB" as DB

User -> UI : I want to register a  publication
activate UI

UI --> User : Please enter the publication that \nyou want to add on MiteLovers
deactivate UI

User -> UI : Here are the details
activate UI

UI -> Controller : register(bibliographicalDataId, userId,\npublicationStatus, editionId, condition)
activate Controller

Controller -> Service : createAndSave(bibliographicalDataId, userId,\npublicationStatus, editionId, condition)
activate Service

' =========================
' Factory creation
' =========================
Service -> Factory : create(bibliographicalDataId, userId,\npublicationStatus, editionId, condition)
activate Factory
Factory -->> pbSample** : <<create>>
Factory --> Service : pbSample
deactivate Factory

' =========================
' Save flow
' =========================
Service -> Repo : save(pbSample)
activate Repo

Repo -> Assembler : toDM(pbSample)
activate Assembler
Assembler -->> pbSampleDM** : <<create>>
Assembler --> Repo : pbSampleDM
deactivate Assembler

Repo -> JPA : save(pbSampleDM)
activate JPA

JPA -> DB : INSERT
activate DB
DB --> JPA : persisted data
deactivate DB

JPA -->> pbSampleDM** : <<create>>
JPA --> Repo : persisted pbSampleDM
deactivate JPA

' ==============
' Reconstruction
' ==============
Repo -> Assembler : toDomain(persisted pbSampleDM)
activate Assembler

Assembler -> Factory : create(pubSampleId, bibliographicalDataId,\nuserId, publicationStatus, editionId, condition)

activate Factory
Factory -->> pbSample** : <<create>>
Factory --> Assembler : pbSample
deactivate Factory

Assembler --> Repo : pbSample
deactivate Assembler

Repo --> Service : pbSample
deactivate Repo

Service --> Controller : pbSample
deactivate Service

Controller --> UI : success
deactivate Controller

UI --> User : Success
deactivate UI

@enduml