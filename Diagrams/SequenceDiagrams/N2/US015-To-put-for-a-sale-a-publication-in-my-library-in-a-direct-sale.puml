@startuml
autonumber
hide footbox
title US015 - To put for sale a publication in my library in a direct sale


actor User
participant ":UI015" as UI

participant ":ToPutPublicationInDirectSaleController" as C
participant ":ItemRepository" as I
participant ":DirectSaleRepository" as S
participant ":Library" as Lib

User -> UI : I want to sell a publication in my library in Direct Sale
activate UI
UI -> C : getListPublications()
activate C
C -> Lib : getListPublications()

activate Lib

create "listOfPublications: List<Publication>" as LP
Lib -> LP
Lib --> C : listOfPublications
deactivate Lib
C --> UI : Success
deactivate C

UI --> User : Choose publication from the List
deactivate UI
User -> UI : Selected publication and insert information for Item
activate UI

UI -> C : createAndAddItem(publication, condition,\n dimensions, weight)
activate C
C -> I : createAndAddItem(publication, condition,\n dimensions, weight)
activate I

create "item1:Item" as item1
I -> item1 : create(publication, condition,\n dimensions, weight)
I -> I : validateItemExists(item1)
I -> I : addToList(item1)
I --> C : item1
deactivate I
C --> UI: Success
deactivate C


UI --> User : Insert Information for Direct Sale
deactivate UI
User -> UI : Information about Direct Sale
activate UI

UI -> C : createDirectSale(item1, price, shortDescription,\n listingTitle, saleType, seller, pictures)
activate C

C -> S : createDirectSale(item1, price, shortDescription,\n listingTitle, saleType, seller, pictures)
activate S
create "listing1:Listing" as listing1
S -> listing1 : create(item1, price, shortDescription,\n listingTitle, saleType, seller, pictures)



create "directSale1:DirectSale" as directSale1
S -> directSale1 : create(listing1, LocalDateTime)
S -> S : validateDirectSaleExists(directSale1)
S -> S : addToList(directSale1)
S --> C : true
deactivate S

C --> UI : success
deactivate C
UI --> User : Direct Sale successfully created
deactivate UI
@enduml