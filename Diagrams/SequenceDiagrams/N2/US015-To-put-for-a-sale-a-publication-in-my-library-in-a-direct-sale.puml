@startuml
autonumber
hide footbox
title US0015 - To put for sale a publication in my library in a Direct Sale

box #WhiteSmoke
actor User
participant ":UI" as UI
end box

box "Controller" #LightBlue
participant ":ToPutPublicationInDirectSaleController" as C
end box

box "Persistence" #LightGrey
participant ":LibraryRepository" as LibRepo
participant ":ItemRepo" as Item
participant ":ListingRepository" as ListRepo
participant ":DirectSaleRepository" as DirSaleRepo
end box

box "Domain Model"#LightYellow
participant "myLibrary:Library" as Lib

User -> UI : I want to sell a publication in Direct Sale
UI --> User : Which library?
User -> UI : myLibrary


UI -> C : getMyLibrary()
activate C
C -> LibRepo : getLibrary(myLibrary)
activate LibRepo
LibRepo -> LibRepo : verifyIfMyLibraryExists()
LibRepo --> C : myLibrary
deactivate LibRepo
C --> UI : myLibrary
deactivate C


UI --> User : Which publication?
User -> UI : publicationBook

UI -> C : findPublication()
activate C
C -> Lib : findPublication(publicationBook)
activate Lib
Lib -> Lib : verifyIfPublicationExists()
Lib --> C : publicationBook
deactivate Lib
C --> UI : publicationBook
deactivate C


UI --> User : Which price?
User -> UI : Price "x"

UI -> C : putPublicationInDirectSale(myLibrary, publicationBook, price)
activate C
C -> Item : createPhysicalItem()
activate Item
create "item1: Item" as item1
Item -> item1 : create
Item --> C : Success
deactivate Item

C -> ListRepo : createNewDirectSale(item1, price)
activate ListRepo
create "directSale1:DirectSale" as directSale1
ListRepo -> directSale1 : create
ListRepo --> C : directSale1
deactivate ListRepo

C -> DirSaleRepo : addNewDirectSale(directSale1)
activate DirSaleRepo
DirSaleRepo --> C : directSale1 added to Repository
deactivate DirSaleRepo
end box

C --> UI : Success(directSale1)
deactivate C
UI --> User : Done
@enduml