@startuml
autonumber
hide footbox
title US013 - To get official genres list

actor User
participant ":UI" as UI
participant ":ToGetListOfGenreController" as Ctrl
participant ":GenreRepository" as Repo
participant "GenreDTO_US013" as DTOClass
participant ":Genre" as genre

User -> UI : I want to get a list of official genres in the system
activate UI

UI -> Ctrl : getGenresList()
activate Ctrl

Ctrl -> Repo : getAllGenres()
activate Repo

Repo --> Ctrl : _genres
deactivate Repo

create "_genresDTO : List<GenreDTO_US013>" as listDTO
Ctrl -> listDTO : create()

loop for each Genre in _genres
    Ctrl -> DTOClass : toDTO(genre)
    activate DTOClass





    DTOClass --> Ctrl : dto
    deactivate DTOClass

    Ctrl -> listDTO : add(dto)
end

Ctrl --> UI : _genresDTO
deactivate Ctrl

UI --> User : Official List of Genres
deactivate UI
@enduml