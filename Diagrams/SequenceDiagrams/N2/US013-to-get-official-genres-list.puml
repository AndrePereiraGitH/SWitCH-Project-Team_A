@startuml
autonumber

hide footbox
title US0013 - To get official genres list

actor User
participant ":UI" as UI

participant ":ListAllGenresGenreController" as AddGenreCtrl

participant ":GenreRepository" as GenreRepository

participant ":GenreMapper" as mapper

participant ":Genre" as genre

participant "genreDTO:GenreDTO" as DTO

User -> UI : I want to get a list of official genres in the system
activate UI
UI -> AddGenreCtrl : getGenresList()
activate AddGenreCtrl

AddGenreCtrl -> GenreRepository : findAllGenres()
activate GenreRepository

create "_genres:List<Genre>" as listGenres
GenreRepository -> listGenres : create()

GenreRepository --> AddGenreCtrl : _genres

deactivate GenreRepository
AddGenreCtrl -> mapper : toDTO(_genres)
activate mapper

create "_genresDTO : List<genresDTO>" as genDTO
mapper -> genDTO :create()

loop for each Genre in list
        mapper -> genre : getGenreType()
        activate genre
        genre --> mapper : genreType
        deactivate genre
        mapper -> DTO ** : createDTO(genreType)
        mapper -> mapper : addToGenresDTO()

    end

mapper --> AddGenreCtrl : _genresDTO
deactivate mapper

AddGenreCtrl --> UI : _genresDTO
deactivate AddGenreCtrl

UI --> User : Official List of Genres
deactivate UI
@enduml