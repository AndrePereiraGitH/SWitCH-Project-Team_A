@startuml

hide footbox
autonumber
title US025 - To get the list of items on direct sale of a given author

actor Buyer
participant ":UI025" as UI025

participant ":GetListOfItemsOnDirectSaleOfGivenAuthorController" as GetListOfItemsOnDirectSaleOfGivenAuthorController

participant ":AuthorRepository" as AuthorRepository

participant ":DirectSaleRepository" as DirectSaleRepository

Buyer -> UI025 : I want to get the list of items on direct sale of a given author
activate UI025
UI025 -> GetListOfItemsOnDirectSaleOfGivenAuthorController : getAllAuthors()
activate GetListOfItemsOnDirectSaleOfGivenAuthorController
GetListOfItemsOnDirectSaleOfGivenAuthorController -> AuthorRepository: getAllAuthors()
activate AuthorRepository
AuthorRepository --> GetListOfItemsOnDirectSaleOfGivenAuthorController: listOfAllAuthors
deactivate AuthorRepository
GetListOfItemsOnDirectSaleOfGivenAuthorController --> UI025 : listOfAllAuthors
deactivate GetListOfItemsOnDirectSaleOfGivenAuthorController
Buyer <-- UI025 : Which author? Choose!
Buyer -> UI025 : author

UI025 -> GetListOfItemsOnDirectSaleOfGivenAuthorController : getListOfItemsOnDirectSale(author)
activate GetListOfItemsOnDirectSaleOfGivenAuthorController

GetListOfItemsOnDirectSaleOfGivenAuthorController -> DirectSaleRepository : getListOfItemsOnDirectSale(author)
activate DirectSaleRepository


DirectSaleRepository -> DirectSaleRepository : validateParameters(author)

create "l1: List<Listing>" as Listing
DirectSaleRepository -> Listing : getList(author)

DirectSaleRepository --> GetListOfItemsOnDirectSaleOfGivenAuthorController : l1
deactivate DirectSaleRepository

GetListOfItemsOnDirectSaleOfGivenAuthorController -> GetListOfItemsOnDirectSaleOfGivenAuthorController : cl1: copyList(l1)

GetListOfItemsOnDirectSaleOfGivenAuthorController --> UI025 : cl1
deactivate GetListOfItemsOnDirectSaleOfGivenAuthorController

UI025 --> Buyer : List of items on direct sale
deactivate UI025

@enduml