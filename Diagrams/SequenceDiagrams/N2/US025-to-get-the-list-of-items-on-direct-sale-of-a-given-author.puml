@startuml

hide footbox
autonumber
title US025 - To get the list of items on direct sale of a given author

box #WhiteSmoke
actor Buyer
participant ":UI025" as UI025
end box

box "Controller" #LightBlue
participant ":GetListOfItemsOnDirectSaleOfGivenAuthorController" as GetListOfItemsOnDirectSaleOfGivenAuthorController
end box

box "Persistence" #LightGrey
participant ":ListingRepository" as ListingRepository
end box

Buyer -> UI025 : I want to get the list of items on direct sale of a given author
activate UI025
Buyer <-- UI025 : Which author?
Buyer -> UI025 : author

UI025 -> GetListOfItemsOnDirectSaleOfGivenAuthorController : getListOfItemsOnDirectSale(author)
activate GetListOfItemsOnDirectSaleOfGivenAuthorController

GetListOfItemsOnDirectSaleOfGivenAuthorController -> ListingRepository : getListOfItems(typeOfSale, author)
activate ListingRepository


ListingRepository -> ListingRepository : validateParameters(typeOfSale, author)

box "Domain Model" #LightYellow
create "l1: List<Listing>" as Listing
ListingRepository -> Listing : getList(typeOfSale, author)
end box

ListingRepository --> GetListOfItemsOnDirectSaleOfGivenAuthorController : l1
deactivate ListingRepository

GetListOfItemsOnDirectSaleOfGivenAuthorController -> GetListOfItemsOnDirectSaleOfGivenAuthorController : cl1: copyList(l1)

GetListOfItemsOnDirectSaleOfGivenAuthorController --> UI025 : cl1
deactivate GetListOfItemsOnDirectSaleOfGivenAuthorController

UI025 --> Buyer : List of items on direct sale
deactivate UI025

@enduml