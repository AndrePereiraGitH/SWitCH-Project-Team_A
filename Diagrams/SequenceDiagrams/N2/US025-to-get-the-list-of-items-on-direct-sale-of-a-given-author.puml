@startuml

hide footbox
autonumber
title US025 - To get the list of items on direct sale of a given author

actor Buyer

' Participants
participant ":UI025" as UI025
participant ":US025ToGetTheListOfItemsOnDirectSale\nOfAGivenAuthorController" as Ctrl
participant ":AuthorRepository" as AuthorRepository
participant ":AuthorMapper_US025" as AuthorMapper
participant ":DirectSaleMapper_US025" as Mapper
participant ":ListingRepository" as ListingRepository
participant ":PublicationSampleRepository" as PublicationSampleRepository
participant ":BibliographicalDataRepository" as BibliographicalDataRepository

' Interactions
Buyer -> UI025 : I want to get the list of items\non direct sale of a given author
activate UI025

UI025 -> Ctrl : getAllAuthors()
activate Ctrl

Ctrl -> AuthorRepository : getAllAuthors()
activate AuthorRepository
AuthorRepository --> Ctrl : listOfAllAuthors
deactivate AuthorRepository

Ctrl -> AuthorMapper : toDTOList(listOfAllAuthors)
activate AuthorMapper
AuthorMapper --> Ctrl : listOfAllAuthorsDTO
deactivate AuthorMapper

Ctrl --> UI025 : listOfAllAuthorsDTO
deactivate Ctrl

UI025 --> Buyer : Which author? Choose!
deactivate UI025

Buyer -> UI025 : authorId
activate UI025

UI025 -> Ctrl : getListOfItemsOnDirectSaleOfAGivenAuthor(authorId)
activate Ctrl

Ctrl -> AuthorRepository : findAuthorById(authorId)
activate AuthorRepository
AuthorRepository --> Ctrl : author
deactivate AuthorRepository

Ctrl -> Mapper : toDTOListByAuthor(author)
activate Mapper

Mapper -> ListingRepository : findAllDirectSaleListings()
activate ListingRepository
ListingRepository --> Mapper : allListings
deactivate ListingRepository

loop for each listing / for each itemId in listing

    Mapper -> PublicationSampleRepository : findPublicationSampleById(itemId)
    activate PublicationSampleRepository
    PublicationSampleRepository --> Mapper : item
    deactivate PublicationSampleRepository

    Mapper -> BibliographicalDataRepository : findBibliographicalDataById(item.getBibliographicalDataID())
    activate BibliographicalDataRepository
    BibliographicalDataRepository --> Mapper : bd
    deactivate BibliographicalDataRepository

    alt bd.getAuthors().contains(author.id())
        Mapper -> Mapper : toDTO(author, item, listing)
        Mapper -> BibliographicalDataRepository : findBibliographicalDataById(item.getBibliographicalDataID())
        activate BibliographicalDataRepository
        BibliographicalDataRepository --> Mapper : bd
        deactivate BibliographicalDataRepository
    end

end

Mapper --> Ctrl : listOfDirectSaleDTOs
deactivate Mapper

Ctrl --> UI025 : listOfDirectSaleDTOs
deactivate Ctrl

UI025 --> Buyer : Shows the list of items on direct sale
deactivate UI025

@enduml