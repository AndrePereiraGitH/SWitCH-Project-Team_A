@startuml

hide footbox
title US006 - To register a publishing company in the system

box #WhiteSmoke
actor Administrator
participant ":UI006" as UI
end box


participant ":PublisherController" as RegisterPublisherController



participant ":PublisherRepository" as PublisherRepository
 participant ":List<Publisher>"
Administrator -> UI : 1 I want to register a Publishing Company
UI -->> Administrator : **2** Please Provide name, VatNumber, and Contact
Administrator -> UI : **3** Name: Cambridge; VatNumber 123456; Contact: +4412345678

UI -> RegisterPublisherController : 4 registerPublisher(name, vatNumber, contact)
activate RegisterPublisherController

RegisterPublisherController -> PublisherRepository : 5 createAndAddNewPublisher(name, vatNumber, contact)

activate PublisherRepository

create "publisherTest: Publisher" as User


PublisherRepository -> User : 6 create(name, vatNumber, contact)


PublisherRepository -> PublisherRepository : 7 validatePublisher(publisherTest)
PublisherRepository -> ":List<Publisher>" : 8 addPublisherToPublisherList(publisherList)
 activate ":List<Publisher>"
 ":List<Publisher>" -->> PublisherRepository : 9 publisherTest added to the PublisherList
 deactivate

PublisherRepository --> RegisterPublisherController : 10 New Publisher added to the list of Publishers
deactivate PublisherRepository

RegisterPublisherController --> UI : 11 success
deactivate RegisterPublisherController

UI --> Administrator : 12 success



@enduml
