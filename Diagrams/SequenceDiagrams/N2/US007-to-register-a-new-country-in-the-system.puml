@startuml

footbox off

title Sequence Diagram - US007 Register a new country in the System


actor Administrator
participant ":UI" as UI

autonumber


participant ":CountryController" as CountryController
participant ":CountryRepository" as CountryRepository
participant ":CountryFactory" as CountryFactory


Administrator -> UI : I want to register a new country
activate UI
UI --> Administrator : What is the name of the country?
deactivate UI

Administrator -> UI : The country is <countryName>
activate UI

UI -> CountryController : registerNewCountry\n (countryName)
activate CountryController


CountryController -> CountryRepository : createAndAddNewCountry\n (countryName)
activate CountryRepository

CountryRepository -->> CountryFactory : «create»
activate CountryFactory
create participant "newCountry1: Country" as Country
CountryFactory -->> Country : «create»

CountryFactory --> CountryRepository : newCountry1
deactivate CountryFactory

CountryRepository -> CountryRepository : validate\n (newCountry1)

alt Country already exists
CountryRepository --> CountryController : newCountry1\n already exists
CountryController --> UI : newCountry1\n already exists
UI --> Administrator : <newCountry1> is already\n registered in the system!
else Country does not exist
CountryRepository -> CountryRepository : Add (newCountry1)
CountryRepository --> CountryController : newCountry1
deactivate CountryRepository

CountryController --> UI : success!
deactivate CountryController

UI --> Administrator : <newCountry1>\n registered successfully!
deactivate UI
end


@enduml