@startuml
hide footbox
autonumber
title Register a Publishing Company

box #WhiteSmoke
actor Administrator
participant ":UI" as UI
end box
participant ":ToRegisterNewPublisherController" as Controller
participant ":PublisherService" as Service
participant ":PublisherFactory" as Factory
participant "publisher:Publisher" as Publisher
participant ":IPublisherRepository" as Repository

Administrator -> UI : I want to register a Publishing Company
activate UI
UI --> Administrator : Please provide name, vatNumber and contact
deactivate UI

Administrator -> UI : Name: Cambridge; VatNumber: 123456; Contact: +4412345678
activate UI
UI -> Controller : registerPublisher(name, vatNumber, contact)
activate Controller

Controller -> Service : createAndSave(name, vatNumber, contact)
activate Service

Service -> Factory : create(name, vatNumber, contact)
activate Factory
Factory -->> Publisher ** : <<create>>\nPublisher(name, vatNumber, contact)
Factory --> Service : publisher
deactivate Factory

Service -> Repository : save(publisher)
activate Repository
Repository --> Service : publisher
deactivate Repository

Service --> Controller : publisher
deactivate Service

Controller --> UI : true
deactivate Controller
UI --> Administrator : success
deactivate UI

@enduml