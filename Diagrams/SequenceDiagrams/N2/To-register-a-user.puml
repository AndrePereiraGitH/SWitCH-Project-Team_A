@startuml

hide footbox
autonumber

title To register a user in the system

actor Administrator
participant ":UI" as UI
participant ":ToRegisterUserController" as Controller
participant ":UserService" as Service
participant ":UserFactory" as Factory
participant ":IUserRepository" as Repository
participant ":UserRepositoryJPAImpl" as RepositoryJPA
participant ":UserAssembler" as Assembler
participant ":IUserRepositoryJPA" as RepositoryJPAInterface
database "Database" as DB

Administrator -> UI : I want to register a user in the system
activate UI

UI -> Controller : registerUser(username, profile, userRole)
activate Controller

Controller -> Service : createAndSave(username, profile, userRoles)
activate Service

Service -> Factory : create(username, profile, userRoles)
activate Factory

Factory -> Factory : new User(username, profile, userRoles)

Factory --> Service : user
deactivate Factory

Service -> Repository : save(user)
activate Repository

Repository -> RepositoryJPA : save(user)
activate RepositoryJPA

RepositoryJPA -> Assembler : toDM(user)
activate Assembler
Assembler --> RepositoryJPA : userDM
deactivate Assembler

RepositoryJPA -> RepositoryJPAInterface : save(userDM)
activate RepositoryJPAInterface

RepositoryJPAInterface -> DB : INSERT
activate DB
DB --> RepositoryJPAInterface : savedUserDM
deactivate DB

RepositoryJPAInterface --> RepositoryJPA : savedUserDM
deactivate RepositoryJPAInterface

RepositoryJPA -> Assembler : toDomain(savedUserDM)
activate Assembler
Assembler -> Factory : create(userId, username, profile, userRoles)
activate Factory
Factory --> Assembler : user
deactivate Factory
Assembler --> RepositoryJPA : user
deactivate Assembler

RepositoryJPA --> Repository : user
deactivate RepositoryJPA

Repository --> Service : user
deactivate Repository

Service --> Controller : user
deactivate Service

Controller --> UI : user
deactivate Controller

UI --> Administrator : New user has been registered in the system
deactivate UI

@enduml