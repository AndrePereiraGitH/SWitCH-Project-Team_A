@startuml

hide footbox
autonumber

title To register a user in the system

actor Administrator
participant ":UI" as UI
participant ":ToRegisterUserController" as Controller
participant ":UserService" as Service
participant ":IUserRepository" as Repository
participant ":IUserRepositoryJPA" as RepositoryJPAInterface
participant ":UserFactory" as Factory
participant "user:User" as user
participant ":UserAssembler" as Assembler
database "Database" as DB
participant "savedUserDM:UserDM" as savedUserDM

Administrator -> UI : I want to register a user in the system
activate UI

UI -> Controller : registerUser(username, profile, userRoles)
activate Controller

Controller -> Service : createAndSave(username, profile, userRoles)
activate Service

Service -> Repository : existsByUsername(username)
activate Repository
Repository -> RepositoryJPAInterface : existsByUsername(username)
activate RepositoryJPAInterface
RepositoryJPAInterface --> Repository : boolean
deactivate RepositoryJPAInterface
Repository --> Service : boolean
deactivate Repository

Service -> Factory : create(username, profile, userRoles)
activate Factory

Factory -->> user ** : <<create>>

Factory --> Service : user
deactivate Factory

Service -> Repository : save(user)
activate Repository

Repository -> Assembler : toDM(user)
activate Assembler
Assembler --> Repository : userDM
deactivate Assembler

Repository -> RepositoryJPAInterface : save(userDM)
activate RepositoryJPAInterface

RepositoryJPAInterface -> DB : INSERT
activate DB
DB -->> savedUserDM ** : <<create>>
deactivate DB

RepositoryJPAInterface --> Repository : savedUserDM
deactivate RepositoryJPAInterface

Repository -> Assembler : toDomain(savedUserDM)
activate Assembler
Assembler -> Factory : create(userId, username, profile, userRoles)
activate Factory
Factory --> Assembler : user
deactivate Factory
Assembler --> Repository : user
deactivate Assembler

Repository --> Service : user
deactivate Repository

Service --> Controller : user
deactivate Service

Controller --> UI : user
deactivate Controller

UI --> Administrator : New user has been registered in the system
deactivate UI

@enduml