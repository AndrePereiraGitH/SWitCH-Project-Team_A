@startuml
hide footbox
autonumber
title Add Publication to Collection Of Publication - Main View

actor "User" as User
participant ":UI" as UI
participant ":ToAddPublicationToA\nListOfMineController" as Controller

participant ":ICollectionOfPublicationsRepository" as CollectionRepo

participant ":IPublicationSampleRepository" as PublicationSampleRepo
participant ":PublicationSampleAssembler" as PublicationSampleAssembler
participant ":IPublicationSample\nRepositoryJPA" as PublicationSampleRepoJPA
participant "publicationSampleDM\n:PublicationSampleDM" as publicationSampleDM
participant ":PublicationSampleFactory" as PubFactory
participant "publicationSample\n:PublicationSample" as PublicationSample
participant "persistedPublicationSampleDM\n:PublicationSampleDM" as persistedPublicationSampleDM
participant "persistedPublicationSample\n:PublicationSample" as persistedPublicationSample

database "DB" as DB

User -> UI : I want to add one of my publications \nto one of my collections
activate UI

' =========================
' Get User Collections
' =========================
UI -> Controller : getUserCollections(userId)
activate Controller

Controller -> CollectionRepo : getUserCollections(userId)
activate CollectionRepo

ref over CollectionRepo
 [[2.GetUserCollections.puml Get User Collections]]
end ref

CollectionRepo --> Controller : userCollections
deactivate CollectionRepo

Controller --> UI : listOfCollectionsDTO
deactivate Controller

UI --> User : Which collection? Select one!
deactivate UI

User -> UI : Selected collection
activate UI

' =========================
' Get Available Publications
' =========================
UI -> Controller : getPublicationsForCollection(userId, collectionId)
activate Controller

Controller -> PublicationSampleRepo : findAvailableForCollection(userId, collectionId)
activate PublicationSampleRepo

ref over PublicationSampleRepo
 [[3.GetAvailablePublications.puml Get Available Publications]]
end ref

PublicationSampleRepo --> Controller : publicationAvailable
deactivate PublicationSampleRepo

Controller --> UI : listOfAvailablePublicationDTO
deactivate Controller

UI --> User : Which publication? Select one or more publications!
deactivate UI

User -> UI : Selected publications
activate UI

' =========================
' Add Publication To Collection
' =========================
UI -> Controller : addPublicationToCollection(collectionId, publicationSampleIds)
activate Controller

Controller -> PublicationSampleRepo : addPublicationToCollection(collectionId, publicationSampleIds)
activate PublicationSampleRepo

loop for each publicationSampleId

    PublicationSampleRepo -> PublicationSampleRepoJPA : findById(publicationSampleId)
    activate PublicationSampleRepoJPA

    PublicationSampleRepoJPA -> DB : select * from PublicationSample
    activate DB

    DB --> PublicationSampleRepoJPA : data
    deactivate DB

    PublicationSampleRepoJPA -->> publicationSampleDM ** : <<create>>

    PublicationSampleRepoJPA --> PublicationSampleRepo : publicationSampleDM
    deactivate PublicationSampleRepoJPA

    PublicationSampleRepo -> PublicationSampleAssembler : toDomain(publicationSampleDM)
    activate PublicationSampleAssembler

    PublicationSampleAssembler -> publicationSampleDM : getPubSampleId()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : pubSampleId
    deactivate publicationSampleDM

    PublicationSampleAssembler -> publicationSampleDM : getBdId()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : bibliographicalDataId
    deactivate publicationSampleDM

    PublicationSampleAssembler -> publicationSampleDM : getOwnerId()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : userId
    deactivate publicationSampleDM

    PublicationSampleAssembler -> publicationSampleDM : getPublicationStatus()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : publicationStatus
    deactivate publicationSampleDM

    PublicationSampleAssembler -> publicationSampleDM : getEditionId()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : editionId
    deactivate publicationSampleDM

    PublicationSampleAssembler -> publicationSampleDM : getCondition()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : condition
    deactivate publicationSampleDM

    PublicationSampleAssembler -> PubFactory : create (PubSampleId, bibliographicalDataId, userId,\npublicationStatus, editionId, condition)
    activate PubFactory

    PubFactory -->> PublicationSample ** : <<create>>

    PubFactory -->> PublicationSampleAssembler : publicationSample
    deactivate PubFactory

    PublicationSampleAssembler --> PublicationSampleRepo : publicationSample
    deactivate PublicationSampleAssembler

    PublicationSampleRepo -> PublicationSample : addPublicationToCollection(collectionId)
    activate PublicationSample

    PublicationSample --> PublicationSampleRepo : true
    deactivate PublicationSample

    PublicationSampleRepo -> PublicationSampleAssembler : toDM(publicationSample)
    activate PublicationSampleAssembler

    PublicationSampleAssembler -->> publicationSampleDM ** : <<create>>

    PublicationSampleAssembler --> PublicationSampleRepo : publicationSampleDM
    deactivate PublicationSampleAssembler

    PublicationSampleRepo -> PublicationSampleRepoJPA : update(publicationSampleDM)
    activate PublicationSampleRepoJPA

    PublicationSampleRepoJPA -> DB : update PublicationSample
    activate DB

    DB --> PublicationSampleRepoJPA : data
    deactivate DB

    PublicationSampleRepoJPA -->> persistedPublicationSampleDM ** : <<create>>

    PublicationSampleRepoJPA --> PublicationSampleRepo : persistedPublicationSampleDM
    deactivate PublicationSampleRepoJPA

    PublicationSampleRepo -> PublicationSampleAssembler : toDomain(persistedPublicationSampleDM)
    activate PublicationSampleAssembler
    PublicationSampleAssembler -> publicationSampleDM : getPubSampleId()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : pubSampleId
    deactivate publicationSampleDM

    PublicationSampleAssembler -> publicationSampleDM : getBdId()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : bibliographicalDataId
    deactivate publicationSampleDM

    PublicationSampleAssembler -> publicationSampleDM : getOwnerId()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : userId
    deactivate publicationSampleDM

    PublicationSampleAssembler -> publicationSampleDM : getPublicationStatus()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : publicationStatus
    deactivate publicationSampleDM

    PublicationSampleAssembler -> publicationSampleDM : getEditionId()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : editionId
    deactivate publicationSampleDM

    PublicationSampleAssembler -> publicationSampleDM : getCondition()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : condition
    deactivate publicationSampleDM

    PublicationSampleAssembler -> PubFactory : create(pubSampleId, bibliographicalDataId, \nuserId, publicationStatus, editionId, condition)
    activate PubFactory

    PubFactory -->> persistedPublicationSample ** : <<create>>

    PubFactory -->> PublicationSampleAssembler : persistedPublicatonSample
    deactivate PubFactory

    PublicationSampleAssembler --> PublicationSampleRepo : persistedPublicationSample
    deactivate PublicationSampleAssembler


end

PublicationSampleRepo --> Controller : persistedPublicationSample
deactivate PublicationSampleRepo

Controller --> UI : Success
deactivate Controller

UI --> User : Success
deactivate UI

@enduml