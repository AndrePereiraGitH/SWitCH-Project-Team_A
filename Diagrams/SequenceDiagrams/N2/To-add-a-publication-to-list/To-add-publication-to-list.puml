@startuml
hide footbox
autonumber

title Add Publication to Collection Of Publication

actor "User" as User
participant ":UI" as UI
participant ":ToAddPublicationToA\nListOfMineController" as Controller

participant ":ICollectionOfPublicationsRepository" as CollectionRepo
participant ":ICollectionOf\nPublicationsRepositoryJPA" as CollectionRepoJPA
participant ":CollectionOf\nPublicationsAssembler" as CollectionAssembler
participant "collectionDMList\n:List<CollectionOfPublicationsDM>" as collectionDMList
participant ":CollectionOf\nPublicationsFactory" as CollectionFactory
' participant "collectionDM\n:CollectionOfPublicationsDM" as collectionDM
participant "userCollections\n:List<CollectionOfPublications>" as userCollections
participant "collection\n:CollectionOfPublications" as Collection

participant ":US018CollectionOf\nPublicationsMapper" as CollectionMapper
participant "listOfCollectionsDTO\n:List<CollectionOfPublicationsDTO>" as listOfCollectionsDTO
participant ":CollectionOfPublications" as CP
participant "collectionDTO\n:CollectionOfPublicationsDTO" as collectionDTO

participant ":IPublicationSampleRepository" as PublicationSampleRepo
participant ":IPublicationSample\nRepositoryJPA" as PublicationSampleRepoJPA
participant ":PublicationSampleAssembler" as PublicationSampleAssembler
participant ":PublicationSampleFactory" as PublicationSampleFactory
participant "publicationSampleDMList\n:List<PublicationSampleDM>" as publicationSampleDMList
participant "publicationSampleDM\n:PublicationSampleDM" as publicationSampleDM
participant "publicationAvailable\n:List<PublicationSample>" as publicationAvailable
participant "publicationSample\n:PublicationSample" as PublicationSample
participant "persistedPublicationSampleDM\n:PublicationSampleDM" as persistedPublicationSampleDM
participant "persistedPublicationSample\n:PublicationSample" as persistedPublicationSample

participant ":PublicationSampleMapper" as PublicationSampleMapper
participant "listOfAvailablePublicationDTO\n:List<PublicationSampleDTO>" as listOfAvailablePublicationDTO
participant "publicationSampleDTO\n:PublicationSampleDTO" as publicationSampleDTO

participant ":IBibliographical\nDataRepository" as BibliographicalDataRepo
participant ":IBibliographical\nDataRepositoryJPA" as BibliographicalDataRepoJPA
participant ":BibliographicalDataAssembler" as BibliographicalDataAssembler
participant ":BibliographicalDataFactory" as BibliographicalDataFactory
participant "bibliographicalDataDM\n:BibliographicalDataDM" as BibliographicalDataDM
participant ":BibliographicalData" as BibliographicalData

database "DB" as DB

' --- Start ---
User -> UI : I want to add one of my publications \nto one of my collections
activate UI

' =========================
' Get CollectionOfPublication - DM
' =========================
UI -> Controller : getUserCollections(userId)
activate Controller

Controller -> CollectionRepo : getUserCollections(userId)
activate CollectionRepo

CollectionRepo -> CollectionRepoJPA : findByUserId(userId)
activate CollectionRepoJPA

CollectionRepoJPA -> DB : select * from CollectionOfPublications
activate DB
DB --> CollectionRepoJPA : data
deactivate DB

CollectionRepoJPA -->> collectionDMList ** : <<create>>
CollectionRepoJPA --> CollectionRepo : collectionDMList
deactivate CollectionRepoJPA

CollectionRepo -> CollectionAssembler : toDomainList(collectionDMList)
activate CollectionAssembler

CollectionAssembler -->> userCollections ** : <<create>>

loop for each collection DM in the list
    CollectionAssembler -> collectionDMList : id()
    activate collectionDMList
    collectionDMList --> CollectionAssembler : collectionId
    deactivate collectionDMList

    CollectionAssembler -> collectionDMList : getCollectionName()
    activate collectionDMList
    collectionDMList --> CollectionAssembler : collectionName
    deactivate collectionDMList

    CollectionAssembler -> collectionDMList : getCollectionGenreId()
    activate collectionDMList
    collectionDMList --> CollectionAssembler : genreId
    deactivate collectionDMList

    CollectionAssembler -> collectionDMList : isPrivate()
    activate collectionDMList
    collectionDMList --> CollectionAssembler : private
    deactivate collectionDMList

    CollectionAssembler -> CollectionFactory : create(collectionId, collectionName, genreId, ownerId, private)
    activate CollectionFactory

    CollectionFactory -->> Collection ** : <<create>>

    CollectionFactory --> CollectionAssembler : collection
    deactivate CollectionFactory

    CollectionAssembler -> CollectionAssembler : userCollections.add(collection)
end

CollectionAssembler --> CollectionRepo : userCollections
deactivate CollectionAssembler

CollectionRepo --> Controller : userCollections
deactivate CollectionRepo

' =========================
' Get CollectionOfPublication - DTO
' =========================
Controller -> CollectionMapper : toDTOs(userCollections)
activate CollectionMapper

CollectionMapper -->> listOfCollectionsDTO ** : <<create>>

loop for each collection in userCollections
    CollectionMapper -> CP : getId()
    activate CP
    CP --> CollectionMapper : id
    deactivate CP

    CollectionMapper -> CP : getCollectionName()
    activate CP
    CP --> CollectionMapper : collectionName
    deactivate CP

    CollectionMapper -->> collectionDTO ** : toDTO()

    CollectionMapper -> CollectionMapper : listOfCollectionsDTO.add(collectionDTO)
end

CollectionMapper --> Controller : listOfCollectionsDTO
deactivate CollectionMapper

Controller --> UI : listOfCollectionsDTO
deactivate Controller

UI --> User : Which collection? Select one!
deactivate UI

User -> UI : Selected collection
activate UI

' =========================
' Get Available Publications - DM
' =========================
UI -> Controller : getPublicationsForCollection(userId, collectionId)
activate Controller

Controller -> PublicationSampleRepo : findAvailableForCollection(userId, collectionId)
activate PublicationSampleRepo

PublicationSampleRepo -> PublicationSampleRepoJPA : findAvailableByUserIdAndNotInCollection(userId, collectionId)
activate PublicationSampleRepoJPA

PublicationSampleRepoJPA -> DB : select * from PublicationSample
activate DB
DB --> PublicationSampleRepoJPA : data
deactivate DB

PublicationSampleRepoJPA -->> publicationSampleDMList ** : <<create>>
PublicationSampleRepoJPA --> PublicationSampleRepo : publicationSampleDMList
deactivate PublicationSampleRepoJPA

PublicationSampleRepo -> PublicationSampleAssembler : toDomainList(publicationSampleDMList)
activate PublicationSampleAssembler

loop for each publication sample DM in the list
        PublicationSampleAssembler -> publicationSampleDMList : getPubSampleId()
        activate publicationSampleDMList

        publicationSampleDMList --> PublicationSampleAssembler : pubSampleId
        deactivate publicationSampleDMList

        PublicationSampleAssembler -> publicationSampleDMList : getBdId()
        activate publicationSampleDMList

        publicationSampleDMList --> PublicationSampleAssembler : bibliographicalDataId
        deactivate publicationSampleDMList

        PublicationSampleAssembler -> publicationSampleDMList : getOwnerId()
        activate publicationSampleDMList

        publicationSampleDMList --> PublicationSampleAssembler : userId
        deactivate publicationSampleDMList

        PublicationSampleAssembler -> publicationSampleDMList: getPublicationStatus()
        activate publicationSampleDMList

        publicationSampleDMList --> PublicationSampleAssembler : publicationStatus
        deactivate publicationSampleDMList

        PublicationSampleAssembler -> publicationSampleDMList : getEditionId()
        activate publicationSampleDMList

        publicationSampleDMList --> PublicationSampleAssembler : editionId
        deactivate publicationSampleDMList

        PublicationSampleAssembler -> publicationSampleDMList : getCondition()
        activate publicationSampleDMList

        publicationSampleDMList --> PublicationSampleAssembler : condition
        deactivate publicationSampleDMList

        PublicationSampleAssembler -> PublicationSampleFactory : create(pubSampleId, bibliographicalDataId, \nuserId, publicationStatus, editionId, condition)
        activate PublicationSampleFactory

    PublicationSampleFactory -->> PublicationSample ** : <<create>>

    PublicationSampleFactory --> PublicationSampleAssembler : publicationSample
    deactivate PublicationSampleFactory

    PublicationSampleAssembler -> PublicationSampleAssembler : publicationAvailable.add(publicationSample)
end

PublicationSampleAssembler --> PublicationSampleRepo : publicationAvailable
deactivate PublicationSampleAssembler

PublicationSampleRepo --> Controller : publicationAvailable
deactivate PublicationSampleRepo

' =========================
' Convert Available Publications to DTO
' =========================
Controller -> PublicationSampleMapper : toDTOs(publicationAvailable)
activate PublicationSampleMapper

PublicationSampleMapper -->> listOfAvailablePublicationDTO ** : <<create>>

loop for each publicationSample
    PublicationSampleMapper -> PublicationSample : getId()
    activate PublicationSample
    PublicationSample --> PublicationSampleMapper : id
    deactivate PublicationSample

    PublicationSampleMapper -> PublicationSample : getTitle()
    activate PublicationSample
    PublicationSample --> PublicationSampleMapper : title
    deactivate PublicationSample

    PublicationSampleMapper -->> publicationSampleDTO ** : toDTO()

    PublicationSampleMapper -> PublicationSampleMapper : listOfAvailablePublicationDTO.add(publicationSampleDTO)
end

PublicationSampleMapper --> Controller : listOfAvailablePublicationDTO
deactivate PublicationSampleMapper

Controller --> UI : listOfAvailablePublicationDTO
deactivate Controller

UI --> User : Which publication? Select one or more publications!
deactivate UI

' =========================
' User selects publication(s)
' =========================
User -> UI : Selected publications
activate UI

UI -> Controller : addPublicationToCollection(collectionId, publicationSampleIds)
activate Controller

' =========================
' Add publication(s) to collection and save
' =========================
Controller -> PublicationSampleRepo : assignPublicationsToCollection(collectionId, publicationSampleIds)
activate PublicationSampleRepo

loop for each publicationSampleId

    PublicationSampleRepo -> PublicationSampleRepoJPA : findById(publicationSampleId)
    activate PublicationSampleRepoJPA

    PublicationSampleRepoJPA -> DB : select * from PublicationSample
    activate DB

    DB --> PublicationSampleRepoJPA : data
    deactivate DB

    PublicationSampleRepoJPA -->> publicationSampleDM ** : <<create>>

    PublicationSampleRepoJPA --> PublicationSampleRepo : publicationSampleDM
    deactivate PublicationSampleRepoJPA

    PublicationSampleRepo -> PublicationSampleAssembler : toDomain(publicationSampleDM)
    activate PublicationSampleAssembler

    PublicationSampleAssembler -> publicationSampleDM : getPubSampleId()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : pubSampleId
    deactivate publicationSampleDM

    PublicationSampleAssembler -> publicationSampleDM : getBdId()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : bibliographicalDataId
    deactivate publicationSampleDM

    PublicationSampleAssembler -> publicationSampleDM : getOwnerId()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : userId
    deactivate publicationSampleDM

    PublicationSampleAssembler -> publicationSampleDM : getPublicationStatus()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : publicationStatus
    deactivate publicationSampleDM

    PublicationSampleAssembler -> publicationSampleDM : getEditionId()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : editionId
    deactivate publicationSampleDM

    PublicationSampleAssembler -> publicationSampleDM : getCondition()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : condition
    deactivate publicationSampleDM

    PublicationSampleAssembler -> PublicationSampleFactory : create(pubSampleId, bibliographicalDataId, \nuserId, publicationStatus, editionId, condition)
    activate PublicationSampleFactory

    PublicationSampleFactory -->> PublicationSample ** : <<create>>

    PublicationSampleFactory --> PublicationSampleAssembler : publicationSample
    deactivate PublicationSampleFactory

    PublicationSampleAssembler --> PublicationSampleRepo : publicationSample
    deactivate PublicationSampleAssembler

    PublicationSampleRepo -> PublicationSample : addPublicationToCollection(collectionId)
    activate PublicationSample

    PublicationSample --> PublicationSampleRepo : true
    deactivate PublicationSample

    PublicationSampleRepo -> PublicationSampleAssembler : toDM(publicationSample)
    activate PublicationSampleAssembler

    PublicationSampleAssembler -->> publicationSampleDM ** : <<create>>

    PublicationSampleAssembler --> PublicationSampleRepo : publicationSampleDM
    deactivate PublicationSampleAssembler

    PublicationSampleRepo -> PublicationSampleRepoJPA : update(publicationSampleDM)
    activate PublicationSampleRepoJPA

    PublicationSampleRepoJPA -> DB : update PublicationSample
    activate DB

    DB --> PublicationSampleRepoJPA : data
    deactivate DB

    PublicationSampleRepoJPA -->> persistedPublicationSampleDM ** : <<create>>

    PublicationSampleRepoJPA --> PublicationSampleRepo : persistedPublicationSampleDM
    deactivate PublicationSampleRepoJPA

    PublicationSampleRepo -> PublicationSampleAssembler : toDomain(persistedPublicationSampleDM)
    activate PublicationSampleAssembler


    PublicationSampleAssembler -> publicationSampleDM : getPubSampleId()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : pubSampleId
    deactivate publicationSampleDM

    PublicationSampleAssembler -> publicationSampleDM : getBdId()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : bibliographicalDataId
    deactivate publicationSampleDM

    PublicationSampleAssembler -> publicationSampleDM : getOwnerId()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : userId
    deactivate publicationSampleDM

    PublicationSampleAssembler -> publicationSampleDM : getPublicationStatus()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : publicationStatus
    deactivate publicationSampleDM

    PublicationSampleAssembler -> publicationSampleDM : getEditionId()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : editionId
    deactivate publicationSampleDM

    PublicationSampleAssembler -> publicationSampleDM : getCondition()
    activate publicationSampleDM

    publicationSampleDM --> PublicationSampleAssembler : condition
    deactivate publicationSampleDM

    PublicationSampleAssembler -> PublicationSampleFactory : create(pubSampleId, bibliographicalDataId, \nuserId, publicationStatus, editionId, condition)
    activate PublicationSampleFactory

    PublicationSampleFactory -->> persistedPublicationSample ** : <<create>>

    PublicationSampleFactory -->> PublicationSampleAssembler : persistedPublicatonSample
    deactivate PublicationSampleFactory

    PublicationSampleAssembler --> PublicationSampleRepo : persistedPublicationSample
    deactivate PublicationSampleAssembler

end

PublicationSampleRepo --> Controller : persistedPublicationSample
deactivate PublicationSampleRepo

Controller --> UI : Success
deactivate Controller

UI --> User : Success
deactivate UI

@enduml