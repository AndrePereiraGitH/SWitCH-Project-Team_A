@startuml
hide footbox
autonumber
title Get User Collections

participant ":ToAddPublicationToA\nListOfMineController" as Controller

participant ":ICollectionOfPublicationsRepository" as CollectionRepo
participant ":ICollectionOf\nPublicationsRepositoryJPA" as CollectionRepoJPA
participant ":CollectionOf\nPublicationsAssembler" as CollectionAssembler
participant "collectionDMList\n:List<CollectionOfPublicationsDM>" as collectionDMList
participant ":CollectionOf\nPublicationsFactory" as CollectionFactory
participant "userCollections\n:List<CollectionOfPublications>" as userCollections
participant "collection\n:CollectionOfPublications" as Collection

participant ":US018CollectionOf\nPublicationsMapper" as CollectionMapper
participant "listOfCollectionsDTO\n:List<CollectionOfPublicationsDTO>" as listOfCollectionsDTO
participant ":CollectionOfPublications" as CP
participant "collectionDTO\n:CollectionOfPublicationsDTO" as collectionDTO

database "DB" as DB

note over Controller #E3F2FD
<b>Fragment</b>
---
This diagram is a fragment of the main sequence diagram.
end note

note over Controller #E3F2FD
<b>Navigation</b>
---
[[1.MainDiagram.puml Return to Main Diagram]]
end note

Controller -> CollectionRepo : getUserCollections(userId)
activate CollectionRepo

CollectionRepo -> CollectionRepoJPA : findByUserId(userId)
activate CollectionRepoJPA

CollectionRepoJPA -> DB : select * from CollectionOfPublications
activate DB

DB --> CollectionRepoJPA : data
deactivate DB

CollectionRepoJPA -->> collectionDMList ** : <<create>>

CollectionRepoJPA --> CollectionRepo : collectionDMList
deactivate CollectionRepoJPA

CollectionRepo -> CollectionAssembler : toDomainList(collectionDMList)
activate CollectionAssembler

CollectionAssembler -->> userCollections ** : <<create>>

loop for each collection DM in the list

    CollectionAssembler -> collectionDMList : id()
    activate collectionDMList
    collectionDMList --> CollectionAssembler : collectionId
    deactivate collectionDMList

    CollectionAssembler -> collectionDMList : getCollectionName()
    activate collectionDMList
    collectionDMList --> CollectionAssembler : collectionName
    deactivate collectionDMList

    CollectionAssembler -> collectionDMList : getCollectionGenreId()
    activate collectionDMList
    collectionDMList --> CollectionAssembler : genreId
    deactivate collectionDMList

    CollectionAssembler -> collectionDMList : isPrivate()
    activate collectionDMList
    collectionDMList --> CollectionAssembler : private
    deactivate collectionDMList

    CollectionAssembler -> CollectionFactory : create(collectionId, collectionName, genreId, ownerId, private)
    activate CollectionFactory

    CollectionFactory -->> Collection ** : <<create>>

    CollectionFactory --> CollectionAssembler : collection
    deactivate CollectionFactory

    CollectionAssembler -> CollectionAssembler : userCollections.add(collection)

end

CollectionAssembler --> CollectionRepo : userCollections
deactivate CollectionAssembler

CollectionRepo --> Controller : userCollections
deactivate CollectionRepo

Controller -> CollectionMapper : toDTOs(userCollections)
activate CollectionMapper

CollectionMapper -->> listOfCollectionsDTO ** : <<create>>

loop for each collection in userCollections

    CollectionMapper -> CP : getId()
    activate CP
    CP --> CollectionMapper : id
    deactivate CP

    CollectionMapper -> CP : getCollectionName()
    activate CP
    CP --> CollectionMapper : collectionName
    deactivate CP

    CollectionMapper -->> collectionDTO ** : <<create>>

    CollectionMapper -> CollectionMapper : listOfCollectionsDTO.add(collectionDTO)

end

CollectionMapper --> Controller : listOfCollectionsDTO
deactivate CollectionMapper

@enduml