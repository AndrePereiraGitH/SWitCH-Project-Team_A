@startuml
hide footbox
autonumber

title US018 - Add Publication to List (N2)

box #whitesmoke
actor "User" as User
participant ":UI - US018" as UI
end box

box "Controller" #Lightblue
participant ":AddPublicationToListController" as Controller
end box

box "Persistence" #LightGrey
participant ":PublicationListRepository" as PublicationListRepo
participant ":LibraryRepository" as LibraryRepo
end box

box "Domain" #Lightyellow
participant ":Library" as Library
end box

User -> UI : I want to add one of my publications to one of my list
activate UI

UI -> Controller : getMyPublicationLists(user)
activate Controller

Controller -> PublicationListRepo : getMyPublicationLists(user)
activate PublicationListRepo
PublicationListRepo --> Controller : user lists
deactivate PublicationListRepo

Controller --> UI : user lists

UI --> User : To what list? Choose!

User -> UI : List

UI -> Controller : getPublicationsForList(user, list)

Controller -> LibraryRepo : getLibrary(user)
activate LibraryRepo
LibraryRepo --> Controller : library
deactivate LibraryRepo

Controller -> Library : getPublications(library)
activate Library
Library --> Controller : allpublications
deactivate Library

Controller -> PublicationListRepo : getPublications (list)
activate PublicationListRepo

PublicationListRepo --> Controller : publicationsInList
deactivate PublicationListRepo

Controller -> Controller : p=diff(allPublications, publicationsInList)

Controller --> UI : Available publications

UI --> User : Which publication? Choose!

User -> UI : select publication

UI -> Controller : addPublicationToList(list, selectedPublication)

Controller -> PublicationListRepo :  addPublicationToList(list, selectedPublication)
activate PublicationListRepo

PublicationListRepo --> Controller : true
deactivate PublicationListRepo

Controller --> UI : success
deactivate Controller

UI --> User : Publication added to list
deactivate UI

@enduml
