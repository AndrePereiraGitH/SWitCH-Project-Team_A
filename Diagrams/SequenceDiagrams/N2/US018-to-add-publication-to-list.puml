@startuml
hide footbox
autonumber

title US018 - Add Publication to Collection Of Publication

actor "User" as User
participant ":UI018" as UI
participant ":AddCollectionOfPublicationsController" as Controller
participant ":CollectionOfPublicationsRepository" as CollectionRepo
participant ":LibraryRepository" as LibraryRepo
participant ":Library" as Library
participant "cp : CollectionOfPublications" as cp

User -> UI : I want to add one of my publications to one of my collections
activate UI

UI -> Controller : getUserCollections(user)
activate Controller

Controller -> CollectionRepo : getUserCollections(user)
activate CollectionRepo

create "userCollections : List<CollectionOfPublications>" as UserCollections
CollectionRepo -> UserCollections : create

loop for each cp : CollectionOfPublications
    CollectionRepo -> cp : isFromUser(user)
    activate cp

     cp --> CollectionRepo : boolean
        deactivate cp

    alt [true]
        CollectionRepo -> CollectionRepo : userCollection.add(cp)
    end
end

CollectionRepo --> Controller : userCollections
deactivate CollectionRepo

Controller --> UI : userCollections

UI --> User : Which collection? Select one!

User -> UI : Selected collection

UI -> Controller : getPublicationsForCollection(user, collection)

Controller -> LibraryRepo : getLibrary(user)
activate LibraryRepo
LibraryRepo --> Controller : library
deactivate LibraryRepo

Controller -> Library : getPublications
activate Library
Library --> Controller : allPublications
deactivate Library

Controller -> cp : getPublications(collection)
activate cp
cp --> Controller : publicationsInCollection
deactivate cp

Controller -> Controller : p = diff(allPublications, publicationsInCollection)

Controller --> UI : Available publications

UI --> User : Which publication? Select one!

User -> UI : selected publication

UI -> Controller : addPublicationToCollection(collection, selectedPublication)

Controller -> CollectionRepo : addPublicationToCollection(collection, selectedPublication)
activate CollectionRepo
CollectionRepo --> Controller : true
deactivate CollectionRepo

Controller --> UI : success
deactivate Controller

UI --> User : Publication added to collection
deactivate UI

@enduml