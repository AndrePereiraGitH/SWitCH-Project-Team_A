@startuml

hide footbox
autonumber
title Register Appraisal Entity (Main)

actor Administrator
participant ":UI" as UI
participant ":ToRegisterAppraisalEntityController" as Controller
participant ":IGenreRepository" as GenreRepo
participant ":IPublicationTypeRepository" as PublicationTypeRepo
participant ":IAppraisalEntityRepository" as AppraisalRepo
participant ":AppraisalEntityFactory" as FactoryAppraisalEntity
participant "apEn : AppraisalEntity" as AppraisalEntity

' --- Start ---
Administrator -> UI : I want to register an Appraisal Entity
activate UI

UI --> Administrator : Please provide name and contact
deactivate UI

Administrator -> UI : Provide name and contact
activate UI

' =========================
' Get Genres (reference)
' =========================
UI -> Controller : getAllGenres()
activate Controller

ref over Controller
[[2.GetGenres.puml Get Genres]]
end ref

Controller --> UI : listOfGenreDTO
deactivate Controller

UI --> Administrator : Display available Genres
deactivate UI

Administrator -> UI : Selected one or more Genres
activate UI

' =========================
' Get Publication Types (reference)
' =========================
UI -> Controller : getAllPublicationTypes()
activate Controller

ref over Controller
[[3.GetPublicationTypes.puml Get Publication Types]]
end ref

Controller --> UI : listOfPublicationTypeDTO
deactivate Controller

UI --> Administrator : Display Publication Types
deactivate UI

Administrator -> UI : Selected one or more Publication Types
activate UI
' =========================
' Register Appraisal Entity
' =========================
UI -> Controller : registerAppraisalEntity(name, contact, genresId, publicationTypesId)
activate Controller

Controller -> AppraisalRepo : createAndAdd(name, contact, genresId, publicationTypesId)
activate AppraisalRepo

AppraisalRepo -> FactoryAppraisalEntity : create(name, contact, genresId, publicationTypesId)
activate FactoryAppraisalEntity

FactoryAppraisalEntity -->> AppraisalEntity **: <<create>>

FactoryAppraisalEntity --> AppraisalRepo : apEn
deactivate FactoryAppraisalEntity

AppraisalRepo -> AppraisalRepo : exists(apEn)
AppraisalRepo --> AppraisalRepo : false
AppraisalRepo -> AppraisalRepo : add(apEn)

AppraisalRepo --> Controller : apEn
deactivate AppraisalRepo

Controller --> UI : Success
deactivate Controller

UI ---> Administrator : Success
deactivate UI
@enduml