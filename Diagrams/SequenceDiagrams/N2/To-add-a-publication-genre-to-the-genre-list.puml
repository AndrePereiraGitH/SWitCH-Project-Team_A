@startuml
hide footbox
autonumber
title To add a publication genre to the genre list

actor Administrator
participant ":UI" as UI
participant ":ToRegisterGenreCtrl" as Ctrl
participant ":IGenreRepository" as genreRepo
participant ":GenreFactory" as factory

Administrator -> UI : I want to add a new genre to the official list
activate UI
UI --> Administrator : What is the genre name?
deactivate UI
Administrator -> UI : genreType("romance")

activate UI

UI -> Ctrl : registerGenre(genreType)
activate Ctrl

Ctrl -> genreRepo : createAndAdd(genreType)
activate genreRepo

genreRepo -> factory : create(genreType)
activate factory
create "romance:Genre" as Genre
factory -->> Genre : <<create>>
factory --> genreRepo : romance
deactivate factory

genreRepo -> genreRepo : exists(romance)

alt [genre already exists]
    genreRepo --> Ctrl : error: "Genre already exists"
    Ctrl --> UI : error: "Genre already exists"
    UI --> Administrator : Genre already exists

else [genre does NOT exist]
    genreRepo -> genreRepo : _genres.add(romance)
    genreRepo --> Ctrl : romance
end

deactivate genreRepo

Ctrl --> UI : true
deactivate Ctrl

UI --> Administrator : success
deactivate UI

@enduml
