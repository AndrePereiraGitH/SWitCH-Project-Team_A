@startuml

hide footbox
autonumber
title US026 - To get the list of items on auction of a given author

actor Buyer

' Participants
participant ":UI026" as UI026
participant ":ToGetTheListOfItemsOnAuction\nOfAGivenAuthorController" as Ctrl
participant ":AuthorRepository" as AuthorRepository
participant ":AuthorMapper_US026" as AuthorMapper
participant ":authorDTO:AuthorDTO_US026" as AuthorDTO
participant ":AuctionMapper_US026" as Mapper
participant ":AuctionRepository" as AuctionRepository
participant "listOfAuction:\nList<Auction>" as ListAuc
participant "auctionDTO:\nAuctionDTO_US026" as DTO
participant "listOfAuctionDTO:\nList<AuctionDTO_US026>" as ListDTO
participant ":Auction" as AU


' Interactions
Buyer -> UI026 : I want to get the list of items\n on auction of a given author
activate UI026
UI026 -> Ctrl : getAllAuthors()
activate Ctrl
Ctrl -> AuthorRepository: getAllAuthors()
activate AuthorRepository
AuthorRepository --> Ctrl: listOfAllAuthors
deactivate AuthorRepository

Ctrl -> AuthorMapper: toDTO(listOfAllAuthors)
activate AuthorMapper
AuthorMapper -> AuthorDTO **
AuthorMapper --> Ctrl: listOfAllAuthorsDTO
deactivate AuthorMapper

Ctrl --> UI026 : listOfAllAuthors
deactivate Ctrl
Buyer <-- UI026 : Which author? Choose!
deactivate UI026
Buyer -> UI026 : author
activate UI026

UI026 -> Ctrl : getListOfItemsOnAuction(author)
activate Ctrl

Ctrl -> AuctionRepository : getListOfItemsOnAuction(author)
activate AuctionRepository

loop for each auction
    AuctionRepository -> AuctionRepository : checkAuctionAuthor(author))
end

AuctionRepository -> ListAuc ** : create ()
AuctionRepository --> Ctrl : listOfAuction
deactivate AuctionRepository

Ctrl -> Mapper : toDTO(listOfAuction)
activate Mapper
Mapper -> ListDTO ** : create ()

loop for each auction
    Mapper -> AU: getDetails(auction)
        activate AU
        AU --> Mapper: auctionDetails
        deactivate AU

    Mapper -> DTO ** : createDTO(auctionDetails)
    DTO --> Mapper: auctionDTO
    Mapper -> ListDTO : add(auctionDTO)
end

Mapper --> Ctrl : listOfAuctionsDTO
deactivate Mapper

Ctrl --> UI026 : listOfAuctionsDTO
deactivate Ctrl

UI026 --> Buyer : Shows the list of items on auction
deactivate UI026

@enduml