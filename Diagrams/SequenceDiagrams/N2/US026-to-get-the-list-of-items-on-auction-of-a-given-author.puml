@startuml

hide footbox
autonumber
title US026 - To get the list of items on auction of a given author

actor Buyer
participant ":UI026" as UI026

participant ":GetListOfItemsOnAuctionOfGivenAuthorController" as GetListOfItemsOnAuctionOfGivenAuthorController

participant ":AuthorRepository" as AuthorRepository

participant ":AuctionRepository" as AuctionRepository

Buyer -> UI026 : I want to get the list of items on le of a given author
activate UI026
UI026 -> GetListOfItemsOnAuctionOfGivenAuthorController : getAllAuthors()
activate GetListOfItemsOnAuctionOfGivenAuthorController
GetListOfItemsOnAuctionOfGivenAuthorController -> AuthorRepository: getAllAuthors()
activate AuthorRepository
AuthorRepository --> GetListOfItemsOnAuctionOfGivenAuthorController: listOfAllAuthors
deactivate AuthorRepository
GetListOfItemsOnAuctionOfGivenAuthorController --> UI026 : listOfAllAuthors
deactivate GetListOfItemsOnAuctionOfGivenAuthorController
Buyer <-- UI026 : Which author? Choose!
Buyer -> UI026 : author

UI026 -> GetListOfItemsOnAuctionOfGivenAuthorController : getListOfItemsOnAuction(author)
activate GetListOfItemsOnAuctionOfGivenAuthorController

GetListOfItemsOnAuctionOfGivenAuthorController -> AuctionRepository : getListOfItemsOnAuction(author)
activate AuctionRepository


AuctionRepository -> AuctionRepository : validateParameters(author)

create "l1: List<Listing>" as Listing
AuctionRepository -> Listing : getList(author)

AuctionRepository --> GetListOfItemsOnAuctionOfGivenAuthorController : l1
deactivate AuctionRepository

GetListOfItemsOnAuctionOfGivenAuthorController -> GetListOfItemsOnAuctionOfGivenAuthorController : cl1: copyList(l1)

GetListOfItemsOnAuctionOfGivenAuthorController --> UI026 : cl1
deactivate GetListOfItemsOnAuctionOfGivenAuthorController

UI026 --> Buyer : List of items on auction
deactivate UI026

@enduml