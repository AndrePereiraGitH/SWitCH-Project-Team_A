@startuml

hide footbox
autonumber
title US026 - To get the list of items on auction of a given author

actor Buyer

' Participants
participant ":UI026" as UI026
participant ":ToGetTheListOfItemsOnAuction\nOfAGivenAuthorController" as Ctrl

participant ":AuthorRepository" as AuthorRepository
participant ":AuthorDTO_US026" as AuthorDTO_US026

participant ":AuctionDTO_US016" as AuctionDTO
participant ":auctionDTO: AuctionDTO_US026" as aucDTO
participant ":authorDTO:AuthorDTO_US026" as AuthorDTO

participant "listOfAuctionDTO:\nList<AuctionDTO_US026>" as ListDTO

participant "List<AuthorDTO>" as authorsListDto

participant ":AuctionRepository" as AuctionRepository
participant "listOfAuctions:List<Auction>" as ListAuc




' Interactions
Buyer -> UI026 : I want to get the list of items\n on auction of a given author
activate UI026
UI026 -> Ctrl : getAllAuthors()
activate Ctrl
Ctrl -> AuthorRepository: getAllAuthors()
activate AuthorRepository
AuthorRepository --> Ctrl: listOfAllAuthors
deactivate AuthorRepository

Ctrl -> authorsListDto **: create()

loop "For each Author in list"
    Ctrl -> AuthorDTO_US026: toDTO(author)
    activate AuthorDTO_US026
    AuthorDTO_US026 -> AuthorDTO **
    AuthorDTO_US026 --> Ctrl: authorDTO
    deactivate AuthorDTO_US026
    Ctrl -> Ctrl : listOfAuthorDTO.add(authorDTO)
end

Ctrl --> UI026 : listOfAllAuthorsDTO
deactivate Ctrl
Buyer <-- UI026 : Which author? Choose!
deactivate UI026
Buyer -> UI026 : author
activate UI026

UI026 -> Ctrl : getListOfItemsOnAuctionByAuthor(authorDTO)
activate Ctrl

Ctrl -> AuctionRepository : getListOfItemsOnAuctionByAuthor(authorDTO)
activate AuctionRepository

AuctionRepository -> ListAuc ** : create ()

loop for each auction in AuctionRepository
    AuctionRepository -> AuctionRepository : verifyIfAuctionItemAuthorMatchesAuthorDto(authorDtoName))
    AuctionRepository -> AuctionRepository : listOfAuctions.add(auction)
end


AuctionRepository --> Ctrl : listOfAuctions
deactivate AuctionRepository

Ctrl -> ListDTO ** : create ()

loop for each auction in listOfAuctions
    Ctrl -> AuctionDTO: toDTO(auction)
        activate AuctionDTO

        AuctionDTO -> aucDTO **
        AuctionDTO --> Ctrl: auctionDTO
        deactivate
        Ctrl -> Ctrl : listOfAuctionDTO.add(auctionDTO)

end


Ctrl --> UI026 : listOfAuctionsDTO
deactivate Ctrl

UI026 --> Buyer : Shows the list of items on auction
deactivate UI026

@enduml