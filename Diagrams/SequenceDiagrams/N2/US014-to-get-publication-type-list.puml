@startuml
autonumber
hide footbox
title US0014 - To get publication types list

actor User
participant ":UI014" as UI
participant ":ToGetPublicationTypeController" as C
participant ":PublicationTypeRepository" as PTR
participant ":PublicationTypeMapper_US014" as PTM

User -> UI : I want to get a list of all publication types
activate UI

UI -> C : getListOfPublicationType()
activate C

C -> PTR : getListOfPublicationType()
activate PTR
create "listOfPublicationType:\nList<PublicationType>" as LOPT
PTR -> LOPT

PTR --> C : listOfPublicationType
deactivate PTR

C -> PTM : toDTO(listOfPublicationType)
activate PTM

create "ListOfPublicationTypesDTO:\nList<publicationTypeDTO>" as listDTO
PTM -> listDTO : create()
    loop for each PublicationType
        PTM -> "PublicationType" : getDetails()
        activate PublicationType
        PublicationType --> PTM : publicationType
        deactivate PublicationType
        create "PublicationTypeDTO\n:PublicationTypeDTO_US014" as PTDTO
        PTM -> PTDTO : createDTO(publicationType)
        PTDTO --> PTM : publicationTypeDTO
        PTM -> listDTO : add(publicationTypeDTO)
    end

PTM --> C :listOfPublicationTypesDTO
deactivate PTM

C --> UI : listOfPublicationTypesDTO
deactivate C

UI --> User : Show List of Publication Types
deactivate UI


@enduml