@startuml
autonumber
hide footbox
title US0014 - Get Publication Types List (without Mapper)

actor User

participant ":UI014" as UI
participant ":GetPublicationTypeListController" as C
participant ":PublicationTypeRepository" as PTR
participant ":PublicationTypeDTO_US014" as DTO

User -> UI : I want to get a list of all publication types
activate UI

UI -> C : getAllPublicationTypes()
activate C

C -> PTR : getAllPublicationTypes()
activate PTR

PTR --> C : listOfPublicationType
deactivate PTR

C -> DTO : fromDomainList(listOfPublicationType)
activate DTO

create "listOfPublicationTypesDTO:\nList<PublicationTypeDTO_US014>" as listDTO
DTO -> listDTO : create()

loop for each PublicationType
    DTO -> "PublicationType" : getDetails()
    activate PublicationType
    PublicationType --> DTO : publicationType
    deactivate PublicationType
    DTO -> DTO : createDTO(publicationType)
    DTO -> listDTO : add(publicationTypeDTO)
end

DTO --> C : listOfPublicationTypesDTO
deactivate DTO

C --> UI : listOfPublicationTypesDTO
deactivate C

UI --> User : Show list of publication types
deactivate UI

@enduml