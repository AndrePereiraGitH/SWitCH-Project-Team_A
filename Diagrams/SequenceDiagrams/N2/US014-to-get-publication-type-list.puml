@startuml
autonumber
hide footbox
title US0014 - To get publication types list

actor User
participant ":UI014" as UI
participant ":ToGetPublicationTypeController" as C
participant ":PublicationTypeRepository" as PTR
participant ":PublicationTypeMapper" as PTM
participant ":PublicationType" as PT
participant "publicationTypeDTO:\npublicationTypeDTO" as DTO


User -> UI : I want to get a list of all publication types
activate UI

UI -> C : getListOfPublicationType()
activate C

C -> PTR : getListOfPublicationType()
activate PTR
create "listOfPublicationType:\nList<PublicationType>" as LOPT
PTR -> LOPT

PTR --> C : listOfPublicationType
deactivate PTR

C -> PTM : toDTO(listOfPublicationType)
activate PTM
create "listOfPublicationTypeDTO:\nList<PublicationTypeDTO>" as lopt1
PTM -> lopt1

    loop for each PublicationType
        PTM -> PT : getDetails()
        activate PT
        PT --> PTM : details
        deactivate PT

        PTM -> DTO ** : create(details)
        activate DTO
        DTO --> PTM : publicationTypeDTO
        deactivate DTO

        PTM -> PTM : listOfPublicationTypeDTO.add(publicationTypeDTO)
    end

PTM --> C :listOfPublicationTypesDTO
deactivate PTM

C --> UI : listOfPublicationTypesDTO
deactivate C

UI --> User : Official List of Publication Types
deactivate UI


@enduml