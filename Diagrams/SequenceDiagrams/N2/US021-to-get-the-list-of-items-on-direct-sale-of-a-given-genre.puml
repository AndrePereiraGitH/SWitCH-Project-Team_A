@startuml

hide footbox
autonumber
title US021 - To get the list of items on direct sale of a given genre

box #WhiteSmoke
actor Buyer
participant ":UI021" as UI021
end box

Buyer -> UI021 : I want to get a list of items on direct sale of a given genre
activate UI021
UI021 --> Buyer : Which genre?
Buyer -> UI021 : genre

box "Controller" #LightBlue
participant ":ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController" as ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController
end box

UI021 -> ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController: getListOfItemsOnDirectSale(genre)
activate ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController

box "Persistence" #LightGrey
participant ":ListingRepository" as ListingRepository
end box

ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController-> ListingRepository : getListOfItemsOnDirectSale(genre)
activate ListingRepository

ListingRepository -> ListingRepository : validateParameters(genre)

box "Domain Model" #LightYellow
create "l1: List<Listing>" as Listing
ListingRepository -> Listing : getList(genre)
end box

ListingRepository --> ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController: l1
deactivate ListingRepository

ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController-> ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController: cl1: copyList(l1)

ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController--> UI021 : cl1
deactivate ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController

UI021 --> Buyer : List of items on direct sale
deactivate UI021

@enduml