@startuml
autonumber
hide footbox
title US021 - Get the list of items on direct sale of a given genre

actor Buyer

' Participants
participant ":UI021" as UI
participant ":ToGetTheListOfItemsOnDirectSale\nOfAGivenGenreController" as Ctrl
participant ":GenreRepository" as GenreRepo
participant ":GenreMapper_US021" as GenreMapper_US021
participant "genreDTO:\nGenreDTO_US021" as GenreDTO
participant ":DirectSaleMapper_US021" as Mapper
participant ":DirectSaleRepository" as DirectSaleRepo
participant "listOfDirectSales:\nList<DirectSale>" as ListDS
'participant ":DirectSale" as DirectSaleDomain
participant "directSaleDTO:\nDirectSaleDTO_US021" as DTO
participant "listOfDirectSalesDTO:\nList<DirectSaleDTO_US021>" as ListDTO


' Interactions
Buyer -> UI : I want to get the list of items\n on direct sale of a given genre
activate UI

UI -> Ctrl : getAllGenres()
activate Ctrl

Ctrl -> GenreRepo : getAllGenres()
activate GenreRepo
GenreRepo --> Ctrl : listOfAllGenres
deactivate GenreRepo

Ctrl -> GenreMapper_US021: toDTO(listOfAllGenre)
activate GenreMapper_US021
/'
GenreMapper_US021 -> GenreDTO ** : create()
activate GenreDTO
GenreDTO --> GenreMapper_US021: GenreDTO
deactivate GenreDTO
GenreMapper_US021 -> GenreMapper_US021 : listOfAllGenreDTO.add(GenreDTO)
'/
GenreMapper_US021 -> GenreDTO **

GenreMapper_US021 --> Ctrl: listOfAllGenreDTO
deactivate GenreMapper_US021

Ctrl --> UI : listOfAllGenres
deactivate Ctrl

UI --> Buyer : Which genre? Choose!
deactivate UI

Buyer -> UI : genre
activate UI

UI -> Ctrl : getListOfItemsOnDirectSale(genre)
activate Ctrl

Ctrl -> DirectSaleRepo : getListOfItemsOnDirectSale(genre)
activate DirectSaleRepo

loop for each direct sale
    DirectSaleRepo -> DirectSaleRepo : checkDirectSaleGenre(genre)
end

DirectSaleRepo -> ListDS ** :
DirectSaleRepo --> Ctrl : listOfDirectSales
deactivate DirectSaleRepo

Ctrl -> Mapper : toDTO(listOfDirectSales)
activate Mapper
Mapper -> ListDTO ** :

    loop for each direct sale
        'Mapper -> DirectSaleDomain : getDetails()
        'activate DirectSaleDomain
        'DirectSaleDomain --> Mapper : details
        'deactivate DirectSaleDomain

        'Mapper -> DTO ** : create(details)
        Mapper -> DTO **
        'activate DTO
        'DTO --> Mapper : directSaleDTO
        'deactivate DTO

        Mapper -> Mapper : listOfDirectSalesDTO.add(directSaleDTO)
    end

Mapper --> Ctrl : listOfDirectSalesDTO
deactivate Mapper

Ctrl --> UI : listOfDirectSalesDTO
deactivate Ctrl

UI --> Buyer : Shows the list of items\n on direct sale
deactivate UI

@enduml