' Section 2 - Get list of direct sales with the genre chosen
Buyer -> UI : selectedgenre
activate UI
UI -> Ctrl : getListOfItemsOnDirectSale(selectedgenre)
activate Ctrl
Ctrl -> DirectSaleRepo : getListOfItemsOnDirectSale(selectedgenre)
activate DirectSaleRepo
DirectSaleRepo -> ListDS ** : create()

loop for each direct sale
    DirectSaleRepo -> DirectSaleRepo : isDirectSaleFromGenre(selectedgenre)
    DirectSaleRepo -> ListDS: add(Item)
end

