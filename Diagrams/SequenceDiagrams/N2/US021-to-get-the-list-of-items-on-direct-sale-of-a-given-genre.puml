@startuml
hide footbox
autonumber
title US021 - To get the list of items on direct sale of a given genre

actor Buyer

' Participants
participant ":UI021" as UI
participant ":ToGetTheListOfItemsOn\nDirectSaleOfAGivenGenreController" as Ctrl
participant ":GenreRepository" as GenreRepo
participant "listOfAllGenres:\n List<Genre>" as ListGenre
participant ":GenreMapper_US021" as GenreMapper
participant "genreDTO:\nGenreDTO_US021" as GenreDTO
participant ":Genre" as Genre
participant "listOfAllGenresDTO:\nList<GenreDTO_US021>" as ListGenreDTO
participant ":DirectSaleMapper_US021" as DSMapper
participant ":DirectSaleRepository" as DirectSaleRepo
participant "listOfDirectSale:\nList<DirectSale>" as ListDS
participant "directSaleDTO:\nDirectSaleDTO_US021" as DSDTO
participant ":DirectSale" as DS
participant "listOfDirectSaleDTO:\nList<DirectSaleDTO_US021>" as ListDSDTO


' Interactions

' Section 1 - Get all genres
Buyer -> UI : I want to get the list of items\n on direct sale of a given genre
activate UI
UI -> Ctrl : getAllGenres()
activate Ctrl
Ctrl -> GenreRepo: getAllGenres()
activate GenreRepo
GenreRepo -> ListGenre **
GenreRepo --> Ctrl: listOfAllGenres
deactivate GenreRepo
Ctrl -> GenreMapper: toDTO(listOfAllGenres)
activate GenreMapper
GenreMapper -> ListGenreDTO ** : create()
loop for each genre
    GenreMapper -> Genre: getDetails(genre)
    activate Genre
    Genre --> GenreMapper: genreDetails
    deactivate Genre
        GenreMapper -> GenreDTO ** : createDTO(genreDetails)
    GenreDTO --> GenreMapper: genreDTO
    GenreMapper --> ListGenreDTO: add(genreDTO)
end
GenreMapper --> Ctrl: listOfAllGenresDTO
deactivate GenreMapper
Ctrl --> UI : listOfAllGenresDTO
deactivate Ctrl
Buyer <-- UI : Which genre? Choose!
deactivate UI

' Section 2 - Get list of direct sales with the genre chosen
Buyer -> UI : genre
activate UI
UI -> Ctrl : getListOfItemsOnDirectSale(genre)
activate Ctrl
Ctrl -> DirectSaleRepo : getListOfItemsOnDirectSale(genre)
activate DirectSaleRepo
DirectSaleRepo -> ListDS ** : create()
loop for each direct sale
    DirectSaleRepo -> DirectSaleRepo : isDirectSaleFromGenre(genre)
    DirectSaleRepo -> ListDS: add(directSale)
end
DirectSaleRepo --> Ctrl : listOfDirectSale
deactivate DirectSaleRepo
Ctrl -> DSMapper : toDTO(listOfDirectSale)
activate DSMapper
DSMapper -> ListDSDTO ** : create()
loop for each direct sale
    DSMapper -> DS: getDetails(directSale)
    activate DS
    DS --> DSMapper: directSaleDetails
    deactivate DS
    DSMapper -> DSDTO **: createDTO(directSaleDetails)
    DSDTO --> DSMapper: directSaleDTO
    DSMapper -> ListDSDTO : add(directSaleDTO)
end
DSMapper --> Ctrl : listOfDirectSaleDTO
deactivate DSMapper
Ctrl --> UI : listOfDirectSaleDTO
deactivate Ctrl
UI --> Buyer : Shows the list of items on direct sale
deactivate UI

@enduml