@startuml
hide footbox
autonumber
title US021 - To get the list of items on direct sale of a given genre

actor Buyer

' Participants
participant ":UI021" as UI
participant ":ToGetTheListOfItemsOnDirectSaleOfAGivenGenreController" as Ctrl
participant ":GenreRepository" as GenreRepo
participant ":FactoryGenre" as FactoryGenre
participant "listOfAllGenres:\nList<Genre>" as LG
participant ":ListingRepository" as ListingRepository

' Interactions

' Section 1 - Get all genres
Buyer -> UI : I want to get the list of items on direct sale of a given genre
activate UI

UI -> Ctrl : getAllGenres()
activate Ctrl

Ctrl -> GenreRepo : getAllGenres()
activate GenreRepo

GenreRepo -> FactoryGenre : create()
activate FactoryGenre

FactoryGenre -> LG ** : create()

FactoryGenre --> GenreRepo : List<Genre> copyGenres
deactivate FactoryGenre

GenreRepo --> Ctrl : List<Genre> copyGenres
deactivate GenreRepo

Ctrl --> UI : List<Genre> copyGenres
deactivate Ctrl

UI --> Buyer : Which genre? Choose!
deactivate UI

' Section 2 - Get list of direct sales with the genre chosen
Buyer -> UI : selectedgenre
activate UI

UI -> Ctrl : 11 getListOfItemsOnDirectSaleOfAGivenGenre(selectedgenre)
activate Ctrl

Ctrl -> ListingRepository : getListOfItemsOnDirectSaleOfAGivenGenre(selectedgenre)
activate ListingRepository

loop for each listing
    ListingRepository -> ListingRepository: isDirectSale()
    ListingRepository -> ListingRepository: isOfGenre(selectedgenre)
    ListingRepository -> ListingRepository: add(item)
end

ListingRepository --> Ctrl : listOfItems
deactivate ListingRepository

Ctrl --> UI : listOfItems
deactivate Ctrl

UI --> Buyer : Shows the list of items on direct sale
deactivate UI

@enduml