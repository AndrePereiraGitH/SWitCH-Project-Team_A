@startuml
hide footbox
autonumber
title To create a private collection of publications

actor "User" as User
participant ":UI" as UI
participant ":ToCreateCollectionOfPublicationsController" as Controller
participant ":IGenreRepository" as GenreRepo
participant ":IGenreRepositoryJpa" as GenreJpaRepo
participant "genreDMList: List<GenreDM>" as GenreDMList
participant ":GenreAssembler" as GenreAssembler
participant ":GenreFactory" as GenreFactory
participant "allGenreList: List<Genre>" as allGenreList
participant ":US017GenreMapper" as GenreMapper
participant "listOfGenreDTO: List<US017GenreDTO>" as listOfGenreDTO
participant ":Genre" as Genre
participant "genreDTO: US017GenreDTO" as GDTO
participant ":ICollectionOfPublicationsRepository" as CollectionRepo
participant ":ICollectionOfPublicationsRepositoryJpa" as CollectionJpaRepo
participant "DataBase" as DB
participant ":CollectionOfPublicationsAssembler" as CollectionAssembler
participant ":CollectionOfPublicationsFactory" as Factory

' --- Start ---
User -> UI : I want to create a new private collection of publications
activate UI
UI --> User : What is the collection name?
deactivate UI

User -> UI : name("My Favorites")
activate UI

' =========================
' Get Genres
' =========================
UI -> Controller : getAllGenres()
activate Controller

Controller -> GenreRepo : findAll()
activate GenreRepo

GenreRepo -> GenreJpaRepo : findAll()
activate GenreJpaRepo
GenreJpaRepo -> DB : SELECT * FROM genres
activate DB
DB --> GenreJpaRepo : data
deactivate DB
GenreJpaRepo -->> GenreDMList ** : <<create>>
GenreJpaRepo --> GenreRepo : genreDMList
deactivate GenreJpaRepo

GenreRepo -->> allGenreList ** : <<create>>

loop for each GenreDM
    GenreRepo -> GenreAssembler : toDomain(genreDM)
    activate GenreAssembler

    GenreAssembler -> GenreFactory : create(genreId, genreType)
    activate GenreFactory
    create ":Genre" as GenreObj
    GenreFactory -->> GenreObj : <<create>>
    GenreFactory --> GenreAssembler : genre
    deactivate GenreFactory

    GenreAssembler --> GenreRepo : genre
    deactivate GenreAssembler

    GenreRepo -> allGenreList : add(genre)
end

GenreRepo --> Controller : allGenreList
deactivate GenreRepo

Controller -> GenreMapper : toDTOList(allGenreList)
activate GenreMapper
GenreMapper -->> listOfGenreDTO ** : <<create>>

loop for each genre in allGenreList
    GenreMapper -> Genre : getGenreType()
    activate Genre
    Genre --> GenreMapper : genreType
    deactivate Genre

    GenreMapper -->> GDTO ** : <<create>>
    GenreMapper -> listOfGenreDTO : add(genreDTO)
end

GenreMapper --> Controller : listOfGenreDTO
deactivate GenreMapper

Controller --> UI : listOfGenreDTO
deactivate Controller

UI --> User : Here is the list of genres, select one!
deactivate UI

' =========================
' Create Private Collection
' =========================
User -> UI : selectedGenre("Fiction")
activate UI

UI -> Controller : createCollection(name, genreId, userId)
activate Controller

Controller -> Factory : create(name, genreId, userId)
activate Factory
create "cp:CollectionOfPublications" as CP
Factory -->> CP : <<create>>
note right : _isPrivate = true\n(enforced by constructor)
Factory --> Controller : cp
deactivate Factory

Controller -> CollectionRepo : save(cp)
activate CollectionRepo

CollectionRepo -> CollectionJpaRepo : existsById(cp.id())
activate CollectionJpaRepo
CollectionJpaRepo -> DB : SELECT * FROM collections WHERE id = ?
activate DB
DB --> CollectionJpaRepo : result
deactivate DB
CollectionJpaRepo --> CollectionRepo : false
deactivate CollectionJpaRepo

alt [collection already exists]
    CollectionRepo --> Controller : error: "Collection already exists"
    Controller --> UI : error: "Collection already exists"

else [collection does NOT exist]

    CollectionRepo -> CollectionAssembler : toDM(cp)
    activate CollectionAssembler
    create "cpDM:CollectionOfPublicationsDM" as CPDM
    CollectionAssembler -->> CPDM : <<create>>
    CollectionAssembler --> CollectionRepo : cpDM
    deactivate CollectionAssembler

    CollectionRepo -> CollectionJpaRepo : save(cpDM)
    activate CollectionJpaRepo
    CollectionJpaRepo -> DB : INSERT INTO collections ...
    activate DB
    DB --> CollectionJpaRepo : savedDM
    deactivate DB
    CollectionJpaRepo --> CollectionRepo : savedDM
    deactivate CollectionJpaRepo

    CollectionRepo -> CollectionAssembler : toDomain(savedDM)
    activate CollectionAssembler
    CollectionAssembler -> Factory : create(id, name, genreId, userId, isPrivate)
    activate Factory
    create "savedCP:CollectionOfPublications" as SavedCP
    Factory -->> SavedCP : <<create>>
    Factory --> CollectionAssembler : savedCP
    deactivate Factory
    CollectionAssembler --> CollectionRepo : savedCP
    deactivate CollectionAssembler

    CollectionRepo --> Controller : savedCP
    deactivate CollectionRepo

    Controller --> UI : savedCP
    deactivate Controller

end

UI --> User : Private collection of publications created successfully
deactivate UI

@enduml