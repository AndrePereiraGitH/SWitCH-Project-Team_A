participant ":UI" as UI
participant ":ToCreateCollectionOfPublicationsController" as Controller
participant ":CollectionOfPublicationsService" as Service
participant ":ICollectionOfPublicationsRepository" as Repo
participant ":ICollectionOfPublicationsRepositoryJpa" as JpaRepo
participant "DataBase" as DB
participant ":CollectionOfPublicationsAssembler" as Assembler
participant ":CollectionOfPublicationsFactory" as Factory

UI -> Controller : createCollection(name, genreId, userId)
activate Controller

Controller -> Service : createAndSave(name, genreId, userId)
activate Service

Service -> Factory : create(name, genreId, userId)
activate Factory

create "cp:CollectionOfPublications" as CP
Factory -->> CP : <<create>>
note right : _isPrivate = true\n(enforced by constructor)

Factory --> Service : cp
deactivate Factory

Service -> Repo : save(cp)
activate Repo

Repo -> JpaRepo : existsById(cp.id())
activate JpaRepo
JpaRepo -> DB : SELECT * FROM collections WHERE id = ?
activate DB
DB --> JpaRepo : result
deactivate DB
JpaRepo --> Repo : false
deactivate JpaRepo

alt [collection already exists]
    Repo --> Service : error: "Collection already exists"
    Service --> Controller : error: "Collection already exists"
    Controller --> UI : error: "Collection already exists"

else [collection does NOT exist]

    Repo -> Assembler : toDM(cp)
    activate Assembler

    create "cpDM:CollectionOfPublicationsDM" as CPDM
    Assembler -->> CPDM : <<create>>

    Assembler --> Repo : cpDM
    deactivate Assembler

    Repo -> JpaRepo : save(cpDM)
    activate JpaRepo

    JpaRepo -> DB : INSERT INTO collections ...
    activate DB
    DB --> JpaRepo : data
    deactivate DB

    create "savedDM:CollectionOfPublicationsDM" as SavedDM
    JpaRepo -->> SavedDM : <<create>>
    JpaRepo --> Repo : savedDM
    deactivate JpaRepo

    Repo -> Assembler : toDomain(savedDM)
    activate Assembler

    Assembler -> Factory : create(id, name, genreId, userId, isPrivate)
    activate Factory

    create "savedCP:CollectionOfPublications" as SavedCP
    Factory -->> SavedCP : <<create>>

    Factory --> Assembler : savedCP
    deactivate Factory

    Assembler --> Repo : savedCP
    deactivate Assembler

    Repo --> Service : savedCP
    deactivate Repo

    Service --> Controller : savedCP
    deactivate Service

    Controller --> UI : savedCP
    deactivate Controller

end

@enduml