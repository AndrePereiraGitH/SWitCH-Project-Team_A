@startuml

footbox off

title Register a new country in the System


actor Administrator
participant ":UI" as UI

autonumber


participant ":CountryController" as CountryController
participant ":CountryService" as CountryService
participant ":ICountryRepository" as ICountryRepository
participant ":CountryFactory" as CountryFactory
participant ":CountryAssembler" as Assembler
participant ":CountryDM" as DM
participant ":ICountryJPARepository" as JPA


Administrator -> UI : I want to register a new country
activate UI
UI --> Administrator : What is the name of the country?
deactivate UI

Administrator -> UI : The country is <countryName>
activate UI

UI -> CountryController : registerNewCountry\n (countryName)
activate CountryController


CountryController -> CountryService : createAndSave\n (countryName)
activate CountryService
CountryService -> CountryFactory : create
activate CountryFactory
create participant "newCountry1: Country" as Country
CountryFactory -->> Country : «create»
CountryFactory --> CountryService : newCountry1
deactivate CountryFactory
CountryService -> ICountryRepository : save
activate ICountryRepository
ICountryRepository --> CountryService : "successfully saved"
deactivate ICountryRepository
CountryService --> CountryController : "<countryName>\n successfully added"
deactivate CountryService

CountryController --> UI : "<countryName>\n successfully added"
deactivate CountryController
UI --> Administrator : "<countryName> has been\n successfully registered in the system!"
deactivate UI

/' ICountryRepository -> CountryFactory : createAndAdd\n(countryName)
activate CountryFactory
CountryFactory -->> Country : «create»

CountryFactory --> ICountryRepository : newCountry1
deactivate CountryFactory

ICountryRepository -> ICountryRepository : validate\n (newCountry1)

alt Country already exists
ICountryRepository --> CountryController : newCountry1\n already exists
CountryController --> UI : newCountry1\n already exists
UI --> Administrator : <newCountry1> is already\n registered in the system!
else Country does not exist
ICountryRepository -> ICountryRepository : Add (newCountry1)
ICountryRepository --> CountryController : newCountry1
deactivate ICountryRepository

CountryController --> UI : success!
deactivate CountryController

UI --> Administrator : <newCountry1>\n registered successfully!
deactivate UI
end
'/


@enduml