@startuml

footbox off

title Sequence Diagram - US007 Register a new country in the System

box "Tests" #LightYellow
actor Administrator
participant ":UI" as UI
end box

participant ":CityController" as CityController
participant ":CityRepository" as AddressRepository

Administrator -> UI : **1** registerNewCity (name, country)

UI -> CityController : **2** registerNewCity (name, country)
activate CityController

CityController -> AddressRepository : **3** addNewCity (name, country)
activate AddressRepository

create "newCity1: City" as City
AddressRepository -> City : **4** createCity(name, country)

AddressRepository -> AddressRepository : **5** validateToAdd (newCity1)
AddressRepository --> CityController : **6** true
deactivate AddressRepository

CityController --> UI : **7** sucess
deactivate CityController

UI --> Administrator : **8** sucess

@enduml