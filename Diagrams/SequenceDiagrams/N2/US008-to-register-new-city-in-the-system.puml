@startuml

footbox off
title Sequence Diagram - US008 Register a new city in the System

actor Administrator
participant ":UI" as UI
participant ":US008ToRegisterACityCtrl" as CityController
participant ":CountryRepository" as CountryRepository
participant ":CityRepository" as CityRepository
participant ":CityFactory" as CityFactory

Administrator -> UI : 1. Request to register a new city
activate UI

UI -> CityController : 2. registerNewCity(countryName, cityName)
activate CityController

CityController -> CountryRepository : 3. findCountryIdByCountryName(countryName)
activate CountryRepository

CountryRepository -> CountryRepository : 4. validate(countryName)
CountryRepository -> CountryRepository : 5. normalize(countryName)

alt Country found
    CountryRepository --> CityController : 6. Optional<CountryID>

    deactivate CountryRepository

    CityController -> CityRepository : 7. createAndAdd(countryID, cityName)
    activate CityRepository

    CityRepository -> CityFactory : 8. create(countryID, cityName)
    activate CityFactory

    create "newCity : City" as City
    CityFactory -> City : 9. instantiate

    CityFactory --> CityRepository : 10. newCity
    deactivate CityFactory

    CityRepository -> CityRepository : 11. existsByAttributes(newCity)

    alt City already exists
        CityRepository --> CityController : throws IllegalArgumentException
        deactivate CityRepository
    else City is new
        CityRepository -> CityRepository : 12. add(newCity)
        CityRepository --> CityController : 13. newCity
        deactivate CityRepository

        CityController --> UI : 14. true
    end

else Country not found
    CountryRepository --> CityController : Optional.empty()
    deactivate CountryRepository

    CityController --> UI : throws IllegalArgumentException
end

deactivate CityController

UI --> Administrator : 15. Operation result (success / error)
deactivate UI

@enduml