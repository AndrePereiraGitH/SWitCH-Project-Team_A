```
@startuml
autonumber
hide footbox
title US012 - As a User, I want to get the list (title, author, type and ISBN/SSN) of publications in my library

actor User
participant ":UI012" as UI
participant ":US012GetListOfPublicationsInLibraryController" as Ctrl

participant ":IUserRepository" as userRepo
participant ":IPublicationSampleRepository" as pubSampleRepo
participant "listOfPublications\n:List<PublicationSample>" as ListPubs
participant ":PublicationSample" as pubSample
participant ":US012PublicationSampleMapper" as Mapper
participant "listOfPublicationsDTO\n:List<PublicationDetailsDTO_US012>" as ListDTO
participant "pubDTO\n:PublicationDetailsDTO_US012" as pubDTO

User -> UI : I want to see a list of the publications in my library
activate UI
UI -> User : Enter your username
deactivate UI
User -> UI : username

activate UI
UI -> Ctrl : getListOfPublicationsInLibrary(username)
activate Ctrl

Ctrl -> userRepo : findUserIdByUsername(username)
activate userRepo
userRepo --> Ctrl : userId
deactivate userRepo

Ctrl -> pubSampleRepo : getAllPublicationsInUserLibrary(userId)
activate pubSampleRepo

pubSampleRepo -->> ListPubs ** : <<create>>

loop for each pubSample in PublicationSampleRepository
    pubSampleRepo -> pubSample : isOwnedByUser(userId)
    activate pubSample
    pubSample --> pubSampleRepo : true
    deactivate pubSample
    pubSampleRepo -> pubSample : isInUserLibrary()
    activate pubSample
    pubSample --> pubSampleRepo : true
    deactivate pubSample
    pubSampleRepo -> pubSampleRepo : listOfPublications.add(pubSample)
end

pubSampleRepo --> Ctrl : listOfPublications
deactivate pubSampleRepo

Ctrl -> Mapper : toDTOs(listOfPublications)
activate Mapper

Mapper -->> ListDTO ** : <<create>>

loop for each publicationSample in listOfPublications
    Mapper -> pubDTO ** : toDTO()
    Mapper -> Mapper : listOfPublicationsDTO.add(pubDTO)
end

Mapper --> Ctrl : listOfPublicationsDTO
deactivate Mapper

Ctrl --> UI : listOfPublicationsDTO
deactivate Ctrl

UI --> User : Display list of publications\n(title, author, type, ISBN/SSN)
deactivate UI

@enduml
```
