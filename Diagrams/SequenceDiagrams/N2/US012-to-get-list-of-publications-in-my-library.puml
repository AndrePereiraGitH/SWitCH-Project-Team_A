@startuml
autonumber
hide footbox
title US012 - As a User, I want to get the list (title, author, type and ISBN/SSN) of publications in my library


actor User
participant ":UI012" as UI



participant ":US012GetListOfPublicationsInLibraryController" as Ctrl

participant ":LibraryRepository" as libraryRepo


participant ":Library" as LibDomain

participant "listOfPublications:List<PublicationSample>" as ListPubs

participant ":PublicationDetailsDTO_US012" as DTO

participant "listOfPublicationsDTO:List<PublicationDetailsDTO>" as ListDTO

participant ":PublicationSample" as PubDomain

participant "pubDTO:PublicationDetailsDTO" as pubDTO







User -> UI : I want to see a list of the publications in my library
activate UI
UI -> User : Enter your username
deactivate UI
User -> UI: username

activate UI

UI -> Ctrl: getListOfPublicationsInLibraryDTO(username)
activate Ctrl
Ctrl -> libraryRepo: getAllPublicationsFromUserLibrary(username)

activate libraryRepo

libraryRepo -> LibDomain : getAllPublications()

activate LibDomain

LibDomain -> ListPubs **: create()

LibDomain -> libraryRepo : listOfAllPublications

deactivate LibDomain


libraryRepo -> Ctrl: listOfAllPublications

deactivate libraryRepo


Ctrl -> DTO: toDTOs(listOfPublications)

activate DTO
DTO -> ListDTO **: create()


    loop for each publication in listOfPublications
        DTO -> PubDomain: getDetails()
        activate PubDomain
        PubDomain --> DTO: details
        deactivate PubDomain

        DTO -> pubDTO** : createDTO(details)

        DTO -> DTO: listOfPublicationsDTO.add(pubDTO)
    end

DTO --> Ctrl: listOfPublicationsDTO
deactivate DTO

Ctrl --> UI: listOfPublicationsDTO
deactivate Ctrl

UI --> User : shows the list of publications with details
deactivate UI
@enduml