@startuml
autonumber
hide footbox
title Get Official Genres List (with JPA)

actor Administrator as User

participant ":UI" as UI
participant ":ToGetListOfGenre\nController" as C
participant ":IGenre\nRepository" as GR
participant ":IGenre\nRepositoryJPA" as GRJPA
participant ":Genre\nAssembler" as Assembler
participant ":Genre\nFactory" as Factory
participant ":US013Genre\nMapper" as MAPPER
participant "DataBase" as EM

User -> UI : I want to see all official\n genres in the system
activate UI

UI -> C : getAllGenres()
activate C

C -> GR : findAll()
activate GR

GR -> GRJPA : findAll()
activate GRJPA

GRJPA -> EM : Query
activate EM

note over EM
Query database (SELECT * FROM genre)
end note

EM --> GRJPA : data
deactivate EM

create "genresPersistedDM:\nList<GenreDM>" as genresPersisted
GRJPA -->> genresPersisted : <<create>>

GRJPA --> GR : genresPersistedDM
deactivate GRJPA

create "listOfGenre:\nList<Genre>" as listDomain
GR -->> listDomain : <<create>>

loop for each GenreDM in genresPersistedDM
    GR -> Assembler : toDomain(genreDM)
    activate Assembler

    Assembler -> Factory : create(dm.getId(), dm.getGenreType())
    activate Factory

    create "genreDomain:\nGenre" as genreDomain
    Factory -->> genreDomain : <<create>>

    Factory --> Assembler : genreDomain
    deactivate Factory

    Assembler --> GR : genreDomain
    deactivate Assembler

    GR -> listDomain : add(genreDomain)
end

GR --> C : listOfGenre
deactivate GR

C -> MAPPER : toDTOList(listOfGenre)
activate MAPPER

create "listOfGenreDTO:\nList<US013GenreDTO>" as listDTO
MAPPER -->> listDTO : <<create>>

loop for each Genre in listOfGenre
    create "genreDTO:\nUS013GenreDTO" as genreDTO
    MAPPER -> genreDTO : toDTO(genre)

    MAPPER -> MAPPER : listOfGenreDTO.add(genreDTO)
end

MAPPER --> C : listOfGenreDTO
deactivate MAPPER

C --> UI : listOfGenreDTO
deactivate C

UI --> User : Here's the list of\n available genres!
deactivate UI

@enduml