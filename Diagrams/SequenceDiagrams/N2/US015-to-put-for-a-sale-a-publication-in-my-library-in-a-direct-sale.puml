@startuml
autonumber
hide footbox
title US015 - To put for sale a publication in my library in a direct sale

box #whitesmoke
actor User
participant ":UI015" as UI
end box

participant ":ToPutPublicationInDirectSaleController" as Ctrl
participant ":Library" as Lib
participant ":PublicationSampleDTO_US015" as DTO
participant "publicationSampleDTO:\nPublicationSampleDTO_US015" as DTO_O
participant ":PublicationSample" as Pub
participant ":FactoryListing" as LFactory
participant ":ListingRepository" as LRepo

User -> UI : I want to put for sale a publication in my library in a direct sale
activate UI
UI -> Ctrl: getAllPublications()
activate Ctrl
Ctrl-> Lib : getAllPublications()
activate Lib
create "listOfAvailablePublications:\n List<PublicationSample>" as LP
Lib -> LP : create()
    loop for each PublicationSample
        Lib -> Pub : getPublicationStatus()
        activate Pub
        Pub --> Lib : status
        deactivate Pub
        alt status != SOLD and status != FOR_SALE
            Lib -> LP : add(pub)
        end
    end
Lib --> Ctrl: listOfAvailablePublications
deactivate Lib

Ctrl-> DTO : toDTO(listOfAvailablePublications)
activate DTO

create "listOfPublicationSampleDTO:\nList<PublicationSampleDTO>" as listDTO
DTO -> listDTO : create()
    loop for each PublicationSample
        DTO -> Pub : getPublicationSampleDetails()
        activate Pub
        Pub --> DTO : publicationSampleDetails
        deactivate Pub
        DTO -> DTO_O ** : createDTO(publicationSampleDetails)
        DTO -> listDTO : add(publicationSampleDTO)
    end
DTO --> Ctrl: listOfPublicationSampleDTO
deactivate DTO
Ctrl--> UI : listOfPublicationSampleDTO
deactivate Ctrl

UI --> User : Which publication(s)? Choose from the list!
deactivate UI

User -> UI : Selected publication(s)
activate UI
UI --> User : Specify the title, price, short description and pictures for the listing
deactivate UI

User -> UI : Title, price, short description, pictures
activate UI

UI -> Ctrl: createListing(title, selectedPublications,\n saleType, price, shortDescription, seller, pictures)
activate Ctrl
Ctrl-> LFactory : create(title, selectedPublications,\n saleType, price, shortDescription, seller, pictures)
activate LFactory

create "listing: Listing" as listing
LFactory -> listing : create (title, selectedPublications, saleType, price, shortDescription, seller, pictures)
LFactory --> Ctrl : listing
deactivate LFactory
Ctrl -> LRepo: add(listing)
activate LRepo
LRepo --> Ctrl: true
deactivate LRepo

Ctrl--> UI: true
deactivate Ctrl

UI --> User : Publication(s) put for direct sale with success
deactivate UI

@enduml