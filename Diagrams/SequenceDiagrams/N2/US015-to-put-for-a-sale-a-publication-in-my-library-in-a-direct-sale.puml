@startuml
autonumber
hide footbox
title US015 - To put for sale a publication in my library in a direct sale

box #whitesmoke
actor User
participant ":UI015" as UI
end box

participant ":US015ToPutPublicationInDirectSaleController" as Ctrl

participant ":ILibraryRepository" as LibRepo

participant ":IPublicationSampleRepository" as PSRepo
participant ":PublicationSample" as Pub

participant "listOfLibraryPublications:\nList<PublicationSample" as ListLibraryPS
participant "listOfAvailablePublication:\nList<PublicationSample>" as ListAvailablePub

participant ":US015PublicationSampleMapper" as Mapper
participant "listOfPublicationSampleDTO:\nList<US015PublicationSampleDTO>" as listDTO
participant "publicationSampleDTO:\nUS015PublicationSampleDTO" as DTO_O

participant ":IListingRepository" as LRepo
participant ":ListingFactory" as LFactory
participant ":Listing" as Listing

' --- Step 1: User initiates the process ---
User -> UI : I want to put for sale a publication\nin a direct sale
activate UI
UI -> Ctrl : findLibraryPublicationsAvailableForSale()
activate Ctrl

' US012
' --- Step 2: find User's Library ---
Ctrl -> LibRepo : getLibraryByUserId(userId)
activate LibRepo
LibRepo --> Ctrl : library
deactivate LibRepo

' --- Step 4: find Library's PublicationSamples ---
Ctrl -> PSRepo : getPublicationsByLibraryID(library.libraryId)
activate PSRepo
PSRepo -->> ListLibraryPS ** : «create»
PSRepo --> Ctrl : listOfLibraryPublications
deactivate PSRepo
' US012

' --- Step 5: verifies if the PublicationSamples available for sale ---
' Later, this should be done by the domain services (not the Controller)
Ctrl -->> ListAvailablePub ** : «create»
loop for each PublicationSample
    Ctrl -> Pub : isAvailableForSale()
    activate Pub
    Pub --> Ctrl : boolean
    deactivate Pub
    alt publicationSample is available
        Ctrl -> ListAvailablePub : add(publicationSample)
    end
end

' --- Step 6: Converts the list of available publications to DTOs ---
Ctrl -> Mapper : toDTOs(listOfAvailablePublications)
activate Mapper
Mapper -->> listDTO ** : «create»
loop for each publicationSample
    Mapper -->> DTO_O **: «create»
    Mapper -> listDTO: add(publicationSampleDTO)
end
Mapper --> Ctrl : listOfPublicationSampleDTO
deactivate Mapper
Ctrl --> UI : listOfPublicationSampleDTO
deactivate Ctrl

' --- Step 7: Returns the list of available publications to the user ---
UI --> User : Which publication(s)?\nChoose from the list!
deactivate UI

' --- Step 8: User selects publications and provides listing details ---
User -> UI : Selected publication(s)
activate UI
UI --> User : Specify title, price,\nshort description and pictures
deactivate UI

User -> UI : Title, price, short description,\npictures
activate UI

UI -> Ctrl : putPublicationForSale(title, selectedPublicationIds,\nprice, shortDescription, userId, pictures)
activate Ctrl

' --- Step 9: Listing creation ---
Ctrl -> LRepo : createAndAdd(title, selectedPublicationIds, SaleType.DIRECT_SALE, price, shortDescription, userId, pictures)
activate LRepo

LRepo -> LFactory : create(title, selectedPublicationIds, SaleType.DIRECT_SALE,\n price, shortDescription, userId, pictures)
activate LFactory

LFactory -->> Listing ** : «create»(title, selectedPublicationIds, SaleType.DIRECT_SALE,\n price, shortDescription, userId, pictures)
LFactory --> LRepo : listing
deactivate LFactory

LRepo -> LRepo : add(listing)
LRepo --> Ctrl : listing
deactivate LRepo

Ctrl --> UI : success
deactivate Ctrl

UI --> User : Publication(s) put for direct\n sale with success
deactivate UI

@enduml

