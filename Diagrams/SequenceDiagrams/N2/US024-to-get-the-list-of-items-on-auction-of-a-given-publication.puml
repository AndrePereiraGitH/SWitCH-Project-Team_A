@startuml

hide footbox
autonumber
title US024 - To get the list of items on auction of a given publication

actor Buyer

' Participants
participant ":UI024" as UI
participant ":GetTheListOfItemsOn\nAuctionOfAGivenPublicationController" as Ctrl
participant ":PublicationRepository" as PubRepo
participant "listOfAllPublications:\n List<Publication>" as ListPub
participant ":PublicationDetailsMapper" as PubMapper
participant "publicationDTO:\nPublicationDetailsDTO" as PubDTO
participant ":Publication" as Pub
participant "listOfAllPublicationsDTO:\nList<PublicationDetailsDTO>" as ListPubDTO
participant ":AuctionRepository" as AuctionRepo
participant "listOfItemsOnAuctionByPublication:\nList<Item>" as ListAuc
participant ":ItemDetailsDTO" as itemDTO
participant "listOfItemsDTO:\nList<ItemDetailsDTO>" as ListAucDTO
participant ":Item" as item
participant "ItemDTO:ItemDetailsDTO" as itemdto

' Interactions

' Section 1 - Get all publications
Buyer -> UI : I want to get the list of items\n on auction of a given publication
activate UI
UI -> Ctrl : getAllPublications()
activate Ctrl
Ctrl -> PubRepo: getAllPublications()
activate PubRepo
PubRepo -> ListPub **: create()
PubRepo --> Ctrl: listOfAllPublications
deactivate PubRepo
Ctrl -> PubMapper: toDTOs(listOfAllPublications)
activate PubMapper
PubMapper -> ListPubDTO ** : create()
loop for each publication
    PubMapper -> Pub: getDetails()
    activate Pub
    Pub --> PubMapper: publicationDetails
    deactivate Pub
        PubMapper -> PubDTO ** : createDTO(publicationDetails)
    PubMapper --> PubMapper: listOfAllPublicationsDTO.add(publicationDTO)
end    
PubMapper --> Ctrl: listOfPublicationsDTO
deactivate PubMapper
Ctrl --> UI : listOfPublicationsDTO
deactivate Ctrl
Buyer <-- UI : Which publication? Choose!
deactivate UI

' Section 2 - Get list of auctions with the publication chosen
Buyer -> UI : publication
activate UI
UI -> Ctrl : getListOfItemsOnAuctionByGivenPublicationDTO(publication)
activate Ctrl
Ctrl -> AuctionRepo : getListOfItemsOnAuctionByGivenPublication(publication)
activate AuctionRepo
AuctionRepo -> ListAuc ** : create()
loop for each auction
    AuctionRepo -> AuctionRepo : verifyIfAuctionHasItemsOfThatPublication(publication)
    AuctionRepo -> AuctionRepo: listOfItemsOnAuctionByPublication.add(item)
end
AuctionRepo --> Ctrl : listOfItemsOnAuctionByPublication
deactivate AuctionRepo
Ctrl -> itemDTO : toDTOs()
activate itemDTO
itemDTO -> ListAucDTO ** : create()
loop for each item
    itemDTO -> item: getItemOnAuctionDetails()
    activate item
    item --> itemDTO: itemDetailsOnAuction
    deactivate item
    itemDTO-> itemdto **: createDTO(itemDetailsOnAuction)
    itemDTO -> itemDTO : listOfItemsDTO.add(itemDTO)
end
itemDTO --> Ctrl : listOfItemsDTO
deactivate itemDTO
Ctrl --> UI : listOfItemsDTO
deactivate Ctrl
UI --> Buyer : Shows the list of items on auction
deactivate UI

@enduml