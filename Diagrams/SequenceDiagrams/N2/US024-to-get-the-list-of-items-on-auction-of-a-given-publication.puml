@startuml

hide footbox
autonumber
title US024 - To get the list of items on auction of a given publication

' Participants
actor Buyer
participant ":UI024" as UI024
participant ":ToGetTheListOfItemsOnAuction\nOfAGivenPublicationController" as Ctrl
participant ":PublicationRepository" as PublicationRepository
participant ":PublicationMapper" as PubMapper
participant "publicationDTO:PublicationDTO" as PubDTO
participant ":AuctionMapper" as Mapper
participant ":AuctionRepository" as AuctionRepository
participant "listOfAuction:\nList<Auction>" as ListAuc
participant ":Auction" as AucDomain
participant "auctionDTO:\nAuctionDTO" as DTO
participant "listOfAuctionDTO:\nList<AuctionDTO>" as ListDTO

'Interactions
Buyer -> UI024 : I want to get the list of items\n on auction of a given publication
activate UI024
UI024 -> Ctrl: getAllPublications()
activate Ctrl
Ctrl -> PublicationRepository: getAllPublications()
activate PublicationRepository
PublicationRepository --> Ctrl: listOfAllPublications
deactivate PublicationRepository

Ctrl -> PubMapper: toDTO(listOfAllPublications)
activate PubMapper
'PubMapper -> PubDTO
PubMapper -> PubDTO ** : create()
activate PubDTO
PubDTO --> PubMapper: PublicationDTO
deactivate PubDTO
PubMapper -> PubMapper : listOfAllPublicationsDTO.add(PublicationDTO)
PubMapper --> Ctrl: listOfAllPublicationsDTO
deactivate PubMapper


Ctrl --> UI024 : listOfAllPublications
deactivate Ctrl
Buyer <-- UI024 : Which publication? Choose!
deactivate UI024
Buyer -> UI024 : publication
activate UI024
UI024 -> Ctrl : getListOfItemsOnAuction(publication)
activate Ctrl

Ctrl -> AuctionRepository : getListOfItemsOnAuction(publication)
activate AuctionRepository

loop for each auction
    AuctionRepository -> AuctionRepository : checkAuctionPublication(publication)
end

AuctionRepository -> ListAuc ** :
AuctionRepository --> Ctrl : listOfAuction

deactivate AuctionRepository

Ctrl -> Mapper : toDTO(listOfAuction)
activate Mapper
Mapper -> ListDTO ** :

    loop for each auction
        Mapper -> AucDomain : getDetails()
        activate AucDomain
        AucDomain --> Mapper : details
        deactivate AucDomain

        Mapper -> DTO ** : create(details)
        activate DTO
        DTO --> Mapper : auctionDTO
        deactivate DTO

        Mapper -> Mapper : listOfAuctionsDTO.add(auctionDTO)
    end

Mapper --> Ctrl : listOfAuctionsDTO
deactivate Mapper

Ctrl --> UI024 : listOfAuctionsDTO
deactivate Ctrl

UI024 --> Buyer : Shows the list of items on auction
deactivate UI024

@enduml