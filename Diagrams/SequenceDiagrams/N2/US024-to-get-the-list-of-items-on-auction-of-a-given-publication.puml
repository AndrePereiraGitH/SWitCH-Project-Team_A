@startuml

hide footbox
autonumber
title US024 - To get the list of items on auction of a given publication

actor Buyer

' Participants
participant ":UI024" as UI
participant ":ToGetTheListOfItemsOn\nAuctionOfAGivenPublicationController" as Ctrl
participant ":PublicationRepository" as PubRepo
participant "listOfAllPublications:\n List<Publication>" as ListPub
participant ":PublicationMapper_US024" as PubMapper
participant "publicationDTO:\nPublicationDTO_US024" as PubDTO
participant ":Publication" as Pub
participant "listOfAllPublicationsDTO:\nList<PublicationDTO>" as ListPubDTO
participant ":AuctionMapper_US024" as AucMapper
participant ":AuctionRepository" as AuctionRepo
participant "listOfAuction:\nList<Auction>" as ListAuc
participant "AuctionDTO:\nAuctionDTO_US024" as AucDTO
participant ":Auction" as Auc
participant "listOfAuctionDTO:\nList<AuctionDTO_US024>" as ListAucDTO


' Interactions

' Section 1 - Get all publications
Buyer -> UI : I want to get the list of items\n on auction of a given publication
activate UI
UI -> Ctrl : getAllPublications()
activate Ctrl
Ctrl -> PubRepo: getAllPublications()
activate PubRepo
PubRepo -> ListPub **
PubRepo --> Ctrl: listOfAllPublications
deactivate PubRepo
Ctrl -> PubMapper: toDTO(listOfAllPublications)
activate PubMapper
PubMapper -> ListPubDTO ** : create()
loop for each publication
    PubMapper -> Pub: getDetails(publication)
    activate Pub
    Pub --> PubMapper: publicationDetails
    deactivate Pub
        PubMapper -> PubDTO ** : createDTO(publicationDetails)
    PubDTO --> PubMapper: publicationDTO
    PubMapper --> ListPubDTO: add(publicationDTO)
end    
PubMapper --> Ctrl: listOfAllPublicationsDTO
deactivate PubMapper
Ctrl --> UI : listOfAllPublicationsDTO
deactivate Ctrl
Buyer <-- UI : Which publication? Choose!
deactivate UI

' Section 2 - Get list of auctions with the publication chosen
Buyer -> UI : publication
activate UI
UI -> Ctrl : getListOfItemsOnAuction(publication)
activate Ctrl
Ctrl -> AuctionRepo : getListOfItemsOnAuction(publication)
activate AuctionRepo
AuctionRepo -> ListAuc ** : create()
loop for each auction
    AuctionRepo -> AuctionRepo : isAuctionFromPublication(publication)
    AuctionRepo -> ListAuc: add(auction)
end
AuctionRepo --> Ctrl : listOfAuction
deactivate AuctionRepo
Ctrl -> AucMapper : toDTO(listOfAuction)
activate AucMapper
AucMapper -> ListAucDTO ** : create()
loop for each auction
    AucMapper -> Auc: getDetails(auction)
    activate Auc
    Auc --> AucMapper: auctionDetails
    deactivate Auc
    AucMapper -> AucDTO **: createDTO(auctionDetails)
    AucDTO --> AucMapper: auctionDTO
    AucMapper -> ListAucDTO : add(auctionDTO)
end
AucMapper --> Ctrl : listOfAuctionDTO
deactivate AucMapper
Ctrl --> UI : listOfAuctionDTO
deactivate Ctrl
UI --> Buyer : Shows the list of items on auction
deactivate UI

@enduml