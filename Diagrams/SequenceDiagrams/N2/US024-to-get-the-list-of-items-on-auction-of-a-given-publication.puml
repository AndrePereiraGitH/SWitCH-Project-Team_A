@startuml

hide footbox
autonumber
title US024 - To get the list of items on auction of a given publication

actor Buyer

' Participants
participant ":UI024" as UI
participant ":US024GetTheListOfItemsOn\nAuctionOfAGivenPublicationController" as Ctrl
participant ":BibliographicalDataRepository" as bdRepo
participant "listOfAllPublicationBD:\n List<BibliographicalData>" as ListPub
participant ":BibliographicalDataDTO_US024" as bdDTO
participant "listOfAllBiblioDataDTO:\nList<BibliographicalDataDTO_US024>" as ListPubDTO
participant "biblioDataDTO:BibliographicalDataDTO_US024" as bddto
participant ":BibliographicalData" as bd
participant ":AuctionRepository" as AuctionRepo
participant "listOfItemsOnAuctionByPublication:\nList<PublicationSample>" as ListAuc
participant ":AuctionItemDTO_US024" as aucDTO
participant "listAuctionItemDTO:\nList<AuctionItemDTO_US024>" as ListAucDTO
participant ":PublicationSample" as item
participant "auctionItemDTO:AuctionItemDTO_US024" as itemdto

' Interactions

' Section 1 - Get all publications
Buyer -> UI : I want to get the list of items\n on auction of a given publication
activate UI
UI -> Ctrl : getAllPublicationBD()
activate Ctrl
Ctrl -> bdRepo: getAllPublicationBD()
activate bdRepo
bdRepo -> ListPub **: create()
bdRepo --> Ctrl: listOfAllPublicationBD
deactivate bdRepo
Ctrl -> bdDTO: toDTOs(listOfAllPublicationBD)
activate bdDTO
bdDTO -> ListPubDTO ** : create()
loop for each BibliographicalData in listOfAllPublicationBD
    bdDTO -> bd: getBibliographicalDataDetails()
    activate bd
    bd --> bdDTO: bibliographicalDataDetails
    deactivate bd
        bdDTO -> bddto ** : createDTO(bibliographicalDataDetails)
    bdDTO -> bdDTO: listOfAllBiblioDataDTO.add(biblioDataDTO)
end
bdDTO --> Ctrl: listOfAllBiblioDataDTO
deactivate bdDTO
Ctrl --> UI : listOfAllBiblioDataDTO
deactivate Ctrl
Buyer <-- UI : Which publication? Choose!
deactivate UI

' Section 2 - Get list of auctions with the publication chosen
Buyer -> UI : bdPublicationDTO
activate UI
UI -> Ctrl : getListOfItemsOnAuctionByGivenPublicationDTO(bdPublicationDTO)
activate Ctrl
Ctrl -> AuctionRepo : getListOfItemsOnAuctionByGivenPublication(bdPublicationDTO)
activate AuctionRepo
AuctionRepo -> ListAuc ** : create()
loop for each auction in AuctionRepository
    AuctionRepo -> AuctionRepo : verifyIfAuctionHasItemsOfThatPublication(bdPublicationDTO)
    AuctionRepo -> AuctionRepo: listOfItemsOnAuctionByPublication.add(bdPublicationDTO)
end
AuctionRepo --> Ctrl : listOfItemsOnAuctionByPublication
deactivate AuctionRepo
Ctrl -> aucDTO : toDTOs(listOfItemsOnAuctionByPublication)
activate aucDTO
aucDTO -> ListAucDTO ** : create()
loop for each item in listOfItemsOnAuctionByPublication
    aucDTO -> item: getAuctionItemDetails()
    activate item
    item --> aucDTO: auctionItemDetails
    deactivate item
    aucDTO-> itemdto **: createDTO(auctionItemDetails)
    aucDTO -> aucDTO : listAuctionItemDTO.add(auctionItemDTO)
end
aucDTO --> Ctrl : listAuctionItemDTO
deactivate aucDTO
Ctrl --> UI : listAuctionItemDTO
deactivate Ctrl
UI --> Buyer : Shows the list of items on auction
deactivate UI

@enduml