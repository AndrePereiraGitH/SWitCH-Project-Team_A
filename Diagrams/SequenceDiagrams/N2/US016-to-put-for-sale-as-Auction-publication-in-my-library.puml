@startuml
autonumber
hide footbox
title US0016 - Put a publication from my library for sale in an auction

box #whitesmoke
    actor User
    participant ":UI" as UI
end box

participant ":US016ToPutPublicationInAuctionController" as ctrl

participant ":LibraryRepository" as LibRepo

participant ":Library" as Lib
participant ":PublicationSampleDTO_US016" as pubDto
participant "listOfPublications List<PublicationSample>" as listPub

participant "listOfPublicationsDTO : List<PublicationSampleDTO" as listPubDTO



participant ":PublicationSampleRepository" as pubRepo

participant ":ListingRepository" as ListingRepo

participant ":ListingFactory" as ListingFactory


participant ":AuctionRepository" as AucRepo
participant ":AuctionFactory" as AuctionFactory





User -> UI : I want to sell a publication of my library as an auction"
activate UI

/' ====== GET LIST OF PUBLICATIONS IN LIBRARY ========= '/
UI -> ctrl : getAllPublicationsInUserLibrary(username)
activate ctrl
ctrl -> LibRepo : getLibraryOfUser(username)
activate LibRepo
LibRepo --> ctrl : userLibrary
deactivate LibRepo

ctrl -> Lib : getAllPublications()

activate Lib
'create "listOfPublications:List<Publication>" as listPub
Lib -> listPub **: getAllPublications()

Lib --> ctrl : listOfPublications
deactivate Lib

'create "listOfPublicationsDTO : List<PublicationSampleDTO" as pubDtoList
ctrl -> listPubDTO ** : create()

loop for each PublicationAmple in Library
    ctrl -> pubDto : toDTO(publication)
    activate pubDto
    pubDto --> ctrl : publicationDTO
    deactivate pubDto
    ctrl -> ctrl : listOfPublicationsDTO.add(publicationDTO)
end


ctrl --> UI : listOfPublicationsDTO
deactivate ctrl
UI --> User : Please, select one or more publications from your Library: pub1_dto, pub2_dto, pub3_dto...
deactivate UI


/' ====== AUCTION AND LISTING REQUESTS ========= '/

User -> UI : Selected publications: pub1_dto
activate UI
UI --> User : Please, insert listingPrice, shortDescription, listingTitle, seller,\n initialDate, finalDate, buyOutPrice.
deactivate UI
User -> UI : provide data
activate UI
UI -> ctrl : createAuctionListing(listingTitle, publicationsDtoList, price, shortDescription,\n pictures, initialDate, finalDate, buyOutPrice)
activate ctrl

ctrl -> pubRepo : getPublicationByDto(publicationsDtoList)
activate pubRepo

create "listOfPublicationSamples : List<PublicationSample>" as listPubSelected
pubRepo -> listPubSelected : create()

loop for each PublicationSampleDTO in pubDtoList
    pubRepo -> pubRepo : getPublicationByDto()
    pubRepo -> pubRepo : listOfPublicationSamples.add(publicationByDto)
end

pubRepo --> ctrl : listOfPublicationSamples
deactivate pubRepo

/' ====== ===== LISTING ========= '/

ctrl -> ListingRepo : createAndAdd ( listing_title, listOfPublicationSamples, SaleType.AUCTION, price, shortDescription, pictures )
activate ListingRepo

ListingRepo -> ListingFactory : create(listing_title, listOfPublicationSamples, SaleType.AUCTION, price, shortDescription, pictures)
activate ListingFactory
create "listing :Listing" as listing
ListingFactory -> listing : create()
ListingFactory --> ListingRepo : listing
deactivate ListingFactory
ListingRepo -> ListingRepo : isExistent(l1)
ListingRepo -> ListingRepo : add(l1)
ListingRepo --> ctrl : listing
deactivate ListingRepo

/' ====== ===== AUCTION ========= '/
ctrl -> AucRepo : createAndAdd(listing, initialDate, finalDate, buyOutPrice)
activate AucRepo

AucRepo -> AuctionFactory : create(listing, initialDate, finalDate, buyOutPrice)
activate AuctionFactory
create "auction1:Auction" as a1
AuctionFactory -> a1 : create()
AuctionFactory --> AucRepo : auction1
deactivate AuctionFactory

AucRepo -> AucRepo : validateAuction(auction1)
AucRepo -> AucRepo : addAuction(auction1)
AucRepo --> ctrl : auction1
deactivate AucRepo

/'========== RETURN SUCCESS ========== '/

ctrl --> UI : success
deactivate ctrl
UI --> User : Your publication pub1 is now in an Auction
deactivate UI
@enduml
