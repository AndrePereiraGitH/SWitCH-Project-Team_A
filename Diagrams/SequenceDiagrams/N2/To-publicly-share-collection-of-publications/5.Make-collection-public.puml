@startuml

hide footbox
autonumber

title "Make Collection Public"

participant ":Controller" as Controller
participant ":ICollectionOfPublication\nRepository" as CollectionRepository
participant ":ICollectionOfPublication\nJPARepository" as collectionRepositoryJPA
participant ":CollectionOfPublications\nAssembler" as collectionAssembler
participant "selectedCollectionDomain\n:CollectionOfPublications" as selectedCollectionDomain

participant ":CollectionOfPublications\nFactory" as collectionsFactory

participant "publicCollectionDM\n:CollectionOfPublicationsDM" as publicCollectionDM
participant "updatedCollectionDM\n:CollectionOfPublicationsDM" as updatedCollectionDM

database DataBase as db

participant "updatedCollection\n:CollectionOfPublications" as updatedCollection

note over Controller #E3F2FD
