@startuml

hide footbox
autonumber

title "Find Collection Of Publications by ID"

participant ":CollectionOfPublications\nService" as service
participant ":ICollectionOfPublication\nRepository" as CollectionRepository
participant ":ICollectionOfPublication\nJPARepository" as collectionRepositoryJPA
participant ":CollectionOfPublications\nAssembler" as collectionAssembler
participant "selectedCollectionDM\n:CollectionOfPublicationsDM" as selectedCollectionDM

participant ":CollectionOfPublications\nFactory" as collectionsFactory
database DataBase as db
participant "selectedCollectionDomain\n:CollectionOfPublications" as selectedCollectionDomain

note over service #E3F2FD
<b>Fragment</b>
---
This diagram is a fragment of Make Collection Public sequence diagram.
end note

note over service #E3F2FD
<b>Navigation</b>
---
[[5.Make-collection-public.puml Return to Main Diagram]]
end note

service -> CollectionRepository : findById(collectionId)
activate CollectionRepository

CollectionRepository -> collectionRepositoryJPA : findById(collectionId)
activate collectionRepositoryJPA

collectionRepositoryJPA -> db : query find collection by id
activate db
db --> collectionRepositoryJPA : collection data
deactivate db

collectionRepositoryJPA -->> selectedCollectionDM** : <<create>>
collectionRepositoryJPA --> CollectionRepository : selectedCollectionDM
deactivate collectionRepositoryJPA

CollectionRepository -> collectionAssembler : toDomain(selectedCollectionDM)
activate collectionAssembler

collectionAssembler -> selectedCollectionDM : getId()
activate selectedCollectionDM
selectedCollectionDM --> collectionAssembler : id
deactivate selectedCollectionDM

collectionAssembler -> selectedCollectionDM : getName()
activate selectedCollectionDM
selectedCollectionDM --> collectionAssembler : name
deactivate selectedCollectionDM

collectionAssembler -> selectedCollectionDM : getGenreId()
activate selectedCollectionDM
selectedCollectionDM --> collectionAssembler : genreId
deactivate selectedCollectionDM

collectionAssembler -> selectedCollectionDM : getUserId()
activate selectedCollectionDM
selectedCollectionDM --> collectionAssembler : userId
deactivate selectedCollectionDM

collectionAssembler -> selectedCollectionDM : get_isPrivate()
activate selectedCollectionDM
selectedCollectionDM --> collectionAssembler : isPrivate
deactivate selectedCollectionDM

collectionAssembler -> collectionsFactory : create(id, name, genreId, userId, isPrivate)
activate collectionsFactory
collectionsFactory -->> selectedCollectionDomain** : <<create>>
collectionsFactory --> collectionAssembler : selectedCollectionDomain
deactivate collectionsFactory

collectionAssembler --> CollectionRepository : selectedCollectionDomain
deactivate collectionAssembler

CollectionRepository --> service : selectedCollectionDomain
deactivate CollectionRepository

@enduml