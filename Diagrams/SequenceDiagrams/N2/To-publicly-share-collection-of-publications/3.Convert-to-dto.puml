end note

note over Controller #E3F2FD
<b>Navigation</b>
---
[[Main-diagram-To-publicly-share-a-list.puml Return to Main Diagram]]
end note

Controller -> Mapper : toDTOs(listOfUserCollections)
activate Mapper
Mapper  -->> listCollectionsDTO ** : «create»

    loop for each collection in listOfUserCollections
        Mapper -> collectionDTO ** : toDTO(collection)
        Mapper -> listCollectionsDTO : add(collectionDTO)
    end
    Mapper  -->> Controller : listCollectionsDTO
deactivate Mapper

deactivate Controller

@enduml