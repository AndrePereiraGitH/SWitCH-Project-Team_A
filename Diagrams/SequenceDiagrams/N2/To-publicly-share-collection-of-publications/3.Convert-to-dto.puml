@startuml

hide footbox
autonumber

title "Convert CollectionOfPublications to CollectionOfPublicationsDTO"

participant ":Controller" as Controller
participant ":US019CollectionOfPublications\nMapper" as Mapper
participant "listCollectionsDTO:\nList<US019CollectionOfPublicationsDTO>" as listCollectionsDTO
participant "collectionDTO:\nUS019CollectionOfPublicationsDTO" as collectionDTO

note over Controller #E3F2FD
<b>Fragment</b>
---
