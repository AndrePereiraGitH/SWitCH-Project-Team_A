@startuml

hide footbox
autonumber
title US023 - To get the list of items on direct sale of a given publication

actor Buyer

' Participants
participant ":UI023" as UI023
participant ":ToGetTheListOfItemsOnDirectSaleOfAGivenPublicationController" as Ctrl
participant ":PublicationRepository" as PublicationRepository
participant ":DirectSaleMapper" as Mapper
participant ":DirectSaleRepository" as DirectSaleRepository
participant "listOfDirectSale:\nList<DirectSale>" as ListDS
participant ":DirectSale" as DSDomain
participant "directSaleDTO:\nDirectSaleDTO" as DTO
participant "listOfDirectSaleDTO:\nList<DirectSaleDTO>" as ListDTO


' Interactions
Buyer -> UI023 : I want to get the list of items\n on direct sale of a given publication
activate UI023
UI023 -> Ctrl : getAllPublications()
activate Ctrl
Ctrl -> PublicationRepository: getAllPublications()
activate PublicationRepository
PublicationRepository --> Ctrl: listOfAllPublications
deactivate PublicationRepository
Ctrl --> UI023 : listOfAllPublications
deactivate Ctrl
Buyer <-- UI023 : Which publication? Choose!
deactivate UI023
Buyer -> UI023 : publication
activate UI023

UI023 -> Ctrl : getListOfItemsOnDirectSale(publication)
activate Ctrl

Ctrl -> DirectSaleRepository : getListOfItemsOnDirectSale(publication)
activate DirectSaleRepository

loop for each direct sale
    DirectSaleRepository -> DirectSaleRepository : checkDirectSaleGenre(genre)
end

DirectSaleRepository -> ListDS ** :
DirectSaleRepository --> Ctrl : listOfDirectSale

deactivate DirectSaleRepository

Ctrl -> Mapper : toDTO(listOfDirectSale)
activate Mapper
Mapper -> ListDTO ** :

    loop for each direct sale
        Mapper -> DSDomain : getDetails()
        activate DSDomain
        DSDomain --> Mapper : details
        deactivate DSDomain

        Mapper -> DTO ** : create(details)
        activate DTO
        DTO --> Mapper : directSaleDTO
        deactivate DTO

        Mapper -> Mapper : listOfDirectSalesDTO.add(directSaleDTO)
    end

Mapper --> Ctrl : listOfDirectSalesDTO
deactivate Mapper

Ctrl --> UI023 : listOfDirectSalesDTO
deactivate Ctrl

UI023 --> Buyer : Shows the list of items on direct sale
deactivate UI023

@enduml