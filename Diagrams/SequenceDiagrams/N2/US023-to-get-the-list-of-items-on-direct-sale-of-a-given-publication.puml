@startuml
hide footbox
autonumber
title US023 - To get the list of items on direct sale of a given publication

box #whitesmoke
actor Buyer
participant ":UI023" as UI
end box

participant ":ToGetTheListOfItemsOn\nDirectSaleOfAGivenPublicationController" as Ctrl
participant ":BibliographicalDataRepository" as BDRepo
participant "listOfAllPublicationsBD:\n List<BibliographicalData>" as ListPub
participant ":BibliographicalDataDTO_US023" as BDDTO_C
participant "bibliographicalDataDTO:\nBibliographicalDataDTO_US023" as BDDTO
participant ":BibliographicalData" as BD
participant "listOfAllBibiographicalDataDTO:\nList<BibliographicalDataDTO_US023>" as ListBDDTO
participant ":ListingRepository" as ListingRepo
participant "listOfListing:\nList<Listing>" as ListListings
participant ":PublicationSampleRepository" as PubSampleRepo
participant "listOfPublicationSample:\nList<PublicationSamples>" as ListItems
participant ":PublicationSampleDTO_US023" as ItemDTO_C
participant "publicationSampleDTO:\nPublicationSampleDTO_US023" as ItemDTO
participant "listOfItemsDTO:\nList<PublicationSampleDTO_US023>" as ListItemsDTO
participant ":PublicationSample" as PubSample

' Interactions

' Section 1 - Get all publications
Buyer -> UI : I want to get the list of items\n on direct sale of a given publication
activate UI
UI -> Ctrl : getAllPublicationBD()
activate Ctrl
Ctrl -> BDRepo: getAllPublicationBD()
activate BDRepo
BDRepo -> ListPub ** : create()
BDRepo --> Ctrl: listOfAllPublicationsBD
deactivate BDRepo
Ctrl -> BDDTO_C: toDTO(listOfAllPublicationsBD)
activate BDDTO_C
BDDTO_C -> ListBDDTO ** : create()
loop for each bibliographicalData
    BDDTO_C -> BD: getBibliographicalDataDetails()
    activate BD
    BD --> BDDTO_C: bibliographicalDataDetails
    deactivate BD
    BDDTO_C -> BDDTO **: createDTO(bibliographicalDataDetails)
    BDDTO_C --> ListBDDTO: add(bibliographicalDataDTO)
end    
BDDTO_C --> Ctrl: listOfAllBibiographicalDataDTO
deactivate BDDTO_C
Ctrl --> UI : listOfAllBibiographicalDataDTO
deactivate Ctrl
Buyer <-- UI : Which publication? Choose!
deactivate UI

' Section 2 - Get list of listings for direct sale
Buyer -> UI : publication
activate UI
UI -> Ctrl : getListOfItemsOnDirectSale(publication)
activate Ctrl
'Ctrl -> ListingRepo : getListOfListingsOnDirectSale()
Ctrl -> ListingRepo : findDirectSaleListings()
activate ListingRepo
ListingRepo -> ListListings ** : create()

/'
loop for each listing
    alt saleType == DIRECT_SALE
    ListingRepo -> ListListings: add(listing)
    end
end
'/
ListingRepo --> Ctrl : listOfListing
deactivate ListingRepo

' Section 3 - Get list of publication samples for the previous listings
'Ctrl -> PubSampleRepo : getListOfPublicationSamples()
Ctrl -> PubSampleRepo : findPublicationSamplesByListing(listOfListings, publication)
activate PubSampleRepo
PubSampleRepo -> ListItems ** : create()
/'
    loop for each listing
        loop for each publicationSample 
            alt publicationSample == publication
            PubSampleRepo -> ListItems: add(publicationSample)
            end
        end
    end
 '/
PubSampleRepo --> Ctrl : listOfItems
deactivate PubSampleRepo

' Section 4 - create DTO for items
Ctrl -> ItemDTO_C : toDTO(listOfItems)
activate ItemDTO_C
ItemDTO_C -> ListItemsDTO ** : create()
loop for each publicationSample
    ItemDTO_C -> PubSample: getPublicationSampleDetails()
    activate PubSample
    PubSample --> ItemDTO_C: publicationSampleDetails
    deactivate PubSample
    ItemDTO_C -> ItemDTO ** : createDTO(publicationSampleDetails)
    ItemDTO_C -> ListItemsDTO : add(publicationSampleDTO)
end
ItemDTO_C --> Ctrl : listOfPublicationSampleDTO
deactivate ItemDTO_C
Ctrl --> UI : listOfPublicationSampleDTO
deactivate Ctrl
UI --> Buyer : Shows the list of items on direct sale
deactivate UI

@enduml