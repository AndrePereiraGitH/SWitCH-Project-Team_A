@startuml
hide footbox
autonumber
title US023 - To get the list of items on direct sale of a given publication

box #whitesmoke
actor Buyer
participant ":UI023" as UI
end box

participant ":US023ToGetTheListOfItemsOn\nDirectSaleOfAGivenPublicationController" as Ctrl

participant ":IBibliographicalDataRepository" as BDRepo
participant "listOfAllPublicationsBD:\n List<BibliographicalData>" as ListPub
participant ":US023BibliographicalDataMapper" as BDMapper
participant "bibliographicalDataDTO:\nUS023BibliographicalDataDTO" as BDDTO
participant "listOfAllBibliographicalDataDTO:\nList<US023BibliographicalDataDTO>" as ListBDDTO
participant ":IListingRepository" as ListingRepo
participant "listOfDSListing:\nList<Listing>" as ListListing
participant ":IPublicationSampleRepository" as PubSampleRepo
participant "listOfPublicationSample:\nList<PublicationSample>" as ListPubSample
participant ":US023PublicationSampleMapper" as PSMapper
participant "publicationSampleDTO:\nUS023PublicationSampleDTO" as ItemDTO
participant "listOfPubSampleDTO:\nList<US023PublicationSampleDTO>" as ListPubSampleDTO

' Section 1 - Get all publications
Buyer -> UI : I want to get the list of items\n on direct sale of a given publication
activate UI
UI -> Ctrl : getAllPublicationBD()
activate Ctrl
Ctrl -> BDRepo: getAllPublicationBD()
activate BDRepo
BDRepo -->> ListPub ** : «create»
BDRepo --> Ctrl: listOfAllPublicationsBD
deactivate BDRepo

' Section 2 - Converts all publications list to DTO
Ctrl -> BDMapper: toDTOs(listOfAllPublicationsBD)
activate BDMapper
BDMapper -->> ListBDDTO ** : «create»
loop for each bibliographicalData
   BDMapper -->> BDDTO **: «create»
   BDMapper -> ListBDDTO: add(bibliographicalDataDTO)
end
BDMapper --> Ctrl : listOfAllBibliographicalDataDTO
deactivate BDMapper
Ctrl --> UI : listOfAllBibliographicalDataDTO
deactivate Ctrl
Buyer <-- UI : Which publication? Choose!
deactivate UI

' Section 3 - Get list of listings in direct sale
Buyer -> UI : publication
activate UI
UI -> Ctrl : findListOfItemsOnDirectSale(publicationId)
activate Ctrl
Ctrl -> ListingRepo : findAllDirectSaleListings()
activate ListingRepo
ListingRepo -->> ListListing ** : «create»
ListingRepo --> Ctrl : listOfDSListing
deactivate ListingRepo

' Section 4 - Get the PublicationSamples for those listings
Ctrl -> PubSampleRepo : findItemsByIdsAndPublication(listOfPubSampleIds,publicationId)
activate PubSampleRepo
PubSampleRepo -->> ListPubSample ** : «create»
PubSampleRepo --> Ctrl : listOfPubSample
deactivate PubSampleRepo

' Section 5 - create DTO for items
Ctrl -> PSMapper : toDTOs(listOfPublicationSample)
activate PSMapper
PSMapper  -->> ListPubSampleDTO ** : «create»
loop for each publicationSample
    PSMapper -->> ItemDTO ** : «create»
    PSMapper -> ListPubSampleDTO : add(publicationSampleDTO)
end
PSMapper --> Ctrl : listOfPubSampleDTO
deactivate PSMapper
Ctrl --> UI : listOfPubSampleDTO
deactivate Ctrl
UI --> Buyer : Shows the list of items on direct sale
deactivate UI

@enduml