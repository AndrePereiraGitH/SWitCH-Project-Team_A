@startuml

hide footbox
autonumber
title Get Publication Types - REST Flow

participant ":PublicationType\nRESTController" as Controller

participant ":IPublicationTypeRepository" as PublicationTypeRepo
participant ":IPublicationType\nRepositoryJPA" as PubRepoJPA
participant ":PublicationTypeAssembler" as PubAssembler

participant "pubTypeListDM\n:PublicationTypeDM" as pubTypeDM
participant ":PublicationTypeFactory" as PubFactory
participant "persistedPubTypeList\n:List<PublicationType>" as persistedPublicationTypeList
participant "persistedPubType\n:PublicationType" as persistedPublicationType

participant ":PublicationTypeMapper" as PublicationTypeMapper
participant "listOfResponsePubTypeDTO\n:List<ResponsePublicationTypeDTO>" as PublicationTypeDTO
participant ":PublicationType" as PublicationType
participant "responsePubTypeDTO\n:ResponsePublicationTypeDTO" as PDTO

database "DB" as DB


' =========================
' CONTEXT / MAIN REFERENCE
' =========================
note over Controller #E3F2FD
<b>Fragment of Main Diagram</b>
---
[[1.MainDiagram.puml Back to Main Flow]]
end note


' =========================
' CONTROLLER ENTRY
' =========================
Controller -> PublicationTypeRepo : findAll()
activate Controller
activate PublicationTypeRepo


' =========================
' REPOSITORY LAYER
' =========================
PublicationTypeRepo -> PubRepoJPA : findAll()
activate PubRepoJPA

PubRepoJPA -> DB : SELECT * FROM PublicationType
activate DB

DB --> PubRepoJPA : publicationTypeDMList
deactivate DB

PubRepoJPA --> pubTypeDM ** : <<create>>
PubRepoJPA --> PublicationTypeRepo : pubTypeDMList
deactivate PubRepoJPA


' =========================
' ASSEMBLER (DM -> DOMAIN)
' =========================
PublicationTypeRepo -> PubAssembler : toDomainList(pubTypeDMList)
activate PubAssembler

PubAssembler -->> persistedPublicationTypeList ** : <<create>>

loop for each publicationTypeDM in pubTypeDMList

    PubAssembler -> pubTypeDM : getId()
    activate pubTypeDM
    pubTypeDM --> PubAssembler : pubTypeId
    deactivate pubTypeDM

    PubAssembler -> pubTypeDM : getMediaFormat()
    activate pubTypeDM
    pubTypeDM --> PubAssembler : mediaFormat
    deactivate pubTypeDM

    PubAssembler -> PubFactory : create(pubTypeId, mediaFormat)
    activate PubFactory

    PubFactory -->> persistedPublicationType ** : <<create>>
    PubFactory --> PubAssembler : persistedPubType
    deactivate PubFactory

    PubAssembler -> PubAssembler : add(persistedPubType)

end

PubAssembler --> PublicationTypeRepo : persistedPubTypeList
deactivate PubAssembler


' =========================
' RETURN TO CONTROLLER
' =========================
PublicationTypeRepo --> Controller : persistedPubTypeList
deactivate PublicationTypeRepo


' =========================
' MAPPER (DOMAIN -> DTO)
' =========================
Controller -> PublicationTypeMapper : toDTOs(persistedPubTypeList)
activate PublicationTypeMapper

PublicationTypeMapper -->> PublicationTypeDTO ** : <<create>>

loop for each publicationType in persistedPubTypeList

    PublicationTypeMapper -> PublicationType : getId()
    activate PublicationType
    PublicationType --> PublicationTypeMapper : id
    deactivate PublicationType

    PublicationTypeMapper -> PublicationType : getMediaFormat()
    activate PublicationType
    PublicationType --> PublicationTypeMapper : mediaFormat
    deactivate PublicationType

    PublicationTypeMapper -->> PDTO ** : <<create>>
    PublicationTypeMapper -> PublicationTypeMapper : add(responsePubTypeDTO)

end

PublicationTypeMapper --> Controller : listOfResponsePubTypeDTO
deactivate PublicationTypeMapper

deactivate Controller

@enduml