@startuml
hide footbox
autonumber
title To add a publication genre to the genre list

actor Administrator
participant ":UI" as UI
participant ":ToRegisterGenreController" as Ctrl
participant ":GenreService" as Service
participant ":IGenreRepository" as Repo
participant ":IGenreRepositoryJpa" as JpaRepo
DataBase "DataBase" as DB
participant ":GenreAssembler" as Assembler
participant ":GenreFactory" as Factory

Administrator -> UI : I want to add a new genre to the official list
activate UI
UI --> Administrator : What is the genre name?

Administrator -> UI : genreType("Drama")

UI -> Ctrl : registerGenre(genreType)
activate Ctrl

Ctrl -> Service : createAndSave(genreType)
activate Service

Service -> Repo : findByTitle(genreType)
activate Repo

Repo -> JpaRepo : findByGenreType(genreType)
activate JpaRepo

JpaRepo -> DB : SELECT * FROM genres WHERE genre_type = ?
activate DB
DB --> JpaRepo : result
deactivate DB

JpaRepo --> Repo : Optional<GenreDM>
deactivate JpaRepo

Repo --> Service : Optional<Genre>
deactivate Repo

alt [genre already exists - Optional.isPresent()]
    Service --> Ctrl : throws IllegalArgumentException
    Ctrl --> UI : error: "Genre already exists"
    UI --> Administrator : Genre already exists

else [genre does NOT exist - Optional.empty()]

    Service -> Factory : create(genreType)
    activate Factory
    create "drama:Genre" as Genre
    Factory -->> Genre : <<create>>
    Factory --> Service : drama
    deactivate Factory

    Service -> Repo : save(drama)
    activate Repo

    Repo -> Assembler : toDM(drama)
    activate Assembler
    create "genreDM:GenreDM" as GenreDM
    Assembler -->> GenreDM : <<create>>
    Assembler --> Repo : genreDM
    deactivate Assembler

    Repo -> JpaRepo : save(genreDM)
    activate JpaRepo
    JpaRepo -> DB : INSERT INTO genres ...
    activate DB
    DB --> JpaRepo : data
    deactivate DB
    create "savedDM:GenreDM" as SavedDM
    JpaRepo -->> SavedDM : <<create>>
    JpaRepo --> Repo : savedDM
    deactivate JpaRepo

    Repo -> Assembler : toDomain(savedDM)
    activate Assembler
    Assembler -> Factory : create(genreId, genreType)
    activate Factory
    create "savedGenre:Genre" as SavedGenre
    Factory -->> SavedGenre : <<create>>
    Factory --> Assembler : savedGenre
    deactivate Factory
    Assembler --> Repo : savedGenre
    deactivate Assembler

    Repo --> Service : savedGenre
    deactivate Repo

    Service --> Ctrl : savedGenre
    deactivate Service

    Ctrl --> UI : true
    deactivate Ctrl

    UI --> Administrator : Genre successfully added!
    deactivate UI

end

@enduml