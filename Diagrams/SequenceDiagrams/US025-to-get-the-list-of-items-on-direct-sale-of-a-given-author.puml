@startuml

hide footbox
title US025 - To get the list of items on direct sale of a given author

box "Tests" #LightYellow
actor Buyer
participant ":UI" as UI
end box

participant ":ItemController" as ItemController
participant ":ItemRepository" as ItemRepository

Buyer -> UI : **1** getListOfItems(typeOfSale, author)

UI -> ItemController : **2** getListOfItems(typeOfSale, author)
activate ItemController

ItemController -> ItemRepository : **3** getListOfItems(typeOfSale, author)
activate ItemRepository

' ItemRepository -> ItemRepository : **4** convertStringToEnum(typeOfSale, author)

ItemRepository -> ItemRepository : **4** validateParameters(typeOfSale, author)

create "i1: List<Item>" as Item
ItemRepository -> Item : **5** createList(typeOfSale, author)

ItemRepository --> ItemController : **6** List<Item> items
deactivate ItemRepository

ItemController -> ItemController : **7** copyList(items)

ItemController --> UI : **8** List<copyItems> (copyItems)
deactivate ItemController

UI --> Buyer : **9** List<copyItems> (copyItems)

@enduml