@startuml

autonumber
hide footbox
title SSD: US015 - To put for a sale a publication in my library in a Direct Sale

actor "User" as User
participant ":System" as System

activate User

   User -> System : Request "I want to sell a publication in my Library in a Direct Sale
   activate System
   System --> User : Choose a publication!
   User -> System : Selected Publication and information for Item
   System --> User : Insert information for Direct Sale
   User -> System : Information about Direct Sale
   System --> User : Direct Sale successfully created!
   deactivate System

deactivate User
@enduml