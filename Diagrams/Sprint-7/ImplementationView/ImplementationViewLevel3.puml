@startuml MiteLovers_Logical_View_L3_Backend

title MiteLovers Logical View - Level 3 (Backend)

skinparam backgroundColor white
skinparam defaultFontSize 12
skinparam component {
  BackgroundColor #7EC8E3
  BorderColor #1B1B1B
}
skinparam ArrowColor #1B1B1B
skinparam ArrowFontSize 11

interface "API" as API
interface "Database" as Database

component "Backend" as BackendApp {

    port " " as pAPI
    port " " as pDB

    component "Router" as router
    component "Persistence" as persistence

    component "ControllerREST" as ctrl
    component "ImplRepository" as implrepo

    component "Mapper + DTO" as mapper

    component "Service" as Services

    component "IRepository" as irepo
    component "Aggregates" as aggregates
    component "Factories" as factories

    component "Value Objects" as VO

    router ..> ctrl
    persistence ..|> implrepo
    implrepo ..|> irepo
    ctrl ..> Services
    ctrl ..> mapper
    Services ..> aggregates
    Services ..> factories
    Services ..> irepo

    ctrl ..> VO
    implrepo ..> VO
    implrepo ..> factories
    implrepo ..> aggregates
    Services ..> VO
    aggregates ...> VO
    factories ..> VO
    irepo ..> VO
    mapper ..> VO


    pAPI -- router
    persistence -- pDB

}


API -- pAPI
Database -- pDB

@enduml