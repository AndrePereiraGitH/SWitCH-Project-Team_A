@startuml MiteLovers_Logical_View_L2_External_API

title MiteLovers Logical View - Level 2 (Com API Externa)

skinparam backgroundColor transparent
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #5F9B96
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #5F9B96
}


interface "UI" as UI
interface "API" as API

package "MiteLovers" <<System>> {
  component "db" as db
  component "Backend" as Backend
  component "Frontend" as Frontend


  interface "Persistence API" as PersistenceAPI


  db -up- PersistenceAPI
  Backend -( PersistenceAPI
}


Backend -up- API


Frontend -( API


Frontend -up- UI

@enduml